def _managed_runtime_container_record(raw: dict, *, include_stopped: bool = False) -> dict | None:
    """Return the minimal identity for a Wolf-created PCGA child container."""
    if not isinstance(raw, dict):
        return None
    config = raw.get("Config") if isinstance(raw.get("Config"), dict) else {}
    state = raw.get("State") if isinstance(raw.get("State"), dict) else {}
    running = bool(state.get("Running"))
    if not include_stopped and not running:
        return None
    name = str(raw.get("Name") or "").lstrip("/")
    image = str(config.get("Image") or "")
    env = {}
    for item in config.get("Env") or []:
        if isinstance(item, str) and "=" in item:
            key, value = item.split("=", 1)
            env[key] = value
    sid = str(env.get("PCGA_GAME_SET_ID") or "").strip()
    managed_name = bool(re.fullmatch(r"PCGA-(?:Setup-)?[A-Za-z0-9_.-]+", name))
    managed_image = image.startswith("pcga/game-") or image.startswith("pcga/setup-") or image.startswith("pcga/heroic-runtime:")
    if not sid or not managed_name or not managed_image:
        return None
    return {
        "id": str(raw.get("Id") or ""),
        "name": name,
        "image": image,
        "game_set_id": sid,
        "running": running,
        "status": str(state.get("Status") or ""),
    }


def _prune_terminal_failed_managed_runtime_containers() -> int:
    """Remove a running transient desktop after its launcher has terminally failed.

    A legacy setup/game image can leave Sway alive for a grace period after Wine
    has already failed.  That stale container then blocks every unrelated Wolf
    catalog reload.  The markers below are written only after the launcher has
    entered a terminal failure path, so removing that disposable child container
    cannot discard preserved media or the persistent install prefix.
    """
    ps = subprocess.run(["docker", "ps", "-q", "--filter", "name=PCGA-"], capture_output=True, text=True)
    if ps.returncode != 0:
        return 0
    removed = 0
    markers = (
        "installer failed; terminating stale Wine helpers",
        "installer failed; exiting transient setup container",
        "primary Wine launch failed; terminating stale prefix helpers",
        "Wine debugger detected after an unhandled game exception",
        "detached Wine process crashed; debugger detected",
        "Wine stayed alive without mapping a game window; terminating black-screen session",
        "no game window appeared after launcher hand-off; terminating stale Wine helpers",
    )
    for cid in [x.strip() for x in ps.stdout.splitlines() if x.strip()]:
        inspected = subprocess.run(["docker", "inspect", cid], capture_output=True, text=True)
        if inspected.returncode != 0:
            continue
        try:
            rows = json.loads(inspected.stdout or "[]")
            raw = rows[0] if isinstance(rows, list) and rows else {}
        except Exception:
            continue
        rec = _managed_runtime_container_record(raw)
        if not rec:
            continue
        logs = subprocess.run(["docker", "logs", "--tail", "120", cid], capture_output=True, text=True)
        text = (logs.stdout or "") + "\n" + (logs.stderr or "")
        if not any(marker in text for marker in markers):
            continue
        proc = subprocess.run(["docker", "rm", "-f", cid], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if proc.returncode == 0:
            removed += 1
            log(f"removed terminally failed transient runtime container {rec['name']}")
    return removed


def _prune_stopped_managed_runtime_containers() -> int:
    """Remove dead Wolf child containers before they can block catalog reloads.

    v0.18.42 and older stopped containers were intentionally retained by Docker.
    They are transient desktops, not preservation artifacts, so keeping the
    container object after exit only creates stale UI/session state.
    """
    ps = subprocess.run(["docker", "ps", "-aq"], capture_output=True, text=True)
    if ps.returncode != 0:
        return 0
    ids = [x.strip() for x in ps.stdout.splitlines() if x.strip()]
    if not ids:
        return 0
    inspected = subprocess.run(["docker", "inspect", *ids], capture_output=True, text=True)
    if inspected.returncode != 0:
        return 0
    try:
        rows = json.loads(inspected.stdout or "[]")
    except Exception:
        return 0
    removed = 0
    for raw in rows if isinstance(rows, list) else []:
        rec = _managed_runtime_container_record(raw, include_stopped=True)
        if not rec or rec["running"]:
            continue
        cid = rec["id"]
        if not cid:
            continue
        proc = subprocess.run(["docker", "rm", "-f", cid], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if proc.returncode == 0:
            removed += 1
            log(f"removed stopped transient runtime container {rec['name']}")
    return removed


def _setup_container_active_for_set(set_id: str) -> bool:
    """Return whether Wolf still owns an interactive setup desktop for this title."""
    token = re.sub(r"[^A-Za-z0-9]+", "", str(set_id))[:12]
    if not token:
        return False
    ps = subprocess.run(
        ["docker", "ps", "--format", "{{.Names}}", "--filter", f"name=PCGA-Setup-{token}"],
        capture_output=True, text=True,
    )
    return ps.returncode == 0 and any(name.strip().startswith(f"PCGA-Setup-{token}") for name in ps.stdout.splitlines())


def _wolf_runtime_session_active() -> tuple[bool, str]:
    """Return whether a PCGA game/setup or GameStream session is active.

    Checking managed runtime containers first is stronger than relying only on
    TCP state: Moonlight's media path is substantially UDP and a live game can
    exist while no relevant TCP socket happens to be ESTABLISHED.
    """
    _prune_terminal_failed_managed_runtime_containers()
    _prune_stopped_managed_runtime_containers()
    ps = subprocess.run(["docker", "ps", "--format", "{{.Names}}"], capture_output=True, text=True)
    if ps.returncode == 0:
        active_names = [name.strip() for name in ps.stdout.splitlines() if name.strip().startswith("PCGA-")]
        if active_names:
            return True, "managed runtime container active: " + ", ".join(active_names[:4])
    if shutil.which("ss"):
        ss = subprocess.run(["ss", "-Htn", "state", "established"], capture_output=True, text=True)
        if ss.returncode == 0 and any(re.search(r":(47984|47989|48010)\b", line) for line in ss.stdout.splitlines()):
            return True, "GameStream control session active"
    return False, ""


def _wolf_pending_load() -> set[str]:
    try:
        data = json.loads(WOLF_RESTART_STATE.read_text(encoding="utf-8"))
        values = data.get("game_set_ids") if isinstance(data, dict) else []
        return {str(x) for x in values or [] if str(x)}
    except Exception:
        return set()


def _wolf_pending_save(set_ids: set[str], reason: str = "configuration-changed") -> None:
    if not set_ids:
        WOLF_RESTART_STATE.unlink(missing_ok=True)
        return
    WOLF_RESTART_STATE.parent.mkdir(parents=True, exist_ok=True)
    save_json(WOLF_RESTART_STATE, {
        "schema": 1,
        "requested_at": now(),
        "reason": reason,
        "game_set_ids": sorted(set_ids),
    })


def _wolf_request_reload(set_id: str) -> None:
    global _WOLF_CONFIG_DIRTY, _WOLF_CHANGED_SET_IDS
    _WOLF_CONFIG_DIRTY = True
    _WOLF_CHANGED_SET_IDS.add(set_id)
    _wolf_pending_save(_wolf_pending_load() | _WOLF_CHANGED_SET_IDS)


def wolf_remove_superseded_apps(aliases: dict[str,str]) -> None:
    """Remove Wolf app blocks owned by superseded duplicate set ids."""
    if not aliases or not WOLF_CONFIG.exists():
        return
    original=WOLF_CONFIG.read_text(encoding="utf-8")
    text=original
    app_rx=re.compile(r"(?ms)^\s*\[\[profiles\.apps\]\]\s*$.*?(?=^\s*\[\[profiles\.apps\]\]\s*$|^\s*\[\[profiles\]\]\s*$|\Z)")
    for sid in sorted(aliases):
        managed_rx=re.compile(rf"(?ms)^# BEGIN PCGA MANAGED APP {re.escape(sid)}\n.*?^# END PCGA MANAGED APP {re.escape(sid)}\n?")
        text=managed_rx.sub("",text)
        removals=[]
        for match in app_rx.finditer(text):
            if re.search(rf"PCGA_GAME_SET_ID={re.escape(sid)}(?:['\"]|\s|$)",match.group(0)):
                removals.append(match.span())
        for a,b in reversed(removals): text=text[:a]+text[b:]
    if text.strip()==original.strip():
        return
    tmp=WOLF_CONFIG.with_suffix(".toml.pcga-dedupe-tmp")
    tmp.write_text(text,encoding="utf-8")
    try:
        import tomllib
        with tmp.open("rb") as fh: tomllib.load(fh)
    except Exception:
        tmp.unlink(missing_ok=True);raise
    os.replace(tmp,WOLF_CONFIG)
    pending=_wolf_pending_load()-set(aliases)
    pending.update(str(x) for x in aliases.values() if str(x))
    _wolf_pending_save(pending,reason="duplicate-app-consolidation")
    for canonical in set(aliases.values()): _wolf_request_reload(canonical)


def _wolf_reconcile_batched_restart() -> bool:
    """Restart Wolf at most once, and never while a PCGA session is active.

    Pending work is persisted because the orchestrator is a periodic oneshot. If
    a live game blocks this pass, a later timer invocation can perform the reload
    even when no new Wolf TOML change occurs on that later pass.
    """
    global _WOLF_CONFIG_DIRTY, _WOLF_CHANGED_SET_IDS
    pending = _wolf_pending_load() | _WOLF_CHANGED_SET_IDS
    if not pending:
        _WOLF_CONFIG_DIRTY = False
        return True
    active, reason = _wolf_runtime_session_active()
    if active:
        _wolf_pending_save(pending, reason="active-session")
        log(f"Wolf reload deferred because {reason}")
        for sid in sorted(pending):
            if state_path(sid).exists():
                state_update(sid, stream_state="pending-restart", stream_backend="wolf", stream_detail=f"Wolf app registered; reload deferred while {reason}")
        return False
    inspect = subprocess.run(["docker", "inspect", "-f", "{{.State.Running}}", "wolf"], capture_output=True, text=True)
    if inspect.stdout.strip() == "true":
        log(f"Reloading Wolf once for {len(pending)} pending PC-game app profile(s)")
        proc = subprocess.run(["docker", "restart", "wolf"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        log("Starting Wolf once to apply pending PC-game app profile changes")
        proc = subprocess.run(["docker", "start", "wolf"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if proc.returncode != 0:
        _wolf_pending_save(pending, reason="reload-failed")
        log("Wolf batched reload failed; app profiles remain pending-restart")
        for sid in sorted(pending):
            if state_path(sid).exists():
                state_update(sid, stream_state="pending-restart", stream_backend="wolf", stream_detail="Wolf app registered; batched reload failed")
        return False
    # Give supervisord/PulseAudio/Wolf time to settle before the orchestrator
    # advertises profiles as ready. This avoids clients racing the restart.
    time.sleep(2.0)

    # Verify that the UUID-managed blocks survived the daemon reload.  A stale
    # Wolf/Wolf-Den control-plane restart can rewrite config.toml from older API
    # state after PCGA has just repaired it; v0.18.48 observed this with swfoc.
    # Repair once in the same reconciliation pass instead of leaving the portal
    # with a missing launch option until a later timer invocation.
    def _missing_after_reload(ids: set[str]) -> list[str]:
        try:
            text = WOLF_CONFIG.read_text(encoding="utf-8")
        except OSError:
            return sorted(ids)
        missing = []
        for sid in sorted(ids):
            st = load_json(state_path(sid))
            if not st:
                continue
            setup_mode = st.get("status") == "setup-required" and bool(st.get("setup_runtime_image"))
            ready_mode = st.get("status") == "ready" and bool(st.get("runtime_image"))
            if not (setup_mode or ready_mode):
                # A demoted title can legitimately be waiting for setup-source
                # reconstruction.  It has no Wolf app to preserve yet.
                continue
            expected_titles = [str(x.get("title") or "") for x in wolf_launch_variant_apps(sid, st, setup_mode)]
            begin = f"# BEGIN PCGA MANAGED APP {sid}"
            end = f"# END PCGA MANAGED APP {sid}"
            if begin not in text or end not in text or any(f'title = "{title}"' not in text for title in expected_titles if title):
                missing.append(sid)
        return missing

    missing = _missing_after_reload(pending)
    if missing:
        log(f"Wolf reload dropped {len(missing)} managed PC-game app block(s); repairing once in-place")
        for sid in missing:
            st = load_json(state_path(sid))
            if not st:
                continue
            game = load_json(SETS / f"{sid}.json") or {"title": st.get("title") or sid}
            try:
                wolf_sync(sid, game, st, force_retry=True)
            except Exception as exc:
                log(f"Wolf post-reload repair failed for {sid}: {type(exc).__name__}: {exc}")
        proc2 = subprocess.run(["docker", "restart", "wolf"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if proc2.returncode != 0:
            _wolf_pending_save(pending, reason="post-reload-repair-restart-failed")
            return False
        time.sleep(2.0)
        still_missing = _missing_after_reload(pending)
        if still_missing:
            # v0.18.68 left the entire pending set armed when one Wolf app block
            # was repeatedly rejected.  The periodic orchestrator therefore
            # restarted Wolf twice every minute, interrupting Moonlight before
            # otherwise healthy titles could launch.  Quarantine only the
            # rejected title(s), promote every surviving app to ready, and
            # clear the global reload queue.  A user-initiated Retry stream uses
            # --force and gets one explicit retry without reviving the restart
            # storm for the rest of the catalog.
            rejected = set(still_missing)
            accepted = set(pending) - rejected
            for sid in sorted(accepted):
                st = load_json(state_path(sid))
                if not st:
                    continue
                setup_mode = st.get("status") == "setup-required" and bool(st.get("setup_runtime_image"))
                if setup_mode:
                    state_update(sid, stream_state="setup-ready", stream_backend="wolf", phase="interactive-setup-ready", stream_detail="Interactive installer is available through Wolf")
                elif st.get("status") == "ready":
                    state_update(sid, stream_state="ready", stream_backend="wolf", phase="stream-ready", stream_detail="Available to paired Moonlight clients through Wolf")
            for sid in sorted(rejected):
                if state_path(sid).exists():
                    state_update(
                        sid,
                        stream_state="failed",
                        stream_backend="wolf",
                        wolf_registration_quarantined_v01869=True,
                        wolf_registration_quarantine_reason="managed-app-block-dropped-after-two-reloads",
                        wolf_registration_quarantined_at=now(),
                        stream_detail="Wolf rejected this app registration after two reload attempts; automatic Wolf reloads are quarantined for this title. Use Retry stream to retry only this app.",
                    )
            _wolf_pending_save(set())
            _WOLF_CONFIG_DIRTY = False
            _WOLF_CHANGED_SET_IDS.clear()
            log("Wolf rejected managed app block(s); quarantined without further automatic daemon reloads: " + ", ".join(still_missing[:6]))
            return True

    for sid in sorted(pending):
        st = load_json(state_path(sid))
        if not st:
            continue
        setup_mode = st.get("status") == "setup-required" and bool(st.get("setup_runtime_image"))
        if setup_mode:
            state_update(sid, stream_state="setup-ready", stream_backend="wolf", phase="interactive-setup-ready", stream_detail="Interactive installer is available through Wolf")
        elif st.get("status") == "ready":
            state_update(sid, stream_state="ready", stream_backend="wolf", phase="stream-ready", stream_detail="Available to paired Moonlight clients through Wolf")
    _wolf_pending_save(set())
    _WOLF_CONFIG_DIRTY = False
    _WOLF_CHANGED_SET_IDS.clear()
    return True


def wolf_sync(set_id: str, game: dict, state: dict, *, force_retry: bool = False) -> dict:
    global _WOLF_CONFIG_DIRTY, _WOLF_CHANGED_SET_IDS
    setup_mode = state.get("status") == "setup-required" and bool(state.get("setup_runtime_image"))
    if state.get("wolf_registration_quarantined_v01869") and not force_retry:
        return state_update(
            set_id,
            stream_state="failed",
            stream_backend="wolf",
            stream_detail="Wolf rejected this app registration after two reload attempts; automatic daemon reloads are quarantined for this title. Use Retry stream to try this title again without disrupting other games.",
        )
    if force_retry and state.get("wolf_registration_quarantined_v01869"):
        state = state_update(
            set_id,
            wolf_registration_quarantined_v01869=False,
            wolf_registration_quarantine_reason=None,
            wolf_registration_quarantined_at=None,
            stream_state="pending",
            stream_backend="wolf",
            stream_detail="Explicit Wolf registration retry requested",
        )
        setup_mode = state.get("status") == "setup-required" and bool(state.get("setup_runtime_image"))
    if not setup_mode and (state.get("status") != "ready" or not state.get("runtime_image")):
        return state
    if not WOLF_CONFIG.exists():
        return state_update(set_id, stream_state="unavailable", stream_backend="wolf", stream_detail="Wolf config is not present on this host")
    lock_path=Path("/run/pcga-game-stack-start.lock")
    lock_path.parent.mkdir(parents=True,exist_ok=True)
    with lock_path.open("a+") as lock:
        fcntl.flock(lock.fileno(),fcntl.LOCK_EX)
        original = WOLF_CONFIG.read_text(encoding="utf-8")
        desired=managed_app_block(set_id,game,state).strip()+"\n"
        managed_rx=re.compile(rf"(?ms)^# BEGIN PCGA MANAGED APP {re.escape(set_id)}\n.*?^# END PCGA MANAGED APP {re.escape(set_id)}\n?")
        app_rx=re.compile(r"(?ms)^\s*\[\[profiles\.apps\]\]\s*$.*?(?=^\s*\[\[profiles\.apps\]\]\s*$|^\s*\[\[profiles\]\]\s*$|\Z)")

        # Reconcile the canonical managed block in place. Pre-v0.18.16 releases
        # removed and re-appended every managed block on each pass. That changed
        # ordering transiently, falsely marked Wolf dirty, and could leave games
        # pending-restart whenever a runtime container happened to be active.
        text=original
        canonical=managed_rx.search(text)
        canonical_span=canonical.span() if canonical else None

        # Remove only unmarked legacy app tables for this set id. Any app table
        # whose start lies inside the canonical BEGIN/END block is the canonical
        # table and must be preserved.
        removals=[]
        for match in app_rx.finditer(text):
            if canonical_span and canonical_span[0] <= match.start() < canonical_span[1]:
                continue
            block=match.group(0)
            if re.search(rf"PCGA_GAME_SET_ID={re.escape(set_id)}(?:['\"]|\s|$)", block):
                removals.append(match.span())
        for a,b in reversed(removals):
            text=text[:a]+text[b:]

        canonical=managed_rx.search(text)
        if canonical:
            current=canonical.group(0).strip()+"\n"
            if current.strip()!=desired.strip():
                text=text[:canonical.start()]+desired+text[canonical.end():]
        else:
            profile_rx = re.compile(r"(?m)^\[\[profiles\]\]\s*$")
            starts = [m.start() for m in profile_rx.finditer(text)]
            insert_at = None
            for i, profile_start in enumerate(starts):
                section_end = starts[i+1] if i+1 < len(starts) else len(text)
                section = text[profile_start:section_end]
                if re.search(r"(?m)^\s*id\s*=\s*['\"]moonlight-profile-id['\"]\s*$", section):
                    insert_at = section_end
                    break
            if insert_at is None:
                return state_update(set_id, stream_state="pending", stream_backend="wolf", stream_detail="Wolf moonlight-profile-id profile is missing")
            text=text[:insert_at]+"\n"+desired+"\n"+text[insert_at:]

        changed = text.strip() != original.strip()
        if changed:
            backup = WOLF_CONFIG.with_suffix(".toml.pcga-backup")
            if not backup.exists(): shutil.copy2(WOLF_CONFIG, backup)
            tmp = WOLF_CONFIG.with_suffix(".toml.pcga-tmp")
            tmp.write_text(text, encoding="utf-8")
            try:
                import tomllib
                with tmp.open("rb") as fh: tomllib.load(fh)
            except Exception as exc:
                tmp.unlink(missing_ok=True)
                return state_update(set_id, stream_state="failed", stream_backend="wolf", stream_detail=f"Generated Wolf TOML was rejected: {type(exc).__name__}")
            os.replace(tmp, WOLF_CONFIG)
            _wolf_request_reload(set_id)
        app_title = wolf_internal_app_title(set_id, setup_mode)
        variant_apps = {str(x.get("key")): str(x.get("title")) for x in wolf_launch_variant_apps(set_id, state, setup_mode) if x.get("key") and x.get("title")} if not setup_mode else {}
        display_title = str(game.get("title") or state.get("title") or "PC Game")
        desired_state = "setup-ready" if setup_mode else "ready"
        detail_text = "Interactive installer is available to paired Moonlight clients through Wolf" if setup_mode else "Available to paired Moonlight clients through Wolf"
        if not changed and state.get("stream_state") == desired_state:
            return state_update(set_id, stream_state=desired_state, stream_backend="wolf", stream_app_title=app_title, stream_variant_apps=variant_apps, stream_display_title=display_title, stream_detail=detail_text)
        # A profile can already be on disk from an earlier pass but still be
        # waiting for a safe Wolf reload. Keep it in this invocation's batch.
        if state.get("stream_state") == "pending-restart":
            _wolf_request_reload(set_id)
        return state_update(set_id, stream_state="pending-restart", stream_backend="wolf", stream_app_title=app_title, stream_variant_apps=variant_apps, stream_display_title=display_title, stream_detail="Wolf app registered; one batched reload will occur after PC-game reconciliation")


def process_set(set_id: str, sources: list[dict], *, install: bool = True, network: bool = True, force: bool = False, reinstall: bool = False) -> dict:
    set_file = SETS / f"{set_id}.json"; game = load_json(set_file)
    if not game:
        return state_update(set_id, status="failed", phase="metadata", detail="Game-set metadata record is missing")
    game = reconcile_game_identity(set_id, game, sources)
    game = ensure_appliance_compatibility_rules(set_id, game)
    current_visibility = load_json(state_path(set_id))
    if game.get("catalog_hidden") or game.get("superseded_by") or current_visibility.get("catalog_hidden") or current_visibility.get("duplicate_of"):
        return current_visibility or state_update(set_id, status="queued", phase="superseded", catalog_hidden=True)
    if network and (force or _pcgw_identity_due(game)):
        resolved, identity_result = pcgw_resolve_identity(dict(game), sources)
        if resolved != game:
            save_json(set_file, resolved)
            game = resolved
    current = load_json(state_path(set_id))
    current_status = current.get("status") or "queued"
    current_phase = current.get("phase") or "metadata"
    state_update(set_id, title=game.get("title"), status=current_status, phase=("metadata" if current_status in {"queued", "installing", "failed"} else current_phase), source_bundles=[x.get("bundle") for x in sources])
    if reinstall:
        reset = reset_install_for_reinstall(set_id, game, sources)
        if reset.get("reinstall_error"):
            return reset
    if generic_game_title(str(game.get("title") or "")) or str(game.get("identity_source") or "") == "needs-identification":
        return state_update(set_id, status="setup-required", phase="identify", detail="PCGA preserved the game image but could not determine the logical game title. Open Details and identify this source before installation.", setup_reason="identity")
    if network:
        if force or metadata_due(game):
            enriched, result = steam_enrich(dict(game))
            enriched = stamp_metadata_probe(enriched, result)
            if enriched != game:
                save_json(set_file, enriched); game = enriched
        else:
            result = "cached"
        state_update(set_id, metadata_state=result)
        game, compat_result = resolve_compatibility(set_id, game, force=force)
        compat = game.get("compatibility") if isinstance(game.get("compatibility"), dict) else {}
        state_update(
            set_id,
            compatibility_state=compat_result,
            compatibility_confidence=compat.get("confidence"),
            compatibility_auto_apply=bool((compat.get("profile") or {}).get("auto_apply")) if isinstance(compat.get("profile"), dict) else False,
        )
    state = load_json(state_path(set_id))
    # v0.18.77 keeps the verified COD2 win32 prefix/media mapping intact and
    # changes only the per-game runtime image.  WineHQ devel 11.19 is installed
    # as a pinned portable WoW64 tree inside that image, so host Wine and other games are
    # unaffected.  The runtime hash includes this runner layer and rebuilds COD2
    # automatically without another reinstall.
    # v0.18.72: retail COD2 single-player enters SafeDisc/SecDrv before mapping
    # a window.  v0.18.71 diagnostics proved that the preserved COD2CD1 optical
    # presentation was healthy while the installed template was #arch=win64 and
    # CoD2SP_s.exe died at ZwLoadDriver(SecDrv)=c0000142.  A Wine prefix cannot
    # be converted in place, so migrate only that exact READY/win64 condition
    # back through the preserved-media installer as a genuine win32 prefix.
    if state.get("status") == "ready" and _is_call_of_duty_2(game) and compatibility_wine_arch(game) == "win32":
        install_root = Path(str(state.get("install_root") or archive_root() / "games/installed" / set_id))
        prefix_arch = _wine_prefix_arch(install_root / "prefix")
        if prefix_arch == "win64" and not state.get("cod2_win32_prefix_migration_v01872"):
            reset_interactive_prefix(install_root, reason="v0.18.72 COD2 SafeDisc win64 -> win32 compatibility migration")
            subprocess.run(["docker", "image", "rm", "-f", "pcga/game-" + set_id.lower()], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
            generation = dt.datetime.now(dt.timezone.utc).strftime("v01872-win32-%Y%m%dT%H%M%SZ")
            state = state_update(
                set_id,
                status="setup-required", phase="interactive-setup",
                setup_reason="cod2-win32-prefix-migration",
                setup_source=str(install_root / "setup-source"), setup_installer="setup.exe", setup_kind="exe",
                launch_executable=None, launch_variants=[], launch_variant_default=None, launch_variant_mode=None,
                runtime_image=None, runtime_build_hash=None, runtime_build_log=None,
                setup_runtime_image=None, setup_runtime_build_hash=None, setup_runtime_log=None,
                stream_state="pending", stream_app_title=None, stream_variant_apps={},
                install_generation=generation,
                cod2_win32_prefix_migration_v01872=True,
                cod2_previous_prefix_arch_v01872=prefix_arch,
                detail="COD2 retail campaign requires a genuine win32 Wine prefix for the SafeDisc/SecDrv startup path. Reset the mutable win64 install prefix; preserved COD2CD1..COD2CD6 media remains intact and will be restaged for one clean reinstall.",
            )
            log(f"{set_id}: migrated COD2 win64 prefix back to preserved-media setup for required win32 compatibility profile")
    # v0.18.67 could leave COD2 in status=failed when generic staging tried to
    # delete the mounted read-only COD2DVD setup-source.  Recover that state here
    # before the generic silent-install fallback runs.  The specialized COD2
    # single-volume reconciler below will either reuse a valid mount or rebuild it.
    if (
        _is_call_of_duty_2(game)
        and state.get("status") == "failed"
        and (
            "read-only file system" in str(state.get("detail") or "").casefold()
            or "00000001.tmp" in str(state.get("detail") or "").casefold()
            or state.get("setup_source_multidisc_optical_v01866")
        )
    ):
        state = state_update(
            set_id, status="setup-required", phase="interactive-setup",
            setup_reason="v0.18.69-cod2-mounted-source-recovery",
            stream_state="pending", stream_app_title=None,
            detail="Recovered COD2 from the v0.18.67 mounted setup-source EROFS failure; rebuilding/reusing the synthetic COD2DVD source without generic restaging",
        )
        log(f"{set_id}: recovered COD2 mounted setup-source failure before generic installer staging")
    state = repair_noncompilation_portable_scope(set_id, game, sources, state)
    # v0.18.69 fixes a source-identity mismatch left by the earlier merged-media
    # work.  setup.exe was still launched through winepath as Z:\pcga-source, so
    # InstallShield/MSI could cache Z: as SourceDir even though D: was the repaired
    # synthetic optical volume.  Reset a failed setup prefix once, then rebuild the
    # setup runtime so COD2 starts as D:\setup.exe from the consolidated medium.
    if (
        state.get("status") == "setup-required"
        and _is_call_of_duty_2(game)
        and state.get("setup_source_multidisc_merged_v01858")
        and not state.get("setup_launch_drive_repaired_v01860")
    ):
        install_root = Path(str(state.get("install_root") or archive_root() / "games/installed" / set_id))
        reset_interactive_prefix(install_root, reason="v0.18.69 COD2 D-drive SourceDir repair")
        (install_root / ".pcga-install-complete").unlink(missing_ok=True)
        state = state_update(
            set_id,
            setup_launch_drive_repaired_v01860=True,
            setup_runtime_image=None, setup_runtime_build_hash=None, setup_runtime_log=None,
            runtime_image=None, runtime_build_hash=None, stream_state="pending", stream_app_title=None,
            detail="Reset failed COD2 setup prefix once so InstallShield launches from synthetic D:\\setup.exe instead of Z:\\pcga-source; verbose MSI logging enabled",
        )
    # v0.18.57 could promote a partially copied COD2 prefix because the game
    # executable appeared before all runtime payloads.  The resulting launch in
    # the attached diagnostics fails before Direct3D with mss32.dll missing.
    # Treat that as an incomplete installation, not a game/runtime failure, and
    # force one clean installer pass from the preserved six-disc source.
    if state.get("status") == "ready" and _is_call_of_duty_2(game):
        install_root = Path(str(state.get("install_root") or archive_root() / "games/installed" / set_id))
        payload_ok, missing_payload = _cod2_runtime_payload_status(install_root)
        if not payload_ok:
            reset_interactive_prefix(
                install_root,
                reason="v0.18.69 COD2 incomplete runtime payload: " + ", ".join(missing_payload),
            )
            state = state_update(
                set_id,
                status="setup-required", phase="interactive-setup",
                setup_reason="cod2-incomplete-runtime-payload",
                setup_source=str(install_root / "setup-source"), setup_installer="setup.exe", setup_kind="exe",
                launch_executable=None, runtime_image=None, runtime_build_hash=None,
                setup_runtime_image=None, setup_runtime_build_hash=None,
                stream_state="pending", stream_app_title=None,
                detail="COD2 executable existed but required runtime payload was incomplete (" + ", ".join(missing_payload) + "); reset the mutable Wine prefix for a clean six-disc reinstall",
            )
    # v0.18.56/57 could mark COD2 READY as soon as a plausible executable was
    # copied, even while the live setup desktop was stopped on Error 1311. Force
    # one clean v0.18.69 restage for states that carry the old merged-media marker.
    if (
        state.get("status") == "ready"
        and _is_call_of_duty_2(game)
        and state.get("setup_source_multidisc_merged_v01857")
        and not state.get("setup_source_multidisc_merged_v01858")
    ):
        install_root = Path(str(state.get("install_root") or archive_root() / "games/installed" / set_id))
        state = state_update(
            set_id,
            status="setup-required", phase="interactive-setup",
            setup_reason="v0.18.69-cod2-media-flatten",
            setup_source=str(install_root / "setup-source"), setup_installer="setup.exe", setup_kind="exe",
            launch_executable=None, runtime_image=None, runtime_build_hash=None,
            setup_runtime_image=None, setup_runtime_build_hash=None,
            stream_state="pending", stream_app_title=None,
            detail="Reset premature COD2 READY state so the six-CD MSI can be restaged as one logical medium",
        )
    state = _repair_false_ready_state(set_id, game, state)
    # v0.18.72 recognizes COD2's obsolete post-install Flash/ActiveX shell as
    # launcher baggage rather than a failed game installation. Retail COD2 can
    # finish copying the complete SP/MP payload and then open a Flash-based
    # launcher whose ShockwaveFlash CLSID is not present in modern Wine. If the
    # setup desktop is no longer active and the direct runtime payload validates,
    # recover that completed install without installing obsolete Flash or asking
    # the user to rerun six-disc setup.
    if state.get("status") in {"setup-required", "failed"} and _is_call_of_duty_2(game) and state.get("install_root"):
        install_root = Path(str(state.get("install_root")))
        setup_log = install_root / "pcga-setup-session.log"
        payload_ok, _missing_payload = _cod2_runtime_payload_status(install_root)
        flash_shell_failure = False
        try:
            if setup_log.is_file():
                tail = setup_log.read_text(errors="ignore")[-250000:].casefold()
                flash_shell_failure = (
                    ("d27cdb6e-ae6d-11cf-96b8-444553540000" in tail and "not registered" in tail)
                    or "0x80040154" in tail
                    or "regdb_e_classnotreg" in tail
                    or "class_e_classnotavailable" in tail
                )
        except OSError:
            flash_shell_failure = False
        if payload_ok and flash_shell_failure and not _setup_container_active_for_set(set_id):
            (install_root / ".pcga-install-complete").touch(exist_ok=True)
            state = state_update(
                set_id,
                cod2_flash_launcher_bypassed_v01870=True,
                setup_reason="cod2-obsolete-flash-launcher-bypassed",
                detail="COD2 installation payload is complete; ignored obsolete Shockwave Flash post-install launcher and will launch the native SP/MP executable directly",
            )
            log(f"{set_id}: recovered completed COD2 install after obsolete Shockwave Flash launcher failure")
    # An interactive setup session writes into the persistent Wine prefix. Once
    # a plausible game executable appears, promote it without asking the user to
    # re-import or re-rip the ISO.
    if state.get("status") == "setup-required" and state.get("install_root"):
        install_root = Path(str(state.get("install_root")))
        existing = choose_installed_executable(install_root, game)
        completion_marker = install_root / ".pcga-install-complete"
        # Never promote while Wolf still owns this title's setup desktop. Older
        # releases promoted COD2 from a partially copied executable while Error
        # 1311 was still on screen. Current interactive installs must also carry
        # the completion marker; executable-only promotion is retained only for
        # legacy states that no longer have an interactive setup source/runtime.
        setup_active = _setup_container_active_for_set(set_id)
        legacy_migration = not state.get("setup_source") and not state.get("setup_runtime_image")
        payload_ok, missing_payload = (True, [])
        if _is_call_of_duty_2(game):
            payload_ok, missing_payload = _cod2_runtime_payload_status(install_root)
            if completion_marker.exists() and not payload_ok:
                completion_marker.unlink(missing_ok=True)
                state = state_update(
                    set_id,
                    status="setup-required", phase="interactive-setup",
                    setup_reason="cod2-incomplete-runtime-payload",
                    detail="Installer exited but COD2 runtime payload validation failed: " + ", ".join(missing_payload),
                )
        if existing and payload_ok and not setup_active and (completion_marker.exists() or legacy_migration):
            state = state_update(
                set_id, status="ready", phase="installed", install_method="interactive-wolf",
                launch_executable=str(existing.relative_to(install_root)),
                setup_reason=None, setup_source=None, setup_installer=None, setup_kind=None,
                setup_runtime_image=None, setup_runtime_build_hash=None, stream_state="pending",
                stream_app_title=None, runtime_image=None, runtime_build_hash=None,
                detail=f"Interactive installation finalized; future sessions launch {existing.name} directly",
            )
            if _is_call_of_duty_2(game):
                _cleanup_cod2_synthetic_setup_media(install_root)
            else:
                shutil.rmtree(install_root / "setup-source", ignore_errors=True)
    if install and state.get("status") not in {"ready", "setup-required"}:
        state = silent_install(set_id, game, sources, force=force)
    elif install and state.get("status") == "setup-required" and not state.get("setup_source") and not state.get("setup_runtime_image"):
        # Migrate v0.17.26/27 setup-required states into the new interactive
        # installer path instead of leaving them permanently inert.
        state = silent_install(set_id, game, sources, force=force)
    elif install and force and state.get("status") == "setup-required" and state.get("setup_reason") in {"identity", "source", "no-iso"}:
        state = silent_install(set_id, game, sources, force=force)
    if state.get("status") in {"ready", "setup-required"}:
        try:
            state = ensure_runtime_media(set_id, sources, state, game)
        except Exception as exc:
            state = state_update(
                set_id,
                runtime_media_errors=[f"{type(exc).__name__}: {str(exc)[:220]}"],
            )
    if state.get("status") == "setup-required" and (state.get("setup_source") or _is_call_of_duty_2(game)):
        # Host-side multi-disc restaging must happen before setup-runtime image
        # generation.  This repairs v0.18.54/55 COD2 states whose unprivileged
        # in-container union could not traverse the optical bind mounts and whose
        # MSI SourceDir still pointed at the single-disc /pcga-source tree.
        state = repair_cod2_multidisc_setup_source(set_id, game, sources, state)
        if not (_is_call_of_duty_2(game) and state.get("setup_source_multidisc_optical_v01866")):
            state = repair_noncompilation_setup_scope(set_id, game, sources, state)
            state = repair_interactive_installer_selection(set_id, game, state)
        else:
            log(f"{set_id}: COD2 synthetic optical setup source is authoritative; skipped generic setup-source restaging")
    if state.get("status") == "setup-required" and state.get("setup_source") and state.get("setup_installer"):
        # Repair old releases that carried the prefix created by a failed silent
        # Wine launch into the interactive setup session. Only do this once and
        # only while PCGA still cannot identify a real installed game executable.
        if "c0000135" in str(state.get("installer_log") or "") and not state.get("setup_prefix_repaired_v01747"):
            install_root = Path(str(state.get("install_root") or archive_root() / "games/installed" / set_id))
            if not choose_installed_executable(install_root, game):
                reset_interactive_prefix(install_root, reason="v0.17.47 c0000135 migration")
                state = state_update(
                    set_id, setup_prefix_repaired_v01747=True,
                    setup_prefix_reset_at=now(),
                    setup_prefix_reset_reason="c0000135-migration",
                    setup_runtime_build_hash=None,
                    setup_runtime_log=None,
                    detail="Reset failed legacy Wine prefix before interactive setup",
                )
        try:
            state = build_setup_runtime(set_id, game, state)
            if state.get("setup_runtime_image"):
                state = wolf_sync(set_id, game, state, force_retry=force)
        except Exception as exc:
            state = state_update(set_id, status="setup-required", stream_state="failed", stream_backend="wolf", stream_detail=f"Interactive setup registration failed: {type(exc).__name__}: {str(exc)[:220]}")
    elif state.get("status") == "ready":
        try:
            state = build_runtime_image(set_id, game, state)
            if state.get("status") == "ready" and state.get("runtime_image"):
                state = wolf_sync(set_id, game, state, force_retry=force)
        except Exception as exc:
            state = state_update(set_id, status="ready", stream_state="failed", stream_backend="wolf", stream_detail=f"Streaming registration failed: {type(exc).__name__}: {str(exc)[:220]}")
    if state.get("status") == "ready" and state.get("stream_state") == "ready":
        state = state_update(set_id, phase="stream-ready")
    elif state.get("status") == "setup-required" and state.get("stream_state") == "setup-ready":
        state = state_update(set_id, phase="interactive-setup-ready")
    return state



def _wolf_reconcile_all_launchable_apps() -> int:
    """Ensure every canonical launchable state owns a current Wolf app block.

    Source reconciliation can legitimately omit a previously-installed game when
    its preserved media ownership has already moved to another canonical record.
    A schema migration of Wolf identifiers must nevertheless update that game's
    app block.  Walking the launchable state registry here keeps Wolf's catalog
    complete and makes UUID-derived runtime identifiers self-healing even when no
    intake source needs work during this invocation.
    """
    repaired = 0
    for path in sorted(STATE_ROOT.glob("*.json")):
        sid = path.stem
        state = load_json(path)
        if not state:
            continue
        game = load_json(SETS / f"{sid}.json")
        if game.get("catalog_hidden") or game.get("superseded_by"):
            continue
        if state.get("catalog_hidden") or state.get("duplicate_of"):
            if not game:
                continue
            # A visible canonical set with stale state visibility is recoverable.
            # Clear it here as a second line of defense so Wolf registration and
            # the portal cannot disagree about whether the title exists.
            state = state_update(sid, catalog_hidden=False, duplicate_of=None)
        status = str(state.get("status") or "")
        if state.get("wolf_registration_quarantined_v01869"):
            # A title that Wolf itself removed after two immediate repair
            # restarts must not be reinserted by the periodic full-catalog
            # repair pass.  Only an explicit user retry clears quarantine.
            continue
        setup_mode = status == "setup-required" and bool(state.get("setup_runtime_image"))
        ready_mode = status == "ready" and bool(state.get("runtime_image"))
        if not (setup_mode or ready_mode):
            continue
        if ready_mode and not state.get("launch_variant_detection_v01871"):
            try:
                state = build_runtime_image(sid, game or {"title": state.get("title") or sid}, state)
            except Exception as exc:
                state_update(sid, stream_state="failed", stream_backend="wolf", stream_detail=f"Launch-variant migration failed: {type(exc).__name__}: {str(exc)[:180]}")
                continue
        expected_titles = [str(x.get("title") or "") for x in wolf_launch_variant_apps(sid, state, setup_mode)]
        before = ""
        if WOLF_CONFIG.exists():
            try:
                before = WOLF_CONFIG.read_text(encoding="utf-8")
            except OSError:
                before = ""
        begin = f"# BEGIN PCGA MANAGED APP {sid}"
        had_current = begin in before and all(f'title = "{title}"' in before for title in expected_titles if title)
        try:
            wolf_sync(sid, game or {"title": state.get("title") or sid}, state)
        except Exception as exc:
            state_update(
                sid,
                stream_state="failed",
                stream_backend="wolf",
                stream_detail=f"Wolf catalog reconciliation failed: {type(exc).__name__}: {str(exc)[:220]}",
            )
            continue
        if not had_current:
            repaired += 1
            log(f"repaired missing/stale Wolf registration for {state.get('title') or game.get('title') or sid}")
    return repaired

def print_status() -> None:
    rows = []
    for p in sorted(STATE_ROOT.glob("*.json")) if STATE_ROOT.exists() else []:
        d = load_json(p); rows.append({k:d.get(k) for k in ("game_set_id", "title", "status", "phase", "metadata_state", "stream_state", "stream_app_title", "install_method", "launch_executable", "setup_reason", "detail")})
    print(json.dumps({"version": VERSION, "games": rows}, indent=2))


def main() -> int:
    prepare_runtime_environment()
    ap = argparse.ArgumentParser(description="PCGA PC-game metadata/install/stream orchestrator")
    ap.add_argument("--status", action="store_true")
    ap.add_argument("--set-id")
    ap.add_argument("--metadata-only", action="store_true")
    ap.add_argument("--no-network", action="store_true")
    ap.add_argument("--force", action="store_true")
    ap.add_argument("--reinstall", action="store_true", help="Reset only the mutable install/runtime state and reinstall from preserved source")
    ns = ap.parse_args()
    if ns.reinstall and not ns.set_id:
        ap.error("--reinstall requires --set-id")
    STATE_ROOT.mkdir(parents=True, exist_ok=True); ASSETS.mkdir(parents=True, exist_ok=True)
    if ns.status: print_status(); return 0
    root = archive_root()
    lock_path=Path("/run/pcga-game-orchestrator.lock"); lock_path.parent.mkdir(parents=True,exist_ok=True)
    with lock_path.open("a+") as lock:
        fcntl.flock(lock.fileno(),fcntl.LOCK_EX)
        mapping = scan_sources(root)
        duplicate_aliases={}
        if not ns.set_id:
            mapping=_precanonicalize_local_identities(mapping)
            mapping,duplicate_aliases=canonicalize_duplicate_source_mapping(mapping)
            wolf_remove_superseded_apps(duplicate_aliases)
        if ns.set_id:
            selected = mapping.get(ns.set_id, [])
            if not selected:
                selected = _reinstall_source_fallback(ns.set_id, load_json(state_path(ns.set_id)))
            mapping = {ns.set_id: selected}
        if not mapping:
            # A prior pass may have deferred a Wolf reload because a game was
            # running. Also reconcile every launchable state so a Wolf schema
            # migration can repair installed titles that no longer own an intake
            # source mapping.
            _wolf_reconcile_all_launchable_apps()
            _wolf_reconcile_batched_restart()
            log("no PC-game intake sources need orchestration")
            return 0
        failures = 0
        for sid, sources in mapping.items():
            if not sid: continue
            try:
                result = process_set(sid, sources, install=not ns.metadata_only, network=not ns.no_network, force=(ns.force or ns.reinstall), reinstall=ns.reinstall)
                log(f"{result.get('title') or sid}: {result.get('status')} / {result.get('stream_state') or '-'}")
                if result.get("status") == "failed": failures += 1
            except Exception as exc:
                failures += 1
                state_update(sid, status="failed", phase="orchestrator", detail=f"{type(exc).__name__}: {str(exc)[:300]}")
                log(f"{sid}: {type(exc).__name__}: {exc}")
                for line in traceback.format_exc().splitlines()[-12:]:
                    log(f"{sid}: orchestrator traceback: {line}")
        # Reconcile the complete launchable registry as well as source-backed
        # records. This repairs missing UUID-based Wolf app blocks left behind by
        # earlier display-title-based registrations.
        _wolf_reconcile_all_launchable_apps()
        # Wolf reload is deliberately outside the per-game loop. A scan that
        # updates ten games must not terminate the streaming daemon ten times.
        _wolf_reconcile_batched_restart()
        return 1 if failures else 0


if __name__ == "__main__":
    raise SystemExit(main())
