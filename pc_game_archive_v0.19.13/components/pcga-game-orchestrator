def prepare_runtime_environment() -> None:
    """Give Docker/Wine orchestration a writable HOME under hardened systemd.

    pcga-game-orchestrator is normally launched as root with ProtectHome=true.
    Docker CLI may still try to create $HOME/.docker, which resolves to /root/.docker
    and fails inside that sandbox. Keep all transient CLI/config state in /run.
    """
    if os.geteuid() == 0:
        base = Path("/run/pcga-game-orchestrator")
    else:
        base = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/tmp/pcga-game-orchestrator-{os.getuid()}")
    docker_cfg = base / "docker"
    config_home = base / "config"
    cache_home = base / "cache"
    for path in (base, docker_cfg, config_home, cache_home):
        path.mkdir(parents=True, exist_ok=True)
    os.environ["HOME"] = str(base)
    os.environ["DOCKER_CONFIG"] = str(docker_cfg)
    os.environ["XDG_CONFIG_HOME"] = str(config_home)
    os.environ["XDG_CACHE_HOME"] = str(cache_home)


def now() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds")


def log(msg: str) -> None:
    print(f"[pcga-game] {msg}", flush=True)


def load_json(path: Path) -> dict:
    try:
        obj = json.loads(path.read_text(encoding="utf-8"))
        return obj if isinstance(obj, dict) else {}
    except Exception:
        return {}


def save_json(path: Path, obj: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(obj, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    os.replace(tmp, path)


def load_env(path: Path) -> dict[str, str]:
    out: dict[str, str] = {}
    try:
        for raw in path.read_text(encoding="utf-8").splitlines():
            line = raw.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, val = line.split("=", 1)
            out[key.strip()] = val.strip().strip('"').strip("'")
    except OSError:
        pass
    return out


def runtime_graphics_settings() -> dict[str, str]:
    """Return appliance-owned Direct3D translation policy for streamed Wine games.

    PCGA launches Wine directly inside the Games-on-Whales Lutris image rather
    than invoking Lutris' Wine runner, so Lutris' normal DXVK toggle is not
    applied automatically. Keep the policy explicit and deterministic here.
    """
    env = load_env(RUNTIME_ENV)
    backend = str(env.get("PCGA_GRAPHICS_BACKEND") or "auto").strip().lower()
    if backend not in {"auto", "dxvk", "wined3d"}:
        backend = "auto"
    verb = str(env.get("PCGA_DXVK_WINETRICKS_VERB") or "dxvk2062").strip().lower()
    if not re.fullmatch(r"dxvk[0-9]{4}", verb):
        verb = "dxvk2062"
    hud = "1" if str(env.get("PCGA_DXVK_HUD") or "0").strip().lower() in {"1","true","yes","on"} else "0"
    return {"backend": backend, "dxvk_verb": verb, "dxvk_hud": hud}


def archive_root() -> Path:
