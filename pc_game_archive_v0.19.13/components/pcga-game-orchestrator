_GENERIC_TITLES = {
    "", "disc", "disk", "cd", "dvd", "iso", "disc iso", "disk iso", "extracted iso",
    "pc game", "pc-game", "pc data disc", "pc-data-disc", "data disc", "data disk",
    "unidentified", "unidentified pc game", "unknown", "optical media", "game",
}

# Retail optical labels are often mastering/internal identifiers rather than game
# names (for example PST-DVD). They are useful evidence, but must never outrank a
# product name recovered from the disc contents or a high-confidence metadata
# resolver result.
_WEAK_OPTICAL_LABEL_RE = re.compile(
    r"(?i)^(?:[a-z0-9]{2,14}[-_ ]+)?(?:cd|dvd|disc|disk)(?:[-_ ]*\d+)?$|^[a-z0-9]{2,14}[-_ ]+(?:cd|dvd|disc|disk)(?:[-_ ]*\d+)?$"
)


def clean_source_title(value: str) -> str:
    text = str(value or "").strip().replace("_", " ")
    text = re.sub(r"(?i)\b(?:disc|disk|cd)\s*[-_. ]*\d+(?:\s*(?:of|/)\s*\d+)?\b", " ", text)
    text = re.sub(r"^\d{8}-\d{6}[-_ ]*", "", text)
    text = re.sub(r"\s+", " ", text).strip(" ._-")
    return text


def generic_game_title(value: str) -> bool:
    text = clean_source_title(value)
    norm = norm_title(text)
    if norm in _GENERIC_TITLES:
        return True
    if not norm or len(norm) < 3:
        return True
    if re.fullmatch(r"(?:pc )?(?:data )?(?:disc|disk|cd|dvd|iso)(?: image)?", norm):
        return True
    return False


def _bundled_payload_title(value: str) -> bool:
    """True for common third-party payload names that leak off retail discs.

    These are prerequisite/document-reader packages, not the customer-facing
    game identity.  Keep the patterns deliberately narrow so product titles are
    not discarded merely because they contain a generic word such as Reader.
    """
    compact = re.sub(r"[^a-z0-9]+", "", str(value or "").casefold())
    if not compact:
        return False
    if re.fullmatch(r"(?:adberdr|adobereader|acrobatreader|acroread)\d*(?:[a-z]{2,10})?", compact):
        return True
    if re.fullmatch(r"(?:directx|dxsetup|dotnetfx|vcredist|vcredistx86|vcredistx64|physx|pbsvc|pbsetup|gamespy)\d*[a-z0-9]*", compact):
        return True
    return False


def weak_source_title(value: str) -> bool:
    raw = str(value or "").strip()
    if generic_game_title(raw) or _bundled_payload_title(raw):
        return True
    compact = re.sub(r"\s+", " ", raw).strip()
    if _WEAK_OPTICAL_LABEL_RE.fullmatch(compact):
        return True
    # Legacy retail discs commonly expose helper executables such as
    # LaunchBFII.exe / LaunchEAW.exe. Some preservation paths append a numeric
    # nonce to those helper names. They are launch wrappers, not product titles.
    compact_launcher = compact.replace("_", " ").replace("-", " ")
    if re.fullmatch(r"(?i)launch(?:bfii|eaw)(?:\s+\d{6,})?", compact_launcher):
        return True
    # Installer/helper executable stems sometimes leak through as provisional
    # game titles (setupBF2, CDKey, IDriver). Treat those as weak evidence so
    # preserved-media identity can replace them with the actual product title.
    helper_compact=re.sub(r"[^a-z0-9]+", "", compact.casefold())
    if helper_compact in {
        "cdkey","idriver","ikernel","autorun","setup","install","installer",
        "syscheck","systemcheck","fpupdate","update","updater","patch","patcher",
        "config","configure","registration","register",
    }:
        return True
    if re.fullmatch(r"(?:setup|install|installer|autorun|update|updater|patch|patcher|syscheck)[a-z0-9]{1,16}", helper_compact):
        return True
    # A short token followed by optical-media wording is almost always a volume
    # identifier, not a customer-facing title (PST-DVD, BG2_CD1, etc.).
    if re.fullmatch(r"(?i)[a-z0-9]{2,12}[-_ ]+(?:cd|dvd|disc|disk)(?:[-_ ]*\d+)?", compact):
        return True
    return False


_CONTENT_STEM_SKIP = {
    "setup", "install", "installer", "autorun", "uninstall", "unins000", "unwise",
    "dxsetup", "directx", "dsetup32", "vcredist", "vc redist", "isdel", "ikernel",
    "idriver", "cdkey", "syscheck", "system check", "fpupdate", "update", "updater",
    "patch", "patcher", "launcher", "launch", "start", "play", "game", "config",
    "configure", "register", "registration", "readme", "binkplay", "mplayer", "acm2wav",
}

# Executables in this family are maintenance/setup utilities, not customer-facing
# game entry points. Keep the exact list small, then use bounded token checks for
# obvious update/patch/config helpers so an installed prefix cannot become READY
# merely because one of these sorts before the real game binary.
_LAUNCH_HELPER_EXACT = {
    "idriver.exe", "ikernel.exe", "isuspm.exe", "issch.exe", "agent.exe",
    "setup.exe", "autorun.exe", "cdkey.exe", "fpupdate.exe", "syscheck.exe",
    "systemcheck.exe", "update.exe", "updater.exe", "patch.exe", "patcher.exe",
    "config.exe", "configure.exe", "register.exe", "registration.exe",
}
_LAUNCH_HELPER_STEM_RE = re.compile(
    r"(?i)^(?:fp)?(?:auto)?(?:update|updater|patch|patcher|syscheck|systemcheck|"
    r"config|configure|register|registration|cdkey)(?:[_-]?[a-z0-9]{0,12})?$"
)


def _content_title_hints(root: Path) -> list[str]:
    """Return bounded product-name hints from application-oriented file stems.

    This is intentionally conservative: installer/runtime helper names are
    ignored, and only shallow files are considered. A stem seen as an executable
    plus an icon/INI gets stronger evidence than a random data filename.
    """
    scores: dict[str, tuple[int, str]] = {}
    try:
        iterator = root.rglob("*")
    except OSError:
        return []
    for p in iterator:
        try:
            rel = p.relative_to(root)
        except ValueError:
            continue
        if len(rel.parts) > 3:
            continue
        try:
            if not p.is_file():
                continue
        except OSError:
            continue
        suffix = p.suffix.casefold()
        if suffix not in {".exe", ".com", ".ico", ".ini", ".cfg"}:
            continue
        stem = clean_source_title(p.stem)
        n = norm_title(stem)
        if p.stem.casefold().startswith(("launchbfii", "launcheaw")):
            continue
        if not n or n in _CONTENT_STEM_SKIP or generic_game_title(stem):
            continue
        if any(tok in _CONTENT_STEM_SKIP for tok in n.split()):
            continue
        if len(n) < 4:
            continue
        weight = {".exe": 8, ".com": 6, ".ico": 3, ".ini": 2, ".cfg": 1}[suffix]
        weight += max(0, 3 - len(rel.parts))
        prev = scores.get(n)
        if prev:
            scores[n] = (prev[0] + weight, prev[1])
        else:
            scores[n] = (weight, stem)
    ranked = sorted(scores.values(), key=lambda x: (-x[0], len(norm_title(x[1])), x[1].casefold()))
    return [title for _, title in ranked[:8]]


def _autorun_fields(root: Path) -> dict[str, str]:
    for name in ("autorun.inf", "AUTORUN.INF", "Autorun.inf"):
        q = root / name
        if not q.is_file():
            continue
        try:
            text = q.read_text(encoding="utf-8-sig", errors="replace")[:256 * 1024]
        except OSError:
            continue
        out: dict[str, str] = {}
        for key in ("label", "icon", "open", "shellexecute"):
            m = re.search(r"(?im)^\s*" + re.escape(key) + r"\s*=\s*(.+?)\s*$", text)
            if m:
                out[key] = m.group(1).strip()
        return out
    return {}


def _autorun_label(root: Path) -> str:
    value = _autorun_fields(root).get("label", "")
    return clean_source_title(value) if value and not generic_game_title(value) else ""


def _autorun_target_stem(value: str) -> str:
    raw = str(value or "").strip().strip('"').strip("'")
    if not raw:
        return ""
    raw = raw.split(",", 1)[0].strip()
    m = re.match(r'^"([^"]+)"', raw)
    if m:
        raw = m.group(1)
    else:
        raw = raw.split(None, 1)[0]
    raw = raw.replace("\\", "/")
    raw_stem = Path(raw).stem
    stem = clean_source_title(raw_stem)
    n = norm_title(stem)
    if raw_stem.casefold().startswith(("launchbfii", "launcheaw")):
        return ""
    if not n or n in _CONTENT_STEM_SKIP or generic_game_title(stem) or len(n) < 4:
        return ""
    if any(tok in _CONTENT_STEM_SKIP for tok in n.split()):
        return ""
    return stem


def _autorun_product_hints(root: Path) -> list[str]:
    """Product identity explicitly referenced by the disc's autorun UI.

    Referenced icon/launch assets outrank unrelated executables found elsewhere
    on the disc.  This prevents bundled demos from becoming the parent disc's
    identity (for example a Torment disc that also contains ICEWIND.EXE).
    """
    info = _autorun_fields(root)
    values: list[str] = []
    def add(v: str) -> None:
        v = clean_source_title(v)
        if v and not weak_source_title(v) and not generic_game_title(v) and v not in values:
            values.append(v)
    add(info.get("label", ""))
    add(_autorun_target_stem(info.get("icon", "")))
    add(_autorun_target_stem(info.get("shellexecute", "")))
    add(_autorun_target_stem(info.get("open", "")))
    return values


def source_identity_candidates(source: dict) -> list[str]:
    bundle = Path(str(source.get("bundle") or ""))
    values: list[str] = []
    def add(v):
        v = clean_source_title(v)
        if v and v not in values:
            values.append(v)
    if bundle.is_dir():
        gm = load_json(bundle / ".pcga-game.json")
        add(gm.get("title")); add(gm.get("collection_title"))
        om = load_json(bundle / ".pcga-optical.json")
        fs = om.get("filesystem") if isinstance(om.get("filesystem"), dict) else {}
        add(fs.get("label"))
        cm = load_json(bundle / ".pcga-classification.json")
        add(cm.get("title"))
        for sidecar in sorted(bundle.glob("*.pcga-classification.json")):
            add(load_json(sidecar).get("title"))
        add(bundle.name)
    elif bundle.is_file():
        cm = load_json(bundle.with_name(bundle.name + ".pcga-classification.json"))
        add(cm.get("title")); add(bundle.stem)
    for iso in source_isos([source]):
        # ISO9660/UDF volume labels often survive older releases that lacked
        # .pcga-game.json. Prefer them over a generic "disc.iso" filename.
        try:
            proc = subprocess.run(["blkid", "-p", "-s", "LABEL", "-o", "value", str(iso)], capture_output=True, text=True, timeout=8)
            if proc.returncode == 0:
                add(proc.stdout.strip())
        except Exception:
            pass
        try:
            mountpoint = Path("/run/pcga-game-identity") / hashlib.sha256(str(iso).encode()).hexdigest()[:16]
            with mounted_iso(iso, mountpoint) as root:
                for hint in _autorun_product_hints(root):
                    add(hint)
                for hint in _content_title_hints(root):
                    add(hint)
                # Some discs put a game-named directory next to generic support
                # folders. Use it only as a low-priority identity hint.
                generic_dirs = {"data","directx","drivers","redist","support","setup","install","movies","video","audio","music","docs","manual","manuals"}
                try:
                    dirs = [x.name for x in root.iterdir() if x.is_dir() and norm_title(x.name) not in generic_dirs]
                    if len(dirs) == 1:
                        add(dirs[0])
                except OSError:
                    pass
        except Exception:
            pass
    return values


def source_intrinsic_identity_candidates(source: dict) -> list[str]:
    """Identity evidence derived from the preserved media itself.

    Deliberately excludes .pcga-game.json and classifier titles because those may
    contain an older automatic misidentification.  Explicit user confirmation is
    handled at the set-record level instead.
    """
    bundle = Path(str(source.get("bundle") or ""))
    autorun_product_values: list[str] = []
    content_values: list[str] = []
    volume_values: list[str] = []
    directory_values: list[str] = []
    def add(bucket, value):
        value = clean_source_title(value)
        if value and value not in bucket:
            bucket.append(value)
    if bundle.is_dir():
        om = load_json(bundle / ".pcga-optical.json")
        fs = om.get("filesystem") if isinstance(om.get("filesystem"), dict) else {}
        add(volume_values, fs.get("label"))
    for iso in source_isos([source]):
        try:
            proc = subprocess.run(["blkid", "-p", "-s", "LABEL", "-o", "value", str(iso)], capture_output=True, text=True, timeout=8)
            if proc.returncode == 0:
                add(volume_values, proc.stdout.strip())
        except Exception:
            pass
        try:
            mountpoint = Path("/run/pcga-game-identity") / hashlib.sha256(str(iso).encode()).hexdigest()[:16]
            with mounted_iso(iso, mountpoint) as root:
                for hint in _autorun_product_hints(root):
                    add(autorun_product_values, hint)
                for hint in _content_title_hints(root):
                    add(content_values, hint)
                generic_dirs = {"data","directx","drivers","redist","support","setup","install","movies","video","audio","music","docs","manual","manuals"}
                try:
                    dirs = [x.name for x in root.iterdir() if x.is_dir() and norm_title(x.name) not in generic_dirs]
                    if len(dirs) == 1:
                        add(directory_values, dirs[0])
                except OSError:
                    pass
        except Exception:
            pass
    # Explicit autorun product assets are strongest. Arbitrary executable names
    # are weaker because retail discs often bundle demos for sibling titles.
    # Volume-mastering labels such as PST-DVD remain useful only as fallback.
    return autorun_product_values + content_values + volume_values + directory_values


def best_intrinsic_source_title(sources: list[dict]) -> str:
    values: list[str] = []
    for src in sources:
        for value in source_intrinsic_identity_candidates(src):
            if value not in values:
                values.append(value)
    for value in values:
        if not weak_source_title(value) and not generic_game_title(value):
            return clean_source_title(value)
    for value in values:
        if not generic_game_title(value):
            return clean_source_title(value)
    return ""


def titles_compatible(a: str, b: str) -> bool:
    """True when one title is plausibly a shortened form of the other."""
    aa, bb = metadata_title_core(a), metadata_title_core(b)
    if not aa or not bb:
        return False
    if aa == bb:
        return True
    aset, bset = set(aa.split()), set(bb.split())
    if aset and (aset.issubset(bset) or bset.issubset(aset)):
        return True
    # Keep a canonical provider title when intrinsic evidence shares most words,
    # but do not preserve unrelated automatic identities (Torment vs Icewind Dale).
    overlap = len(aset & bset) / max(1, min(len(aset), len(bset)))
    return overlap >= 0.75


def best_source_title(sources: list[dict], current: str = "") -> str:
    if current and not weak_source_title(current):
        return clean_source_title(current)
    candidates: list[str] = []
    for src in sources:
        for value in source_identity_candidates(src):
            if value not in candidates:
                candidates.append(value)
    # Prefer a product-like content hint over optical mastering labels.
    for value in candidates:
        if not weak_source_title(value):
            return clean_source_title(value)
    # Keep a weak label only as a last resort; the network identity resolver may
    # still be able to turn it into a canonical title.
    for value in candidates:
        if not generic_game_title(value):
            return clean_source_title(value)
    return ""


def _invalidate_provider_metadata(game: dict) -> None:
    """Invalidate provider cache when the logical game identity changes."""
    had_match = isinstance(game.get("metadata_match"), dict) and bool(game.get("metadata_match"))
    game.pop("metadata_probe", None)
    game.pop("metadata_match", None)
    game.pop("identity_probe", None)
    game.pop("compatibility", None)
    if had_match:
        for key in ("description", "marketing_description", "genres", "categories", "website", "marketing_assets"):
            game.pop(key, None)
        ext = dict(game.get("external_ids") or {})
        ext.pop("steam", None)
        game["external_ids"] = ext


def reconcile_game_identity(set_id: str, game: dict, sources: list[dict]) -> dict:
    """Repair legacy/source-only PC-game records before provider metadata lookup."""
    old_title = str(game.get("title") or "")
    intrinsic = best_intrinsic_source_title(sources)
    explicit = bool(game.get("user_confirmed"))
    # Migrate the old v0.17.26-v0.17.30 uploaded-source records that were
    # accidentally marked non-provisional even though no user confirmed a title.
    if game.get("source") == "user-upload" and not explicit and game.get("provisional") is False:
        game["provisional"] = True
    if explicit:
        title = old_title
    elif weak_source_title(old_title):
        title = intrinsic or best_source_title(sources, "")
    elif intrinsic and not titles_compatible(old_title, intrinsic):
        title = intrinsic
    else:
        title = old_title or intrinsic or best_source_title(sources, "")
    changed = False
    if title and (weak_source_title(old_title) or norm_title(title) != norm_title(old_title)):
        game["title"] = title
        game["sort_title"] = title
        game["normalized_title"] = norm_title(title)
        game["identity_source"] = "preserved-source-reconciliation"
        game["identity_confidence"] = 0.72 if weak_source_title(old_title) else 0.85
        game["updated_at"] = now()
        _invalidate_provider_metadata(game)
        changed = True
    elif generic_game_title(old_title):
        game["title"] = "Unidentified PC Game"
        game["sort_title"] = "Unidentified PC Game"
        game["normalized_title"] = norm_title(game["title"])
        game["identity_source"] = "needs-identification"
        game["updated_at"] = now()
        _invalidate_provider_metadata(game)
        changed = True
    if changed:
        save_json(SETS / f"{set_id}.json", game)
    return game


def compatibility_profile(game: dict) -> dict:
    compat = game.get("compatibility") if isinstance(game.get("compatibility"), dict) else {}
    profile = compat.get("profile") if isinstance(compat.get("profile"), dict) else {}
    return profile


def compatibility_marker(game: dict) -> str:
    profile = compatibility_profile(game)
    payload = json.dumps({
        "wine_arch": compatibility_wine_arch(game),
        "runner": compatibility_wine_runner_id(game),
        "windows_version": profile.get("windows_version"),
        "winetricks_components": profile.get("winetricks_components") or [],
    }, sort_keys=True, separators=(",", ":"))
    return ".pcga-compat-" + hashlib.sha256(payload.encode()).hexdigest()[:16]


def compatibility_winetricks(game: dict) -> list[str]:
    profile = compatibility_profile(game)
    out=[]
    winver=str(profile.get("windows_version") or "").strip().lower()
    if winver in {"win2000","winxp","win2003","vista","win7","win8","win81","win10","win11"}:
        out.append(winver)
    for item in profile.get("winetricks_components") or []:
        value=str(item or "").strip().lower()
        if re.fullmatch(r"[a-z0-9_]{2,40}", value) and value not in out:
            out.append(value)
    return out


def _is_jedi_outcast(game: dict) -> bool:
    title = norm_title(str(game.get("title") or ""))
    appid = str((game.get("external_ids") or {}).get("steam") or "") if isinstance(game.get("external_ids"), dict) else ""
    return appid == "6030" or title in {"jedioutcast", "jedi outcast"} or (
        "jedi" in title and "outcast" in title and ("knight ii" in title or "jedi knight 2" in title or "jedi knight ii" in title)
    )


def _is_call_of_duty_2(game: dict) -> bool:
    """Identify the retail COD2 title without relying on mutable display punctuation."""
    title = norm_title(str(game.get("title") or ""))
    appid = str((game.get("external_ids") or {}).get("steam") or "") if isinstance(game.get("external_ids"), dict) else ""
    return appid == "2630" or title in {"call of duty 2", "cod2"}


def compatibility_wine_runner_id(game: dict) -> str:
    # Return the runtime Wine implementation without changing host Wine.
    # COD2 is intentionally the first isolated-runner title. Its per-game image
    # gets a pinned portable Wine 11.19 WoW64 tree; every other title keeps GOW base Wine.
    if _is_call_of_duty_2(game):
        return f"{COD2_WINE_RUNNER}-{COD2_WINE_RUNNER_VERSION}"
    profile = compatibility_profile(game)
    runner = str(profile.get("runner") or "wine").strip().lower()
    version = str(profile.get("runner_version") or "").strip()
    if runner in {"winehq-devel", "portable-wow64"} and re.fullmatch(r"[0-9]+(?:\.[0-9]+){1,2}", version):
        return f"{runner}-{version}"
    return "base-image-wine"


def compatibility_wine_runner_dockerfile(game: dict) -> tuple[str, str]:
    # Return (runner_id, Dockerfile fragment) for isolated per-game Wine.
    # v0.18.77 avoids injecting WineHQ packages into the Games-on-Whales image.
    # COD2 SP instead receives a pinned vanilla Wine 11.19 new-WoW64 archive
    # built from official Wine sources by Kron4ek/Wine-Builds. Their amd64-wow64
    # build runs 32-bit Windows applications without 32-bit Unix libraries.
    runner_id = compatibility_wine_runner_id(game)
    if not runner_id.startswith("portable-wow64-"):
        return runner_id, ""
    version = runner_id.removeprefix("portable-wow64-")
    if not re.fullmatch(r"[0-9]+(?:\.[0-9]+){1,2}", version):
        raise ValueError(f"invalid isolated Wine runner version: {version!r}")
    if version != COD2_WINE_RUNNER_VERSION:
        raise ValueError(f"unsupported pinned portable Wine version: {version!r}")
    archive_dir = f"wine-{version}-amd64-wow64"
    archive_url = COD2_WINE_RUNNER_ARCHIVE_URL
    archive_sha = COD2_WINE_RUNNER_ARCHIVE_SHA256
    install_dir = f"/opt/{archive_dir}"
    fragment = f'''
ARG DEBIAN_FRONTEND=noninteractive
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates wget xz-utils; \
    wget --tries=5 --timeout=30 -O /tmp/pcga-wine.tar.xz {archive_url}; \
    echo "{archive_sha}  /tmp/pcga-wine.tar.xz" | sha256sum -c -; \
    tar -xJf /tmp/pcga-wine.tar.xz -C /opt; \
    test -x {install_dir}/bin/wine; \
    test -x {install_dir}/bin/wineserver; \
    {install_dir}/bin/wine --version | tee /tmp/pcga-wine-version; \
    grep -Eq '^wine-{re.escape(version)}([.-]|$)' /tmp/pcga-wine-version; \
    echo "[pcga-runner-build] portable Wine archive sha256={archive_sha}"; \
    echo "[pcga-runner-build] portable Wine path={install_dir}"; \
    rm -f /tmp/pcga-wine.tar.xz /tmp/pcga-wine-version; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*
ENV PCGA_WINE_RUNNER={runner_id}
ENV PCGA_WINE_BIN={install_dir}/bin/wine
ENV PCGA_WINESERVER_BIN={install_dir}/bin/wineserver
ENV PATH={install_dir}/bin:$PATH
'''
    return runner_id, fragment


def compatibility_wine_arch(game: dict) -> str:
    """Return the effective prefix architecture, including offline appliance rules.

    COD2 retail is deliberately authoritative here rather than relying solely on
    a network-resolved provider profile.  Its 32-bit campaign executable enters
    the SafeDisc/SecDrv path before a window maps; the v0.18.71 diagnostics showed
    a win64 prefix failing ZwLoadDriver(SecDrv) with c0000142.
    """
    if _is_call_of_duty_2(game):
        return "win32"
    arch = str(compatibility_profile(game).get("wine_arch") or "")
    return arch if arch in {"win32", "win64"} else ""


def ensure_appliance_compatibility_rules(set_id: str, game: dict) -> dict:
    """Persist deterministic local compatibility rules without network access."""
    if not _is_call_of_duty_2(game):
        return game
    compat = dict(game.get("compatibility") or {}) if isinstance(game.get("compatibility"), dict) else {}
    profile = dict(compat.get("profile") or {}) if isinstance(compat.get("profile"), dict) else {}
    changed = False
    desired = {
        "runner": COD2_WINE_RUNNER,
        "runner_version": COD2_WINE_RUNNER_VERSION,
        "runner_version_policy": "pinned-isolated-runtime",
        "wine_arch": "win32",
        "legacy_drm": "safedisc-4.60-secdrv",
        "expected_volume_label": "COD2CD1",
        "auto_apply": True,
    }
    for key, value in desired.items():
        if profile.get(key) != value:
            profile[key] = value
            changed = True
    preferred = [Path(str(x)).name for x in profile.get("preferred_executables") or [] if str(x).lower().endswith(".exe")]
    merged = ["CoD2SP_s.exe", "CoD2MP_s.exe"] + [x for x in preferred if x.casefold() not in {"cod2sp_s.exe", "cod2mp_s.exe"}]
    if profile.get("preferred_executables") != merged[:12]:
        profile["preferred_executables"] = merged[:12]
        changed = True
    sources = [str(x) for x in profile.get("source") or [] if str(x)]
    if "pcga-known-good" not in sources:
        sources.append("pcga-known-good")
        profile["source"] = sources
        changed = True
    if compat.get("appliance_rule_version") != VERSION:
        compat["appliance_rule_version"] = VERSION
        changed = True
    if compat.get("profile") != profile:
        compat["profile"] = profile
        changed = True
    if changed:
        compat["status"] = "matched"
        compat["confidence"] = max(float(compat.get("confidence") or 0), 0.98)
        game = dict(game)
        game["compatibility"] = compat
        game["updated_at"] = now()
        save_json(SETS / f"{set_id}.json", game)
        log(f"{set_id}: applied offline appliance compatibility rule: COD2 win32 SafeDisc/SecDrv profile")
    return game


def _wine_prefix_arch(prefix: Path) -> str:
    """Read Wine's immutable #arch marker without starting Wine."""
    system_reg = prefix / "system.reg"
    try:
        with system_reg.open("r", encoding="utf-8", errors="ignore") as fh:
            for _ in range(32):
                line = fh.readline()
                if not line:
                    break
                m = re.match(r"^#arch=(win32|win64)\s*$", line.strip(), re.I)
                if m:
                    return m.group(1).lower()
    except OSError:
        pass
    return ""


def _disc_number_from_volume_label(label: str) -> int | None:
    """Extract a physical disc number from labels such as COD2CD1 / GAME_DISC_02."""
    value = str(label or "").strip().casefold()
    if not value:
        return None
    matches = re.findall(r"(?:disc|disk|cd)[ _.-]*0*([1-9][0-9]?)", value)
    if not matches:
        return None
    try:
        return int(matches[-1])
    except (TypeError, ValueError):
        return None


def _iso_volume_label(iso: Path) -> str:
    """Read an optical-image label without trusting canonical slot ordering."""
    if not iso.is_file() or not shutil.which("blkid"):
        return ""
    try:
        proc = subprocess.run(
            ["blkid", "-p", "-s", "LABEL", "-o", "value", str(iso)],
            capture_output=True, text=True, timeout=8,
        )
    except Exception:
        return ""
    return proc.stdout.strip()[:96] if proc.returncode == 0 else ""


def _cod2_logical_media_map(isos: list[Path]) -> dict[int, tuple[int, Path, str]]:
    """Map COD2CD1..COD2CD6 labels to logical disc numbers.

    The preservation catalog's slot order is intentionally not trusted here: the
    current archive has COD2CD1 in slot 6.  The on-disc volume label is the source
    of truth for the temporary setup-source merge.
    """
    mapped: dict[int, tuple[int, Path, str]] = {}
    for slot, iso in enumerate(isos, 1):
        label = _iso_volume_label(iso)
        if not re.fullmatch(r"(?i)COD2CD0*[1-9][0-9]*", label or ""):
            continue
        logical = _disc_number_from_volume_label(label)
        if logical is None or logical in mapped:
            return {}
        mapped[logical] = (slot, iso, label)
    return mapped


def _make_setup_tree_world_readable(root: Path) -> None:
    """Normalize only the disposable setup staging tree for uid 1000 runtimes."""
    for base, dirs, files in os.walk(root):
        b = Path(base)
        try:
            os.chmod(b, stat.S_IMODE(b.stat().st_mode) | 0o555)
        except OSError:
            pass
        for name in dirs:
            q = b / name
            try:
                os.chmod(q, stat.S_IMODE(q.stat().st_mode) | 0o555)
            except OSError:
                pass
        for name in files:
            q = b / name
            try:
                os.chmod(q, stat.S_IMODE(q.stat().st_mode) | 0o444)
            except OSError:
                pass


def _msi_media_rows(msi: Path) -> list[dict]:
    """Export the MSI Media table as typed dictionaries.

    Windows Installer uses more than VolumeLabel when it crosses a Media row.
    In Wine in particular, a new DiskId can still trigger source-media resolution
    even when every row carries the same volume label.  Keep the complete table so
    COD2's old six-CD package can be flattened deliberately instead of only
    relabelled.
    """
    proc = subprocess.run(
        ["msiinfo", "export", str(msi), "Media"],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=20,
    )
    if proc.returncode != 0:
        return []
    lines = proc.stdout.splitlines()
    if len(lines) < 4:
        return []
    header = lines[0].split("\t")
    out: list[dict] = []
    for line in lines[3:]:
        if not line:
            continue
        cols = line.split("\t")
        row = {name: (cols[i] if i < len(cols) else "") for i, name in enumerate(header)}
        for key in ("DiskId", "LastSequence"):
            try:
                row[key] = int(str(row.get(key) or "0"))
            except ValueError:
                row[key] = 0
        out.append(row)
    return out


def _sql_msi_string(value: str) -> str:
    return str(value or "").replace("'", "''")


def _flatten_cod2_msi_media_table(root: Path, unified_label: str) -> list[dict]:
    """Convert COD2's disposable staged MSI from six logical CDs to one source.

    v0.18.61 attempted to rewrite the Media table with SQL UPDATE/DELETE queries.
    The live diagnostics proved that this was not deterministic for COD2.msi on
    the appliance: the verification pass repeatedly found COD2CD3 and COD2CD5
    still present.  Build an authoritative Media.idt from the exported table and
    import the whole table instead.  msibuild documents ``-i <table>.idt`` as an
    overwrite of the existing table, so there is no partially-updated Media map.

    For cabinet-less COD2 media we collapse all rows to the first DiskId and
    extend LastSequence through the original maximum.  Cabinet-backed packages
    retain their row boundaries but every row is normalized to the synthetic
    merged volume label.  Preserved optical images are never modified; this only
    touches the disposable host-staged MSI.
    """
    if not shutil.which("msiinfo") or not shutil.which("msibuild"):
        raise RuntimeError("msitools (msiinfo + msibuild) is required to flatten COD2 multi-disc MSI media")

    results: list[dict] = []
    for msi in sorted(q for q in root.rglob("*") if q.is_file() and q.suffix.casefold() == ".msi"):
        export = subprocess.run(
            ["msiinfo", "export", str(msi), "Media"],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=20,
        )
        if export.returncode != 0:
            continue
        raw_lines = export.stdout.splitlines()
        if len(raw_lines) < 4:
            continue
        header = raw_lines[0].split("\t")
        required = {"DiskId", "LastSequence", "DiskPrompt", "Cabinet", "VolumeLabel"}
        if not required.issubset(set(header)):
            raise RuntimeError(f"{msi.name} Media table is missing expected columns: {sorted(required - set(header))}")

        before = _msi_media_rows(msi)
        if not before:
            continue
        is_cod2 = msi.name.casefold() == "cod2.msi" or any(
            re.fullmatch(r"(?i)COD2CD0*[1-9][0-9]*", str(row.get("VolumeLabel") or ""))
            or "call of duty 2" in str(row.get("DiskPrompt") or "").casefold()
            for row in before
        )
        if not is_cod2:
            continue

        max_last = max(int(row.get("LastSequence") or 0) for row in before)
        cabinet_rows = [row for row in before if str(row.get("Cabinet") or "").strip()]
        collapse = len(before) > 1 and not cabinet_rows
        mode = "single-media-idt" if collapse else "cabinet-preserving-idt"

        rows: list[list[str]] = []
        for line in raw_lines[3:]:
            if not line:
                continue
            cols = line.split("\t")
            if len(cols) < len(header):
                cols += [""] * (len(header) - len(cols))
            rows.append(cols[:len(header)])
        if not rows:
            raise RuntimeError(f"{msi.name} Media export contained no data rows")

        idx = {name: header.index(name) for name in required}
        first_id = min(int(row.get("DiskId") or 0) for row in before if int(row.get("DiskId") or 0) > 0)
        if collapse:
            candidates = [r for r in rows if int(r[idx["DiskId"]] or "0") == first_id]
            if len(candidates) != 1:
                raise RuntimeError(f"{msi.name} Media table does not have one unique first DiskId={first_id} row")
            row = list(candidates[0])
            row[idx["DiskId"]] = str(first_id)
            row[idx["LastSequence"]] = str(max_last)
            row[idx["DiskPrompt"]] = unified_label
            row[idx["VolumeLabel"]] = unified_label
            rows = [row]
        else:
            for row in rows:
                row[idx["DiskPrompt"]] = unified_label
                row[idx["VolumeLabel"]] = unified_label

        os.chmod(msi, stat.S_IMODE(msi.stat().st_mode) | 0o600)
        with tempfile.TemporaryDirectory(prefix="pcga-cod2-media-idt-", dir=str(msi.parent)) as td:
            idt = Path(td) / "Media.idt"
            # msiinfo export already emits the three IDT metadata/header lines.
            # Reuse them byte-for-byte and replace only the data rows.
            idt_text = "\r\n".join(raw_lines[:3] + ["\t".join(row) for row in rows]) + "\r\n"
            idt.write_text(idt_text, encoding="utf-8", newline="")
            proc = subprocess.run(
                ["msibuild", str(msi), "-i", str(idt)],
                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=30,
            )
        if proc.returncode != 0:
            raise RuntimeError(f"msibuild failed to import authoritative Media.idt for {msi.name}: {proc.stderr.strip()[:240]}")

        after = _msi_media_rows(msi)
        if not after:
            raise RuntimeError(f"could not verify Media table after IDT replacement in {msi.name}")
        bad_labels = [
            str(row.get("VolumeLabel") or "") for row in after
            if str(row.get("VolumeLabel") or "").casefold() != unified_label.casefold()
        ]
        bad_prompts = [
            str(row.get("DiskPrompt") or "") for row in after
            if str(row.get("DiskPrompt") or "").casefold() != unified_label.casefold()
        ]
        if bad_labels or bad_prompts:
            raise RuntimeError(
                f"{msi.name} Media.idt verification failed; labels={bad_labels[:6]} prompts={bad_prompts[:6]}"
            )
        if collapse:
            if len(after) != 1 or int(after[0].get("DiskId") or 0) != first_id or int(after[0].get("LastSequence") or 0) != max_last:
                raise RuntimeError(
                    f"{msi.name} Media table did not collapse to one row DiskId={first_id} through sequence {max_last}: {after[:3]}"
                )

        # External cabinet rows, if any, must resolve from the merged SourceDir.
        cabinet_aliases: list[str] = []
        for row in after:
            cab = str(row.get("Cabinet") or "").strip()
            if not cab or cab.startswith("#"):
                continue
            target = root / cab
            if target.is_file():
                continue
            matches = [q for q in root.rglob("*") if q.is_file() and q.name.casefold() == Path(cab).name.casefold()]
            if len(matches) == 1:
                target.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(matches[0], target)
                cabinet_aliases.append(f"{matches[0].relative_to(root)} -> {cab}")
            else:
                raise RuntimeError(f"external MSI cabinet {cab!r} is not uniquely available in merged COD2 SourceDir")

        results.append({
            "msi": str(msi.relative_to(root)),
            "mode": mode,
            "before": before,
            "after": after,
            "label": unified_label,
            "max_last_sequence": max_last,
            "cabinet_aliases": cabinet_aliases,
            "rewrite": "authoritative-Media.idt-import-v01866-optical",
        })
    if not results:
        raise RuntimeError("no COD2 MSI Media table was found in the staged six-disc source")
    return results

def _exact_mount_source(target: Path) -> str:
    """Return the source mounted exactly at *target*, not its parent filesystem."""
    if shutil.which("findmnt"):
        try:
            proc = subprocess.run(
                ["findmnt", "-rn", "-M", str(target), "-o", "SOURCE"],
                capture_output=True, text=True, timeout=5,
            )
            if proc.returncode == 0:
                return proc.stdout.strip().splitlines()[0] if proc.stdout.strip() else ""
        except Exception:
            pass
    try:
        return _runtime_media_source_device(target) if target.is_mount() else ""
    except OSError:
        return ""


def _unmount_setup_source(target: Path) -> str:
    """Detach a disposable setup-source mount and return its former source.

    Path.is_mount() was not reliable enough for the synthetic COD2 loop mount.
    v0.18.63/64 could therefore unlink setup-source-v01863.iso while /dev/loop
    still had it mounted, leaving a `(deleted)` loop backing file and a read-only
    setup-source tree.  Query findmnt for the exact mountpoint and refuse to
    delete the ISO until the mount is demonstrably gone.
    """
    source = _exact_mount_source(target)
    if not source:
        return ""
    proc = subprocess.run(
        ["umount", str(target)], capture_output=True, text=True, timeout=20,
    )
    if proc.returncode != 0:
        raise RuntimeError(
            "could not unmount stale synthetic setup volume: "
            + (proc.stderr.strip() or proc.stdout.strip())[:240]
        )
    if _exact_mount_source(target):
        raise RuntimeError("synthetic setup volume still appears mounted after umount")
    return source


def _build_single_volume_iso(source: Path, output: Path, label: str) -> None:
    """Build a real ISO-9660 volume from the disposable merged setup tree.

    Wine's MSI source resolver does not reliably treat an ext4 directory symlink as
    removable optical media, even if HKEY_LOCAL_MACHINE\\Software\\Wine\\Drives says
    ``cdrom``.  A real ISO filesystem gives GetDriveType/GetVolumeInformation and
    Windows Installer one coherent source identity.
    """
    tool = shutil.which("xorriso")
    if not tool:
        raise RuntimeError("xorriso is required to build the synthetic single-volume setup ISO")
    output.parent.mkdir(parents=True, exist_ok=True)
    output.unlink(missing_ok=True)
    proc = subprocess.run(
        [
            tool, "-as", "mkisofs", "-quiet", "-iso-level", "3", "-J", "-R",
            "-V", label, "-o", str(output), str(source),
        ],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=900,
    )
    if proc.returncode != 0 or not output.is_file() or output.stat().st_size <= 0:
        raise RuntimeError(
            "xorriso failed to build synthetic setup volume: "
            + (proc.stderr.strip() or proc.stdout.strip())[-400:]
        )
    if shutil.which("blkid"):
        probe = subprocess.run(
            ["blkid", "-p", "-s", "LABEL", "-o", "value", str(output)],
            capture_output=True, text=True, timeout=10,
        )
        actual = probe.stdout.strip() if probe.returncode == 0 else ""
        if actual.casefold() != label.casefold():
            raise RuntimeError(f"synthetic setup ISO label mismatch: expected {label!r}, got {actual!r}")


def _mount_setup_iso(iso: Path, target: Path, label: str) -> str:
    """Persistently mount a synthetic setup ISO and return its host loop device."""
    target.mkdir(parents=True, exist_ok=True)
    _unmount_setup_source(target)
    proc = subprocess.run(
        ["mount", "-o", "loop,ro,nosuid,nodev,noexec", str(iso), str(target)],
        capture_output=True, text=True, timeout=30,
    )
    if proc.returncode != 0:
        raise RuntimeError(
            "could not mount synthetic setup ISO: "
            + (proc.stderr.strip() or proc.stdout.strip())[:300]
        )
    try:
        device = _runtime_media_source_device(target)
        if not device:
            raise RuntimeError("synthetic setup ISO mounted without a discoverable /dev/loop device")
        if shutil.which("blkid"):
            probe = subprocess.run(
                ["blkid", "-p", "-s", "LABEL", "-o", "value", device],
                capture_output=True, text=True, timeout=10,
            )
            actual = probe.stdout.strip() if probe.returncode == 0 else ""
            if actual.casefold() != label.casefold():
                raise RuntimeError(f"mounted setup ISO label mismatch: expected {label!r}, got {actual!r}")
        return device
    except Exception:
        _unmount_setup_source(target)
        raise


def _cleanup_cod2_synthetic_setup_media(install_root: Path) -> bool:
    """Remove only disposable COD2 setup media, never preservation ISOs.

    Return False instead of unlinking backing files if the read-only loop mount
    cannot be detached.  This prevents the `(deleted)` /dev/loop state observed
    in the v0.18.64 diagnostics.
    """
    setup_source = install_root / "setup-source"
    try:
        _unmount_setup_source(setup_source)
    except Exception as exc:
        log(f"COD2 synthetic setup-volume unmount blocked cleanup: {type(exc).__name__}: {exc}")
        return False
    if _exact_mount_source(setup_source):
        log("COD2 synthetic setup-volume cleanup refused because setup-source is still mounted")
        return False
    if setup_source.exists():
        if setup_source.is_dir():
            shutil.rmtree(setup_source, ignore_errors=True)
        else:
            setup_source.unlink(missing_ok=True)
    for name in (
        "setup-source-v01866.iso",
        ".setup-source-v01866.iso.tmp",
        ".setup-source-v01866.tmp",
        "setup-source-v01865.iso",
        ".setup-source-v01865.iso.tmp",
        ".setup-source-v01865.tmp",
        "setup-source-v01863.iso",
        ".setup-source-v01863.iso.tmp",
        ".setup-source-v01863.tmp",
        ".setup-source-v01858.tmp",
    ):
        q = install_root / name
        # Never unlink an ISO that is still loop-backed.
        busy = False
        if q.is_file() and shutil.which("losetup"):
            try:
                probe = subprocess.run(["losetup", "-j", str(q)], capture_output=True, text=True, timeout=5)
                busy = bool(probe.stdout.strip())
            except Exception:
                busy = False
        if busy:
            log(f"COD2 synthetic setup-volume cleanup retained busy loop backing file: {q}")
            return False
        if q.is_dir():
            shutil.rmtree(q, ignore_errors=True)
        else:
            q.unlink(missing_ok=True)
    return True


def _copy_cod2_disc_payload(source: Path, destination: Path) -> None:
    """Overlay one preserved COD2 disc without carrying Wine/PCGA pseudo-files.

    The preserved optical filesystem is authoritative for payload bytes, but
    PCGA/Wine control files such as ``.windows-label`` are not game content.
    v0.18.65 still allowed a stale pseudo-file to participate in the six-disc
    overlay and field systems could abort before the setup runtime was created.
    Copy bytes only (not ISO ownership/xattrs/directory metadata), keep the
    destination writable for the next disc overlay, and ignore root-level
    appliance pseudo-files.
    """
    source = source.resolve()
    destination.mkdir(parents=True, exist_ok=True)
    pseudo = {".windows-label", ".windows-serial"}
    for base, dirs, files in os.walk(source):
        src_base = Path(base)
        rel = src_base.relative_to(source)
        dst_base = destination if str(rel) == "." else destination / rel
        dst_base.mkdir(parents=True, exist_ok=True)
        try:
            os.chmod(dst_base, 0o755)
        except OSError:
            pass
        # Do not copy synthetic/appliance markers from a source root. They are
        # regenerated after all six genuine discs have been overlaid.
        for name in files:
            if str(rel) == "." and (name in pseudo or name.startswith(".pcga-")):
                log(f"COD2 staging ignored non-payload source marker: {name}")
                continue
            src = src_base / name
            dst = dst_base / name
            if src.is_symlink():
                # ISO media can contain Rock Ridge symlinks. Follow only links
                # that resolve to regular files inside the mounted disc tree.
                try:
                    resolved = src.resolve(strict=True)
                    resolved.relative_to(source)
                except (OSError, ValueError):
                    continue
                if not resolved.is_file():
                    continue
                src = resolved
            if not src.is_file():
                continue
            dst.parent.mkdir(parents=True, exist_ok=True)
            # copyfile intentionally avoids copy2/copystat/xattrs from the
            # read-only ISO. Windows installers need the bytes, not POSIX metadata.
            shutil.copyfile(src, dst)
            try:
                os.chmod(dst, 0o644)
            except OSError:
                pass


def _cod2_synthetic_setup_source_ready(state: dict) -> tuple[bool, str, str]:
    """Validate the durable COD2DVD mount without pathlib.Path.is_mount().

    Path.is_mount() has proved unreliable for PCGA loop-backed setup media. Use
    findmnt-backed exact-mount detection plus payload probes so periodic
    reconciliation cannot tear down a healthy source while Wolf launches setup.
    """
    setup_source = Path(str(state.get("setup_source") or ""))
    setup_iso = Path(str(state.get("setup_source_iso_v01866") or ""))
    installer_rel = str(state.get("setup_installer") or "setup.exe").replace("\\", "/").lstrip("/")
    if not str(state.get("setup_source") or ""):
        return False, "", "setup source path is missing"
    mounted_from = _exact_mount_source(setup_source)
    if not mounted_from:
        return False, "", "setup source is not an exact mounted optical filesystem"
    if not setup_iso.is_file():
        return False, "", "synthetic COD2DVD ISO backing file is missing"
    if not (setup_source / installer_rel).is_file():
        return False, "", f"mounted COD2DVD is missing {installer_rel}"
    if not (setup_source / "Setup" / "Data" / "main" / "iw_02.iwd").is_file():
        return False, "", "mounted COD2DVD is missing Setup/Data/main/iw_02.iwd"
    if not (setup_source / ".pcga-msi-media-flattened-v01866.json").is_file():
        return False, "", "mounted COD2DVD is missing the MSI media flatten marker"
    try:
        device = _runtime_media_source_device(setup_source)
    except OSError:
        device = ""
    if not device or not Path(device).exists():
        return False, "", "mounted COD2DVD raw loop device is unavailable"
    return True, device, "ready"


def repair_cod2_multidisc_setup_source(set_id: str, game: dict, sources: list[dict], state: dict) -> dict:
    """Materialize COD2's six CDs as one genuine synthetic optical volume.

    v0.18.62 proved that replacing the MSI Media table alone is not enough when
    Wine D: is still a directory-backed ext4 bind mount masquerading as a CD-ROM.
    Build the established CD-to-DVD layout instead: merge the six immutable CD
    images, flatten only the disposable COD2.msi Media table, author a read-only
    ISO-9660 image labelled COD2DVD, and expose both its mounted filesystem and
    loop block device to Wine.  This makes the filesystem label, Win32 drive type,
    MSI SourceDir, and the Media table all describe one physical-looking medium.
    """
    if state.get("status") != "setup-required":
        return state
    if not _is_call_of_duty_2(game):
        return state
    if state.get("setup_source_multidisc_optical_v01866"):
        ready, device, reason = _cod2_synthetic_setup_source_ready(state)
        if ready:
            if str(state.get("setup_source_device_v01866") or "") != device:
                return state_update(set_id, setup_source_device_v01866=device)
            return state
        log(f"{set_id}: COD2 synthetic optical source needs repair: {reason}")
        state = state_update(
            set_id,
            setup_source=None, setup_source_iso_v01866=None, setup_source_device_v01866=None,
            setup_source_volume_label_v01866=None, setup_source_multidisc_optical_v01866=False,
            setup_source_multidisc_merged_v01858=False, setup_source_multidisc_merged_v01862=False,
            setup_source_msi_media_flattened_v01858=None, setup_source_msi_media_flattened_v01862=None,
            setup_source_msi_media_flattened_v01866=None, setup_runtime_image=None,
            setup_runtime_build_hash=None, setup_runtime_log=None, stream_state="pending",
            stream_app_title=None, stream_detail=f"Repairing COD2 synthetic optical setup source: {reason}",
        )

    isos = source_isos(sources)
    if not isos:
        isos = persisted_media_isos(state)
    mapped = _cod2_logical_media_map(isos)
    if set(mapped) != {1, 2, 3, 4, 5, 6}:
        return state_update(
            set_id,
            detail="COD2 setup still needs a complete COD2CD1..COD2CD6 preserved set before single-volume staging",
        )

    install_root = Path(str(state.get("install_root") or archive_root() / "games/installed" / set_id))
    install_root.mkdir(parents=True, exist_ok=True)
    setup_source = install_root / "setup-source"
    setup_iso = install_root / "setup-source-v01866.iso"
    temp_iso = install_root / ".setup-source-v01866.iso.tmp"
    staged = archive_root() / "games" / ".staging" / f"{set_id}-cod2-v01866"
    if not _cleanup_cod2_synthetic_setup_media(install_root):
        return state_update(set_id, detail="COD2 synthetic optical source is still busy; end the active setup session and retry", stream_state="pending-restart")
    # The temporary merge tree must never itself be a mountpoint.
    try:
        _unmount_setup_source(staged)
    except Exception:
        pass
    if staged.exists():
        shutil.rmtree(staged, ignore_errors=True)
    staged.mkdir(parents=True, exist_ok=True)

    required_bytes = sum(row[1].stat().st_size for row in mapped.values())
    try:
        free_bytes = shutil.disk_usage(install_root).free
    except OSError:
        free_bytes = -1
    # The merge tree and generated ISO coexist briefly. Reserve enough for both,
    # then discard the tree after the ISO is mounted.
    reserve = 768 * 1024 * 1024
    peak_required = required_bytes * 2 + reserve
    if free_bytes >= 0 and free_bytes < peak_required:
        shutil.rmtree(staged, ignore_errors=True)
        need_gib = peak_required / (1024 ** 3)
        free_gib = free_bytes / (1024 ** 3)
        return state_update(
            set_id,
            detail=f"COD2 single-volume staging needs about {need_gib:.1f} GiB temporarily; only {free_gib:.1f} GiB is available",
        )

    merge_root = Path("/run/pcga-game-installer") / set_id / "cod2-single-volume-v01866"
    copied_labels: list[str] = []
    synthetic_label = "COD2DVD"
    try:
        # Highest-numbered disc first, CD1 last. If support/bootstrap files are
        # duplicated, the lowest logical disc wins while unique payload remains.
        for logical in sorted(mapped, reverse=True):
            slot, iso, label = mapped[logical]
            mountpoint = merge_root / f"cd{logical}"
            with mounted_iso(iso, mountpoint) as src:
                _copy_cod2_disc_payload(src, staged)
            copied_labels.append(f"CD{logical}=slot{slot}:{label}")

        installer_rel = str(state.get("setup_installer") or "setup.exe").replace("\\", "/").lstrip("/")
        installer_path = staged / installer_rel
        sentinel = staged / "Setup" / "Data" / "main" / "iw_02.iwd"
        if not installer_path.is_file():
            raise RuntimeError(f"merged COD2 source is missing installer {installer_rel}")
        if not sentinel.is_file():
            candidates = [q for q in staged.rglob("*") if q.is_file() and q.name.casefold() == "iw_02.iwd"]
            if len(candidates) == 1:
                sentinel.parent.mkdir(parents=True, exist_ok=True)
                if candidates[0] != sentinel:
                    shutil.copy2(candidates[0], sentinel)
            if not sentinel.is_file():
                raise RuntimeError("merged COD2 source is still missing Setup/Data/main/iw_02.iwd")

        # Match known-working COD2 CD-to-DVD conversions: one real optical volume
        # named COD2DVD and a disposable MSI whose Media table names that volume.
        msi_media = _flatten_cod2_msi_media_table(staged, synthetic_label)
        marker = staged / ".pcga-msi-media-flattened-v01866.json"
        marker.write_text(json.dumps(msi_media, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        _make_setup_tree_world_readable(staged)

        _build_single_volume_iso(staged, temp_iso, synthetic_label)
        os.replace(temp_iso, setup_iso)
        device = _mount_setup_iso(setup_iso, setup_source, synthetic_label)
        if not (setup_source / installer_rel).is_file():
            raise RuntimeError(f"mounted COD2DVD volume is missing installer {installer_rel}")
        if not (setup_source / "Setup" / "Data" / "main" / "iw_02.iwd").is_file():
            raise RuntimeError("mounted COD2DVD volume is missing Setup/Data/main/iw_02.iwd")

        # The mounted ISO is now authoritative; free the temporary merge tree.
        shutil.rmtree(staged, ignore_errors=True)
        reset_interactive_prefix(install_root, reason="v0.18.69 COD2 real single-volume optical restage")
        return state_update(
            set_id,
            setup_source=str(setup_source),
            setup_source_iso_v01866=str(setup_iso),
            setup_source_device_v01866=device,
            setup_source_volume_label_v01866=synthetic_label,
            setup_source_multidisc_merged_v01858=True,
            setup_source_multidisc_merged_v01862=True,
            setup_source_multidisc_optical_v01866=True,
            setup_source_multidisc_labels_v01858=copied_labels,
            setup_source_msi_media_flattened_v01858=msi_media,
            setup_source_msi_media_flattened_v01862=msi_media,
            setup_source_msi_media_flattened_v01866=msi_media,
            setup_runtime_image=None,
            setup_runtime_build_hash=None,
            setup_runtime_log=None,
            stream_state="pending",
            stream_app_title=None,
            runtime_active_disc=mapped[1][0],
            detail="COD2 six-CD source rebuilt as a genuine read-only COD2DVD ISO; Wine setup now receives one labelled optical filesystem plus its raw loop block device",
        )
    except Exception as exc:
        shutil.rmtree(staged, ignore_errors=True)
        temp_iso.unlink(missing_ok=True)
        cleanup_ok = _cleanup_cod2_synthetic_setup_media(install_root)
        if not cleanup_ok:
            log("COD2 failed staging retained its synthetic ISO because the loop mount is still busy")
        log(f"COD2 single-volume setup staging failed: {type(exc).__name__}: {exc}")
        for line in traceback.format_exc().splitlines()[-12:]:
            log(f"COD2 staging traceback: {line}")
        return state_update(
            set_id,
            setup_source=None,
            setup_source_iso_v01866=None,
            setup_source_device_v01866=None,
            setup_source_volume_label_v01866=None,
            setup_source_multidisc_merged_v01858=False,
            setup_source_multidisc_merged_v01862=False,
            setup_source_multidisc_optical_v01866=False,
            setup_source_msi_media_flattened_v01858=None,
            setup_source_msi_media_flattened_v01862=None,
            setup_source_msi_media_flattened_v01866=None,
            setup_runtime_image=None,
            setup_runtime_build_hash=None,
            setup_runtime_log=None,
            stream_state="failed",
            stream_app_title=None,
            stream_detail="COD2 synthetic optical setup source failed validation; installer launch was blocked",
            detail=f"COD2 single-volume setup staging failed closed: {type(exc).__name__}: {str(exc)[:180]}",
        )

def compatibility_preferred_executables(game: dict) -> list[str]:
    """Return ordered direct-launch preferences, including offline appliance rules."""
    values=[]
    title_norm = norm_title(str(game.get("title") or ""))
    if _is_call_of_duty_2(game):
        # The retail install ships both single-player and multiplayer binaries.
        # A generic lexical scorer selected CoD2MP_s.exe first in v0.18.57/58.
        # Prefer the normal single-player entry point for the title card while
        # retaining multiplayer as the second valid direct-launch target.
        values.extend(["CoD2SP_s.exe", "CoD2MP_s.exe"])
    if _is_jedi_outcast(game):
        values.extend(["jk2sp.exe", "JediOutcast.exe"])
    if title_norm in {"swfoc","sweaw"} or ("empire at war" in title_norm and "star wars" in title_norm):
        values.extend(["swfoc.exe", "sweaw.exe", "starwarsg.exe", "LaunchEAW.exe"])
    for item in compatibility_profile(game).get("preferred_executables") or []:
        name=Path(str(item)).name
        if name.lower().endswith(".exe") and name.casefold() not in {x.casefold() for x in values}:
            values.append(name)
    return values[:12]


def compatibility_runtime_environment(game: dict) -> dict[str, str]:
    profile = compatibility_profile(game)
    allowed = {"MESA_EXTENSION_MAX_YEAR", "__GL_ExtensionStringVersion"}
    out: dict[str, str] = {}
    raw = profile.get("runtime_environment") if isinstance(profile.get("runtime_environment"), dict) else {}
    for key, value in raw.items():
        key = str(key or "")
        value = str(value or "")
        if key in allowed and re.fullmatch(r"[A-Za-z0-9_.:+-]{1,80}", value):
            out[key] = value
    return out


def compatibility_launch_arguments(game: dict) -> list[str]:
    profile = compatibility_profile(game)
    out: list[str] = []
    for item in profile.get("launch_arguments") or []:
        value = str(item or "")
        if value and len(value) <= 96 and "\x00" not in value and "\n" not in value and "\r" not in value:
            out.append(value)
        if len(out) >= 24:
            break
    return out


def compatibility_virtual_cd(game: dict) -> dict:
    """Return a validated appliance-owned Wine virtual-CD recipe."""
    profile = compatibility_profile(game)
    raw = profile.get("virtual_cd") if isinstance(profile.get("virtual_cd"), dict) else {}
    if not raw and _is_jedi_outcast(game):
        raw = {
            "drive_letter": "d", "label": "JEDIOUTCAST",
            "required_paths": ["gamedata/gamedata/jk2sp.exe", "gamedata/gamedata/jk2sp"],
        }
    letter = str(raw.get("drive_letter") or "").lower()
    label = str(raw.get("label") or "").strip()
    if not re.fullmatch(r"[d-k]", letter) or not re.fullmatch(r"[A-Za-z0-9_. +()-]{1,64}", label):
        return {}
    required=[]
    for item in raw.get("required_paths") or []:
        value=str(item or "").replace("\\", "/").strip("/")
        if value and ".." not in value.split("/") and re.fullmatch(r"[A-Za-z0-9_. +()'/-]{1,180}", value):
            required.append(value)
        if len(required) >= 8:
            break
    if not required:
        return {}
    return {"drive_letter": letter, "label": label, "required_paths": required}


def resolve_compatibility(set_id: str, game: dict, *, force: bool = False) -> tuple[dict, str]:
    """Run the provider-neutral resolver and reload the game record.

    The resolver owns its network/cache policy and never executes provider scripts.
    Failure is non-fatal: preservation/install continues with the existing generic
    Wine profile and the portal exposes the lookup state for diagnosis.
    """
    if not COMPAT_RESOLVER.is_file() or not os.access(COMPAT_RESOLVER, os.X_OK):
        return game, "resolver-unavailable"
    cmd=[str(COMPAT_RESOLVER), "--set-id", set_id]
    if force:
        cmd.append("--force")
    try:
        proc=subprocess.run(cmd, capture_output=True, text=True, timeout=55)
    except Exception as exc:
        return game, "error-" + type(exc).__name__
    updated=load_json(SETS / f"{set_id}.json") or game
    compat=updated.get("compatibility") if isinstance(updated.get("compatibility"),dict) else {}
    if proc.returncode != 0:
        return updated, "failed-" + str(proc.returncode)
    return updated, str(compat.get("status") or "resolved")


def compatibility_runtime_environment_prelude(game: dict) -> str:
    """Return game-process-only environment exports for runtime compatibility.

    These variables must never be inherited by Sway/wlroots.  In particular,
    MESA_EXTENSION_MAX_YEAR intentionally hides modern GL extensions from old
    games; applying it to the compositor can make wlroots lose required formats
    such as BGRA8888 and abort before Wine is ever launched.
    """
    lines=[]
    for key, value in compatibility_runtime_environment(game).items():
        lines.append(f'export {key}={shlex.quote(value)}')
        lines.append(f'echo "[pcga-compat] applying game-process environment {key}={value}" >&2')
    return "\n".join(lines)


def compatibility_shell_prelude(game: dict, *, prefix_expr: str, marker_expr: str, include_runtime_environment: bool = True) -> str:
    """Return a bounded shell fragment for allow-listed compatibility settings."""
    profile=compatibility_profile(game)
    arch=compatibility_wine_arch(game)
    verbs=compatibility_winetricks(game)
    lines=[]
    if include_runtime_environment:
        env_prelude = compatibility_runtime_environment_prelude(game)
        if env_prelude:
            lines.extend(env_prelude.splitlines())
    if arch in {"win32","win64"}:
        # WINEARCH only applies while creating a prefix. Exporting win32 against
        # an existing 64-bit prefix (or vice versa) makes Wine reject the prefix,
        # so preserve previously-created PCGA prefixes and apply the hint only to
        # fresh ones.
        lines.append(f'if [[ ! -s "{prefix_expr}/drive_c/windows/system32/kernel32.dll" ]]; then export WINEARCH={shlex.quote(arch)}; fi')
    if verbs:
        quoted=" ".join(shlex.quote(v) for v in verbs)
        lines += [
            f'if [[ ! -f "{marker_expr}" ]]; then',
            f'  if [[ ! -s "{prefix_expr}/drive_c/windows/system32/kernel32.dll" ]]; then wineboot -i || true; wineserver -k >/dev/null 2>&1 || true; fi',
            '  if command -v winetricks >/dev/null 2>&1; then',
            f'    if timeout "${{PCGA_COMPAT_WINETRICKS_SECONDS:-300}}" winetricks -q {quoted}; then touch "{marker_expr}"; else echo "[pcga-compat] winetricks profile could not be fully applied within the bounded setup window; continuing with generic Wine behavior" >&2; fi',
            '  else echo "[pcga-compat] winetricks unavailable in runtime; compatibility components are advisory only" >&2; fi',
            'fi',
        ]
    return "\n".join(lines)


def state_update(set_id: str, **fields) -> dict:
    path = state_path(set_id)
    state = load_json(path)
    state.setdefault("schema", 1)
    state.setdefault("game_set_id", set_id)
    state.update(fields)
    state["updated_at"] = now()
    save_json(path, state)
    return state


def scan_sources(root: Path) -> dict[str, list[dict]]:
    """Return set-id -> source bundle metadata.

    The canonical disc registry is used when present, but each promoted bundle's
    .pcga-game.json travels with the immutable source and is sufficient to recover.
    """
    result: dict[str, list[dict]] = {}
    base = root / "ingest/inbox/pc-games"
    if not base.exists():
        return result
    for marker in base.rglob(".pcga-game.json"):
        bundle = marker.parent
        meta = load_json(marker)
        contents = meta.get("contents") if isinstance(meta.get("contents"), list) else []
        set_ids: list[str] = []
        for item in contents:
            if isinstance(item, dict) and item.get("game_set_id"):
                sid = str(item["game_set_id"])
                if sid not in set_ids:
                    set_ids.append(sid)
        for sid in meta.get("game_set_ids") or []:
            sid = str(sid or "")
            if sid and sid not in set_ids:
                set_ids.append(sid)
        if meta.get("game_set_id") and str(meta["game_set_id"]) not in set_ids:
            set_ids.append(str(meta["game_set_id"]))
        for sid in set_ids:
            result.setdefault(sid, []).append({
                "bundle": str(bundle),
                "fingerprint": meta.get("fingerprint"),
                "disc_number": meta.get("disc_number"),
                "disc_count": meta.get("disc_count"),
                "disc_role": meta.get("disc_role"),
                "volume_label": meta.get("volume_label"),
                "layout": meta.get("layout"),
                "collection_id": meta.get("collection_id"),
                "source_paths": [str(x.get("source_path") or ".") for x in contents if isinstance(x, dict) and str(x.get("game_set_id") or "") == sid],
            })
    # Uploaded/manual PC game sources might not carry optical metadata. Keep them
    # visible under a deterministic synthetic id rather than silently ignoring them.
    for child in base.iterdir() if base.exists() else []:
        if child.name.startswith(".") or (child / ".pcga-game.json").exists():
            continue
        # Try classification manifest title and match an intake set. A loose ISO
        # is promoted into a PC-game directory with a sidecar named after the
        # original file, so accept either the bundle-level manifest or one of
        # those file sidecars.
        if child.is_dir():
            manifest = load_json(child / ".pcga-classification.json")
            if not manifest:
                for sidecar in sorted(child.glob("*.pcga-classification.json")):
                    manifest = load_json(sidecar)
                    if manifest:
                        break
        else:
            manifest = load_json(child.with_name(child.name + ".pcga-classification.json"))
        title = str(manifest.get("title") or child.stem).strip()
        # Legacy/source-only images were sometimes promoted as disc.iso. Recover
        # identity from the preserved optical source before synthesizing a game set.
        recovered = best_source_title([{"bundle": str(child), "source_paths": ["."]}], title)
        if recovered:
            title = recovered
        elif generic_game_title(title):
            title = "Unidentified PC Game"
        wanted = norm_title(title)
        matched = None
        for p in SETS.glob("*.json"):
            d = load_json(p)
            if norm_title(str(d.get("title") or "")) == wanted:
                matched = str(d.get("id") or p.stem); break
        if not matched and str(manifest.get("classification") or "") == "pc-game":
            sid=str(uuid.uuid5(uuid.NAMESPACE_URL, "pcga-upload:"+str(child.resolve())))
            record={
                "schema":1,"id":sid,"title":title or child.stem,"sort_title":title or child.stem,
                "normalized_title":wanted,"series":None,"release_year":manifest.get("year"),"edition":None,
                "publisher":None,"developer":None,"platform":"PC","operating_system":None,"language":None,"region":None,
                "external_ids":{},"provisional":True,"user_confirmed":False,"source":"user-upload","created_at":now(),"updated_at":now(),
            }
            save_json(SETS/f"{sid}.json",record); matched=sid
        if matched:
            result.setdefault(matched, []).append({"bundle": str(child), "fingerprint": None, "disc_number": None, "disc_count": None, "layout": "uploaded", "source_paths": ["."]})
    return result


def catalog_family_key(value: object) -> str:
    key=norm_title(str(value or ""))
    if not key:
        return ""
    key=re.sub(r"(?:^|\s)(?:disc|disk|cd|dvd)\s*\d+(?:\s*(?:of|/)\s*\d+)?$", " ", key).strip()
    key=re.sub(r"(?:disc|disk|cd|dvd)\d+(?:of\d+)?$", "", key).strip()
    return " ".join(key.split())


def catalog_identity_aliases(value: object) -> set[str]:
    """Return conservative title aliases used only for duplicate convergence.

    Optical labels often use an acronym while a user-selected database profile
    uses the full retail title (for example ``cod2`` vs ``Call of Duty 2``).
    A second common mastering label is the subtitle alone (``JEDIOUTCAST`` vs
    ``Star Wars Jedi Knight II: Jedi Outcast``).  Subtitle aliases are accepted
    only when the suffix is at least eight compact characters to avoid merging
    short generic subtitles such as ``Gold`` or ``Deluxe``.
    """
    raw=str(value or "").strip()
    family=catalog_family_key(raw)
    if not family:
        return set()
    words=re.findall(r"[a-z]+|\d+",family.casefold())
    aliases=set()
    compact="".join(words)
    if len(compact)>=4:
        aliases.add(compact)
    if len(words)>=2:
        acronym="".join((w if w.isdigit() else w[0]) for w in words if w)
        if len(acronym)>=4:
            aliases.add(acronym)
    if ":" in raw:
        subtitle=raw.rsplit(":",1)[1]
        subtitle_compact="".join(re.findall(r"[a-z]+|\d+",subtitle.casefold()))
        if len(subtitle_compact)>=8:
            aliases.add(subtitle_compact)
    return aliases


def _catalog_record_identity_aliases(set_id: str) -> set[str]:
    """Collect conservative aliases from both metadata and runtime history.

    Duplicate convergence used to look only at the current set title.  That can
    miss a record whose optical/mastering name is normalized later in the same
    orchestration pass, or whose selected database title lives only in the
    install state.  Treat these historical/display names as identity evidence,
    while keeping the alias generator itself deliberately strict.
    """
    game=load_json(SETS/f"{set_id}.json")
    state=load_json(state_path(set_id))
    values=[
        game.get("title"), game.get("sort_title"), game.get("normalized_title"),
        state.get("title"),
    ]
    match=game.get("metadata_match") if isinstance(game.get("metadata_match"),dict) else {}
    values.append(match.get("matched_title"))
    aliases=set()
    for value in values:
        aliases.update(catalog_identity_aliases(value))
    return aliases


def _expand_duplicate_candidates(mapping: dict[str,list[dict]]) -> dict[str,list[dict]]:
    """Add installed metadata/runtime siblings that are linked to scanned media.

    A metadata-only UUID may have no current source mapping after ownership was
    moved to another record, but it can still own the selected RAWG profile or a
    historical runtime.  Include only records that are strongly linked to an
    already-scanned title so unique metadata-only records are not orchestrated
    with an empty source list.
    """
    expanded={sid:list(rows) for sid,rows in mapping.items()}
    if not expanded or not SETS.exists():
        return expanded
    changed=True
    while changed:
        changed=False
        known_ids=set(expanded)
        known_aliases=set()
        known_rawg=set()
        for sid in known_ids:
            known_aliases.update(_catalog_record_identity_aliases(sid))
            g=load_json(SETS/f"{sid}.json")
            ext=g.get("external_ids") if isinstance(g.get("external_ids"),dict) else {}
            if ext.get("rawg") not in (None,""):
                known_rawg.add(str(ext.get("rawg")))
        for path in SETS.glob("*.json"):
            g=load_json(path);sid=str(g.get("id") or path.stem)
            if not sid or sid in expanded or not state_path(sid).exists():
                continue
            target=str(g.get("superseded_by") or "")
            merged={str(x) for x in g.get("merged_set_ids") or [] if str(x)}
            ext=g.get("external_ids") if isinstance(g.get("external_ids"),dict) else {}
            rawg=str(ext.get("rawg") or "")
            linked=(target in known_ids) or bool(merged & known_ids)
            linked=linked or bool(_catalog_record_identity_aliases(sid) & known_aliases)
            linked=linked or bool(rawg and rawg in known_rawg)
            if linked:
                expanded[sid]=[]
                changed=True
    return expanded


def _precanonicalize_local_identities(mapping: dict[str,list[dict]]) -> dict[str,list[dict]]:
    """Normalize local optical identities before duplicate grouping.

    Previously duplicate grouping ran first, then process_set() normalized labels
    such as ``Co D2 MP s`` into ``cod2``.  By then two records that were clearly
    the same title could already have escaped the merge pass.
    """
    for sid,sources in list(mapping.items()):
        game=load_json(SETS/f"{sid}.json")
        if not game:
            continue
        try:
            resolved=reconcile_game_identity(sid,dict(game),sources)
        except Exception:
            continue
        if resolved!=game:
            save_json(SETS/f"{sid}.json",resolved)
    return mapping


def _duplicate_set_score(set_id: str, source_count: int = 0, group_disc_count: int = 0) -> tuple:
    game=load_json(SETS/f"{set_id}.json")
    state=load_json(state_path(set_id))
    status=str(state.get("status") or "")
    stream=str(state.get("stream_state") or "")
    score=0
    if status=="ready":
        score+=800
        rel=str(state.get("launch_executable") or "").strip()
        root=Path(str(state.get("install_root") or archive_root()/"games/installed"/set_id))
        target=root/rel if rel else Path("/")
        valid = bool(rel and _launch_candidate_allowed(root,target))
        # A legacy state can point at IDriver/CDKey/fpupdate even though the same
        # prefix already contains the actual game. Evaluate that recoverability
        # before choosing the canonical duplicate so a copied optical payload does
        # not beat a genuinely completed Wine installation.
        if not valid:
            try:
                valid = choose_installed_executable(root, game) is not None
            except Exception:
                valid = False
        score += 180 if valid else -500
        method=str(state.get("install_method") or "").casefold()
        media=game.get("media") if isinstance(game.get("media"),dict) else {}
        try:
            disc_count=max(int(media.get("disc_count") or 0),int(state.get("source_logical_disc_count") or 0),int(group_disc_count or 0))
        except (TypeError,ValueError):
            disc_count=0
        if method in {"interactive-wolf","msi","inno","nsis","installshield","bootstrap-exe","autorun-bootstrap"}:
            score+=120
        elif method=="portable-copy":
            # A multi-disc retail title classified as portable is a migration
            # error, not a stronger completed installation.  Prefer the sibling
            # setup/prefix record so metadata converges onto the path that can
            # actually mount all preserved discs correctly.
            score += -900 if disc_count > 1 else 10
    elif status=="setup-required": score+=520
    elif status=="installing": score+=420
    elif status in {"queued","source"}: score+=250
    if stream=="ready": score+=140
    if stream=="setup-ready": score+=100
    if state.get("runtime_image") or state.get("setup_runtime_image"): score+=45
    # Hidden/superseded sibling states remain on disk intentionally for recovery.
    # Do not let a stale setup/runtime image on one of those siblings overtake the
    # currently visible canonical title during a transient restage.  v0.18.63 could
    # clear the canonical setup_runtime_image while rebuilding COD2, allowing the
    # hidden sibling to win by a few points and leaving both state records hidden.
    if state.get("catalog_hidden") or state.get("duplicate_of"): score-=250
    if game.get("catalog_hidden") or game.get("superseded_by"): score-=250
    if game.get("user_confirmed"): score+=80
    profile=game.get("metadata_profile") if isinstance(game.get("metadata_profile"),dict) else {}
    if profile.get("selected_by_user"): score+=60
    score+=min(30,source_count*5)
    # Stable UUID ordering breaks otherwise-equal ties deterministically.
    return (score, source_count, set_id)



def _redirect_game_set_id(record: dict, old_id: str, new_id: str, canonical_title: str) -> bool:
    changed=False
    ids=record.get("game_set_ids") if isinstance(record.get("game_set_ids"),list) else []
    if ids:
        new_ids=[]
        for value in ids:
            value=str(value or "")
            if value==old_id:
                value=new_id;changed=True
            if value and value not in new_ids:new_ids.append(value)
        record["game_set_ids"]=new_ids
    if str(record.get("game_set_id") or "")==old_id:
        record["game_set_id"]=new_id;changed=True
    contents=record.get("contents") if isinstance(record.get("contents"),list) else []
    for item in contents:
        if not isinstance(item,dict):continue
        if str(item.get("game_set_id") or "")==old_id:
            item["game_set_id"]=new_id
            if canonical_title:item["title"]=canonical_title
            changed=True
    overrides=record.get("user_overrides") if isinstance(record.get("user_overrides"),dict) else None
    if overrides and isinstance(overrides.get("game_set_ids"),list):
        vals=[]
        for value in overrides.get("game_set_ids") or []:
            value=str(value or "")
            if value==old_id:value=new_id;changed=True
            if value and value not in vals:vals.append(value)
        overrides["game_set_ids"]=vals
    # A single-title sidecar should present the canonical title after ownership
    # migration; compilation/anthology titles keep their collection title.
    final_ids=[str(x) for x in record.get("game_set_ids") or [] if str(x)]
    if final_ids==[new_id] and record.get("layout")!="compilation" and canonical_title:
        if str(record.get("title") or "")!=canonical_title:
            record["title"]=canonical_title;changed=True
    if changed:record["updated_at"]=now()
    return changed


def _rewrite_duplicate_media_ownership(old_id: str, new_id: str, sources: list[dict], canonical_title: str) -> None:
    discs=INTAKE_ROOT/"discs"
    collections=INTAKE_ROOT/"collections"
    fingerprints={str(x.get("fingerprint") or "") for x in sources if str(x.get("fingerprint") or "")}
    for fp in fingerprints:
        path=discs/f"{fp}.json"
        data=load_json(path)
        if data and _redirect_game_set_id(data,old_id,new_id,canonical_title):save_json(path,data)
    for source in sources:
        bundle=Path(str(source.get("bundle") or ""))
        marker=bundle/".pcga-game.json" if bundle.is_dir() else None
        if marker and marker.is_file():
            data=load_json(marker)
            if data and _redirect_game_set_id(data,old_id,new_id,canonical_title):save_json(marker,data)
    # Collections can reference set ids even when the disc sidecar is a
    # compilation. Keep those relationships consistent with the canonical set.
    if collections.exists():
        for path in collections.glob("*.json"):
            data=load_json(path)
            ids=data.get("game_set_ids") if isinstance(data.get("game_set_ids"),list) else []
            if old_id not in [str(x) for x in ids]:continue
            vals=[]
            for value in ids:
                value=str(value or "")
                if value==old_id:value=new_id
                if value and value not in vals:vals.append(value)
            data["game_set_ids"]=vals;data["updated_at"]=now();save_json(path,data)


def _rebuild_canonical_disc_inventory(set_id: str, game: dict) -> dict:
    discs=INTAKE_ROOT/"discs";rows=[]
    if discs.exists():
        for path in discs.glob("*.json"):
            data=load_json(path)
            ids=data.get("game_set_ids") if isinstance(data.get("game_set_ids"),list) else [data.get("game_set_id")]
            if set_id not in [str(x or "") for x in ids]:continue
            rows.append({
                "fingerprint":data.get("fingerprint") or path.stem,
                "disc_number":data.get("disc_number"),"disc_count":data.get("disc_count"),
                "disc_role":data.get("disc_role"),"volume_label":data.get("volume_label"),
                "metadata_status":data.get("metadata_status"),"layout":data.get("layout"),
            })
    rows.sort(key=lambda x:(int(x.get("disc_number")) if isinstance(x.get("disc_number"),int) else 9999,str(x.get("volume_label") or "").casefold()))
    if rows:
        declared=[int(x["disc_count"]) for x in rows if isinstance(x.get("disc_count"),int) and x["disc_count"]>0]
        game["media"]={"schema":1,"kind":"optical-disc-set","disc_count":max(declared) if declared else len(rows),"discs":rows}
        game["disc_fingerprints"]=[str(x.get("fingerprint")) for x in rows if x.get("fingerprint")]
    return game


def _merge_duplicate_user_metadata(canonical_id: str, member_ids: list[str]) -> dict:
    """Carry explicitly selected web metadata onto the strongest runtime set.

    Metadata selection and runtime installation are orthogonal. Older builds
    could apply RAWG to a weak/source UUID while the actually working Wine
    prefix lived under another UUID. When those records converge, keep the
    working runtime identity but move the user's newest selected profile onto it.
    """
    canonical = load_json(SETS/f"{canonical_id}.json")
    if not canonical:
        return canonical
    donors=[]
    for sid in member_ids:
        g=load_json(SETS/f"{sid}.json")
        profile=g.get("metadata_profile") if isinstance(g.get("metadata_profile"),dict) else {}
        if profile.get("selected_by_user"):
            donors.append((str(g.get("updated_at") or g.get("created_at") or ""), sid, g))
    if not donors:
        return canonical
    _, donor_id, donor = sorted(donors, key=lambda x:(x[0],x[1]))[-1]
    metadata_fields={
        "title","sort_title","normalized_title","release_date","release_year","year",
        "developer","publisher","genres","categories","description","marketing_description",
        "website","platform","database_platforms","esrb_rating","metacritic",
        "database_rating","database_ratings_count","external_ids","marketing_assets",
        "metadata_profile","metadata_match","identity_source","identity_confidence",
        "identity_status","metadata_incomplete","provisional","user_confirmed","edition",
    }
    for key in metadata_fields:
        value=donor.get(key)
        if value is not None:
            canonical[key]=value
    canonical["id"]=canonical_id
    canonical.pop("superseded_by",None)
    canonical["catalog_hidden"]=False
    canonical["metadata_runtime_source_set_id"]=donor_id
    canonical["updated_at"]=now()
    if donor_id!=canonical_id:
        src=INTAKE_ROOT/"assets"/donor_id
        dst=INTAKE_ROOT/"assets"/canonical_id
        if src.is_dir():
            dst.mkdir(parents=True,exist_ok=True)
            for asset in src.iterdir():
                if asset.is_file() and asset.suffix.lower() in {".png",".jpg",".jpeg",".webp"}:
                    try: shutil.copy2(asset,dst/asset.name)
                    except OSError: pass
    return canonical


def canonicalize_duplicate_source_mapping(mapping: dict[str,list[dict]]) -> tuple[dict[str,list[dict]], dict[str,str]]:
    """Converge duplicate title UUIDs without deleting preserved/install data.

    Besides title-family matches, v0.18.49 treats a shared non-compilation
    preserved source, a persisted merged-set relationship, or the same external
    database id as strong evidence that two UUIDs are the same logical game.
    This lets a metadata-paired record converge onto the UUID that owns the
    working launcher instead of creating a second library card.
    """
    mapping=_expand_duplicate_candidates(mapping)
    redirected: dict[str,list[dict]]={}
    aliases: dict[str,str]={}
    for sid,sources in mapping.items():
        game=load_json(SETS/f"{sid}.json")
        target=str(game.get("superseded_by") or "").strip()
        if target and (SETS/f"{target}.json").exists():
            aliases[sid]=target
            redirected.setdefault(target,[]).extend(sources)
        else:
            redirected.setdefault(sid,[]).extend(sources)
    mapping=redirected
    # A previously hidden sibling is redirected to its visible canonical UUID
    # before union groups are built. That can leave only one member in the group,
    # so repair stale canonical state visibility here as well as after multi-member
    # canonical selection below.
    for sid in list(mapping):
        game=load_json(SETS/f"{sid}.json")
        state=load_json(state_path(sid))
        if (
            game and state
            and not game.get("catalog_hidden") and not game.get("superseded_by")
            and (state.get("catalog_hidden") or state.get("duplicate_of"))
        ):
            state_update(sid, catalog_hidden=False, duplicate_of=None)
            log(f"recovered stale canonical catalog visibility for {sid} ({game.get('title') or state.get('title') or 'PC game'})")
    ids=list(mapping)
    parent={sid:sid for sid in ids}

    def find(x: str) -> str:
        while parent[x]!=x:
            parent[x]=parent[parent[x]]
            x=parent[x]
        return x

    def union(a: str,b: str) -> None:
        if a not in parent or b not in parent:return
        ra,rb=find(a),find(b)
        if ra!=rb:parent[rb]=ra

    # Existing merged UUID history is authoritative even if one record later
    # received a completely different canonical metadata title.
    for sid in ids:
        game=load_json(SETS/f"{sid}.json")
        for other in game.get("merged_set_ids") or []:
            other=str(other or "")
            if other in parent:union(sid,other)

    # Identical external provider ids are also a strong same-title key.
    external_groups={}
    for sid in ids:
        game=load_json(SETS/f"{sid}.json")
        ext=game.get("external_ids") if isinstance(game.get("external_ids"),dict) else {}
        rawg=str(ext.get("rawg") or "").strip()
        if rawg:external_groups.setdefault(("rawg",rawg),[]).append(sid)
    for members in external_groups.values():
        for other in members[1:]:union(members[0],other)

    # A short optical/mastering label can be an acronym of the full retail
    # database title (cod2 <-> Call of Duty 2). Only aliases of four or more
    # characters participate so generic two/three-letter abbreviations do not
    # collapse unrelated games.
    alias_groups={}
    for sid in ids:
        for alias in _catalog_record_identity_aliases(sid):
            alias_groups.setdefault(alias,[]).append(sid)
    for members in alias_groups.values():
        members=list(dict.fromkeys(members))
        for other in members[1:]:union(members[0],other)

    # A preserved non-compilation optical fingerprint/bundle cannot represent
    # two different single-title games. Compilation discs are explicitly
    # excluded because sharing one anthology disc is expected there.
    source_groups={}
    for sid,sources in mapping.items():
        for source in sources:
            if str(source.get("layout") or "").casefold()=="compilation":
                continue
            fp=str(source.get("fingerprint") or "").strip()
            bundle=str(source.get("bundle") or "").strip()
            if fp:source_groups.setdefault(("fingerprint",fp),[]).append(sid)
            elif bundle:source_groups.setdefault(("bundle",bundle),[]).append(sid)
    for members in source_groups.values():
        members=list(dict.fromkeys(members))
        for other in members[1:]:union(members[0],other)

    # Keep the old title-family convergence, but preserve genuinely distinct
    # user-confirmed editions unless a stronger relation above already links them.
    family_groups: dict[str,list[str]]={}
    for sid in ids:
        key=catalog_family_key(load_json(SETS/f"{sid}.json").get("title"))
        if key:family_groups.setdefault(key,[]).append(sid)
    for members in family_groups.values():
        if len(members)<2:continue
        explicit=set()
        for sid in members:
            g=load_json(SETS/f"{sid}.json")
            edition=norm_title(str(g.get("edition") or ""))
            profile=g.get("metadata_profile") if isinstance(g.get("metadata_profile"),dict) else {}
            if edition and (g.get("user_confirmed") or profile.get("selected_by_user")):
                explicit.add(edition)
        if len(explicit)<=1:
            for other in members[1:]:union(members[0],other)

    groups={}
    for sid in ids:groups.setdefault(find(sid),[]).append(sid)
    for members in groups.values():
        if len(members)<2:continue
        group_sources=[]
        for sid in members:
            group_sources.extend(mapping.get(sid,[]))
        group_disc_count=logical_disc_count(group_sources,[]) if group_sources else 0
        member_set=set(members)
        # Preserve an already-established canonical UUID.  A canonical record
        # normally remembers its former siblings in merged_set_ids; v0.18.63/64
        # could temporarily clear its setup runtime and let a previously hidden
        # sibling win the score, producing two synthetic setup trees and stale
        # Wolf setup apps.  Historical canonical ownership outranks transient
        # runtime scoring.
        historical=[]
        for candidate in members:
            g=load_json(SETS/f"{candidate}.json")
            merged={str(x) for x in g.get("merged_set_ids") or [] if str(x)}
            if merged & (member_set-{candidate}) and not g.get("superseded_by"):
                historical.append(candidate)
        visible=[]
        for candidate in members:
            g=load_json(SETS/f"{candidate}.json")
            st=load_json(state_path(candidate))
            if not g.get("catalog_hidden") and not g.get("superseded_by") and not st.get("catalog_hidden") and not st.get("duplicate_of"):
                visible.append(candidate)
        pool = historical if len(historical)==1 else (visible if len(visible)==1 else members)
        canonical=max(pool,key=lambda sid:_duplicate_set_score(sid,len(mapping.get(sid,[])),group_disc_count))
        canonical_game=_merge_duplicate_user_metadata(canonical,members)
        if canonical_game:
            save_json(SETS/f"{canonical}.json",canonical_game)
        canonical_title=str(canonical_game.get("title") or load_json(SETS/f"{canonical}.json").get("title") or "")
        merged=[];seen=set()
        for sid in members:
            for source in mapping.get(sid,[]):
                token=(str(source.get("fingerprint") or ""),str(source.get("bundle") or ""),tuple(source.get("source_paths") or []))
                if token in seen:continue
                seen.add(token);merged.append(source)
            if sid==canonical:continue
            aliases[sid]=canonical
            _rewrite_duplicate_media_ownership(sid,canonical,mapping.get(sid,[]),canonical_title)
            game=load_json(SETS/f"{sid}.json")
            if game:
                game["superseded_by"]=canonical
                game["catalog_hidden"]=True
                game["superseded_at"]=now()
                save_json(SETS/f"{sid}.json",game)
            st=load_json(state_path(sid))
            if st:
                state_update(sid,catalog_hidden=True,duplicate_of=canonical,stream_state="superseded",stream_app_title=None,
                             detail=f"Duplicate title record consolidated into {canonical}; install data retained for recovery")
        canonical_game=load_json(SETS/f"{canonical}.json")
        if canonical_game:
            canonical_game.pop("superseded_by",None);canonical_game["catalog_hidden"]=False
            old=[str(x) for x in canonical_game.get("merged_set_ids") or [] if str(x)]
            canonical_game["merged_set_ids"]=list(dict.fromkeys(old+[sid for sid in members if sid!=canonical]))[-32:]
            canonical_game=_rebuild_canonical_disc_inventory(canonical,canonical_game)
            canonical_game["updated_at"]=now();save_json(SETS/f"{canonical}.json",canonical_game)
        # Keep the install-state visibility invariant in sync with the canonical
        # game record.  Older duplicate consolidation only unhid the set metadata,
        # leaving catalog_hidden/duplicate_of behind in game-installs/<id>.json.
        # The portal treats those state flags as authoritative and could therefore
        # hide the newly selected canonical title entirely.
        canonical_state=load_json(state_path(canonical))
        if canonical_state and (canonical_state.get("catalog_hidden") or canonical_state.get("duplicate_of")):
            state_update(canonical, catalog_hidden=False, duplicate_of=None)
            log(f"recovered stale canonical catalog visibility for {canonical} ({canonical_title or 'PC game'})")
        mapping[canonical]=merged
        for sid in members:
            if sid!=canonical:mapping.pop(sid,None)
        log(f"catalog linked duplicates consolidated {len(members)} records -> {canonical} ({canonical_title or 'PC game'})")
    return mapping,aliases


def http_json(url: str, timeout: float = 6.0) -> dict:
    req = urllib.request.Request(url, headers={"User-Agent": f"PCGameArchive/{VERSION}", "Accept": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        raw = resp.read(2 * 1024 * 1024)
    obj = json.loads(raw.decode("utf-8", "replace") or "{}")
    return obj if isinstance(obj, dict) else {}


def _pcgw_identity_due(game: dict) -> bool:
    probe = game.get("identity_probe") if isinstance(game.get("identity_probe"), dict) else {}
    if str(probe.get("title_norm") or "") != norm_title(str(game.get("title") or "")):
        return True
    raw = str(probe.get("checked_at") or "").strip()
    if not raw:
        return True
    try:
        checked = dt.datetime.fromisoformat(raw.replace("Z", "+00:00"))
        if checked.tzinfo is None:
            checked = checked.replace(tzinfo=dt.timezone.utc)
        age = dt.datetime.now(dt.timezone.utc) - checked
    except Exception:
        return True
    return age >= (dt.timedelta(days=30) if probe.get("status") == "matched" else dt.timedelta(hours=6))


def _pcgw_opensearch(query: str) -> list[str]:
    env = load_env(METADATA_ENV)
    ua = env.get("PCGA_METADATA_USER_AGENT") or f"PCGameArchive/{VERSION} (local appliance metadata resolver)"
    params = urllib.parse.urlencode({
        "action": "opensearch", "search": query, "redirects": "resolve",
        "limit": "8", "format": "json",
    })
    req = urllib.request.Request(
        "https://www.pcgamingwiki.com/w/api.php?" + params,
        headers={"User-Agent": ua, "Accept": "application/json"},
    )
    with urllib.request.urlopen(req, timeout=7) as resp:
        raw = resp.read(1024 * 1024)
    obj = json.loads(raw.decode("utf-8", "replace") or "[]")
    if not isinstance(obj, list) or len(obj) < 2 or not isinstance(obj[1], list):
        return []
    blocked = ("Series:", "Company:", "Engine:", "Category:", "Template:", "User:", "PCGamingWiki:")
    return [str(x) for x in obj[1] if str(x).strip() and not str(x).startswith(blocked)]


def _identity_match_score(hint: str, candidate: str) -> float:
    h = metadata_title_core(hint)
    c = metadata_title_core(candidate)
    if not h or not c:
        return 0.0
    if h == c:
        score = 1.0
    else:
        hs, cs = set(h.split()), set(c.split())
        if hs and hs.issubset(cs):
            score = 0.65 + 0.20 * (len(hs) / max(1, len(cs)))
        else:
            score = 0.62 * (len(hs & cs) / max(1, len(hs | cs)))
    if not any(tok in norm_title(candidate).split() for tok in _METADATA_EDITION_TOKENS):
        score += 0.04
    return min(1.0, score)


def pcgw_resolve_identity(game: dict, sources: list[dict]) -> tuple[dict, str]:
    """Resolve provisional/weak optical names to a canonical PC game title.

    PCGamingWiki's anonymous MediaWiki opensearch endpoint is used only for
    identity resolution. The result must beat a conservative score and margin;
    otherwise the local title remains untouched for manual review.
    """
    title = str(game.get("title") or "").strip()
    # A user-confirmed normal title always wins. Weak legacy labels are allowed
    # through even if an older release accidentally marked the record final.
    if (game.get("user_confirmed") is True or (game.get("provisional") is False and game.get("source") != "user-upload")) and not weak_source_title(title):
        game["identity_probe"] = {"provider":"pcgamingwiki","status":"skipped-confirmed","title_norm":norm_title(title),"checked_at":now()}
        return game, "skipped-confirmed"
    hints: list[str] = []
    def add(v: str) -> None:
        v = clean_source_title(v)
        if v and not generic_game_title(v) and v not in hints:
            hints.append(v)
    add(title)
    intrinsic = best_intrinsic_source_title(sources)
    add(intrinsic)
    # Once preserved-media evidence has produced a strong intrinsic identity, do
    # not let stale generated sidecars or unrelated bundled demo executables
    # compete as equal provider queries.  Broader source hints are used only when
    # the intrinsic signal is absent/weak, or when they are compatible with it.
    for src in sources:
        for value in source_identity_candidates(src):
            if not intrinsic or weak_source_title(intrinsic) or titles_compatible(value, intrinsic):
                add(value)
    # Favor product-like/local application hints over weak optical labels while
    # preserving insertion order for equally concise hints.
    hints.sort(key=lambda x: (weak_source_title(x), len(norm_title(x).split()), len(x)))
    scored: list[tuple[float, str, str]] = []
    queried = []
    try:
        for hint in hints[:5]:
            query = hint
            if weak_source_title(hint):
                query = re.sub(r"(?i)(?:[-_ ]+(?:cd|dvd|disc|disk)(?:[-_ ]*\d+)?)$", "", hint).strip(" -_")
            if len(norm_title(query)) < 4 or query in queried:
                continue
            queried.append(query)
            for candidate in _pcgw_opensearch(query):
                score = _identity_match_score(query, candidate)
                if score >= 0.68:
                    scored.append((score, candidate, query))
        if not scored:
            game["identity_probe"] = {"provider":"pcgamingwiki","status":"no-confident-match","title_norm":norm_title(title),"queries":queried,"checked_at":now()}
            return game, "no-confident-match"
        scored.sort(key=lambda x: (-x[0], len(metadata_title_core(x[1]).split()), len(x[1]), x[1].casefold()))
        best = scored[0]
        second = scored[1][0] if len(scored) > 1 else 0.0
        if best[0] < 0.74 or (best[0] - second < 0.025 and norm_title(best[1]) != norm_title(best[2])):
            game["identity_probe"] = {"provider":"pcgamingwiki","status":"ambiguous","title_norm":norm_title(title),"queries":queried,"candidates":[{"title":x[1],"score":round(x[0],3)} for x in scored[:5]],"checked_at":now()}
            return game, "ambiguous"
        canonical = best[1]
        changed = norm_title(canonical) != norm_title(title)
        if changed:
            _invalidate_provider_metadata(game)
            game["title"] = canonical
            game["sort_title"] = canonical
            game["normalized_title"] = norm_title(canonical)
            game["identity_source"] = "pcgamingwiki-opensearch"
            game["identity_confidence"] = round(best[0], 3)
            ext = dict(game.get("external_ids") or {})
            ext["pcgamingwiki"] = canonical
            game["external_ids"] = ext
            game["updated_at"] = now()
        game["identity_probe"] = {"provider":"pcgamingwiki","status":"matched","title_norm":norm_title(game.get("title") or canonical),"query":best[2],"matched_title":canonical,"confidence":round(best[0],3),"checked_at":now()}
        return game, "matched"
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError, OSError) as exc:
        game["identity_probe"] = {"provider":"pcgamingwiki","status":"network-"+type(exc).__name__,"title_norm":norm_title(title),"checked_at":now()}
        return game, "network-" + type(exc).__name__
    except Exception as exc:
        game["identity_probe"] = {"provider":"pcgamingwiki","status":"error-"+type(exc).__name__,"title_norm":norm_title(title),"checked_at":now()}
        return game, "error-" + type(exc).__name__


def download(url: str, dest: Path, max_bytes: int = 12 * 1024 * 1024) -> bool:
    if not url.lower().startswith(("https://", "http://")):
        return False
    try:
        req = urllib.request.Request(url, headers={"User-Agent": f"PCGameArchive/{VERSION}"})
        with urllib.request.urlopen(req, timeout=10) as resp:
            ctype = str(resp.headers.get("Content-Type") or "")
            data = resp.read(max_bytes + 1)
        if len(data) > max_bytes or not data:
            return False
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_bytes(data)
        (dest.with_suffix(dest.suffix + ".content-type")).write_text(ctype + "\n")
        return True
    except Exception:
        return False


def metadata_due(game: dict) -> bool:
    """Bound metadata traffic from the periodic reconciler.

    Successful profiles refresh roughly monthly; unsuccessful/network probes retry
    after six hours. A title change always invalidates the previous lookup.
    A profile explicitly selected by the user from a game database is authoritative;
    Steam may still be used indirectly by compatibility tooling, but it must not
    replace that selected descriptive profile.
    """
    selected = game.get("metadata_profile") if isinstance(game.get("metadata_profile"), dict) else {}
    if selected.get("locked_by_user") is True:
        return False
    probe = game.get("metadata_probe") if isinstance(game.get("metadata_probe"), dict) else {}
    if str(probe.get("title_norm") or "") != norm_title(str(game.get("title") or "")):
        return True
    raw = str(probe.get("checked_at") or "").strip()
    if not raw:
        return True
    try:
        checked = dt.datetime.fromisoformat(raw.replace("Z", "+00:00"))
        if checked.tzinfo is None:
            checked = checked.replace(tzinfo=dt.timezone.utc)
        age = dt.datetime.now(dt.timezone.utc) - checked
    except Exception:
        return True
    matched = isinstance(game.get("metadata_match"), dict) and bool(game.get("metadata_match"))
    return age >= (dt.timedelta(days=30) if matched else dt.timedelta(hours=6))


def stamp_metadata_probe(game: dict, result: str) -> dict:
    game["metadata_probe"] = {"provider": "steam-store", "status": result, "title_norm": norm_title(str(game.get("title") or "")), "checked_at": now()}
    return game


def steam_enrich(game: dict) -> tuple[dict, str]:
    """Best-effort no-key Steam Store metadata enrichment.

    A conservative exact/near-exact title match is required. This is enrichment,
    never a prerequisite for preservation or installation.
    """
    title = str(game.get("title") or "").strip()
    if not title or title.lower().startswith("unidentified"):
        return game, "skipped-unidentified"
    env = load_env(METADATA_ENV)
    if env.get("PCGA_STEAM_STORE_METADATA", "1").lower() in {"0", "false", "no", "off"}:
        return game, "disabled"
    try:
        q = urllib.parse.urlencode({"term": title, "l": env.get("PCGA_METADATA_LANGUAGE", "english"), "cc": env.get("PCGA_METADATA_COUNTRY", "US")})
        search = http_json("https://store.steampowered.com/api/storesearch/?" + q)
        candidates = search.get("items") if isinstance(search.get("items"), list) else []
        target_norm = norm_title(title)
        target_core = metadata_title_core(title)
        scored = []
        for item in candidates[:12]:
            if not isinstance(item, dict): continue
            name = str(item.get("name") or "")
            cand_norm = norm_title(name)
            if not cand_norm: continue
            cand_core = metadata_title_core(name)
            # Exact title is safest. A candidate differing only by explicit edition
            # words can still provide useful synopsis/art, but edition-specific
            # release/developer data is not allowed to overwrite the original game.
            relation = "exact"
            if target_norm == cand_norm:
                score = 1.0
            elif target_core and target_core == cand_core:
                score = 0.88; relation = "related-edition"
            else:
                a, b = set(target_norm.split()), set(cand_norm.split())
                score = len(a & b) / max(1, len(a | b))
                relation = "near-title"
            if score >= 0.74:
                scored.append((score, relation, item))
        if not scored:
            return game, "no-confident-match"
        scored.sort(key=lambda x: x[0], reverse=True)
        score, relation, item = scored[0]
        appid = str(item.get("id") or "")
        if not appid:
            return game, "no-appid"
        details = http_json("https://store.steampowered.com/api/appdetails?" + urllib.parse.urlencode({"appids": appid, "l": env.get("PCGA_METADATA_LANGUAGE", "english"), "cc": env.get("PCGA_METADATA_COUNTRY", "US")}))
        entry = details.get(appid) if isinstance(details.get(appid), dict) else {}
        data = entry.get("data") if entry.get("success") and isinstance(entry.get("data"), dict) else {}
        if not data:
            return game, "details-unavailable"
        # Do not overwrite deliberate local/user metadata with empty provider data.
        desc = re.sub(r"<[^>]+>", " ", str(data.get("short_description") or ""))
        desc = re.sub(r"\s+", " ", desc).strip()
        if desc and not game.get("description"):
            game["description"] = desc
        about = re.sub(r"<[^>]+>", " ", str(data.get("about_the_game") or ""))
        about = re.sub(r"\s+", " ", about).strip()
        if about and not game.get("marketing_description"):
            game["marketing_description"] = about[:12000]
        rd = data.get("release_date") if isinstance(data.get("release_date"), dict) else {}
        devs = [str(x) for x in data.get("developers") or [] if str(x).strip()]
        pubs = [str(x) for x in data.get("publishers") or [] if str(x).strip()]
        if relation != "related-edition":
            if rd.get("date") and not game.get("release_date"):
                game["release_date"] = rd.get("date")
            if not game.get("release_year"):
                m = re.search(r"\b(19|20)\d{2}\b", str(rd.get("date") or ""))
                if m: game["release_year"] = int(m.group(0))
            if devs and not game.get("developer"): game["developer"] = ", ".join(devs[:4])
            if pubs and not game.get("publisher"): game["publisher"] = ", ".join(pubs[:4])
        genres = [str(x.get("description")) for x in data.get("genres") or [] if isinstance(x, dict) and x.get("description")]
        cats = [str(x.get("description")) for x in data.get("categories") or [] if isinstance(x, dict) and x.get("description")]
        if genres: game["genres"] = genres[:12]
        if cats: game["categories"] = cats[:16]
        if data.get("website"): game["website"] = data.get("website")
        ext = dict(game.get("external_ids") or {}); ext["steam"] = appid; game["external_ids"] = ext
        marketing = dict(game.get("marketing_assets") or {})
        if data.get("header_image"): marketing["header_remote"] = data["header_image"]
        if data.get("capsule_image"): marketing["cover_remote"] = data["capsule_image"]
        screens = []
        for row in data.get("screenshots") or []:
            if isinstance(row, dict) and row.get("path_full"): screens.append(str(row["path_full"]))
        if screens: marketing["screenshots_remote"] = screens[:6]
        game["marketing_assets"] = marketing
        game["metadata_match"] = {"provider": "steam-store", "id": appid, "confidence": round(score, 3), "relation": relation, "matched_title": data.get("name") or item.get("name"), "updated_at": now()}

        asset_dir = ASSETS / str(game.get("id"))
        local = dict(marketing.get("local") or {})
        cover_url = marketing.get("cover_remote") or marketing.get("header_remote")
        if cover_url:
            suffix = ".jpg" if ".jpg" in str(cover_url).lower() or ".jpeg" in str(cover_url).lower() else ".img"
            cover = asset_dir / ("cover" + suffix)
            if download(str(cover_url), cover): local["cover"] = str(cover)
        if marketing.get("header_remote"):
            header = asset_dir / "hero.jpg"
            if download(str(marketing["header_remote"]), header): local["hero"] = str(header)
        local_screens = []
        for idx, url in enumerate(screens[:4], 1):
            p = asset_dir / f"screenshot-{idx}.jpg"
            if download(url, p): local_screens.append(str(p))
        if local_screens: local["screenshots"] = local_screens
        marketing["local"] = local; game["marketing_assets"] = marketing
        game["updated_at"] = now()
        return game, "matched"
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError, OSError) as exc:
        return game, "network-" + type(exc).__name__
    except Exception as exc:
        return game, "error-" + type(exc).__name__


@contextlib.contextmanager
def mounted_iso(iso: Path, target: Path):
    target.mkdir(parents=True, exist_ok=True)
    subprocess.run(["umount", str(target)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    proc = subprocess.run(["mount", "-o", "loop,ro,nosuid,nodev", str(iso), str(target)], capture_output=True, text=True)
    if proc.returncode != 0:
        raise RuntimeError("mount failed: " + (proc.stderr.strip() or proc.stdout.strip())[:240])
    try:
        yield target
    finally:
        subprocess.run(["umount", str(target)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)


def source_isos(sources: list[dict]) -> list[Path]:
    """Return one preserved ISO for each logical optical disc.

    A game can have more than one preserved *copy* of the same physical disc
    (for example after re-ripping or re-importing it).  Older releases counted
    raw ISO paths and therefore reported a false multi-disc game whenever two
    bundles carrying the same fingerprint mapped to one game_set_id.  Prefer
    optical fingerprints, then explicit disc numbers, before falling back to a
    path identity so duplicate preservation never turns into a disc-change
    requirement.
    """
    rows: list[tuple[int, Path]] = []
    seen: set[tuple[str, str]] = set()
    for src in sources:
        b = Path(str(src.get("bundle") or ""))
        if not b.exists():
            continue
        try:
            disc_no = int(src.get("disc_number")) if src.get("disc_number") is not None else None
        except (TypeError, ValueError):
            disc_no = None
        fingerprint = str(src.get("fingerprint") or "").strip().lower()
        collection = str(src.get("collection_id") or "").strip().lower()
        candidates = [b] if b.is_file() else [q for q in b.iterdir() if q.is_file()]
        for iso in sorted((q for q in candidates if q.suffix.lower() == ".iso"), key=lambda q: q.name.lower()):
            if fingerprint:
                key = ("fingerprint", fingerprint)
            elif disc_no is not None:
                key = ("disc-number", f"{collection}:{disc_no}")
            else:
                try:
                    key = ("path", str(iso.resolve()))
                except OSError:
                    key = ("path", str(iso))
            if key in seen:
                log(f"ignoring duplicate preserved ISO for logical disc: {iso}")
                continue
            seen.add(key)
            rows.append((disc_no if disc_no is not None else 9999, iso))
    rows.sort(key=lambda x: (x[0], x[1].name.lower()))
    return [q for _, q in rows]


def persisted_media_isos(state: dict) -> list[Path]:
    """Return surviving preserved ISO paths from an already-materialized state.

    Canonicalization can move optical intake ownership away from a launchable
    record while leaving its runtime-media inventory intact.  Setup recovery
    must not erase that inventory merely because the current source scan is
    empty.
    """
    out: list[Path] = []
    seen: set[str] = set()
    for value in state.get("source_isos") or []:
        q = Path(str(value or ""))
        if q.is_file():
            key = str(q.resolve()) if q.exists() else str(q)
            if key not in seen:
                seen.add(key); out.append(q)
    for row in state.get("runtime_media") or []:
        if not isinstance(row, dict):
            continue
        q = Path(str(row.get("iso") or ""))
        if q.is_file():
            key = str(q.resolve()) if q.exists() else str(q)
            if key not in seen:
                seen.add(key); out.append(q)
    return out


def persisted_disc_count(state: dict, isos: list[Path]) -> int:
    discs=set()
    for row in state.get("runtime_media") or []:
        if not isinstance(row, dict):
            continue
        try:
            n=int(row.get("disc") or 0)
        except (TypeError, ValueError):
            n=0
        if n>0:
            discs.add(n)
    try:
        stored=int(state.get("source_logical_disc_count") or 0)
    except (TypeError, ValueError):
        stored=0
    return max(len(isos), len(discs), stored)


def stage_multidisc_installer_from_isos(set_id: str, install_dir: Path, isos: list[Path], disc_count: int) -> dict:
    """Find the strongest vendor bootstrapper across every preserved disc.

    Historical canonical records can retain the right media but in a bad logical
    order.  Scanning only runtime disc 1 left COD2 demoted to setup-required
    without any setup source.  Search every preserved member, then make the disc
    containing the best bootstrapper the active D: for initial setup.
    """
    choices=[]
    root=Path("/run/pcga-game-installer") / set_id / "multi-disc-bootstrap-scan"
    for idx, iso in enumerate(isos, 1):
        mountpoint=root / f"disc{idx}"
        try:
            with mounted_iso(iso, mountpoint) as src:
                cand=scan_installers(src)
                rel=str(cand.get("relative") or "").replace("\\", "/")
                kind=str(cand.get("kind") or "none")
                if not rel or kind in {"none", "portable-candidate"}:
                    continue
                target=src/rel
                if not target.is_file():
                    continue
                score=int(cand.get("selection_score") or 0)
                # Favor explicit autorun/vendor bootstrappers over payload MSIs.
                if kind == "autorun-bootstrap": score += 1000
                elif kind in {"bootstrap-exe", "installshield", "inno", "nsis"}: score += 500
                elif kind == "msi": score -= 100
                choices.append((score, idx, iso, dict(cand)))
        except Exception as exc:
            log(f"multi-disc bootstrap scan skipped {iso}: {type(exc).__name__}: {exc}")
    if not choices:
        return state_update(
            set_id, status="setup-required", phase="installer",
            launch_executable=None, runtime_image=None, runtime_build_hash=None,
            setup_source=None, setup_installer=None, setup_runtime_image=None,
            setup_runtime_build_hash=None, stream_state="pending", stream_app_title=None,
            install_method=None, setup_reason="multi-disc-installer-unidentified",
            setup_disc_count=disc_count, source_isos=[str(x) for x in isos],
            source_logical_disc_count=disc_count,
            detail=f"{disc_count}-disc title preserved, but no safe vendor bootstrapper was identified on any attached disc",
        )
    choices.sort(key=lambda x: (-x[0], x[1]))
    _, idx, iso, candidate=choices[0]
    mountpoint=root / "selected"
    with mounted_iso(iso, mountpoint) as src:
        # Re-scan the selected mount so every stored path is relative to the
        # source tree that is actually copied into setup-source.
        candidate=scan_installers(src)
        candidate["source_path"]="."
        candidate["media_disc"]=idx
        staged=prepare_interactive_source(set_id, install_dir, src, candidate)
    return state_update(
        set_id, status="setup-required", phase="interactive-setup",
        setup_reason="multi-disc", setup_kind=candidate.get("kind"),
        setup_disc_count=disc_count, setup_bootstrap_disc=idx, runtime_active_disc=idx,
        source_isos=[str(x) for x in isos], source_logical_disc_count=disc_count,
        installer=candidate, install_method=None, launch_executable=None,
        runtime_image=None, runtime_build_hash=None, stream_state="pending", stream_app_title=None,
        detail=f"{disc_count}-disc installer set staged from preserved media disc slot {idx} through {Path(str(candidate.get('relative') or '')).name}",
    )


def _runtime_media_backing_file(target: Path) -> str:
    """Return the file backing a mounted optical image when it can be resolved."""
    proc = subprocess.run(
        ["findmnt", "-rn", "-o", "SOURCE", "--target", str(target)],
        capture_output=True, text=True, timeout=5,
    )
    source = proc.stdout.strip() if proc.returncode == 0 else ""
    if not source:
        return ""
    if source.startswith("/dev/loop") and shutil.which("losetup"):
        loop = subprocess.run(
            ["losetup", "-n", "-O", "BACK-FILE", source],
            capture_output=True, text=True, timeout=5,
        )
        if loop.returncode == 0 and loop.stdout.strip():
            return loop.stdout.strip().removesuffix(" (deleted)")
    return source


def _runtime_media_source_device(target: Path) -> str:
    """Return the host block device backing an active optical loop mount.

    Wine distinguishes a real CD-ROM from a directory drive partly through the
    DOS-device `X::` mapping.  A preserved ISO bind mount is only a regular file;
    expose the read-only host loop block device to the Wolf child instead.
    """
    proc = subprocess.run(
        ["findmnt", "-rn", "-o", "SOURCE", "--target", str(target)],
        capture_output=True, text=True, timeout=5,
    )
    source = proc.stdout.strip() if proc.returncode == 0 else ""
    if source.startswith("/dev/loop") and Path(source).exists():
        return source
    return ""


def _cdemu_run(*args: str, timeout: int = 20) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["cdemu", "--bus", "system", *args],
        capture_output=True,
        text=True,
        timeout=timeout,
    )


def _parse_cdemu_device_mapping(text: str, device_index: int = CDEMU_DEVICE_INDEX) -> tuple[str, str]:
    """Extract /dev/srN and /dev/sgN from cdemu's locale-independent table rows."""
    for raw in str(text or "").splitlines():
        m = re.match(rf"^\s*{int(device_index)}\s+(/dev/sr\d+)\s+(/dev/sg\d+)", raw)
        if m:
            return m.group(1), m.group(2)
    return "", ""


def _scan_cdemu_sysfs_mapping() -> tuple[str, str]:
    """Resolve CDEmu's virtual optical node without depending on client table formatting."""
    root = Path("/sys/class/block")
    if not root.exists():
        return "", ""
    for entry in sorted(root.glob("sr*"), key=lambda x: x.name):
        try:
            vendor = (entry / "device/vendor").read_text(errors="replace").strip()
        except OSError:
            vendor = ""
        try:
            model = (entry / "device/model").read_text(errors="replace").strip()
        except OSError:
            model = ""
        if "cdemu" not in f"{vendor} {model}".casefold():
            continue
        sr = f"/dev/{entry.name}"
        sg = ""
        generic = entry / "device/generic"
        try:
            resolved = generic.resolve(strict=True)
            if resolved.name.startswith("sg") and Path("/dev", resolved.name).exists():
                sg = f"/dev/{resolved.name}"
        except OSError:
            pass
        if Path(sr).exists():
            return sr, sg
    return "", ""


def _cdemu_failure_context() -> str:
    rows: list[str] = []
    probes = [
        (["systemctl", "is-active", CDEMU_SERVICE], "service"),
        (["modinfo", "-F", "version", "vhba"], "vhba"),
        (["dkms", "status"], "dkms"),
    ]
    for cmd, label in probes:
        if not shutil.which(cmd[0]):
            continue
        try:
            proc = subprocess.run(cmd, capture_output=True, text=True, timeout=8)
        except Exception as exc:
            rows.append(f"{label}={type(exc).__name__}")
            continue
        value = (proc.stdout.strip() or proc.stderr.strip()).replace("\n", "; ")
        if value:
            rows.append(f"{label}={value[:500]}")
    if shutil.which("journalctl"):
        try:
            proc = subprocess.run(
                ["journalctl", "-u", CDEMU_SERVICE, "-n", "12", "--no-pager", "-o", "cat"],
                capture_output=True, text=True, timeout=8,
            )
            value = (proc.stdout.strip() or proc.stderr.strip()).replace("\n", " | ")
            if value:
                rows.append("journal=" + value[-1800:])
        except Exception:
            pass
    return " ; ".join(rows)[-3000:]


def _prepare_cod2_cdemu_optical(set_id: str, iso: Path) -> dict:
    """Load preserved COD2CD1 into CDEmu and return its virtual optical node.

    Wine D: remains the existing read-only ISO filesystem mount. CDEmu supplies
    only SP's low-level D:: optical device. Multiplayer never consumes this
    mapping. If host CDEmu is unavailable, state records the reason and SP can
    safely fall back to the already-proven loop device rather than killing the
    Wolf stream.
    """
    result = {
        "status": "unavailable",
        "device_index": CDEMU_DEVICE_INDEX,
        "image": str(iso),
        "prepared_at": now(),
        "kernel": os.uname().release,
    }
    if not iso.is_file():
        result["detail"] = "COD2CD1 ISO is missing"
        return result
    missing = [name for name in ("cdemu", "modprobe", "systemctl") if not shutil.which(name)]
    if missing:
        result["detail"] = "CDEmu host tools are unavailable: " + ", ".join(missing)
        return result

    bootstrap = Path("/usr/local/sbin/pcga-cdemu-bootstrap")
    if bootstrap.is_file():
        try:
            boot = subprocess.run([str(bootstrap)], capture_output=True, text=True, timeout=90)
        except Exception as exc:
            result["detail"] = f"CDEmu VHBA bootstrap raised {type(exc).__name__}: {str(exc)[:300]}"
            return result
        if boot.returncode != 0:
            detail = (boot.stderr.strip() or boot.stdout.strip()).replace("\n", " | ")
            result["detail"] = "VHBA bootstrap failed: " + detail[-1200:]
            context = _cdemu_failure_context()
            if context:
                result["host_context"] = context
            return result
    else:
        mod = subprocess.run(["modprobe", "vhba"], capture_output=True, text=True, timeout=20)
        if mod.returncode != 0 or not Path("/dev/vhba_ctl").exists():
            result["detail"] = "vhba kernel module could not be loaded: " + (mod.stderr.strip() or mod.stdout.strip())[:500]
            return result

    if not Path("/dev/vhba_ctl").exists():
        result["detail"] = "vhba loaded but /dev/vhba_ctl is missing"
        return result
    if shutil.which("modinfo"):
        probe = subprocess.run(["modinfo", "-F", "version", "vhba"], capture_output=True, text=True, timeout=5)
        result["vhba_version"] = probe.stdout.strip()[:64]

    subprocess.run(["systemctl", "reset-failed", CDEMU_SERVICE], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    svc = subprocess.run(["systemctl", "start", CDEMU_SERVICE], capture_output=True, text=True, timeout=30)
    if svc.returncode != 0:
        result["detail"] = f"{CDEMU_SERVICE} could not start: " + (svc.stderr.strip() or svc.stdout.strip())[:500]
        context = _cdemu_failure_context()
        if context:
            result["host_context"] = context
        return result

    ready = False
    last_status = ""
    st = None
    for _ in range(40):
        try:
            st = _cdemu_run("status", timeout=5)
        except Exception as exc:
            last_status = str(exc)
        else:
            last_status = (st.stderr.strip() or st.stdout.strip())[:500]
            if st.returncode == 0:
                ready = True
                break
        time.sleep(0.25)
    if not ready or st is None:
        result["detail"] = "CDEmu system-bus daemon did not become ready: " + last_status
        context = _cdemu_failure_context()
        if context:
            result["host_context"] = context
        return result

    # Device 0 is appliance-owned. Avoid replacing an already-correct image so
    # the one-minute orchestrator timer cannot disturb an active SP session.
    status_text = st.stdout or ""
    already_loaded = any(
        re.match(rf"^\s*{CDEMU_DEVICE_INDEX}\s+", line) and str(iso) in line
        for line in status_text.splitlines()
    )
    if not already_loaded:
        load = _cdemu_run("load", "--replace", str(CDEMU_DEVICE_INDEX), str(iso), timeout=45)
        if load.returncode != 0:
            result["status"] = "error"
            result["detail"] = "CDEmu failed to load COD2CD1 ISO: " + (load.stderr.strip() or load.stdout.strip())[:800]
            return result

    feature_results = {}
    for command in ("bad-sector-emulation", "dpm-emulation"):
        try:
            proc = _cdemu_run(command, str(CDEMU_DEVICE_INDEX), "1", timeout=8)
            feature_results[command] = proc.returncode == 0
        except Exception:
            feature_results[command] = False

    if shutil.which("udevadm"):
        subprocess.run(["udevadm", "settle", "--timeout=10"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)

    sr = sg = ""
    mapping_text = ""
    for _ in range(40):
        try:
            mapping = _cdemu_run("device-mapping", timeout=5)
        except Exception as exc:
            mapping_text = str(exc)
        else:
            mapping_text = (mapping.stdout or "") + "\n" + (mapping.stderr or "")
            if mapping.returncode == 0:
                sr, sg = _parse_cdemu_device_mapping(mapping_text, CDEMU_DEVICE_INDEX)
        if not sr or not Path(sr).exists():
            sr, sg_scan = _scan_cdemu_sysfs_mapping()
            if sg_scan:
                sg = sg_scan
        if sr and Path(sr).exists():
            break
        time.sleep(0.25)
    if not sr or not Path(sr).exists():
        result["status"] = "error"
        result["detail"] = "CDEmu daemon is running but no virtual /dev/srN optical node appeared"
        result["device_mapping"] = mapping_text[-1200:]
        context = _cdemu_failure_context()
        if context:
            result["host_context"] = context
        return result

    label = ""
    if shutil.which("blkid"):
        for _ in range(30):
            probe = subprocess.run(
                ["blkid", "-p", "-s", "LABEL", "-o", "value", sr],
                capture_output=True, text=True, timeout=5,
            )
            if probe.returncode == 0 and probe.stdout.strip():
                label = probe.stdout.strip()[:96]
                break
            time.sleep(0.25)
    if label.casefold() != "cod2cd1":
        result["status"] = "error"
        result["device"] = sr
        result["sg_device"] = sg
        result["label"] = label
        result["detail"] = f"CDEmu virtual CD-ROM label mismatch: expected COD2CD1, got {label or 'unlabelled'}"
        return result

    result.update({
        "status": "ready",
        "device": sr,
        "sg_device": sg if sg and Path(sg).exists() else "",
        "label": label,
        "bad_sector_emulation": bool(feature_results.get("bad-sector-emulation")),
        "dpm_emulation": bool(feature_results.get("dpm-emulation")),
        "detail": "COD2CD1 loaded into CDEmu virtual CD-ROM for single-player D::",
    })
    log(f"{set_id}: CDEmu COD2CD1 ready on {sr}" + (f" ({sg})" if sg else ""))
    return result

def ensure_runtime_media(set_id: str, sources: list[dict], state: dict, game: dict | None = None) -> dict:
    """Present preserved optical images at stable host mountpoints for Wolf.

    Wine's legacy CD-ROM model needs both a directory containing the mounted disc
    and, for reliable volume-label/media detection, access to the corresponding
    raw optical image.  PCGA keeps the preservation ISO authoritative and creates
    only read-only loop mounts under /run; no crack or modified game executable is
    used.  The Wolf app bind-mounts both views into the isolated runtime.
    """
    isos = source_isos(sources)
    if not isos:
        isos = [Path(str(x)) for x in state.get("source_isos") or [] if str(x)]
    isos = [x for x in isos if x.is_file()][:MAX_RUNTIME_MEDIA_DISCS]
    if not isos:
        if state.get("runtime_media") or state.get("runtime_media_errors"):
            return state_update(set_id, runtime_media=[], runtime_media_errors=[])
        return state

    RUNTIME_MEDIA_ROOT.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(RUNTIME_MEDIA_ROOT, 0o755)
    except OSError:
        pass
    set_root = RUNTIME_MEDIA_ROOT / set_id
    set_root.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(set_root, 0o755)
    except OSError:
        pass

    rows: list[dict] = []
    errors: list[str] = []
    for index, iso in enumerate(isos, 1):
        letter = chr(ord("d") + index - 1)
        target = set_root / f"disc{index}"
        target.mkdir(parents=True, exist_ok=True)
        try:
            os.chmod(target, 0o755)
        except OSError:
            pass

        mounted = target.is_mount()
        if mounted:
            try:
                current = _runtime_media_backing_file(target)
            except Exception:
                current = ""
            try:
                same = bool(current) and Path(current).resolve() == iso.resolve()
            except OSError:
                same = current == str(iso)
            if not same:
                proc = subprocess.run(
                    ["umount", str(target)], capture_output=True, text=True, timeout=10
                )
                if proc.returncode != 0:
                    errors.append(
                        f"disc{index}: existing mount could not be replaced: "
                        f"{(proc.stderr.strip() or proc.stdout.strip())[:180]}"
                    )
                    continue
                mounted = False

        if not mounted:
            proc = subprocess.run(
                ["mount", "-o", "loop,ro,nosuid,nodev,noexec", str(iso), str(target)],
                capture_output=True, text=True, timeout=20,
            )
            if proc.returncode != 0:
                errors.append(
                    f"disc{index}: mount failed: "
                    f"{(proc.stderr.strip() or proc.stdout.strip())[:180]}"
                )
                continue

        label = ""
        if shutil.which("blkid"):
            probe = subprocess.run(
                ["blkid", "-p", "-s", "LABEL", "-o", "value", str(iso)],
                capture_output=True, text=True, timeout=8,
            )
            if probe.returncode == 0:
                label = probe.stdout.strip()[:96]
        loop_device = ""
        try:
            loop_device = _runtime_media_source_device(target)
        except Exception:
            loop_device = ""
        if not loop_device:
            errors.append(f"disc{index}: mounted ISO has no discoverable /dev/loop block device")
        rows.append({
            "disc": index,
            "drive_letter": letter,
            "iso": str(iso),
            "mountpoint": str(target),
            "label": label,
            "device": loop_device,
            "disc_role": next((str(x.get("disc_role") or "") for x in sources if x.get("disc_number") == index), ""),
        })

    # v0.18.85 keeps preserved ISO media authoritative. COD2 single-player may
    # additionally load the same COD2CD1 ISO into CDEmu so Wine's D:: points at
    # an emulated MMC/SCSI optical device instead of a generic loop block node.
    # D: itself remains the proven read-only ISO filesystem mount. Multiplayer
    # remains on the previous Wine 9 + loop-backed optical path.
    physical_auth = None
    cdemu_optical = None
    if game and _is_call_of_duty_2(game) and state.get("status") == "ready":
        cod2_row = next((r for r in rows if str(r.get("label") or "").strip().casefold() == "cod2cd1"), None)
        if cod2_row:
            try:
                cdemu_optical = _prepare_cod2_cdemu_optical(set_id, Path(str(cod2_row.get("iso") or "")))
            except Exception as exc:
                cdemu_optical = {
                    "status": "error",
                    "image": str(cod2_row.get("iso") or ""),
                    "prepared_at": now(),
                    "detail": f"{type(exc).__name__}: {str(exc)[:240]}",
                }

    detail = None
    if rows:
        mapped = ", ".join(f"{r['drive_letter'].upper()}:={r.get('label') or 'disc'+str(r['disc'])}" for r in rows)
        detail = f"Preserved optical media prepared for streamed Wine runtime ({mapped})"
    fields = {
        "source_isos": [str(x) for x in isos],
        "runtime_media": rows,
        "runtime_media_errors": errors,
        "runtime_physical_auth": physical_auth,
        "runtime_cdemu_optical": cdemu_optical,
        "runtime_active_disc": int(state.get("runtime_active_disc") or 1) if rows else None,
    }
    if detail and state.get("status") == "ready":
        fields["detail"] = detail
    return state_update(set_id, **fields)


def runtime_media_shell_prelude(state: dict, game: dict | None = None, *, compat_overlay: bool = False, setup_mode: bool = False) -> str:
    """Attach the complete title-owned disc set to Wine.

    D: is the active/swappable optical drive expected by legacy installers. For a
    multi-disc title every member also receives a stable archive mapping beginning
    at E:, so all media remains tied to the same Wolf/Wine session.
    """
    media = state.get("runtime_media") if isinstance(state.get("runtime_media"), list) else []
    virtual = compatibility_virtual_cd(game or {}) if compat_overlay else {}
    if setup_mode and game and _is_call_of_duty_2(game):
        # COD2 setup owns a genuine synthetic COD2DVD optical volume. Never
        # layer the generic Wine .windows-label virtual-CD shim over it.
        virtual = {}
    try: active_disc = int(state.get("runtime_active_disc") or 1)
    except (TypeError, ValueError): active_disc = 1
    valid = []
    for row in media[:MAX_RUNTIME_MEDIA_DISCS]:
        if not isinstance(row, dict): continue
        try: disc=int(row.get("disc") or 0)
        except (TypeError,ValueError): continue
        if disc>0: valid.append(disc)
    if valid and active_disc not in valid: active_disc=valid[0]
    lines: list[str] = ['mkdir -p "$WINEPREFIX/dosdevices"']

    if len(valid) > 1:
        for pos,disc in enumerate(valid):
            letter=chr(ord('e')+pos)
            if letter>'k': break
            root=f"/pcga-media/disc{disc}"; raw=f"/dev/pcga-media-disc{disc}"
            lines += [
                f'rm -f "$WINEPREFIX/dosdevices/{letter}:" "$WINEPREFIX/dosdevices/{letter}::"',
                f'ln -s {shlex.quote(root)} "$WINEPREFIX/dosdevices/{letter}:"',
                f'if [[ -b {shlex.quote(raw)} ]]; then ln -s {shlex.quote(raw)} "$WINEPREFIX/dosdevices/{letter}::"; fi',
                f"wine reg add 'HKEY_LOCAL_MACHINE\\Software\\Wine\\Drives' /v '{letter}:' /t REG_SZ /d cdrom /f /reg:32 >/dev/null 2>&1 || true",
                f"wine reg add 'HKEY_LOCAL_MACHINE\\Software\\Wine\\Drives' /v '{letter}:' /t REG_SZ /d cdrom /f /reg:64 >/dev/null 2>&1 || true",
                f'echo "[pcga-media] title disc {disc} attached as {letter.upper()}: raw=$([[ -b {raw} ]] && echo {raw} || echo unavailable)" >&2',
            ]

    # The North-American retail Call of Duty 2 installer spans six CDs but its
    # MSI reads payload files from one mutable D: source path. Under Wine a plain
    # symlink swap can race the already-running MSI and produce the title's well-
    # known 1603/InstallFiles failure when a requested Setup/Data/main/*.iwd file
    # lives on another CD. For setup only, synthesize the same merged file tree
    # used by established CD-to-DVD conversions: overlay CD6 -> ... -> CD1 so
    # lower-numbered media wins duplicate bootstrap files while every unique data
    # file remains visible at D:. The preserved images remain immutable and each
    # original disc is still available on E:..J: and through the portal controls.
    setup_union = bool(setup_mode and game and _is_call_of_duty_2(game) and len(valid) > 1)
    if setup_union:
        numbered=[]
        for row in media[:MAX_RUNTIME_MEDIA_DISCS]:
            if not isinstance(row, dict):
                continue
            try:
                slot=int(row.get("disc") or 0)
            except (TypeError, ValueError):
                continue
            if slot not in valid:
                continue
            physical=_disc_number_from_volume_label(str(row.get("label") or ""))
            numbered.append((physical if physical is not None else 10_000 + slot, slot, str(row.get("label") or "")))
        physical_numbers=[n for n,_,_ in numbered if n < 10_000]
        if len(physical_numbers)==len(valid) and len(set(physical_numbers))==len(valid):
            ordered_slots=[slot for _,slot,_ in sorted(numbered, key=lambda x: x[0], reverse=True)]
            cd1_slot=min(numbered, key=lambda x: x[0])[1]
            cd1_label=min(numbered, key=lambda x: x[0])[2]
            mapping=", ".join(f"slot {slot}={label or 'unlabeled'}" for _,slot,label in sorted(numbered, key=lambda x: x[0]))
        else:
            ordered_slots=sorted(valid, reverse=True)
            cd1_slot=active_disc if active_disc in valid else valid[0]
            cd1_label=next((str(row.get("label") or "") for row in media if isinstance(row,dict) and int(row.get("disc") or 0)==cd1_slot), "")
            mapping=", ".join(f"slot {slot}" for slot in sorted(valid))
        staged_source = bool(state.get("setup_source_multidisc_optical_v01866"))
        if staged_source:
            # v0.18.69 presents the consolidated setup as an actual ISO-9660
            # filesystem and passes the backing loop block device through to the
            # Wolf child. D: and D:: therefore describe the same labelled optical
            # medium instead of an ext4 directory merely registered as cdrom.
            lines += [
                f'echo "[pcga-media] COD2 synthetic optical setup source: {mapping}; bootstrap slot {cd1_slot}" >&2',
                # E:..J: registration above starts wineserver before D: exists. Wine
                # caches the DOS-device map for that server generation, so stop
                # that helper generation before publishing the synthetic D: drive.
                'if command -v wineserver >/dev/null 2>&1; then echo "[pcga-media] refreshing wineserver before COD2 D: optical mapping" >&2; wineserver -k >/dev/null 2>&1 || true; timeout 5 wineserver -w >/dev/null 2>&1 || true; sleep 0.25; fi',
                'rm -f "$WINEPREFIX/dosdevices/d:" "$WINEPREFIX/dosdevices/d::"',
                'ln -s /pcga-source "$WINEPREFIX/dosdevices/d:"',
                'if [[ -b /dev/pcga-setup-media ]]; then ln -s /dev/pcga-setup-media "$WINEPREFIX/dosdevices/d::"; else echo "[pcga-media] FATAL: synthetic COD2 optical block device is missing" >&2; exit 75; fi',
                "wine reg add 'HKEY_LOCAL_MACHINE\\Software\\Wine\\Drives' /v 'd:' /t REG_SZ /d cdrom /f /reg:32 >/dev/null 2>&1 || true",
                "wine reg add 'HKEY_LOCAL_MACHINE\\Software\\Wine\\Drives' /v 'd:' /t REG_SZ /d cdrom /f /reg:64 >/dev/null 2>&1 || true",
                'echo "[pcga-media] D: link=$(readlink \"$WINEPREFIX/dosdevices/d:\" 2>/dev/null || echo missing) D:: link=$(readlink \"$WINEPREFIX/dosdevices/d::\" 2>/dev/null || echo missing)" >&2',
                'test -r "$WINEPREFIX/dosdevices/d:/Setup/Data/main/iw_02.iwd" && echo "[pcga-media] DOS-device symlink payload probe found D:/Setup/Data/main/iw_02.iwd" >&2 || { echo "[pcga-media] FATAL: D: DOS-device symlink does not resolve the synthetic ISO payload" >&2; exit 78; }',
                # Reload both the DOS-device symlinks and Wine Drives registry in
                # one fresh server generation before running Windows-side probes.
                'if command -v wineserver >/dev/null 2>&1; then echo "[pcga-media] restarting wineserver after COD2 D: optical registration" >&2; wineserver -k >/dev/null 2>&1 || true; timeout 5 wineserver -w >/dev/null 2>&1 || true; sleep 0.25; fi',
                'echo "[pcga-media] active optical drive D: = genuine synthetic COD2DVD ISO (/dev/pcga-setup-media)" >&2',
                "test -r '/pcga-source/.pcga-msi-media-flattened-v01866.json' && echo '[pcga-media] COD2 MSI Media single-volume flatten marker v0.18.72 present' >&2 || { echo '[pcga-media] FATAL: COD2 MSI Media v0.18.69 marker missing' >&2; exit 76; }",
                "test -r '/pcga-source/.pcga-msi-media-flattened-v01866.json' && { printf '[pcga-media] COD2 MSI Media audit: ' >&2; tr '\n' ' ' < '/pcga-source/.pcga-msi-media-flattened-v01866.json' | head -c 2800 >&2; echo >&2; } || true",
                "test -r '/pcga-source/Setup/Data/main/iw_02.iwd' && echo '[pcga-media] synthetic ISO payload probe found /pcga-source/Setup/Data/main/iw_02.iwd' >&2 || { echo '[pcga-media] FATAL: synthetic ISO payload probe cannot read /pcga-source/Setup/Data/main/iw_02.iwd' >&2; exit 77; }",
                "timeout 5 wine cmd /c dir 'D:\\Setup\\Data\\main\\iw_02.iwd' >/dev/null 2>&1 && echo '[pcga-media] D: optical-media probe found D:\\Setup\\Data\\main\\iw_02.iwd' >&2 || { echo '[pcga-media] FATAL: D: optical-media probe cannot find D:\\Setup\\Data\\main\\iw_02.iwd' >&2; exit 78; }",
                "pcga_cod2_vol=$(timeout 8 wine cmd /c vol D: 2>&1 | tr -d '\r' || true)",
                "printf '%s\\n' \"$pcga_cod2_vol\" | sed -e 's/^/[pcga-media] /' >&2",
                "printf '%s\\n' \"$pcga_cod2_vol\" | grep -qi 'COD2DVD' || { echo '[pcga-media] FATAL: Wine does not see COD2DVD as the D: volume label' >&2; exit 79; }",
                "pcga_drive_row=$(timeout 8 wine wmic logicaldisk get DeviceID,DriveType,VolumeName 2>/dev/null | tr -d '\r' | awk '$1 == \"D:\" {print; exit}' || true)",
                'echo "[pcga-media] Win32 synthetic-drive probe: ${pcga_drive_row:-missing}" >&2',
                '[[ "$pcga_drive_row" =~ ^D:([[:space:]]+)5([[:space:]]+) ]] || { echo "[pcga-media] FATAL: synthetic COD2 D: is not DRIVE_CDROM (5)" >&2; exit 80; }',
            ]
        else:
            lines += [
                'echo "[pcga-media] FATAL: validated COD2DVD synthetic optical source is unavailable; refusing directory-backed/stale installer launch" >&2',
                'exit 74',
            ]


    if virtual:
        letter=str(virtual["drive_letter"]).lower(); label=str(virtual["label"])
        overlay=f'$WINEPREFIX/.pcga-virtual-cd-{letter}'
        lines += [f'PCGA_VCD="{overlay}"','rm -rf "$PCGA_VCD"','mkdir -p "$PCGA_VCD"',f'printf \'%s\\n\' {shlex.quote(label)} > "$PCGA_VCD/.windows-label"']
        for rel in virtual.get("required_paths") or []:
            parent=str(Path(rel).parent).replace("\\","/"); name=Path(rel).name
            parent_shell="$PCGA_VCD" if parent=="." else f'$PCGA_VCD/{parent}'
            lines += [f'mkdir -p "{parent_shell}"',f'pcga_vcd_source=$(find /pcga-media -type f -iname {shlex.quote(name)} -print -quit 2>/dev/null || true)','if [[ -z "$pcga_vcd_source" && -f "${TARGET:-}" ]]; then pcga_vcd_source="$TARGET"; fi',f'if [[ -n "$pcga_vcd_source" ]]; then ln -sf "$pcga_vcd_source" "{parent_shell}/{name}"; else : > "{parent_shell}/{name}"; fi']
        backing=active_disc
        for row in media:
            if isinstance(row,dict) and str(row.get('label') or '').casefold()==label.casefold():
                try: backing=int(row.get('disc') or backing)
                except (TypeError,ValueError): pass
                break
        raw=f"/dev/pcga-media-disc{backing}"
        lines += [f'rm -f "$WINEPREFIX/dosdevices/{letter}:" "$WINEPREFIX/dosdevices/{letter}::"',f'ln -s "$PCGA_VCD" "$WINEPREFIX/dosdevices/{letter}:"',f'if [[ -b {shlex.quote(raw)} ]]; then ln -s {shlex.quote(raw)} "$WINEPREFIX/dosdevices/{letter}::"; fi']
    elif valid and not setup_union:
        cod2_cd1_disc = None
        if game and _is_call_of_duty_2(game):
            for row in media:
                if not isinstance(row, dict):
                    continue
                if str(row.get("label") or "").strip().casefold() != "cod2cd1":
                    continue
                try:
                    candidate = int(row.get("disc") or 0)
                except (TypeError, ValueError):
                    candidate = 0
                if candidate in valid:
                    cod2_cd1_disc = candidate
                    break
        raw=f"/dev/pcga-media-disc{active_disc}"; root=f"/pcga-media/disc{active_disc}"
        if cod2_cd1_disc and game and _is_call_of_duty_2(game):
            cod2_loop_raw=f"/dev/pcga-media-disc{cod2_cd1_disc}"
            cod2_root=f"/pcga-media/disc{cod2_cd1_disc}"
            cod2_iso=f"/pcga-media/disc{cod2_cd1_disc}.iso"
            lines += [
                'rm -f "$WINEPREFIX/dosdevices/d:" "$WINEPREFIX/dosdevices/d::"',
                'if [[ "${PCGA_LAUNCH_VARIANT:-singleplayer}" == "singleplayer" ]]; then',
                f'  test -d {shlex.quote(cod2_root)} || {{ echo "[pcga-media] FATAL: mounted COD2CD1 ISO filesystem is missing: {cod2_root}" >&2; exit 88; }}',
                f'  test -f {shlex.quote(cod2_iso)} || {{ echo "[pcga-media] FATAL: preserved COD2CD1 ISO is missing: {cod2_iso}" >&2; exit 88; }}',
                f'  test -b {shlex.quote(cod2_loop_raw)} || {{ echo "[pcga-media] FATAL: COD2CD1 ISO loop block device is missing: {cod2_loop_raw}" >&2; exit 88; }}',
                f'  ln -s {shlex.quote(cod2_root)} "$WINEPREFIX/dosdevices/d:"',
                f'  if [[ -b {shlex.quote(CDEMU_CONTAINER_DEVICE)} ]] && dd if={shlex.quote(CDEMU_CONTAINER_DEVICE)} of=/dev/null bs=2048 count=1 status=none 2>/dev/null; then',
                f'    ln -s {shlex.quote(CDEMU_CONTAINER_DEVICE)} "$WINEPREFIX/dosdevices/d::"',
                f'    echo "[pcga-media] COD2 SP ISO-backed optical D: image={cod2_iso} mount={cod2_root}; D:: CDEmu={CDEMU_CONTAINER_DEVICE}" >&2',
                f'    echo "[pcga-media] COD2CD1 CDEmu virtual-CD read probe: PASS" >&2',
                '  else',
                f'    ln -s {shlex.quote(cod2_loop_raw)} "$WINEPREFIX/dosdevices/d::"',
                '    echo "[pcga-media] WARNING: CDEmu unavailable/unreadable; retaining proven ISO loop-backed D:: so the Wolf stream stays alive" >&2',
                '    echo "[pcga-media] CDEmu status=${PCGA_COD2_CDEMU_STATUS:-unavailable} detail=${PCGA_COD2_CDEMU_DETAIL:-not-provided}" >&2',
                f'    if dd if={shlex.quote(cod2_loop_raw)} of=/dev/null bs=2048 count=1 status=none 2>/dev/null; then echo "[pcga-media] COD2CD1 ISO loop-device fallback read probe: PASS" >&2; else echo "[pcga-media] FATAL: both CDEmu and preserved COD2CD1 loop device are unreadable" >&2; exit 88; fi',
                '  fi',
                f'  PCGA_ACTIVE_DISC={cod2_cd1_disc}',
                'else',
                f'  ln -s {shlex.quote(root)} "$WINEPREFIX/dosdevices/d:"',
                f'  if [[ -b {shlex.quote(raw)} ]]; then ln -s {shlex.quote(raw)} "$WINEPREFIX/dosdevices/d::"; fi',
                f'  PCGA_ACTIVE_DISC={active_disc}',
                'fi',
            ]
        else:
            lines += [
                'rm -f "$WINEPREFIX/dosdevices/d:" "$WINEPREFIX/dosdevices/d::"',
                f'ln -s {shlex.quote(root)} "$WINEPREFIX/dosdevices/d:"',
                f'if [[ -b {shlex.quote(raw)} ]]; then ln -s {shlex.quote(raw)} "$WINEPREFIX/dosdevices/d::"; fi',
                f'PCGA_ACTIVE_DISC={active_disc}',
            ]

    if valid:
        # Registering archive drives E:.. starts wineserver. A fresh runner prefix
        # can therefore cache the pre-existing/missing D: DOS-device map before
        # the active optical symlinks above are published. Restart the selected
        # wineserver after D:/D:: are final so Wine 11/new-WoW64 re-reads both
        # links before registry registration and volume probes. Setup-union has
        # its own stricter refresh sequence above.
        if not setup_union:
            lines += [
                'echo "[pcga-media] D: link=$(readlink \"$WINEPREFIX/dosdevices/d:\" 2>/dev/null || echo missing) D:: link=$(readlink \"$WINEPREFIX/dosdevices/d::\" 2>/dev/null || echo missing)" >&2',
                'if command -v wineserver >/dev/null 2>&1; then echo "[pcga-media] refreshing wineserver after runtime D: optical mapping" >&2; wineserver -k >/dev/null 2>&1 || true; timeout 5 wineserver -w >/dev/null 2>&1 || true; sleep 0.25; fi',
            ]
        lines += [
            "wine reg add 'HKEY_LOCAL_MACHINE\\Software\\Wine\\Drives' /v 'd:' /t REG_SZ /d cdrom /f /reg:32 >/dev/null 2>&1 || true",
            "wine reg add 'HKEY_LOCAL_MACHINE\\Software\\Wine\\Drives' /v 'd:' /t REG_SZ /d cdrom /f /reg:64 >/dev/null 2>&1 || true",
        ]
        if not setup_union:
            lines.append('echo "[pcga-media] active optical drive D: = title disc ${PCGA_ACTIVE_DISC:-unknown}" >&2')
        lines += [
            "timeout 5 wine cmd /c vol D: 2>&1 | sed -e 's/^/[pcga-media] /' >&2 || true",
            "pcga_drive_row=$(timeout 8 wine wmic logicaldisk get DeviceID,DriveType,VolumeName 2>/dev/null | tr -d '\\r' | awk '$1 == \"D:\" {print; exit}' || true)",
            'if [[ -n "$pcga_drive_row" ]]; then echo "[pcga-media] Win32 drive probe: $pcga_drive_row" >&2; [[ "$pcga_drive_row" =~ ^D:([[:space:]]+)5([[:space:]]+) ]] || echo "[pcga-media] WARNING: D: is not reported as DRIVE_CDROM (5)" >&2; fi',
        ]
    if len(valid)>1 and not virtual and not setup_union:
        switch_script = """cat > /tmp/pcga-disc-switch <<'PCGA_DISC_SWITCH'
#!/usr/bin/env bash
set -euo pipefail
n=\"${1:-}\"
[[ \"$n\" =~ ^[0-9]+$ ]] || { echo \"usage: pcga-disc-switch DISC_NUMBER\" >&2; exit 2; }
root=\"/pcga-media/disc$n\"; raw=\"/dev/pcga-media-disc$n\"
[[ -d \"$root\" && -b \"$raw\" ]] || { echo \"disc $n is not attached to this session\" >&2; exit 3; }
rm -f \"$WINEPREFIX/dosdevices/d:\" \"$WINEPREFIX/dosdevices/d::\"
ln -s \"$root\" \"$WINEPREFIX/dosdevices/d:\"
ln -s \"$raw\" \"$WINEPREFIX/dosdevices/d::\"
wine reg add 'HKEY_LOCAL_MACHINE\\Software\\Wine\\Drives' /v 'd:' /t REG_SZ /d cdrom /f /reg:32 >/dev/null 2>&1 || true
wine reg add 'HKEY_LOCAL_MACHINE\\Software\\Wine\\Drives' /v 'd:' /t REG_SZ /d cdrom /f /reg:64 >/dev/null 2>&1 || true
wine cmd /c vol D: 2>&1 || true
PCGA_DISC_SWITCH
chmod 0755 /tmp/pcga-disc-switch"""
        lines.append(switch_script)
    if virtual:
        for rel in virtual.get("required_paths") or []:
            win=rel.replace('/', '\\')
            lines.append(f"timeout 5 wine cmd /c dir 'D:\\{win}' >/dev/null 2>&1 && echo '[pcga-media] verified D:\\{win}' >&2 || echo '[pcga-media] WARNING: virtual CD sentinel missing: D:\\{win}' >&2")
    return "\n".join(lines)

def logical_disc_count(sources: list[dict], isos: list[Path] | None = None) -> int:
    """Determine logical disc count from metadata, not preservation-copy count."""
    declared: list[int] = []
    numbers: set[int] = set()
    for src in sources:
        try:
            count = int(src.get("disc_count")) if src.get("disc_count") is not None else 0
        except (TypeError, ValueError):
            count = 0
        try:
            number = int(src.get("disc_number")) if src.get("disc_number") is not None else 0
        except (TypeError, ValueError):
            number = 0
        if count > 0:
            declared.append(count)
        if number > 0:
            numbers.add(number)
    if declared:
        return max(declared)
    if numbers:
        return max(len(numbers), max(numbers))
    if isos is None:
        isos = source_isos(sources)
    return len(isos)


def _autorun_installer_target(mount: Path) -> Path | None:
    """Return the executable explicitly selected by autorun.inf, when safe.

    Optical installers commonly ship a vendor bootstrapper (usually Setup.exe)
    beside one or more MSI payloads.  Launching the MSI directly can bypass
    prerequisite/custom-action logic and, for titles such as Call of Duty 2,
    is explicitly rejected by the package.  The disc-authored autorun target
    therefore outranks generic payload discovery.
    """
    root = mount.resolve()
    info = _autorun_fields(mount)
    for key in ("shellexecute", "open"):
        raw = str(info.get(key) or "").strip()
        if not raw:
            continue
        m = re.match(r'^\s*"([^"]+)"', raw)
        token = m.group(1) if m else raw.split(None, 1)[0]
        token = token.strip().strip('"').strip("'").replace("\\", "/")
        if not token:
            continue
        candidate = (mount / token).resolve()
        try:
            candidate.relative_to(root)
        except ValueError:
            continue
        if candidate.is_file() and candidate.suffix.casefold() in {".exe", ".com"}:
            return candidate
    return None


def scan_installers(mount: Path) -> dict:
    candidates = []
    portable = []
    skip = {"unins000.exe", "uninstall.exe", "dxsetup.exe", "vcredist.exe", "vc_redist.exe", "directx.exe", "syscheck.exe", "systemcheck.exe"}
    # Retail game discs frequently bundle unrelated prerequisite/application
    # installers (Adobe Reader, DirectX, drivers, GameSpy/PunkBuster, .NET, etc.).
    # Those can have perfectly generic Setup.exe names and used to outrank the
    # actual game bootstrapper when scanning from the disc root.  They are not
    # game installers unless the disc's own autorun.inf explicitly points there.
    bundled_component_dirs = {
        "redist", "redistributable", "redistributables", "support", "directx",
        "drivers", "driver", "nvidia_driver", "adobe", "acrobat", "reader",
        "dotnet", "dotnetfx", "prereq", "prereqs", "prerequisite",
        "prerequisites", "gamespy", "punkbuster", "pb", "manual", "manuals",
    }
    bundled_component_stems = (
        "adberdr", "acroread", "reader", "dotnetfx", "dxsetup", "vcredist",
        "vc_redist", "physx", "pbsvc", "pbsetup", "gamespy", "nvidia",
    )
    autorun_target = _autorun_installer_target(mount)
    for p in mount.rglob("*"):
        try:
            rel = p.relative_to(mount)
        except ValueError:
            continue
        if len(rel.parts) > 5 or not p.is_file():
            continue
        name = p.name.lower()
        suffix = p.suffix.lower()
        if suffix == ".msi":
            # MSI files are frequently *payloads* consumed by a vendor
            # bootstrapper.  Prefer them only when the disc does not provide an
            # explicit executable installer.
            score = 150 + max(0, 12 - 2 * (len(rel.parts) - 1))
            candidates.append((score, "msi", p, "msi-payload"))
            continue
        if suffix == ".exe":
            is_autorun_target = autorun_target is not None and p.resolve() == autorun_target
            parts_cf = {part.casefold() for part in rel.parts[:-1]}
            if name in skip or name.startswith(("unins", "vcredist", "vc_redist", "dxsetup")):
                continue
            if not is_autorun_target and (parts_cf & bundled_component_dirs or p.stem.casefold().startswith(bundled_component_stems)):
                continue
            # A generic Setup.exe buried under GameData on a single-title disc
            # is commonly a system-check/managed helper rather than the retail
            # installer.  A compilation member mapped directly to GameData sees
            # the same file at relative depth zero, so legitimate anthology
            # member installers remain eligible.
            if not is_autorun_target and "gamedata" in parts_cf and name in {"setup.exe", "install.exe", "installer.exe", "autorun.exe"}:
                continue
            score = 0
            kind = "exe-unknown"
            reason = "executable-installer"
            if is_autorun_target:
                score += 500
                kind = "autorun-bootstrap"
                reason = "autorun-target"
            if name == "setup.exe":
                score += 320
                if kind == "exe-unknown": kind = "bootstrap-exe"
                reason = "setup-bootstrap" if reason != "autorun-target" else reason
            elif name in {"install.exe", "installer.exe"}:
                score += 290
                if kind == "exe-unknown": kind = "bootstrap-exe"
                reason = "named-bootstrap" if reason != "autorun-target" else reason
            # Prefer a root-level bootstrapper over setup helpers buried in
            # redistributable/demo subdirectories. Compilation members already
            # pass their mapped subdirectory as `mount`, so a genuine per-game
            # bootstrapper is still root-relative here.
            if score and not is_autorun_target:
                depth = max(0, len(rel.parts) - 1)
                score += 40
                score -= min(240, 90 * depth)
            try:
                data = p.open("rb").read(8 * 1024 * 1024)
                low = data.lower()
                if b"inno setup" in low:
                    kind = "inno"; score += 90
                elif b"nullsoft" in low or b"nsis" in low:
                    kind = "nsis"; score += 80
                elif b"installshield" in low:
                    kind = "installshield"; score += 70
            except OSError:
                pass
            if score:
                candidates.append((score, kind, p, reason))
            else:
                portable.append(p)
    candidates.sort(key=lambda x: (-x[0], len(x[2].relative_to(mount).parts), x[2].name.lower()))
    portable.sort(key=lambda p: (len(p.relative_to(mount).parts), p.name.lower()))
    if candidates:
        score, kind, p, reason = candidates[0]
        return {
            "kind": kind, "path": str(p), "relative": str(p.relative_to(mount)),
            "candidate_count": len(candidates), "selection_score": score,
            "selection_reason": reason,
            "autorun_target": str(autorun_target.relative_to(mount)) if autorun_target else None,
        }
    if portable:
        return {"kind": "portable-candidate", "path": str(portable[0]), "relative": str(portable[0].relative_to(mount)), "candidate_count": len(portable)}
    return {"kind": "none", "candidate_count": 0}



WINE_PREFIX_BUILTIN_DIRS = {
    "internet explorer",
    "windows media player",
    "windows nt",
}
WINE_PREFIX_BUILTIN_EXES = {
    "iexplore.exe",
    "winebrowser.exe",
    "wineboot.exe",
    "winecfg.exe",
}


def _launch_candidate_allowed(install_dir: Path, p: Path) -> bool:
    try:
        rel = p.relative_to(install_dir)
    except ValueError:
        return False
    parts = [x.casefold() for x in rel.parts]
    name = p.name.casefold()
    if not p.is_file() or p.suffix.casefold() != ".exe":
        return False
    if name.startswith(("unins", "setup", "install", "dxsetup", "vcredist", "vc_redist")) or "uninstall" in name:
        return False
    # Wine seeds a new prefix with several desktop applications. In particular,
    # iexplore.exe lives below Program Files and therefore escaped the older
    # system32-only guard, causing an empty/incomplete prefix to be promoted as a
    # successfully installed PC game. These paths are runtime scaffolding, never
    # a PCGA game launch target.
    if name in WINE_PREFIX_BUILTIN_EXES:
        return False
    if name in _LAUNCH_HELPER_EXACT or _LAUNCH_HELPER_STEM_RE.fullmatch(p.stem):
        return False
    if any(x in WINE_PREFIX_BUILTIN_DIRS for x in parts):
        return False
    # Shared InstallShield/runtime helpers under Common Files are never the game
    # entry point. COD2 was previously promoted to IDriver.exe from this tree.
    if "common files" in parts or "installshield" in parts:
        return False
    if any(x in {"redist","redistributable","redistributables","support","updates","update","patches","patch"} for x in parts):
        return False
    if "windows" in parts or "system32" in parts or "syswow64" in parts:
        return False
    if any(x in {"users", "programdata", "$recycle.bin", "temp", "tmp"} for x in parts):
        return False
    try:
        if p.stat().st_size < 4 * 1024:
            return False
    except OSError:
        return False
    return True


def choose_installed_executable(install_dir: Path, game: dict) -> Path | None:
    root = install_dir / "prefix" / "drive_c"
    if not root.exists():
        return None
    exes = []
    title_tokens = [x for x in norm_title(str(game.get("title") or "")).split() if len(x) >= 4 and x not in {"edition", "enhanced", "game"}]
    for p in root.rglob("*.exe"):
        if not _launch_candidate_allowed(install_dir, p):
            continue
        try:
            rel = p.relative_to(install_dir)
        except ValueError:
            continue
        stem_norm = norm_title(p.stem)
        path_norm = norm_title(" ".join(rel.parts))
        stem_hits = sum(1 for token in title_tokens if token in stem_norm)
        path_hits = sum(1 for token in title_tokens if token in path_norm)
        score = stem_hits * 18 + path_hits * 10
        title_compact=re.sub(r"[^a-z0-9]+","",norm_title(str(game.get("title") or "")))
        stem_compact=re.sub(r"[^a-z0-9]+","",stem_norm)
        if title_compact and stem_compact == title_compact:
            score += 180
        elif title_compact and len(title_compact) >= 4 and (title_compact in stem_compact or stem_compact in title_compact):
            score += 70
        # Real installed applications normally live in Program Files or a vendor
        # directory under C:. Parent-directory title matches matter because older
        # games often use opaque executable names such as IDMain.exe.
        if any(x.casefold().startswith("program files") for x in rel.parts):
            score += 5
        # Prefer the real game binary over vendor splash/launcher wrappers when
        # both live in the same installed directory.  Legacy launchers often
        # depend on shell/IE components or hand off immediately, which presents
        # as a black screen in a streamed headless desktop.  The helper remains
        # eligible when it is the only plausible executable.
        exe_name = p.name.casefold()
        preferred=[str(x).casefold() for x in compatibility_preferred_executables(game)]
        if exe_name in preferred:
            # Preserve resolver ordering. This is important for retail games that
            # ship both a launcher shell and a direct game executable.
            score += 260 - min(preferred.index(exe_name), 10) * 80
        if exe_name.startswith(("launch", "launcher")) or "launcher" in stem_norm:
            score -= 24
        score -= len(rel.parts)
        exes.append((score, path_hits, stem_hits, len(rel.parts), p.name.lower(), p))
    if not exes:
        return None
    exes.sort(key=lambda x: (-x[0], -x[1], -x[2], x[3], x[4]))
    return exes[0][5]


def _launch_role_from_executable(name: str) -> str | None:
    """Classify explicit SP/MP executables without guessing from metadata.

    Only names with a strong executable-level role marker are accepted. This
    avoids manufacturing choices for games that merely mention multiplayer in
    metadata while still catching common retail layouts such as iw3sp/iw3mp and
    CoD2SP_s/CoD2MP_s.
    """
    stem = Path(str(name or "")).stem.casefold()
    normalized = re.sub(r"[^a-z0-9]+", "_", stem).strip("_")
    if any(token in normalized for token in ("multiplayer", "multi_player")):
        return "multiplayer"
    if any(token in normalized for token in ("singleplayer", "single_player")):
        return "singleplayer"
    if re.search(r"mp(?:_s)?$", normalized):
        return "multiplayer"
    if re.search(r"sp(?:_s)?$", normalized):
        return "singleplayer"
    return None


def _launch_family_from_executable(name: str, role: str) -> str:
    stem = Path(str(name or "")).stem.casefold()
    normalized = re.sub(r"[^a-z0-9]+", "_", stem).strip("_")
    if role == "multiplayer":
        normalized = re.sub(r"(?:multiplayer|multi_player|mp)(?:_s)?$", "", normalized)
    elif role == "singleplayer":
        normalized = re.sub(r"(?:singleplayer|single_player|sp)(?:_s)?$", "", normalized)
    return re.sub(r"[^a-z0-9]+", "", normalized)


def discover_launch_variants(install_root: Path, launch_executable: str) -> list[dict]:
    """Discover a conservative same-directory single-player/multiplayer pair.

    A title only becomes multi-launch when the chosen executable itself has an
    SP/MP marker and another executable in the same directory has the opposite
    marker with the same normalized family. PCGA therefore never invents modes
    from metadata alone and never scans unrelated helper directories for an MP
    server executable.
    """
    rel = str(launch_executable or "").replace("\\", "/").strip("/")
    if not rel:
        return []
    chosen = install_root / rel
    if not chosen.is_file():
        return []
    chosen_role = _launch_role_from_executable(chosen.name)
    if not chosen_role:
        return []
    family = _launch_family_from_executable(chosen.name, chosen_role)
    if not family:
        return []
    found: dict[str, Path] = {}
    try:
        for exe in chosen.parent.iterdir():
            if not exe.is_file() or exe.suffix.casefold() != ".exe":
                continue
            role = _launch_role_from_executable(exe.name)
            if role and _launch_family_from_executable(exe.name, role) == family:
                found.setdefault(role, exe)
    except OSError:
        return []
    if not {"singleplayer", "multiplayer"}.issubset(found):
        return []
    rows=[]
    labels={"singleplayer":"Single-player", "multiplayer":"Multiplayer"}
    for role in ("singleplayer", "multiplayer"):
        exe=found[role]
        rows.append({
            "key": role,
            "role": role,
            "label": labels[role],
            "executable": str(exe.relative_to(install_root)).replace("\\", "/"),
            "default": exe.resolve() == chosen.resolve(),
        })
    return rows


def _cod2_runtime_payload_status(install_root: Path) -> tuple[bool, list[str]]:
    """Validate the minimum installed COD2 runtime payload before READY/launch.

    The six-CD installer can copy the game executables before later media rows
    finish.  v0.18.57 therefore produced a plausible CoD2MP_s.exe while the
    Miles Sound System runtime mss32.dll was still absent.  Wine then fails
    before Direct3D initialization with STATUS_DLL_NOT_FOUND (c0000135).
    """
    drive_c = install_root / "prefix" / "drive_c"
    if not drive_c.is_dir():
        return False, ["Wine drive_c is missing"]
    game_dirs: list[Path] = []
    try:
        for q in drive_c.rglob("*"):
            if not q.is_file():
                continue
            if q.name.casefold() in {"cod2sp_s.exe", "cod2mp_s.exe"}:
                if q.parent not in game_dirs:
                    game_dirs.append(q.parent)
    except OSError:
        pass
    if not game_dirs:
        return False, ["CoD2SP_s.exe/CoD2MP_s.exe is missing"]
    for game_dir in game_dirs:
        names = {}
        try:
            names = {x.name.casefold(): x for x in game_dir.iterdir() if x.is_file()}
        except OSError:
            continue
        has_exe = "cod2sp_s.exe" in names or "cod2mp_s.exe" in names
        has_mss = "mss32.dll" in names
        main_dir = game_dir / "main"
        has_iwd = False
        try:
            has_iwd = any(x.is_file() and x.suffix.casefold() == ".iwd" for x in main_dir.iterdir())
        except OSError:
            pass
        if has_exe and has_mss and has_iwd:
            return True, []
    missing=[]
    # Report the most useful loader/runtime symptoms rather than every file.
    if not any((d / "mss32.dll").is_file() or any(x.is_file() and x.name.casefold()=="mss32.dll" for x in d.iterdir()) for d in game_dirs if d.is_dir()):
        missing.append("mss32.dll")
    if not any((d / "main").is_dir() and any(x.is_file() and x.suffix.casefold()==".iwd" for x in (d / "main").iterdir()) for d in game_dirs if (d / "main").is_dir()):
        missing.append("main/*.iwd")
    return False, missing or ["COD2 runtime payload is incomplete"]


def _repair_false_ready_state(set_id: str, game: dict, state: dict) -> dict:
    if state.get("status") != "ready":
        return state
    rel = str(state.get("launch_executable") or "").strip()
    install_root = Path(str(state.get("install_root") or archive_root() / "games/installed" / set_id))
    target = install_root / rel if rel else Path("/")
    if rel and _launch_candidate_allowed(install_root, target):
        # Existing releases may have selected a vendor launcher wrapper even
        # though the real game executable is present beside it. Re-run the
        # candidate scorer for those helper targets so upgrades can repair
        # LaunchEAW.exe/LaunchBFII.exe-style black-screen handoff paths without
        # requiring a reinstall.
        current_name = target.name.casefold()
        replacement = choose_installed_executable(install_root, game)
        preferred=[str(x).casefold() for x in compatibility_preferred_executables(game)]
        current_rank = preferred.index(current_name) if current_name in preferred else 999
        replacement_name = replacement.name.casefold() if replacement is not None else ""
        replacement_rank = preferred.index(replacement_name) if replacement_name in preferred else 999
        # Re-evaluate both legacy Launch*.exe wrappers and any lower-ranked
        # compatibility target. Jedi Outcast upgrades from JediOutcast.exe to
        # jk2sp.exe here without reinstalling the already-complete prefix.
        if replacement is not None and replacement != target and (
            current_name.startswith(("launch", "launcher")) or replacement_rank < current_rank
        ):
            return state_update(
                set_id,
                status="ready",
                phase="installed",
                launch_executable=str(replacement.relative_to(install_root)),
                runtime_image=None,
                runtime_build_hash=None,
                stream_state="pending",
                stream_app_title=None,
                detail=f"Selected direct known-good game executable {replacement.name} instead of {target.name}",
            )
        return state
    # A prior release may have promoted a Wine-supplied executable such as
    # Program Files (x86)/Internet Explorer/iexplore.exe. Before demoting the
    # game, see whether the already-installed prefix contains a better genuine
    # application candidate. This repairs completed installs without re-ripping.
    replacement = choose_installed_executable(install_root, game)
    if replacement is not None:
        return state_update(
            set_id,
            status="ready",
            phase="installed",
            launch_executable=str(replacement.relative_to(install_root)),
            runtime_image=None,
            runtime_build_hash=None,
            stream_state="pending",
            stream_app_title=None,
            detail="Repaired false Wine runtime launch target and selected installed game executable",
        )
    # No genuine application executable was found. Demote and rebuild the
    # interactive setup source from the preserved ISO instead of advertising a
    # false READY state.
    repaired = state_update(
        set_id,
        status="setup-required",
        phase="installer",
        detail="Previous READY state did not contain a valid game executable; PCGA will restage the preserved installer",
        setup_reason="invalid-launch-executable",
        launch_executable=None,
        runtime_image=None,
        runtime_build_hash=None,
        stream_state="pending",
        stream_app_title=None,
        setup_source=None,
        setup_installer=None,
        setup_runtime_image=None,
        setup_runtime_build_hash=None,
    )
    return repaired


def prepare_interactive_source(set_id: str, install_dir: Path, install_source: Path, installer: dict) -> dict:
    setup_source = install_dir / "setup-source"
    # setup-source may be the mountpoint of PCGA's synthetic read-only COD2DVD
    # volume.  Generic restaging used to call shutil.rmtree() on that live mount;
    # the first ISO file it tried to unlink (commonly 00000001.TMP) then raised
    # EROFS and failed the entire orchestrator before Wolf could register any app.
    # Unmount exactly this setup-source first and fail cleanly if a streamed setup
    # container still holds it busy.
    mounted_from = _exact_mount_source(setup_source)
    if mounted_from:
        try:
            _unmount_setup_source(setup_source)
        except Exception as exc:
            return state_update(
                set_id, status="setup-required", phase="interactive-setup",
                setup_reason="setup-source-busy", stream_state="pending",
                stream_app_title=None,
                detail=f"Interactive setup source is still mounted read-only from {mounted_from}; end the active setup stream and retry ({type(exc).__name__}: {str(exc)[:160]})",
            )
    if _exact_mount_source(setup_source):
        return state_update(
            set_id, status="setup-required", phase="interactive-setup",
            setup_reason="setup-source-busy", stream_state="pending",
            stream_app_title=None,
            detail="Interactive setup source is still mounted read-only; refusing to delete files from a live optical mount",
        )
    if setup_source.exists() or setup_source.is_symlink():
        if setup_source.is_dir() and not setup_source.is_symlink():
            shutil.rmtree(setup_source)
        else:
            setup_source.unlink(missing_ok=True)
    shutil.copytree(install_source, setup_source, dirs_exist_ok=True)
    rel = str(installer.get("relative") or "").replace("\\", "/")
    if not rel or not (setup_source / rel).is_file():
        return state_update(set_id, status="setup-required", phase="interactive-setup", detail="Interactive installer payload could not be staged", setup_reason="setup-source")
    try:
        os.chown(install_dir, 1000, 1000)
        os.chown(setup_source, 1000, 1000)
    except OSError:
        pass
    return state_update(
        set_id, status="setup-required", phase="interactive-setup",
        detail="Legacy installer requires an interactive setup session; PCGA staged it for Wolf/Moonlight",
        setup_reason=str(installer.get("kind") or "interactive-installer"),
        setup_source=str(setup_source), setup_installer=rel, setup_kind=installer.get("kind"),
    )


def repair_interactive_installer_selection(set_id: str, game: dict, state: dict) -> dict:
    """Re-evaluate an already-staged setup source with current ranking rules.

    Older releases could persist an MSI payload, a nested managed helper such as
    GameData/Setup.exe, or another executable that newer installer discovery
    correctly ranks below the disc-authored/root bootstrapper.  The staged
    source is immutable input, so rescanning it is safe and idempotent.
    """
    if state.get("status") != "setup-required" or not state.get("setup_source"):
        return state
    source = Path(str(state.get("setup_source") or ""))
    if not source.is_dir():
        return state
    current_rel = str(state.get("setup_installer") or "").replace("\\", "/")
    current = source / current_rel if current_rel else None
    candidate = scan_installers(source)
    rel = str(candidate.get("relative") or "").replace("\\", "/")
    replacement = source / rel if rel else None
    if not rel or not replacement or not replacement.is_file():
        return state
    if candidate.get("kind") in {"msi", "portable-candidate", "none"} or replacement.suffix.casefold() == ".msi":
        return state
    if current_rel == rel and current is not None and current.is_file():
        return state

    old_name = current_rel if current_rel else "missing installer"
    return state_update(
        set_id, setup_installer=rel, setup_kind=candidate.get("kind"), installer=candidate,
        setup_runtime_image=None, setup_runtime_build_hash=None, setup_runtime_log=None,
        stream_state="pending", stream_app_title=None,
        detail=f"Re-selected vendor installer bootstrapper {Path(rel).name} instead of stale setup target {old_name}",
        installer_selection_repaired_v01845=True,
    )

def repair_noncompilation_portable_scope(set_id: str, game: dict, sources: list[dict], state: dict) -> dict:
    """Undo false portable READY states created from a narrowed single-title path.

    Before v0.18.40, a metadata source_path such as GameData could make the
    installer scan miss the disc-root bootstrapper and classify one arbitrary EXE
    as a portable game. Re-scan preserved disc 1 from its root; if a real
    installer exists, return the title to interactive setup without deleting the
    old copied payload or preserved media.
    """
    if state.get("status") != "ready" or str(state.get("install_method") or "") != "portable-copy":
        return state
    if any(str(row.get("layout") or "") == "compilation" for row in sources):
        return state
    installer = state.get("installer") if isinstance(state.get("installer"), dict) else {}
    source_path = str(installer.get("source_path") or ".").strip().replace("\\", "/")
    isos = source_isos(sources)
    # A canonical record can retain fully materialized runtime_media even after
    # intake ownership has moved away from the source rows used by scan_sources.
    # v0.18.48 returned early in that case, allowing COD2 to remain READY as a
    # six-disc portable-copy forever.  Treat the persisted media inventory as an
    # equally valid preservation source for migration/reclassification.
    runtime_media = state.get("runtime_media") if isinstance(state.get("runtime_media"), list) else []
    runtime_isos = []
    runtime_discs = set()
    for row in runtime_media:
        if not isinstance(row, dict):
            continue
        try:
            disc = int(row.get("disc") or 0)
        except (TypeError, ValueError):
            disc = 0
        if disc > 0:
            runtime_discs.add(disc)
        iso_text = str(row.get("iso") or "").strip()
        iso_path = Path(iso_text) if iso_text else None
        if iso_path and iso_path.is_file() and iso_path not in runtime_isos:
            runtime_isos.append(iso_path)
    if not isos:
        isos = runtime_isos
    game_media = game.get("media") if isinstance(game.get("media"), dict) else {}
    try:
        declared_disc_count = int(game_media.get("disc_count") or 0)
    except (TypeError, ValueError):
        declared_disc_count = 0
    disc_count = max(
        logical_disc_count(sources, isos) if (sources or isos) else 0,
        len(runtime_discs),
        declared_disc_count,
        int(state.get("source_logical_disc_count") or 0) if str(state.get("source_logical_disc_count") or "").isdigit() else 0,
    )
    if not isos:
        if disc_count > 1:
            return state_update(
                set_id, status="setup-required", phase="installer",
                launch_executable=None, runtime_image=None, runtime_build_hash=None,
                stream_state="pending", stream_app_title=None,
                setup_reason="multi-disc-installer-unidentified",
                portable_multidisc_repaired_v01849=True, install_method=None,
                detail=f"Reclassified legacy {disc_count}-disc portable copy; preserved media inventory proves this is installer media, but disc 1 is not currently mountable",
            )
        return state
    # v0.18.39 stamped portable_source_scope_repaired_v01839 even when its
    # attempted migration could not safely recover a multi-disc title.  That
    # marker must never suppress the stronger multi-disc rule introduced later.
    # Any retail title with more than one logical disc is re-evaluated at least
    # once under the current migration, regardless of older markers.
    if disc_count <= 1 and state.get("portable_source_scope_repaired_v01839"):
        return state
    # Never trust a migration marker while a multi-disc title is *still* READY
    # as portable-copy.  Reclassification is idempotent: a successful repair
    # changes status/method and this function stops matching on the next pass.
    # Keeping an old marker here allowed the broken COD2 portable launcher to
    # survive later duplicate convergence indefinitely.
    # A normal single-disc portable title whose source was already the disc root
    # remains valid.  Multi-disc media never takes this fast path.
    if source_path in {"", ".", "./"} and disc_count <= 1:
        return state
    install_root = Path(str(state.get("install_root") or archive_root() / "games/installed" / set_id))
    if disc_count > 1:
        return stage_multidisc_installer_from_isos(set_id, install_root, isos, disc_count)
    mountpoint = Path("/run/pcga-game-installer") / set_id / "portable-scope-repair"
    try:
        with mounted_iso(isos[0], mountpoint) as src:
            candidate = scan_installers(src)
            rel = str(candidate.get("relative") or "").replace("\\", "/")
            target = src / rel if rel else None
            if rel and target and target.is_file() and candidate.get("kind") not in {"none", "portable-candidate"}:
                candidate["source_path"] = "."
                staged = prepare_interactive_source(set_id, install_root, src, candidate)
                return state_update(
                    set_id,
                    installer=candidate,
                    status="setup-required",
                    phase="interactive-setup",
                    launch_executable=None,
                    runtime_image=None,
                    runtime_build_hash=None,
                    stream_state="pending",
                    stream_app_title=None,
                    portable_source_scope_repaired_v01839=True,
                    portable_multidisc_repaired_v01841=disc_count > 1,
                    portable_multidisc_repaired_v01844=disc_count > 1,
                    install_method=None,
                    detail=f"Reclassified legacy portable copy as installer media after disc-root scan found {Path(rel).name}",
                )
            if disc_count > 1:
                return state_update(
                    set_id, status="setup-required", phase="installer",
                    launch_executable=None, runtime_image=None, runtime_build_hash=None,
                    stream_state="pending", stream_app_title=None,
                    setup_reason="multi-disc-installer-unidentified",
                    portable_source_scope_repaired_v01839=True,
                    portable_multidisc_repaired_v01841=True, portable_multidisc_repaired_v01844=True,
                    install_method=None,
                    detail=f"Reclassified legacy {disc_count}-disc portable copy; no safe vendor bootstrapper was identified on disc 1",
                )
            normalize_install_template_permissions(install_root)
            return state_update(
                set_id,
                portable_source_scope_repaired_v01839=True,
                detail=f"Verified legacy portable source scope from {source_path}; no disc-root installer was found",
            )
    except Exception as exc:
        normalize_install_template_permissions(install_root)
        return state_update(
            set_id,
            portable_source_scope_repaired_v01839=True,
            detail=f"Portable source-scope migration could not complete: {type(exc).__name__}: {str(exc)[:180]}",
        )



def repair_noncompilation_setup_scope(set_id: str, game: dict, sources: list[dict], state: dict) -> dict:
    """Restage stale single-title setup sessions from the optical-disc root.

    v0.18.39 only retried states whose stored ``source_path`` was narrowed. In
    practice some already-staged records had been rewritten to ``.`` while still
    pointing at a nested helper such as ``GameData/Setup.exe``.  A prior repair
    marker then made the bad choice permanent.  v0.18.49 verifies the actual
    staged target once with current root-level ranking, regardless of old markers.
    """
    if state.get("status") != "setup-required" or not state.get("setup_source"):
        return state
    if state.get("setup_source_scope_verified_v01845"):
        return state
    if any(str(row.get("layout") or "") == "compilation" for row in sources):
        return state

    installer = state.get("installer") if isinstance(state.get("installer"), dict) else {}
    source_path = str(installer.get("source_path") or ".").strip().replace("\\", "/")
    current_rel = str(state.get("setup_installer") or "").strip().replace("\\", "/")
    rel_path = Path(current_rel) if current_rel else Path()
    rel_parts_cf = {part.casefold() for part in rel_path.parts[:-1]}
    suspicious_dirs = {
        "gamedata", "redist", "redistributable", "redistributables", "support",
        "directx", "drivers", "driver", "adobe", "acrobat", "reader", "dotnet",
        "dotnetfx", "prereq", "prereqs", "prerequisite", "prerequisites",
        "gamespy", "punkbuster", "pb", "manual", "manuals",
    }
    nested_generic_setup = (
        len(rel_path.parts) > 1 and rel_path.name.casefold() in
        {"setup.exe", "install.exe", "installer.exe", "autorun.exe"}
    )
    suspicious_target = bool(rel_parts_cf & suspicious_dirs) or nested_generic_setup
    suspicious_identity = weak_source_title(str(game.get("title") or ""))

    # Fresh states selected from the disc root need no migration unless their
    # concrete target itself is suspicious. Old v0.18.39 markers do not suppress
    # this verification because they were written before nested helper filtering.
    if source_path in {"", ".", "./"} and not suspicious_target and not suspicious_identity:
        return state_update(set_id, setup_source_scope_verified_v01845=True)

    isos = source_isos(sources)
    if not isos:
        return state_update(
            set_id,
            detail="Setup source needs disc-root verification, but no preserved optical image is currently available; verification will retry",
        )
    install_root = Path(str(state.get("install_root") or archive_root() / "games/installed" / set_id))
    mountpoint = Path("/run/pcga-game-installer") / set_id / "scope-repair-v01845"
    try:
        with mounted_iso(isos[0], mountpoint) as src:
            candidate = scan_installers(src)
            rel = str(candidate.get("relative") or "").replace("\\", "/")
            target = src / rel if rel else None
            if not rel or not target or not target.is_file() or candidate.get("kind") in {"none", "portable-candidate", "msi"}:
                return state_update(
                    set_id, setup_source_scope_verified_v01845=True,
                    detail=f"Verified preserved disc root for stale setup target {current_rel or 'unset'}; no safer executable bootstrapper was identified",
                )
            candidate["source_path"] = "."
            # Even when the relative path happens to match, rebuild the staged
            # source from the immutable disc root if the previous source was a
            # narrowed copy. This restores sibling files required by bootstrapper
            # custom actions and prerequisite detection.
            needs_restage = (
                source_path not in {"", ".", "./"} or
                rel != current_rel or
                suspicious_target or
                suspicious_identity
            )
            if not needs_restage:
                return state_update(set_id, setup_source_scope_verified_v01845=True, installer=candidate)
            prepare_interactive_source(set_id, install_root, src, candidate)
            return state_update(
                set_id,
                installer=candidate,
                setup_source_scope_repaired_v01839=True,
                setup_source_scope_verified_v01845=True,
                setup_runtime_image=None,
                setup_runtime_build_hash=None,
                setup_runtime_log=None,
                stream_state="pending",
                stream_app_title=None,
                detail=f"Restaged single-title installer from preserved disc root through {Path(rel).name} instead of stale target {current_rel or source_path}",
            )
    except Exception as exc:
        return state_update(
            set_id,
            detail=f"Disc-root setup-source verification could not complete and will retry: {type(exc).__name__}: {str(exc)[:180]}",
        )

def reset_interactive_prefix(install_dir: Path, *, reason: str) -> None:
    """Discard a prefix poisoned by a failed unattended installer attempt.

    Interactive setup must never inherit a half-created Wine prefix after Wine
    has already returned loader status c0000135. The preserved disc source is
    untouched; only the mutable install prefix is regenerated.
    """
    prefix = install_dir / "prefix"
    (install_dir / ".pcga-install-complete").unlink(missing_ok=True)
    if prefix.exists():
        shutil.rmtree(prefix, ignore_errors=True)
    prefix.mkdir(parents=True, exist_ok=True)
    try:
        os.chown(prefix, 1000, 1000)
    except OSError:
        pass
    log(f"reset interactive Wine prefix ({reason})")


def docker_image_ready(image: str) -> bool:
    return subprocess.run(["docker", "image", "inspect", image], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0


def ensure_runtime_image(image: str, state_id: str) -> bool:
    if docker_image_ready(image): return True
    state_update(state_id, status="installing", phase="runtime-image", detail=f"Pulling {image}")
    return subprocess.run(["docker", "pull", image]).returncode == 0


def _reinstall_source_fallback(set_id: str, state: dict) -> list[dict]:
    """Recover preserved source bundles recorded in install state.

    The intake scanner is canonical, but a reinstall must remain possible when a
    marker was moved/reconciled after installation. Only existing preserved paths
    are accepted; this never points at the mutable installed prefix.
    """
    rows = []
    seen = set()
    for value in state.get("source_bundles") or []:
        path = Path(str(value or ""))
        try:
            resolved = path.resolve()
        except OSError:
            continue
        if not resolved.exists() or str(resolved) in seen:
            continue
        seen.add(str(resolved))
        rows.append({
            "bundle": str(resolved),
            "fingerprint": None,
            "disc_number": None,
            "disc_count": None,
            "layout": "state-recovered",
            "source_paths": ["."],
        })
    return rows


def reset_install_for_reinstall(set_id: str, game: dict, sources: list[dict]) -> dict:
    """Reset only mutable install/runtime state, preserving ingested media.

    This is intentionally conservative: if no preserved source can be found, the
    existing installation is left untouched and the request fails visibly.
    """
    state = load_json(state_path(set_id))
    if not sources:
        sources = _reinstall_source_fallback(set_id, state)
    if not sources:
        return state_update(
            set_id,
            status=state.get("status") or "setup-required",
            phase="reinstall-source-missing",
            detail="Reinstall requested, but the preserved install source could not be found. Existing installed files were left untouched.",
            reinstall_error="preserved-source-not-found",
        )

    root = archive_root()
    install_root = Path(str(state.get("install_root") or root / "games/installed" / set_id))
    history = STATE_ROOT / "reinstall-history" / set_id
    history.mkdir(parents=True, exist_ok=True)
    stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    try:
        save_json(history / f"{stamp}.json", state)
    except Exception:
        pass

    # Preserve logs across reinstalls, but discard mutable game payload/prefixes.
    (install_root / ".pcga-install-complete").unlink(missing_ok=True)
    if _is_call_of_duty_2(game):
        # Never continue a reinstall after failing to detach the synthetic optical
        # mount.  Continuing used to feed the mounted read-only setup-source into
        # generic staging, which then died on 00000001.TMP with EROFS.
        if not _cleanup_cod2_synthetic_setup_media(install_root):
            return state_update(
                set_id,
                status="setup-required", phase="interactive-setup",
                setup_reason="setup-source-busy",
                stream_state="pending", stream_app_title=None,
                reinstall_error="setup-media-busy",
                detail="Reinstall is waiting for the existing COD2 synthetic optical setup volume to detach; end any active setup stream and retry",
            )
    for name in ("prefix", "portable", "setup-source"):
        target = install_root / name
        if target.exists():
            if target.is_dir():
                shutil.rmtree(target, ignore_errors=True)
            else:
                target.unlink(missing_ok=True)
    for name in ("pcga-setup-session.log",):
        target = install_root / name
        if target.is_file():
            try:
                shutil.copy2(target, history / f"{stamp}-{name}")
            except OSError:
                pass
            target.unlink(missing_ok=True)

    # Runtime images are derived artifacts. Force a rebuild after installation.
    for image in {
        str(state.get("runtime_image") or ""),
        str(state.get("setup_runtime_image") or ""),
        "pcga/game-" + set_id.lower(),
        "pcga/setup-" + set_id.lower(),
    }:
        if image:
            subprocess.run(["docker", "image", "rm", "-f", image], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)

    return state_update(
        set_id,
        title=game.get("title") or state.get("title"),
        status="queued",
        phase="reinstall-pending",
        detail="Reinstall requested; mutable install state was reset while preserved source media was retained",
        reinstall_requested_at=now(),
        install_generation=stamp,
        reinstall_error=None,
        installer=None,
        install_method=None,
        launch_executable=None,
        runtime_image=None,
        runtime_build_hash=None,
        stream_state="pending",
        stream_app_title=None,
        stream_detail=None,
        setup_reason=None,
        setup_source=None,
        setup_installer=None,
        setup_kind=None,
        setup_runtime_image=None,
        setup_runtime_build_hash=None,
        setup_runtime_log=None,
        setup_source_iso_v01866=None,
        setup_source_device_v01866=None,
        setup_source_volume_label_v01866=None,
        setup_source_multidisc_optical_v01866=False,
        setup_source_multidisc_merged_v01858=False,
        setup_source_multidisc_merged_v01862=False,
        setup_source_msi_media_flattened_v01858=None,
        setup_source_msi_media_flattened_v01862=None,
        setup_source_msi_media_flattened_v01866=None,
    )


def recover_related_preserved_sources(set_id: str, game: dict) -> list[dict]:
    """Recover optical source rows from conservative title-linked sibling records.

    Duplicate cleanup intentionally keeps source-only preservation records.  A
    canonical runtime can later need those rows again (for example COD2 after a
    broken portable runtime is demoted to setup).  Reuse only siblings that share
    the strict catalog identity aliases already used for duplicate convergence.
    """
    try:
        mapping = scan_sources(archive_root())
    except Exception:
        return []
    direct = list(mapping.get(set_id) or [])
    aliases = _catalog_record_identity_aliases(set_id) | catalog_identity_aliases(game.get("title"))
    recovered=[]
    seen=set()
    candidates=[(set_id,direct)]
    if aliases:
        candidates.extend(
            (sid,rows) for sid,rows in mapping.items()
            if sid != set_id and (_catalog_record_identity_aliases(sid) & aliases)
        )
    for sid, rows in candidates:
        for row in rows:
            bundle=str(row.get("bundle") or "")
            fingerprint=str(row.get("fingerprint") or "")
            key=(bundle,fingerprint,str(row.get("disc_number") or ""))
            if key in seen:
                continue
            seen.add(key); recovered.append(dict(row))
    if recovered:
        log(f"recovered {len(recovered)} preserved source row(s) for {game.get('title') or set_id} from title-linked source records")
    return recovered


def silent_install(set_id: str, game: dict, sources: list[dict], force: bool = False) -> dict:
    root = archive_root()
    install_dir = root / "games/installed" / set_id
    prefix = install_dir / "prefix"
    install_dir.mkdir(parents=True, exist_ok=True)
    prior = load_json(state_path(set_id))
    effective_sources = list(sources) or recover_related_preserved_sources(set_id, game)
    current_isos = source_isos(effective_sources)
    isos = current_isos or persisted_media_isos(prior)
    source_count = logical_disc_count(effective_sources, current_isos) if (effective_sources or current_isos) else 0
    game_media = game.get("media") if isinstance(game.get("media"), dict) else {}
    try:
        declared_count = int(game_media.get("disc_count") or 0)
    except (TypeError, ValueError):
        declared_count = 0
    disc_count = max(source_count, persisted_disc_count(prior, isos), declared_count)
    fields = {
        "title": game.get("title"),
        "source_logical_disc_count": disc_count,
        "install_root": str(install_dir),
    }
    if effective_sources:
        fields["source_bundles"] = [x.get("bundle") for x in effective_sources]
    if isos:
        fields["source_isos"] = [str(x) for x in isos]
    state_update(set_id, **fields)
    if not isos:
        return state_update(set_id, status="setup-required", phase="source", detail="No mountable ISO was found in the preserved source bundle or persisted runtime-media inventory", setup_reason="no-iso")
    multi_disc = disc_count > 1
    if multi_disc:
        return stage_multidisc_installer_from_isos(set_id, install_dir, isos, disc_count)
    mountpoint = Path("/run/pcga-game-installer") / set_id / "disc1"
    try:
        with mounted_iso(isos[0], mountpoint) as src:
            hints=[]
            for row in effective_sources:
                for hint in row.get("source_paths") or []:
                    hint=str(hint or ".").strip().replace("\\","/")
                    if hint and hint not in hints: hints.append(hint)
            compilation = any(str(row.get("layout") or "")=="compilation" for row in effective_sources)
            # A non-dot source_path is meaningful for anthologies/compilations,
            # where several games share one disc tree. For an ordinary single-title
            # disc it is merely a metadata hint and must not narrow installer
            # discovery to GameData/Support/etc. That mistake selected managed
            # helpers such as GameData/Setup.exe (syscheck) instead of the disc's
            # vendor bootstrapper.
            rel_hint=next((x for x in hints if x not in {".","./"}), ".") if compilation else "."
            if compilation and rel_hint==".":
                return state_update(set_id, status="setup-required", phase="installer", detail="Compilation game membership has no source directory/installer mapping yet", setup_reason="compilation-source-map")
            install_source=(src/rel_hint).resolve() if rel_hint!="." else src
            try:
                install_source.relative_to(src.resolve())
            except ValueError:
                return state_update(set_id, status="failed", phase="installer", detail="Game source path escaped the preserved disc root")
            if not install_source.exists():
                return state_update(set_id, status="setup-required", phase="installer", detail=f"Mapped anthology source path is missing: {rel_hint}", setup_reason="source-path-missing")
            installer = scan_installers(install_source)
            installer["source_path"]=rel_hint
            state_update(set_id, installer=installer, phase="installer-detected")
            kind = installer.get("kind")
            if multi_disc:
                # Multi-disc installs must stay interactive, but still need a
                # concrete vendor entry point.  Stage disc 1 through the same
                # bootstrapper-aware scanner used for single-disc titles; all
                # preserved members are attached later by ensure_runtime_media().
                if installer.get("relative") and kind != "portable-candidate":
                    staged = prepare_interactive_source(set_id, install_dir, install_source, installer)
                    return state_update(
                        set_id, status="setup-required", phase="interactive-setup",
                        detail=f"{disc_count}-disc installer set staged through {Path(str(installer.get('relative'))).name}; use the streamed disc controls when the installer requests another disc",
                        setup_reason="multi-disc", setup_kind=kind, setup_disc_count=disc_count,
                    )
                return state_update(
                    set_id, status="setup-required", phase="installer",
                    detail=f"{disc_count}-disc installer set requires interactive setup, but no vendor bootstrapper could be identified on disc 1",
                    setup_reason="multi-disc-installer-unidentified", setup_disc_count=disc_count,
                )
            if kind == "portable-candidate":
                # A disc with directly runnable binaries is copied once as the template.
                payload = install_dir / "portable"
                if payload.exists() and force: shutil.rmtree(payload)
                if not payload.exists(): shutil.copytree(install_source, payload, dirs_exist_ok=True)
                exe_rel = str(Path("portable") / installer["relative"])
                return state_update(set_id, status="ready", phase="installed", install_method="portable-copy", launch_executable=exe_rel, detail="Portable game payload copied from preserved ISO")
            if kind not in {"msi", "inno", "nsis", "installshield"}:
                if installer.get("relative"):
                    return prepare_interactive_source(set_id, install_dir, install_source, installer)
                return state_update(set_id, status="setup-required", phase="installer", detail=f"{kind or 'unknown'} installer requires identification before setup", setup_reason=kind or "unknown-installer")
            if kind == "installshield" and not any(p.name.lower() == "setup.iss" for p in install_source.rglob("*") if p.is_file()):
                return prepare_interactive_source(set_id, install_dir, install_source, installer)
            image = load_env(RUNTIME_ENV).get("PCGA_GAME_RUNTIME_IMAGE", DEFAULT_RUNTIME_IMAGE)
            if not ensure_runtime_image(image, set_id):
                return state_update(set_id, status="failed", phase="runtime-image", detail=f"Could not pull runtime image {image}")
            prefix.mkdir(parents=True, exist_ok=True)
            try:
                os.chown(install_dir, 1000, 1000); os.chown(prefix, 1000, 1000)
            except OSError: pass
            rel = str(installer["relative"]).replace("\\", "/")
            win = "Z:\\pcga-source\\" + rel.replace("/", "\\")
            if kind == "msi": command = ["wine", "msiexec", "/i", win, "/qn", "/norestart"]
            elif kind == "inno": command = ["wine", win, "/VERYSILENT", "/SUPPRESSMSGBOXES", "/NORESTART", "/SP-"]
            elif kind == "nsis": command = ["wine", win, "/S"]
            else: command = ["wine", win, "/s"]
            state_update(set_id, status="installing", phase="silent-install", detail=f"Running {kind} installer unattended")
            compat_prelude = compatibility_shell_prelude(
                game, prefix_expr="$WINEPREFIX", marker_expr=f"$WINEPREFIX/{compatibility_marker(game)}"
            )
            silent_script = "set -e; mkdir -p /tmp/pcga-home; command -v wine >/dev/null; "
            if compat_prelude:
                silent_script += "\n" + compat_prelude + "\n"
            silent_script += " ".join(shlex.quote(x) for x in command)
            proc = subprocess.run([
                "docker", "run", "--rm", "--user", "1000:1000", "--entrypoint", "/bin/bash",
                "-e", "HOME=/tmp/pcga-home", "-e", "WINEPREFIX=/pcga-prefix",
                "-v", f"{prefix}:/pcga-prefix:rw", "-v", f"{install_source}:/pcga-source:ro", image,
                "-lc", silent_script
            ], timeout=int(load_env(RUNTIME_ENV).get("PCGA_INSTALL_TIMEOUT_SECONDS", "1800")), capture_output=True, text=True)
            if proc.returncode != 0:
                installer_log = (proc.stdout + "\n" + proc.stderr)[-6000:]
                # Never carry a failed/partially-created prefix into the interactive
                # session. Wine loader status c0000135 is especially prone to leaving
                # an unusable prefix that then makes the streamed installer exit at once.
                reset_interactive_prefix(install_dir, reason=f"failed unattended {kind} install rc={proc.returncode}")
                staged = prepare_interactive_source(set_id, install_dir, install_source, installer)
                staged.update({
                    "installer_log": installer_log,
                    "setup_prefix_reset_at": now(),
                    "setup_prefix_reset_reason": f"unattended-{kind}-rc-{proc.returncode}",
                    "detail": f"Unattended {kind} install returned {proc.returncode}; interactive Wolf/Moonlight setup is ready with a clean Wine prefix",
                })
                save_json(state_path(set_id), staged)
                return staged
    except subprocess.TimeoutExpired:
        return state_update(set_id, status="setup-required", phase="silent-install", detail="Unattended installer timed out; use streamed setup", setup_reason="timeout")
    except Exception as exc:
        return state_update(set_id, status="failed", phase="installer", detail=f"{type(exc).__name__}: {str(exc)[:280]}")

    # Pick the likely game executable from the installed prefix.
    chosen = choose_installed_executable(install_dir, game)
    if not chosen:
        return state_update(set_id, status="setup-required", phase="launch-detection", detail="Install completed but PCGA could not identify a safe game executable", setup_reason="launch-executable")
    return state_update(set_id, status="ready", phase="installed", install_method=installer.get("kind"), launch_executable=str(chosen.relative_to(install_dir)), detail="Installed template is ready for isolated streamed sessions")


def shell_quote(s: str) -> str:
    return "'" + s.replace("'", "'\"'\"'") + "'"



def normalize_install_template_permissions(root: Path) -> None:
    """Make mutable installed templates readable by Wolf's unprivileged user.

    This touches only /games/installed state, never the preserved optical source.
    Python's chmod walk handles ordinary trees; GNU chmod is used as a second
    bounded pass because older copied media can contain directory modes/ACL-ish
    edge cases that caused `cp -a /pcga-template/.` to fail before Wine started.
    """
    if not root.exists():
        return
    for base, dirs, files in os.walk(root, followlinks=False):
        bp=Path(base)
        for q in [bp, *(bp / name for name in dirs)]:
            try:
                if q.is_symlink():
                    continue
                mode=stat.S_IMODE(q.stat().st_mode)
                q.chmod(mode | 0o055)
            except OSError:
                pass
        for name in files:
            q=bp/name
            try:
                if q.is_symlink():
                    continue
                mode=stat.S_IMODE(q.stat().st_mode)
                q.chmod(mode | 0o044)
            except OSError:
                pass
    subprocess.run(
        ["chmod","-R","a+rX",str(root)],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False,
    )

def _ensure_portable_prefix_template(set_id: str, install_dir: Path, state: dict) -> tuple[bool, str]:
    """Seed a valid Wine prefix for true portable-copy titles.

    Older PCGA releases copied the optical payload but no Wine prefix.  The
    streamed runtime then set WINEPREFIX to an empty directory and failed with
    missing C:\\windows/kernel32.dll before the game executable could start.
    """
    if str(state.get("install_method") or "") != "portable-copy":
        return True, "not-portable"
    prefix = install_dir / "prefix"
    kernel = prefix / "drive_c" / "windows" / "system32" / "kernel32.dll"
    if kernel.is_file():
        return True, "ready"
    image = load_env(RUNTIME_ENV).get("PCGA_GAME_RUNTIME_IMAGE", DEFAULT_RUNTIME_IMAGE)
    if not ensure_runtime_image(image, set_id):
        return False, f"runtime image unavailable: {image}"
    prefix.mkdir(parents=True, exist_ok=True)
    try:
        os.chown(prefix, 1000, 1000)
    except OSError:
        pass
    proc = subprocess.run([
        "docker", "run", "--rm", "--user", "1000:1000", "--entrypoint", "/bin/bash",
        "-e", "HOME=/tmp/pcga-home", "-e", "WINEPREFIX=/pcga-prefix",
        "-v", f"{prefix}:/pcga-prefix:rw", image,
        "-lc", "mkdir -p /tmp/pcga-home; wineboot -u >/tmp/pcga-wineboot.log 2>&1; rc=$?; wineserver -w >/dev/null 2>&1 || true; cat /tmp/pcga-wineboot.log; exit $rc",
    ], capture_output=True, text=True, timeout=180)
    if proc.returncode != 0 or not kernel.is_file():
        return False, (proc.stdout + "\n" + proc.stderr)[-3000:]
    normalize_install_template_permissions(prefix)
    return True, "created"


def build_runtime_image(set_id: str, game: dict, state: dict) -> dict:
    if state.get("status") != "ready" or not state.get("launch_executable"):
        return state
    root = archive_root(); install_dir = Path(str(state.get("install_root") or root / "games/installed" / set_id))
    prefix_ok, prefix_detail = _ensure_portable_prefix_template(set_id, install_dir, state)
    if not prefix_ok:
        return state_update(
            set_id, status="ready", phase="runtime-prefix", stream_state="failed",
            stream_backend="wolf",
            stream_detail="Portable runtime Wine prefix initialization failed",
            runtime_build_log=prefix_detail,
        )
    if prefix_detail == "created":
        state = state_update(set_id, portable_prefix_repaired_v01841=True)
    normalize_install_template_permissions(install_dir)
    runtime_log_dir = install_dir / "runtime-logs"
    runtime_log_dir.mkdir(parents=True, exist_ok=True)
    try:
        os.chown(runtime_log_dir, 1000, 1000)
    except OSError:
        pass
    build = STATE_ROOT / "build" / set_id; build.mkdir(parents=True, exist_ok=True)
    launch_rel = str(state["launch_executable"]).replace("\\", "/")
    launch_variants = discover_launch_variants(install_dir, launch_rel)
    launch_variant_default = next((str(x.get("key")) for x in launch_variants if x.get("default")), None)
    existing_variants = state.get("launch_variants") if isinstance(state.get("launch_variants"), list) else []
    if launch_variants != existing_variants or state.get("launch_variant_default") != launch_variant_default or not state.get("launch_variant_detection_v01871"):
        state = state_update(
            set_id,
            launch_variants=launch_variants,
            launch_variant_default=launch_variant_default,
            launch_variant_mode=("executable-role" if len(launch_variants) > 1 else None),
            launch_variant_detection_v01871=True,
        )
    had_generation = bool(state.get("install_generation"))
    generation = str(state.get("install_generation") or hashlib.sha256((set_id + "|" + launch_rel).encode()).hexdigest()[:12])
    legacy_marker_compatible = "1" if not had_generation else "0"
    if not had_generation:
        state = state_update(set_id, install_generation=generation)
    title = str(game.get("title") or "PC Game")
    compat_prelude = compatibility_shell_prelude(
        game,
        prefix_expr="$WINEPREFIX",
        marker_expr=f"$WINEPREFIX/{compatibility_marker(game)}",
        include_runtime_environment=False,
    )
    compat_game_env_prelude = compatibility_runtime_environment_prelude(game)
    compat_launch_args = compatibility_launch_arguments(game)
    compat_launch_shell = " ".join(shell_quote(x) for x in compat_launch_args)
    compat_arch = compatibility_wine_arch(game)
    requested_runner_id, requested_runner_docker = compatibility_wine_runner_dockerfile(game)
    runtime_runner_id, runtime_runner_docker = requested_runner_id, requested_runner_docker
    # If an isolated runner could not be built, keep the title playable with the
    # base image rather than reporting READY/FAILED forever or nudging the user
    # toward a destructive reinstall. A later PCGA release can clear this marker
    # to retry the isolated layer deliberately.
    if (state.get("runtime_wine_runner_fallback_v01877")
            and state.get("runtime_wine_runner_requested") == requested_runner_id):
        runtime_runner_id, runtime_runner_docker = "base-image-wine", ""
    media_prelude = runtime_media_shell_prelude(state, game, compat_overlay=True)
    # GOW app images run startup.sh as the unprivileged retro user. The template
    # is copied into each Wolf profile/app home on first launch, giving each
    # player isolated mutable Wine/save state while preserving one master install.
    variant_target_lines=[]
    if len(launch_variants) > 1 and launch_variant_default:
        variant_target_lines.append(f'PCGA_LAUNCH_VARIANT="${{PCGA_LAUNCH_VARIANT:-{launch_variant_default}}}"')
        variant_target_lines.append('case "$PCGA_LAUNCH_VARIANT" in')
        for row in launch_variants:
            key=str(row.get("key") or "")
            rel=str(row.get("executable") or "").replace("\\", "/")
            if not key or not rel:
                continue
            variant_target_lines.append(f'  {shell_quote(key)}) TARGET="$INSTANCE/{rel}" ;;')
        variant_target_lines.append('  *) echo "[pcga-game] ERROR: unknown launch variant: $PCGA_LAUNCH_VARIANT" >&2; exit 64 ;;')
        variant_target_lines.append('esac')
        variant_target_lines.append('echo "[pcga-game] launch variant: $PCGA_LAUNCH_VARIANT -> $(basename "$TARGET")" >&2')
    else:
        variant_target_lines.append(f'TARGET="$INSTANCE/{launch_rel}"')
    variant_target_shell="\n".join(variant_target_lines)
    startup = f'''#!/bin/bash
set -Eeuo pipefail
# GOW launch-comp.sh tests RUN_GAMESCOPE with `-n` and is not nounset-safe.
# PCGA uses Sway for legacy Wine sessions, so define Gamescope explicitly empty
# before sourcing the helper. This is both `set -u` safe and keeps Gamescope off.
export RUN_GAMESCOPE=""
export RUN_SWAY="${{RUN_SWAY:-1}}"
source /opt/gow/launch-comp.sh
LOG=/pcga-runtime-logs/session.log
mkdir -p /pcga-runtime-logs /home/retro /home/retro/.config /home/retro/.cache
touch "$LOG" 2>/dev/null || true
exec > >(tee -a "$LOG") 2>&1
pcga_signal=none
pcga_launcher_pid=""
pcga_on_signal() {{
  pcga_signal="$1"
  echo "[pcga-game] received signal=$1 at $(date -Is); runtime container/session is being terminated externally" >&2
  if [[ -n "${{pcga_launcher_pid:-}}" ]] && kill -0 "$pcga_launcher_pid" 2>/dev/null; then
    echo "[pcga-game] forwarding signal=$1 to launcher pid=$pcga_launcher_pid" >&2
    kill -s "$1" "$pcga_launcher_pid" 2>/dev/null || true
  fi
}}
pcga_on_exit() {{
  rc=$?
  echo "[pcga-game] shell exiting rc=$rc signal=$pcga_signal at $(date -Is)" >&2
}}
trap 'pcga_on_signal TERM' TERM
trap 'pcga_on_signal INT' INT
trap 'pcga_on_signal HUP' HUP
trap pcga_on_exit EXIT
export HOME=/home/retro
export XDG_CONFIG_HOME=/home/retro/.config
export XDG_CACHE_HOME=/home/retro/.cache
# The appliance does not expose a desktop accessibility bus. GTK/Waybar probing
# for AT-SPI is harmless but extremely noisy in persisted game logs.
export NO_AT_BRIDGE=1
echo "[pcga-game] ===== session $(date -Is) ====="
TEMPLATE=/pcga-template
INSTANCE=/home/retro/pcga-game
if [[ ! -f "$INSTANCE/.pcga-template-{set_id}-{generation}" ]]; then
  if [[ {legacy_marker_compatible} == 1 && -f "$INSTANCE/.pcga-template-{set_id}" ]]; then
    # v0.17.58 marker migration for an existing install: do not recopy or disturb
    # the player's current prefix/saves merely because the marker format changed.
    mv "$INSTANCE/.pcga-template-{set_id}" "$INSTANCE/.pcga-template-{set_id}-{generation}"
  else
    # A real reinstall changes install_generation. Preserve the player's previous
    # runtime instance before refreshing from the newly installed host template.
    BACKUP=/home/retro/pcga-game-pre-reinstall
    rm -rf "$BACKUP"
    if [[ -d "$INSTANCE" ]]; then mv "$INSTANCE" "$BACKUP"; fi
    mkdir -p "$INSTANCE"
    cp -a "$TEMPLATE"/. "$INSTANCE"/
    touch "$INSTANCE/.pcga-template-{set_id}-{generation}"
  fi
fi
{variant_target_shell}
if [[ ! -f "$TARGET" ]]; then
  echo "PCGA launch executable missing: $TARGET" >&2
  exit 66
fi
# Make incomplete COD2 installs explicit before Wine's loader turns the session
# into a short black stream.  The host reconciler normally catches this first,
# but runtime instances can survive an upgrade until their generation refreshes.
case "${{TARGET,,}}" in
  */cod2sp_s.exe|*/cod2mp_s.exe)
    if ! find "$(dirname "$TARGET")" -maxdepth 1 -type f -iname 'mss32.dll' -print -quit 2>/dev/null | grep -q .; then
      echo "[pcga-game] ERROR: COD2 runtime payload is incomplete: mss32.dll is missing beside $(basename "$TARGET"); reinstall required" >&2
      exit 53
    fi
    ;;
esac
export PCGA_BASE_PREFIX="$INSTANCE/prefix"
export WINEPREFIX="$PCGA_BASE_PREFIX"
export PCGA_EXPECTED_WINE_ARCH={shlex.quote(compat_arch)}
export PCGA_WINE_RUNNER_EXPECTED={shlex.quote(runtime_runner_id)}
pcga_cod2_sp=0
pcga_cod2_mp=0
case "${{TARGET,,}}" in
  */cod2sp_s.exe) pcga_cod2_sp=1 ;;
  */cod2mp_s.exe) pcga_cod2_mp=1 ;;
esac

# v0.18.77 keeps multiplayer on the known-good base Wine runtime even when the
# COD2 image contains an isolated experimental runner. The isolated runner is
# relevant only to the SafeDisc-protected single-player executable.
if [[ $pcga_cod2_mp -eq 1 && -x /usr/bin/wine ]]; then
  unset PCGA_WINE_BIN PCGA_WINESERVER_BIN
  export PCGA_WINE_RUNNER=base-image-wine
  export PCGA_WINE_RUNNER_EXPECTED=base-image-wine
  export PATH="/usr/bin:/bin:$PATH"
elif [[ -n "${{PCGA_WINE_BIN:-}}" ]]; then
  [[ -x "$PCGA_WINE_BIN" ]] || {{ echo "[pcga-game] ERROR: isolated Wine runner is missing: $PCGA_WINE_BIN" >&2; exit 88; }}
  export PATH="$(dirname "$PCGA_WINE_BIN"):$PATH"
fi

pcga_effective_wine="$(command -v wine 2>/dev/null || true)"
pcga_effective_wineserver="$(command -v wineserver 2>/dev/null || true)"
echo "[pcga-runner] selected=${{PCGA_WINE_RUNNER:-base-image-wine}} expected=$PCGA_WINE_RUNNER_EXPECTED wine=${{pcga_effective_wine:-missing}} wineserver=${{pcga_effective_wineserver:-missing}}" >&2
if [[ "${{PCGA_WINE_RUNNER:-base-image-wine}}" != "$PCGA_WINE_RUNNER_EXPECTED" ]]; then
  echo "[pcga-game] ERROR: runtime Wine runner mismatch; rebuild the per-game runtime image" >&2
  exit 88
fi

# Validate the known-good installed prefix before an experimental runner creates
# its own runtime prefix. The retail installer remains on the genuine win32
# prefix that v0.18.72 established successfully.
pcga_prefix_arch="$(grep -m1 '^#arch=' "$PCGA_BASE_PREFIX/system.reg" 2>/dev/null | cut -d= -f2 | tr -d '\r[:space:]' || true)"
if [[ -n "${{PCGA_EXPECTED_WINE_ARCH:-}}" ]]; then
  echo "[pcga-compat] installed Wine prefix architecture: existing=${{pcga_prefix_arch:-unknown}} required=$PCGA_EXPECTED_WINE_ARCH" >&2
  if [[ "$pcga_prefix_arch" != "$PCGA_EXPECTED_WINE_ARCH" ]]; then
    echo "[pcga-game] ERROR: installed Wine prefix architecture mismatch; host reconciliation/reinstall is required before launch" >&2
    exit 87
  fi
fi

# Wine 11's new WoW64 mode should not use the pure WINEARCH=win32 install prefix
# as its native prefix. Single-player therefore gets a persistent runner-owned
# default/WoW64 prefix. The installed COD2 payload is projected into that prefix
# with hard links, preserving C:/Program Files (x86) semantics without another
# multi-gigabyte copy.
if [[ $pcga_cod2_sp -eq 1 && "${{PCGA_WINE_RUNNER:-base-image-wine}}" != "base-image-wine" && -n "${{PCGA_WINE_BIN:-}}" ]]; then
  pcga_runner_prefix="$INSTANCE/runner-prefixes/${{PCGA_WINE_RUNNER}}"
  pcga_runner_wineboot="$(dirname "$PCGA_WINE_BIN")/wineboot"
  pcga_runner_wineserver="${{PCGA_WINESERVER_BIN:-$(dirname "$PCGA_WINE_BIN")/wineserver}}"
  if [[ ! -f "$pcga_runner_prefix/system.reg" ]]; then
    echo "[pcga-runner] creating COD2 single-player runner prefix: $pcga_runner_prefix" >&2
    rm -rf "$pcga_runner_prefix"
    mkdir -p "$pcga_runner_prefix"
    if ! env -u WINEARCH WINEPREFIX="$pcga_runner_prefix" "$pcga_runner_wineboot" -i </dev/null; then
      echo "[pcga-runner] isolated runner prefix creation failed; falling back to base Wine without touching the installed prefix" >&2
      rm -rf "$pcga_runner_prefix"
      unset PCGA_WINE_BIN PCGA_WINESERVER_BIN
      export PCGA_WINE_RUNNER=base-image-wine
      export PCGA_WINE_RUNNER_EXPECTED=base-image-wine
      export PATH="/usr/bin:/bin:$PATH"
      export WINEPREFIX="$PCGA_BASE_PREFIX"
    else
      WINEPREFIX="$pcga_runner_prefix" "$pcga_runner_wineserver" -w >/dev/null 2>&1 || true
    fi
  fi
  if [[ "${{PCGA_WINE_RUNNER:-base-image-wine}}" != "base-image-wine" ]]; then
    pcga_runner_arch="$(grep -m1 '^#arch=' "$pcga_runner_prefix/system.reg" 2>/dev/null | cut -d= -f2 | tr -d '\r[:space:]' || true)"
    if [[ "$pcga_runner_arch" != "win64" ]]; then
      echo "[pcga-runner] isolated Wine 11 prefix is not native WoW64/win64 (arch=${{pcga_runner_arch:-unknown}}); falling back to base Wine" >&2
      unset PCGA_WINE_BIN PCGA_WINESERVER_BIN
      export PCGA_WINE_RUNNER=base-image-wine
      export PCGA_WINE_RUNNER_EXPECTED=base-image-wine
      export PATH="/usr/bin:/bin:$PATH"
      export WINEPREFIX="$PCGA_BASE_PREFIX"
    else
      pcga_base_game_dir="$(dirname "$TARGET")"
      pcga_runner_game_dir="$pcga_runner_prefix/drive_c/Program Files (x86)/Activision/Call of Duty 2"
      if [[ ! -f "$pcga_runner_game_dir/CoD2SP_s.exe" ]]; then
        echo "[pcga-runner] projecting installed COD2 payload into isolated WoW64 prefix" >&2
        rm -rf "$pcga_runner_game_dir"
        mkdir -p "$pcga_runner_game_dir"
        if ! cp -al "$pcga_base_game_dir"/. "$pcga_runner_game_dir"/ 2>/dev/null; then
          echo "[pcga-runner] hard-link projection failed; using a normal file copy for the runner-owned prefix" >&2
          rm -rf "$pcga_runner_game_dir"
          mkdir -p "$pcga_runner_game_dir"
          cp -a "$pcga_base_game_dir"/. "$pcga_runner_game_dir"/
        fi
      fi
      export WINEPREFIX="$pcga_runner_prefix"
      TARGET="$pcga_runner_game_dir/$(basename "$TARGET")"
      echo "[pcga-runner] COD2 single-player isolated prefix ready: arch=$pcga_runner_arch target=$TARGET" >&2
    fi
  fi
fi

case "${{TARGET,,}}" in
  */cod2sp_s.exe)
    echo "[pcga-compat] COD2 single-player profile: preserved win32 install • runner-isolated WoW64 when available • original SecDrv staging • preserved optical media" >&2
    ;;
  */cod2mp_s.exe)
    echo "[pcga-compat] COD2 multiplayer profile: preserved win32 install • base Wine runtime • preserved optical media" >&2
    ;;
esac
{compat_prelude}
{media_prelude}

# v0.18.78: do not hand COD2 SP to SafeDisc unless the *selected runner prefix*
# sees the expected retail play disc through Win32 APIs. This catches stale
# wineserver DOS-device caches as a media-mapping error instead of presenting
# COD2's misleading "insert the correct CD/DVD-ROM" dialog.
if [[ $pcga_cod2_sp -eq 1 ]]; then
  pcga_cod2_vol="$(timeout 8 wine cmd /c vol D: 2>&1 | tr -d '\r' || true)"
  printf '%s\n' "$pcga_cod2_vol" | sed -e 's/^/[pcga-media] COD2 SP validation: /' >&2
  pcga_cod2_drive_row="$(timeout 8 wine wmic logicaldisk get DeviceID,DriveType,VolumeName 2>/dev/null | tr -d '\r' | awk '$1 == "D:" {{print; exit}}' || true)"
  echo "[pcga-media] COD2 SP Win32 drive probe: ${{pcga_cod2_drive_row:-missing}}" >&2
  if ! printf '%s\n' "$pcga_cod2_vol" | grep -qi 'COD2CD1'; then
    echo "[pcga-media] ERROR: COD2 single-player requires D:=COD2CD1; refusing launch with stale/unlabelled optical mapping" >&2
    exit 81
  fi
  if [[ -n "$pcga_cod2_drive_row" ]]; then
    if [[ ! "$pcga_cod2_drive_row" =~ ^D:([[:space:]]+)5([[:space:]]+) ]]; then
      echo "[pcga-media] ERROR: COD2 single-player D: is not reported as DRIVE_CDROM (5); refusing launch" >&2
      exit 82
    fi
  else
    # Some portable Wine builds omit WMIC. In that case require the Wine drive
    # registry to agree with the D:: raw-device mapping rather than rejecting a
    # correctly-labelled disc only because the diagnostic utility is absent.
    pcga_cod2_drive_reg="$(timeout 8 wine reg query 'HKEY_LOCAL_MACHINE\\Software\\Wine\\Drives' /v 'd:' 2>/dev/null | tr -d '\r' || true)"
    printf '%s\n' "$pcga_cod2_drive_reg" | sed -e 's/^/[pcga-media] COD2 SP drive-registry fallback: /' >&2
    printf '%s\n' "$pcga_cod2_drive_reg" | grep -Eqi 'd:.*REG_SZ.*cdrom' || {{
      echo "[pcga-media] ERROR: COD2 single-player cannot verify D: as a CD-ROM; refusing launch" >&2
      exit 82
    }}
  fi
fi

# Retail COD2 Disc 1 contains the original SafeDisc SecDrv.sys. Modern Wine can
# create the SecDrv service yet fail ZwLoadDriver when the original driver file
# has not been materialized into the prefix. Stage only the user's preserved
# original-media driver; no patched/no-CD executable is introduced.
if [[ $pcga_cod2_sp -eq 1 ]]; then
  pcga_secdrv_src="$(find /pcga-media -maxdepth 5 -type f -iname 'secdrv.sys' -print -quit 2>/dev/null || true)"
  if [[ -n "$pcga_secdrv_src" && -r "$pcga_secdrv_src" ]]; then
    pcga_secdrv_sha="$(sha256sum "$pcga_secdrv_src" 2>/dev/null | awk '{{print $1}}' || true)"
    for pcga_driver_dir in "$WINEPREFIX/drive_c/windows/system32/drivers" "$WINEPREFIX/drive_c/windows/syswow64/drivers"; do
      mkdir -p "$pcga_driver_dir"
      cp -f "$pcga_secdrv_src" "$pcga_driver_dir/SecDrv.sys"
      chmod 0644 "$pcga_driver_dir/SecDrv.sys" 2>/dev/null || true
    done
    echo "[pcga-compat] staged original-media SecDrv.sys from $pcga_secdrv_src sha256=${{pcga_secdrv_sha:-unknown}}" >&2
  else
    echo "[pcga-compat] WARNING: original-media SecDrv.sys was not found under mounted COD2 media" >&2
  fi
  wine reg add 'HKCU\\Software\\Wine\\AppDefaults\\CoD2SP_s.exe' /v Version /t REG_SZ /d winxp /f >/dev/null 2>&1 || true
  wineserver -k >/dev/null 2>&1 || true
  sleep 0.25
  echo "[pcga-compat] CoD2SP_s.exe Windows-version override: winxp" >&2
fi

cd "$(dirname "$TARGET")"
echo "[pcga-game] launching $(basename "$TARGET") from $PWD" >&2
echo "[pcga-game] identity: $(id) HOME=$HOME WINEPREFIX=$WINEPREFIX" >&2
echo "[pcga-game] wine: $(wine --version 2>/dev/null || echo unavailable) • $(command -v wine 2>/dev/null || echo missing)" >&2
echo "[pcga-game] compositor env: RUN_SWAY=${{RUN_SWAY-<unset>}} RUN_GAMESCOPE=${{RUN_GAMESCOPE-<unset>}} WAYLAND_DISPLAY=${{WAYLAND_DISPLAY-<unset>}} XDG_RUNTIME_DIR=${{XDG_RUNTIME_DIR-<unset>}}" >&2
if [[ -d /dev/dri ]]; then
  ls -l /dev/dri >&2 || true
  for n in /dev/dri/renderD*; do
    [[ -e "$n" ]] || continue
    if [[ -r "$n" && -w "$n" ]]; then echo "[pcga-game] gpu access ok: $n" >&2; else echo "[pcga-game] WARNING: runtime user cannot read/write $n" >&2; fi
  done
else echo "[pcga-game] /dev/dri is not present" >&2; fi

# Classic Infinity Engine retail builds can reject modern Xwayland desktops
# because their DirectDraw startup probe cannot find an acceptable fullscreen
# mode. Keep Torment itself windowed; the streamed compositor owns presentation.
if [[ "${{TARGET,,}}" == *"/torment.exe" ]]; then
  while IFS= read -r -d '' ini; do
    if grep -qiE '^[[:space:]]*Full Screen[[:space:]]*=' "$ini"; then
      sed -i -E 's/^[[:space:]]*Full Screen[[:space:]]*=.*/Full Screen=0/I' "$ini"
    else
      printf '\n[Program Options]\nFull Screen=0\n' >> "$ini"
    fi
    echo "[pcga-game] applied classic Infinity Engine windowed-video compatibility: $ini" >&2
  done < <(find "$INSTANCE/prefix/drive_c" -type f -iname 'torment.ini' -print0 2>/dev/null)
fi

# PCGA streams are appliance surfaces, not Linux desktops. Suppress GOW's
# Waybar and use a plain black compositor background once Sway is ready.
pcga_args=({compat_launch_shell})
if (( ${{#pcga_args[@]}} > 0 )); then
  echo "[pcga-compat] applying known-good launch arguments: ${{pcga_args[*]}}" >&2
fi
case "${{TARGET,,}}" in
  */cod2sp_s.exe)
    # The retail COD2 SP executable can map its splash/title window and then
    # stall indefinitely while Wine attempts the legacy intro movie. Preserve
    # the authenticated optical path and skip only that obsolete intro.
    pcga_args+=(+set com_introplayed 1)
    echo "[pcga-compat] COD2 single-player: skipping legacy intro movie to avoid Wine startup hang" >&2
    ;;
  */battlefrontii.exe)
    # The 2005 Battlefront II executable supports a normal windowed mode and
    # explicit resolution. This avoids legacy fullscreen mode negotiation
    # disappearing behind a headless Xwayland/Sway stream.
    pcga_args+=(/win /resolution 1920 1080)
    echo "[pcga-game] applying Battlefront II windowed compatibility: ${{pcga_args[*]}}"
    ;;
  */swfoc.exe|*/sweaw.exe|*/starwarsg.exe)
    # Empire at War exposes a documented WINDOWED launch mode plus explicit
    # dimensions. Prefer the actual game executable over LaunchEAW.exe and keep
    # presentation under the streamed compositor.
    pcga_args+=(WINDOWED SCREENWIDTH=1920 SCREENHEIGHT=1080)
    echo "[pcga-game] applying Empire at War windowed compatibility: ${{pcga_args[*]}}"
    ;;
esac
# GOW's `launcher` helper ultimately serializes its argv into a shell command.
# Passing a Windows install path such as `Program Files (x86)` through that
# boundary loses argv quoting and `/bin/sh` treats the parenthesis as syntax.
# Persist the exact argv as NUL-delimited data and launch a fixed no-argument
# wrapper instead. This preserves spaces, parentheses, quotes and future odd
# retail install paths without relying on the launcher's string quoting.
PCGA_ARGV=/tmp/pcga-runtime.argv
printf '%s\\0' "$TARGET" "${{pcga_args[@]}}" >"$PCGA_ARGV"
cat >/tmp/pcga-wine-session.sh <<'PCGA_WINE_SESSION'
#!/bin/bash
set -uo pipefail
mapfile -d '' -t pcga_argv </tmp/pcga-runtime.argv
if (( ${{#pcga_argv[@]}} < 1 )); then
  echo "[pcga-wine-session] launch argv is missing" >&2
  exit 70
fi
target="${{pcga_argv[0]}}"
pcga_child_args=("${{pcga_argv[@]:1}}")
printf '[pcga-wine-session] argv:' >&2
printf ' %q' "${{pcga_argv[@]}}" >&2
printf '\n' >&2
cd "$(dirname "$target")" || exit 72
# Wine's X11 driver can race Sway/Xwayland during very fast direct-game launches.
# Sway reserves DISPLAY before Xwayland has necessarily accepted its first client,
# so wait for the display socket (and, when available, an actual X probe) before
# starting Wine. Installer sessions often hid this race behind prefix setup time.
pcga_wait_for_xwayland() {{
  local ticks="${{PCGA_XWAYLAND_WAIT_TICKS:-150}}"
  local i display_num socket probe_ok
  echo "[pcga-wine-session] waiting for Xwayland: DISPLAY=${{DISPLAY-<unset>}}" >&2
  for ((i=0; i<ticks; i++)); do
    socket=""
    if [[ -n "${{DISPLAY:-}}" ]]; then
      display_num="${{DISPLAY#*:}}"
      display_num="${{display_num%%.*}}"
      if [[ "$display_num" =~ ^[0-9]+$ ]]; then
        socket="/tmp/.X11-unix/X${{display_num}}"
      fi
    fi
    if [[ -z "$socket" || ! -S "$socket" ]]; then
      for socket in /tmp/.X11-unix/X*; do
        [[ -S "$socket" ]] || continue
        display_num="${{socket##*/X}}"
        [[ "$display_num" =~ ^[0-9]+$ ]] || continue
        export DISPLAY=":${{display_num}}"
        break
      done
    fi
    if [[ -n "${{socket:-}}" && -S "$socket" ]]; then
      probe_ok=1
      if command -v xdpyinfo >/dev/null 2>&1; then
        xdpyinfo -display "$DISPLAY" >/dev/null 2>&1 || probe_ok=0
      elif command -v xset >/dev/null 2>&1; then
        xset -display "$DISPLAY" q >/dev/null 2>&1 || probe_ok=0
      else
        # No X11 probe utility in the minimal image. Give Xwayland a short
        # settle period after its listening socket appears.
        sleep 0.25
      fi
      if [[ $probe_ok -eq 1 ]]; then
        echo "[pcga-wine-session] Xwayland ready: DISPLAY=$DISPLAY socket=$socket" >&2
        return 0
      fi
    fi
    sleep 0.1
  done
  echo "[pcga-wine-session] ERROR: Xwayland did not become ready after $ticks checks (DISPLAY=${{DISPLAY-<unset>}})" >&2
  return 71
}}
if ! pcga_wait_for_xwayland; then
  exit 71
fi
# Media/registry probes run before GOW starts Sway so they can prepare the
# persistent prefix. Those headless Wine invocations may leave wineserver /
# explorer helper processes alive with Wine's null display driver selected.
# Terminate that pre-compositor Wine server now that Xwayland is confirmed
# reachable; the real game then becomes the first Wine GUI process in a fresh
# server generation with DISPLAY available from process start.
if command -v wineserver >/dev/null 2>&1; then
  echo "[pcga-wine-session] resetting pre-compositor Wine helpers before GUI launch" >&2
  wineserver -k >/dev/null 2>&1 || true
  sleep 0.30
fi
# Re-check the X endpoint after the wineserver reset so a compositor failure is
# not misreported as another Wine graphics-driver problem.
if command -v xset >/dev/null 2>&1; then
  if ! xset -display "$DISPLAY" q >/dev/null 2>&1; then
    echo "[pcga-wine-session] ERROR: Xwayland became unreachable before Wine launch: DISPLAY=$DISPLAY" >&2
    exit 71
  fi
fi
echo "[pcga-wine-session] Wine GUI launch boundary ready: DISPLAY=$DISPLAY XAUTHORITY=${{XAUTHORITY-<unset>}}" >&2

# PCGA uses the Games-on-Whales Lutris image as a container base but launches
# Wine directly, so Lutris' runner-level DXVK switch never runs. Explicitly
# provision a pinned DXVK release into this per-user runtime prefix when Vulkan
# is actually usable. DirectDraw/D3D1-7 remain on WineD3D; OpenGL titles simply
# ignore the DXVK DLL overrides. Any Vulkan/DXVK failure falls back to WineD3D
# rather than turning a playable legacy title into a hard failure.
pcga_configure_graphics_backend() {{
  local backend="${{PCGA_GRAPHICS_BACKEND:-auto}}"
  local verb="${{PCGA_DXVK_WINETRICKS_VERB:-dxvk2062}}"
  local marker="$WINEPREFIX/.pcga-${{verb}}-installed"
  local vklog=/tmp/pcga-vulkan-summary.log
  pcga_use_wined3d() {{
    # Winetricks persists native DXVK DLL overrides in the prefix. A user can
    # later force WineD3D, or Auto can discover that the current GPU lacks a
    # usable Vulkan device. Override the DXVK DLL set as builtin for THIS launch
    # without destroying the prefix's DXVK installation, so switching back to
    # Auto/DXVK on capable hardware remains cheap and reversible.
    local builtin_d3d='d3d8,d3d9,d3d10core,d3d11,dxgi=b'
    if [[ -n "${{WINEDLLOVERRIDES:-}}" ]]; then
      export WINEDLLOVERRIDES="${{WINEDLLOVERRIDES}};${{builtin_d3d}}"
    else
      export WINEDLLOVERRIDES="$builtin_d3d"
    fi
  }}
  case "$backend" in
    auto|dxvk|wined3d) ;;
    *) echo "[pcga-graphics] invalid backend '$backend'; using auto" >&2; backend=auto ;;
  esac
  if [[ "$backend" == "wined3d" ]]; then
    pcga_use_wined3d
    echo "[pcga-graphics] backend=wined3d (forced); Direct3D uses Wine's built-in renderer" >&2
    return 0
  fi
  if ! command -v vulkaninfo >/dev/null 2>&1; then
    pcga_use_wined3d
    echo "[pcga-graphics] Vulkan probe unavailable (vulkaninfo missing); falling back to WineD3D" >&2
    return 0
  fi
  if ! timeout "${{PCGA_VULKAN_PROBE_SECONDS:-12}}" vulkaninfo --summary >"$vklog" 2>&1; then
    echo "[pcga-graphics] Vulkan probe failed; falling back to WineD3D" >&2
    sed -n '1,12p' "$vklog" >&2 2>/dev/null || true
    pcga_use_wined3d
    return 0
  fi
  local gpu_line api_line
  gpu_line="$(grep -m1 -E 'deviceName|GPU[0-9]+:' "$vklog" 2>/dev/null | sed 's/^[[:space:]]*//' || true)"
  api_line="$(grep -m1 -E 'apiVersion' "$vklog" 2>/dev/null | sed 's/^[[:space:]]*//' || true)"
  # Do not silently select Mesa's CPU Vulkan implementation. Lavapipe is useful
  # for diagnostics, but routing a streamed D3D game through software Vulkan is
  # almost always worse than WineD3D on the real OpenGL GPU.
  if grep -Eiq 'deviceName[[:space:]]*=.*(llvmpipe|lavapipe)|deviceType[[:space:]]*=.*CPU' "$vklog" 2>/dev/null; then
    pcga_use_wined3d
    echo "[pcga-graphics] Vulkan is software-only${{gpu_line:+ • $gpu_line}}; falling back to WineD3D" >&2
    return 0
  fi
  # DXVK 2.x requires Vulkan 1.3. A loader can exist while the selected GPU
  # exposes only an older API, so reject that case before changing DLL overrides.
  if ! grep -Eq 'apiVersion[[:space:]]*=.*1\\.(3|4)(\\.|[[:space:]]|$)' "$vklog" 2>/dev/null; then
    pcga_use_wined3d
    echo "[pcga-graphics] Vulkan device does not expose API 1.3+${{api_line:+ • $api_line}}; falling back to WineD3D" >&2
    return 0
  fi
  echo "[pcga-graphics] Vulkan available${{gpu_line:+ • $gpu_line}}${{api_line:+ • $api_line}}" >&2
  if [[ ! -f "$marker" ]]; then
    if ! command -v winetricks >/dev/null 2>&1; then
      pcga_use_wined3d
      echo "[pcga-graphics] winetricks unavailable; cannot provision $verb, falling back to WineD3D" >&2
      return 0
    fi
    echo "[pcga-graphics] provisioning pinned $verb for D3D8/9/10/11 -> Vulkan" >&2
    WINETRICKS_GUI=none WINEDEBUG=-all timeout "${{PCGA_DXVK_SETUP_SECONDS:-600}}" winetricks -q "$verb" </dev/null
    local dxvk_rc=$?
    wineserver -k >/dev/null 2>&1 || true
    sleep 0.35
    if [[ $dxvk_rc -ne 0 ]]; then
      pcga_use_wined3d
      echo "[pcga-graphics] $verb provisioning failed rc=$dxvk_rc; falling back to WineD3D" >&2
      return 0
    fi
    touch "$marker"
  fi
  # winetricks installs native overrides for DXVK's DLL set. Show the D3D9
  # override because most of the current retail target library is D3D9-era.
  local d3d9_override
  d3d9_override="$(wine reg query 'HKCU\\Software\\Wine\\DllOverrides' /v d3d9 2>/dev/null | tr -d '\\r' | tail -n 1 | xargs || true)"
  wineserver -k >/dev/null 2>&1 || true
  sleep 0.30
  echo "[pcga-graphics] backend=dxvk verb=$verb${{d3d9_override:+ • $d3d9_override}}" >&2
  if [[ "${{PCGA_DXVK_HUD:-0}}" == "1" ]]; then
    export DXVK_HUD="devinfo,fps"
    echo "[pcga-graphics] DXVK HUD enabled for verification" >&2
  fi
}}
pcga_configure_graphics_backend

# Scope game-specific graphics compatibility to Wine and its children.  The
# streamed compositor has already started with the host's full Mesa feature set.
{compat_game_env_prelude}
pcga_visible_game_window() {{
  command -v swaymsg >/dev/null 2>&1 || return 1
  SWAYSOCK=/run/user/wolf/sway.socket swaymsg -t get_tree -r 2>/dev/null | grep -Eq '"window"[[:space:]]*:[[:space:]]*[1-9][0-9]*'
}}
pcga_wine_debugger_active() {{
  # Wine starts winedbg after an unhandled Windows exception.  That debugger can
  # map its own X11 window, which fooled the generic window watchdog into
  # treating a crashed game as a healthy stream indefinitely.
  pgrep -x winedbg >/dev/null 2>&1 || \
  pgrep -x winedbg.exe >/dev/null 2>&1 || \
  pgrep -f '(^|/)[w]inedbg(\\.exe)?([[:space:]]|$)' >/dev/null 2>&1
}}

pcga_game_wine_log=/tmp/pcga-game-wine.log
: >"$pcga_game_wine_log"
rm -f /pcga-runtime-logs/last-failure.json 2>/dev/null || true
wine "./$(basename "$target")" "${{pcga_child_args[@]}}" > >(tee -a "$pcga_game_wine_log") 2>&1 &
main_pid=$!
# A Wine process that never maps a window leaves Moonlight faithfully streaming
# a black compositor forever. Give normal legacy startup a generous minute, but
# tear down a headless/hung launch rather than reserving a lane indefinitely.
pcga_window_seen=0
pcga_crash_detected=0
pcga_start_ticks="${{PCGA_GAME_WINDOW_START_TICKS:-600}}"
for ((pcga_tick=0; pcga_tick<pcga_start_ticks; pcga_tick++)); do
  if pcga_wine_debugger_active; then
    pcga_crash_detected=1
    echo "[pcga-wine-session] ERROR: Wine debugger detected after an unhandled game exception" >&2
    break
  fi
  if pcga_visible_game_window; then
    pcga_window_seen=1
    echo "[pcga-wine-session] first game window visible after ${{pcga_tick}} tick(s)" >&2
    break
  fi
  kill -0 "$main_pid" 2>/dev/null || break
  sleep 0.1
done
if [[ $pcga_crash_detected -eq 1 ]]; then
  kill -TERM "$main_pid" 2>/dev/null || true
  wineserver -k >/dev/null 2>&1 || true
  wait "$main_pid" 2>/dev/null || true
  main_rc=125
elif kill -0 "$main_pid" 2>/dev/null && [[ $pcga_window_seen -eq 0 ]]; then
  echo "[pcga-wine-session] ERROR: Wine stayed alive without mapping a game window; terminating black-screen session" >&2
  kill -TERM "$main_pid" 2>/dev/null || true
  sleep 1
  kill -KILL "$main_pid" 2>/dev/null || true
  wineserver -k >/dev/null 2>&1 || true
  wait "$main_pid" 2>/dev/null || true
  main_rc=124
else
  wait "$main_pid"
  main_rc=$?
fi
echo "[pcga-wine-session] primary Wine process exited rc=$main_rc at $(date -Is)"
pcga_known_legacy_drm_failure=0
if [[ $main_rc -ne 0 && "${{target,,}}" == */cod2sp_s.exe ]] \
    && grep -Eqi 'ZwLoadDriver.*SecDrv|Services\\SecDrv' "$pcga_game_wine_log" 2>/dev/null; then
  pcga_known_legacy_drm_failure=1
  pcga_secdrv_status="$(grep -Eio 'SecDrv[^[:space:]]*.*c[0-9a-f]{{7}}|ZwLoadDriver.*SecDrv.*c[0-9a-f]{{7}}' "$pcga_game_wine_log" 2>/dev/null | grep -Eio 'c[0-9a-f]{{7}}' | tail -n1 || true)"
  echo "[pcga-compat] ERROR: COD2 single-player hit the SafeDisc/SecDrv kernel-driver boundary status=${{pcga_secdrv_status:-unknown}} using runner=${{PCGA_WINE_RUNNER:-base-image-wine}}. Optical media and prefix architecture already passed startup validation." >&2
  printf '{{"schema":1,"kind":"legacy-drm","legacy_drm":"safedisc-4.60-secdrv","executable":"CoD2SP_s.exe","ntstatus":"%s","wine_runner":"%s","wine_version":"%s","at":"%s"}}\n' \
    "${{pcga_secdrv_status:-unknown}}" "${{PCGA_WINE_RUNNER:-base-image-wine}}" "$(wine --version 2>/dev/null | tr -d '\r\n' || true)" "$(date -Is)" \
    > /pcga-runtime-logs/last-failure.json 2>/dev/null || true
  # 86 is a PCGA-specific terminal compatibility failure.  The outer startup
  # path recognizes it and closes the compositor immediately instead of
  # presenting a diagnostic black screen after the game process has died.
  main_rc=86
fi
# Legacy launchers frequently hand off to a second Wine process and exit. Wait
# for the hand-off only while an actual Xwayland game window remains. This keeps
# valid child processes alive but prevents explorer/services.exe helpers from
# holding a black stream for the old 12-hour wineserver timeout.
if command -v wineserver >/dev/null 2>&1; then
  if [[ $main_rc -eq 0 ]]; then
    echo "[pcga-wine-session] monitoring detached Wine child processes"
    wineserver -w &
    pcga_wineserver_wait_pid=$!
    pcga_no_window_ticks=0
    pcga_handoff_ticks=0
    while kill -0 "$pcga_wineserver_wait_pid" 2>/dev/null; do
      pcga_handoff_ticks=$((pcga_handoff_ticks + 1))
      if pcga_wine_debugger_active; then
        pcga_crash_detected=1
        echo "[pcga-wine-session] ERROR: detached Wine process crashed; debugger detected" >&2
        wineserver -k >/dev/null 2>&1 || true
        break
      fi
      if pcga_visible_game_window; then
        pcga_window_seen=1
        pcga_no_window_ticks=0
      else
        pcga_no_window_ticks=$((pcga_no_window_ticks + 1))
