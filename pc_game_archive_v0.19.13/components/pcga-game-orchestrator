def norm_title(value: str) -> str:
    return " ".join(re.sub(r"[^a-z0-9]+", " ", (value or "").casefold()).split())


_METADATA_EDITION_TOKENS = {"enhanced", "edition", "remaster", "remastered", "definitive", "anniversary", "hd"}

def metadata_title_core(value: str) -> str:
    tokens = [x for x in norm_title(value).split() if x not in _METADATA_EDITION_TOKENS]
    return " ".join(tokens)


def slug(value: str, limit: int = 48) -> str:
    s = re.sub(r"[^a-z0-9]+", "-", norm_title(value)).strip("-")
    return (s or "game")[:limit]


def state_path(set_id: str) -> Path:
