def wolf_internal_app_title(set_id: str, setup_mode: bool) -> str:
    """Return an immutable Docker/Wolf-safe application identifier.

    Wolf uses the app title as part of its per-session home-directory bind path.
    Human metadata titles can legally contain ':' and other characters that are
    meaningful to Docker's ``host:container:mode`` volume syntax.  Keeping the
    Wolf title UUID-derived prevents both invalid bind specifications and app
    duplication when web metadata later renames a title.  The portal presents
    the human title separately.
    """
    token = re.sub(r"[^A-Za-z0-9]+", "", str(set_id))[:12] or "unknown"
    return ("PCGA Setup " if setup_mode else "PCGA Game ") + token


def wolf_launch_variant_apps(set_id: str, state: dict, setup_mode: bool) -> list[dict]:
    base = wolf_internal_app_title(set_id, setup_mode)
    if setup_mode:
        return [{"key":"setup", "label":"Setup", "title":base, "default":True}]
    variants = state.get("launch_variants") if isinstance(state.get("launch_variants"), list) else []
    default_key = str(state.get("launch_variant_default") or "")
    if len(variants) < 2 or not default_key:
        return [{"key":"default", "label":"Play", "title":base, "default":True}]
    rows=[]
    for row in variants:
        if not isinstance(row, dict):
            continue
        key=str(row.get("key") or "").strip()
        if not key:
            continue
        is_default=key == default_key
        suffix=re.sub(r"[^A-Za-z0-9]+", "", key).upper()[:12] or "ALT"
        rows.append({
            "key":key,
            "label":str(row.get("label") or key.title()),
            "title":base if is_default else f"{base} {suffix}",
            "default":is_default,
        })
    rows.sort(key=lambda x:(0 if x.get("default") else 1, str(x.get("key"))))
    return rows or [{"key":"default", "label":"Play", "title":base, "default":True}]


