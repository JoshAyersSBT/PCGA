#!/usr/bin/env python3
"""Optional Steam Remote Play host for PCGA. Steam owns installation, auth and Proton.
No Steam account credentials are ever accepted by this bridge.
"""
import argparse, json, os, re, shutil, subprocess, sys
from pathlib import Path

ROOT_CONFIG=Path('/etc/pc-game-archive/archive-root')
NAME='pcga-steam-native'
IMAGE='josh5/steam-headless:2'

def execute(args, timeout=20):
    return subprocess.run(args,capture_output=True,text=True,timeout=timeout,check=False)

def root():
    if not ROOT_CONFIG.is_file():raise RuntimeError('PCGA archive root is not configured')
    value=ROOT_CONFIG.read_text().strip()
    p=Path(value).resolve(strict=True)
    if not p.is_dir():raise RuntimeError('PCGA archive root is not a directory')
    return p

def steam_paths():
    base=root()/'games'/'steam'
    return base,base/'home',base/'library',base/'state',base/'journal'

def container_state():
    if not shutil.which('docker'):return ('unavailable', '')
    result=execute(['docker','inspect','--format','{{.State.Status}}|{{.Config.Image}}',NAME],10)
    if result.returncode:return ('not-installed','')
    parts=result.stdout.strip().split('|',1)
    return (parts[0],parts[1] if len(parts)>1 else '')

def scan():
    # Read-only manifest discovery. ACF is Valve's KeyValues, not JSON.
    _,_,lib,_,_=steam_paths()
    rows=[]
    if not lib.is_dir():return rows
    for item in sorted(lib.glob('steamapps/appmanifest_*.acf'))[:3000]:
        if item.is_symlink() or not item.is_file() or item.stat().st_size>1024*1024:continue
        app=re.fullmatch(r'appmanifest_([0-9]{1,12})\.acf',item.name)
        if not app:continue
        content=item.read_text(encoding='utf-8',errors='replace')
        def field(key):
            found=re.search(r'^\s*"'+re.escape(key)+r'"\s+"([^"\r\n]{0,250})"',content,re.M)
            return found.group(1) if found else ''
        title=field('name')
        if not title:continue
        rows.append({'appid':app.group(1),'title':title,'installed': True,'state_flags':field('StateFlags'), 'provider':'steam','streaming':'steam-remote-play'})
    return rows

def status():
    state,image=container_state()
    games=scan()
    return {'ok':True,'provider':'steam','mode':'native-client','status':state,'image':image,'games':games,'installed_count':len(games),'streaming':'Steam Remote Play / Steam Link','steam_link_required':True,'ready':state=='running', 'detail':('Steam manages store login, installs, updates and Proton. Pair using Steam Link or another Steam client.' if state=='running' else 'Steam runtime is opt-in. Start it only after checking local GPU/input support and trusted LAN access.')}

def start():
    state,image=container_state()
    if state=='running':return status()
    if state not in ('not-installed','exited','created'):raise RuntimeError('Unexpected Steam runtime state: '+state)
    if not shutil.which('docker'):raise RuntimeError('Docker is required')
    nodes=[str(p) for p in sorted(Path('/dev/dri').glob('renderD*')) if p.is_char_device()]
    if not nodes:raise RuntimeError('No DRM GPU render node found; Steam host startup refused')
    for needed in ('/dev/uinput','/dev/fuse'):
        if not Path(needed).exists():raise RuntimeError('Steam input/runtime device missing: '+needed)
    base,home,lib,persistent,journal=steam_paths()
    for p in (home,lib,persistent,journal):
        p.mkdir(parents=True,exist_ok=True)
        # Runtime user must own persistent state, not the root control service.
        if p.stat().st_uid==0 and uid!=0:
            os.chown(p,uid,gid)
    if state in ('exited','created'):
        p=execute(['docker','start',NAME],45)
        if p.returncode:raise RuntimeError('Could not start existing Steam runtime: '+p.stderr[-500:])
        return status()
    # On-demand only: never run this on upgrade or boot. Host network is needed
    # for Steam Remote Play discovery; exposes container services to the LAN.
    uid=int(os.environ.get('SUDO_UID') or 1000)
    gid=int(os.environ.get('SUDO_GID') or 1000)
    cmd=['docker','run','-d','--name',NAME,'--hostname',NAME,'--restart','no',
         '--network','host','--shm-size','2g','--pids-limit','8192',
         '--cap-add','DAC_READ_SEARCH','--cap-add','NET_ADMIN','--cap-add','SYS_ADMIN',
         '--cap-add','SYS_NICE','--cap-add','SYS_PTRACE',
         '--security-opt','apparmor=unconfined','--security-opt','seccomp=unconfined',
         '--device','/dev/fuse','--device','/dev/uinput',
         '-e',f'PUID={uid}','-e',f'PGID={gid}','-e','ENABLE_STEAM=true',
         '-v',f'{home}:/home/steamheadless', '-v',f'{lib}:/mnt/games',
         '-v',f'{persistent}:/var/lib/steam-headless','-v',f'{journal}:/var/log/journal',
         '-v','/etc/localtime:/run/host-localtime:ro']
    for node in nodes:cmd.extend(['--device',node])
    if Path('/dev/uhid').exists():cmd.extend(['--device','/dev/uhid'])
    cmd.append(IMAGE)
    p=execute(cmd,180)
    if p.returncode:raise RuntimeError('Steam runtime launch failed: '+p.stderr[-600:])
    return status()

def stop():
    state,_=container_state()
    if state=='running':
        p=execute(['docker','stop','-t','30',NAME],45)
        if p.returncode:raise RuntimeError('Steam runtime stop failed: '+p.stderr[-500:])
    return status()

def main():
    a=argparse.ArgumentParser()
    a.add_argument('command',choices=['status','start','stop'])
    ns=a.parse_args()
    try: result={'status':status,'start':start,'stop':stop}[ns.command]()
    except Exception as exc:
        result={'ok':False,'error':type(exc).__name__,'detail':str(exc)[:600]}
    print(json.dumps(result))
    if not result['ok']:sys.exit(1)
if __name__=='__main__':main()
