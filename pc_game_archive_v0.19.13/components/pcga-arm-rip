#!/usr/bin/env bash
set -Eeuo pipefail
name="${1#/dev/}"
dev="/dev/$name"
allowed=/etc/pc-game-archive/media-drives
[[ -r "$allowed" ]] || exit 0
grep -Fxq "$dev" "$allowed" || exit 0
[[ -b "$dev" ]] || exit 0

exec 9>"/run/pcga-optical-${name}.lock"
flock -n 9 || exit 0

stopping=0
cleanup_on_signal() {
  local sig="$1"
  [[ $stopping -eq 0 ]] || exit 143
  stopping=1
  logger -t PCGA-ARM "Received $sig while ingesting $dev; terminating only this drive's ARM process tree"
  /usr/local/sbin/pcga-arm-stop "$name" || true
  exit 143
}
trap 'cleanup_on_signal TERM' TERM
trap 'cleanup_on_signal INT' INT

ready=0
for _ in $(seq 1 60); do
  if /usr/local/sbin/pcga-optical-media-present "$dev"; then ready=1; break; fi
  sleep 1
done
if [[ $ready -ne 1 ]]; then logger -t PCGA-ARM "Disc in $dev never became ready; not starting ARM"; exit 0; fi
route="$(/usr/local/sbin/pcga-optical-identify --field route "$dev" 2>/dev/null || true)"
case "$route" in
  arm-video|arm-audio) ;;
  *) logger -t PCGA-ARM "Refusing $dev because optical dispatcher classified route=${route:-unknown}; ARM only accepts video/audio media"; exit 0 ;;
esac
if [[ "$(docker inspect -f '{{.State.Running}}' arm-rippers 2>/dev/null || true)" != true ]]; then
  logger -t PCGA-ARM "ARM container is not running; ignoring $dev"; exit 0
fi
if ! /usr/local/sbin/pcga-optical-health --quiet "$dev"; then
  logger -t PCGA-ARM "Optical hardware preflight failed for $dev; refusing ingest"; exit 74
fi
set +e
/usr/local/sbin/pcga-arm-reconcile "$name"; rc=$?
set -e
if [[ $rc -ne 0 ]]; then
  logger -t PCGA-ARM "ARM stale-job reconciliation refused/failed for $dev (exit $rc); not starting a competing ingest"; exit "$rc"
fi
set +e
/usr/local/sbin/pcga-makemkv-preflight "$name"; rc=$?
set -e
if [[ $rc -ne 0 ]]; then logger -t PCGA-ARM "MakeMKV preflight failed for $dev (exit $rc); refusing an unattended rip that may hang"; exit "$rc"; fi
ROOT="$(cat /etc/pc-game-archive/archive-root 2>/dev/null || true)"
DISPATCH_STATE="/var/lib/pc-game-archive/optical-dispatch/${name}.json"
media_fp=""
if [[ "$route" == arm-video && -r "$DISPATCH_STATE" ]]; then
  media_fp="$(python3 - "$DISPATCH_STATE" <<'PY_FP' 2>/dev/null || true
import json,sys
d=json.load(open(sys.argv[1]));print(d.get('fingerprint') or '')
PY_FP
)"
fi
disc_bytes="$(blockdev --getsize64 "$dev" 2>/dev/null || printf '0')"
free_bytes="$(df -B1 --output=avail "$ROOT/media/arm/work/raw" 2>/dev/null | tail -n1 | tr -d '[:space:]' || printf '0')"
reserve=$((5 * 1024 * 1024 * 1024))
if [[ "$disc_bytes" =~ ^[0-9]+$ && "$free_bytes" =~ ^[0-9]+$ && $disc_bytes -gt 0 && $free_bytes -lt $((disc_bytes + reserve)) ]]; then
  logger -t PCGA-ARM "Insufficient free space for $dev: disc=${disc_bytes}B free=${free_bytes}B reserve=${reserve}B"; exit 73
fi
[[ -n "${media_fp:-}" ]] && /usr/local/sbin/pcga-media-intake mark-rip "$media_fp" started --drive "$dev" >/dev/null 2>&1 || true
logger -t PCGA-ARM "Starting automatic ARM ingest for $dev (original MakeMKV output; transcoding disabled)"
set +e
docker exec --user arm --workdir /home/arm arm-rippers python3 /opt/arm/arm/ripper/main.py -d "$name"
rc=$?
set -e
if [[ -n "${media_fp:-}" ]]; then
  if [[ $rc -eq 0 ]]; then
    /usr/local/sbin/pcga-media-intake mark-rip "$media_fp" complete --drive "$dev" >/dev/null 2>&1 || true
  else
    /usr/local/sbin/pcga-media-intake mark-rip "$media_fp" failed --drive "$dev" --error "ARM exit $rc" >/dev/null 2>&1 || true
  fi
fi
# Always kick the post-rip sorter. On a successful ARM handoff it consumes
# completed staging; on a failed final move it can recover retained raw MKVs
# once they satisfy the settle window.
systemctl --no-block start pcga-media-sort.service >/dev/null 2>&1 || true
if [[ $rc -ne 0 ]]; then
  logger -t PCGA-ARM "ARM ingest failed for $dev (exit $rc); raw MakeMKV output is retained and PCGA recovery will inspect it automatically. Manual inspection: game-archive raw-review"
  exit "$rc"
fi
logger -t PCGA-ARM "ARM ingest process completed for $dev; PCGA classification/promotion has been triggered"
# Apply any ingest-setting change that was deferred while this rip was active.
# pcga-arm-configure --ensure is idempotent and does not rewrite an already
# aligned arm.yaml. Never mutate ARM configuration immediately before a rip.
PCGA_CONFIG_DURING_TRIGGER=1 /usr/local/sbin/pcga-arm-configure --ensure >/dev/null 2>&1 || logger -t PCGA-ARM "WARNING: deferred ARM ingest settings could not be reconciled"
