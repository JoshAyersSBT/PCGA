def configure_pc_game_metadata(payload: dict) -> dict:
    provider = str(payload.get("provider") or "rawg").strip().lower()
    if provider != "rawg":
        raise ValueError("v0.18.69 currently supports RAWG for interactive PC-game database search")
    values = {"PCGA_GAME_DB_PROVIDER": "rawg"}
    if "rawg_api_key" in payload:
        key = str(payload.get("rawg_api_key") or "").strip()
        if any(ch in key for ch in "\r\n\0") or len(key) > 512:
            raise ValueError("invalid RAWG API key")
        # A blank key is deliberately ignored unless clear_rawg_api_key=true so
        # reopening Settings never destroys a configured secret.
        if key:
            values["RAWG_API_KEY"] = key
        elif bool(payload.get("clear_rawg_api_key")):
            values["RAWG_API_KEY"] = ""
    patch_env(GAME_METADATA_ENV, values)
    cfg = pc_game_metadata_config()
    return {"ok": True, "action": "pc-game-metadata-configure", "metadata": cfg, "detail": "PC game database settings saved."}


def _game_db_http_json(url: str, *, timeout: float = 12.0, max_bytes: int = 4 * 1024 * 1024) -> dict:
    req = urllib.request.Request(url, headers={"Accept": "application/json", "User-Agent": AUDIO_USER_AGENT})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read(max_bytes + 1)
            if len(raw) > max_bytes:
                raise RuntimeError("game database response exceeded PCGA safety limit")
            data = json.loads(raw.decode("utf-8", "replace") or "{}")
            if not isinstance(data, dict):
                raise RuntimeError("game database returned an unexpected response")
            return data
    except urllib.error.HTTPError as exc:
        try:
            detail = exc.read(2048).decode("utf-8", "replace")
        except Exception:
            detail = ""
        if exc.code in {401, 403}:
            raise RuntimeError("RAWG rejected the configured API key") from exc
        if exc.code == 429:
            raise RuntimeError("RAWG rate limit reached; try the search again later") from exc
        raise RuntimeError(f"RAWG returned HTTP {exc.code}: {detail[:500]}") from exc
    except urllib.error.URLError as exc:
        raise RuntimeError(f"RAWG is unreachable: {exc.reason}") from exc


def _rawg_api_key() -> str:
    key = str(_simple_env(GAME_METADATA_ENV).get("RAWG_API_KEY") or "").strip()
    if not key:
        raise RuntimeError("RAWG is not configured. Add an API key under Settings → PC games & LAN sessions.")
    return key


def _rawg_request(path: str, params: dict | None = None) -> dict:
    query = dict(params or {})
    query["key"] = _rawg_api_key()
    return _game_db_http_json("https://api.rawg.io/api" + path + "?" + urlencode(query))


def _rawg_result(row: dict) -> dict:
    platforms=[]
    for item in row.get("platforms") or []:
        if isinstance(item, dict) and isinstance(item.get("platform"), dict) and item["platform"].get("name"):
            platforms.append(str(item["platform"]["name"]))
    genres=[str(x.get("name")) for x in row.get("genres") or [] if isinstance(x,dict) and x.get("name")]
    released=str(row.get("released") or "")
    year=None
    m=re.match(r"^(19|20)\d{2}", released)
    if m:
        year=int(released[:4])
    slug=str(row.get("slug") or "")
    return {
        "provider":"rawg",
        "provider_id":str(row.get("id") or ""),
        "title":str(row.get("name") or "Untitled game"),
        "released":released or None,
        "release_year":year,
        "platforms":platforms[:10],
        "genres":genres[:10],
        "image_url":row.get("background_image"),
        "metacritic":row.get("metacritic"),
        "rating":row.get("rating"),
        "source_url":f"https://rawg.io/games/{quote(slug)}" if slug else "https://rawg.io/",
        "attribution":"RAWG",
    }


def _metadata_search_norm(value: str) -> str:
    value = re.sub(r"([a-z])([A-Z])", r"\1 \2", str(value or ""))
    value = value.casefold().replace("&", " and ")
    return " ".join(re.sub(r"[^a-z0-9]+", " ", value).split())


def _metadata_search_terms(query: str) -> list[str]:
    """Generate useful search variants without rewriting the user's query.

    Optical labels and provisional PCGA titles frequently contain transport/setup
    noise (COD2CD1, setupBF2, syscheck, installer, DVD-ROM).  RAWG's precise
    search is much more useful when those tokens are also removed, but the raw
    user-entered title remains the first and highest-authority search term.
    """
    raw = " ".join(str(query or "").strip().split())
    terms: list[str] = []
    def add(value: str) -> None:
        value = " ".join(str(value or "").strip().split())
        if len(value) >= 2 and value.casefold() not in {x.casefold() for x in terms}:
            terms.append(value[:180])
    add(raw)
    split = re.sub(r"([a-z])([A-Z])", r"\1 \2", raw)
    split = re.sub(r"[_\-.]+", " ", split)
    add(split)
    clean = split
    # Remove only unmistakable media/setup tokens.  Standalone numbers are kept
    # because they are often sequel numbers (Call of Duty 2, Battlefield 2).
    clean = re.sub(r"(?i)(?:\b|(?<=[a-z0-9]))(?:cd|disc|disk|dvd)[ _-]*\d{1,2}\b", " ", clean)
    clean = re.sub(r"(?i)\b(?:cdrom|dvdrom|setup|installer|install|autorun|syscheck|launcher|launch|uninstall|patcher|updater|update|game ?data)\b", " ", clean)
    clean = re.sub(r"(?i)\b(?:cdkey|keygen)\b", " ", clean)
    clean = " ".join(clean.split())
    add(clean)
    # A second variant drops common packaging suffixes while leaving the original
    # edition-aware query available for exact matches.
    broad = re.sub(r"(?i)\b(?:game of the year|goty|gold|platinum|collector'?s|collectors|limited|deluxe|special|complete|ultimate)\s+edition\b", " ", clean)
    broad = " ".join(broad.split())
    add(broad)
    return terms[:4]


def _metadata_match_score(query_terms: list[str], result: dict) -> float:
    title = _metadata_search_norm(str(result.get("title") or ""))
    if not title:
        return 0.0
    best = 0.0
    for term in query_terms:
        q = _metadata_search_norm(term)
        if not q:
            continue
        if q == title:
            score = 1.0
        else:
            ratio = difflib.SequenceMatcher(None, q, title).ratio()
            qtok, ttok = set(q.split()), set(title.split())
            overlap = len(qtok & ttok) / max(1, len(qtok | ttok))
            prefix = 1.0 if (title.startswith(q + " ") or q.startswith(title + " ")) else 0.0
            score = ratio * 0.68 + overlap * 0.24 + prefix * 0.08
        best = max(best, score)
    platforms = {str(x).casefold() for x in result.get("platforms") or []}
    if any("pc" == x or "windows" in x for x in platforms):
        best = min(1.0, best + 0.035)
    # When PCGA is cleaning a setup/disc-derived title, do not let an unrelated
    # utility/product whose *actual* catalog title is "Setup ..." outrank a
    # plausible game returned by the cleaned query variant.
    noise={"setup","installer","install","syscheck","updater","update","launcher","cdkey"}
    title_tokens=set(title.split())
    cleaned_exists=any(not (set(_metadata_search_norm(t).split()) & noise) for t in query_terms[1:])
    if cleaned_exists and title_tokens & noise:
        best=max(0.0,best-0.30)
    return round(best, 4)


def _rawg_direct_lookup(query: str) -> dict | None:
    """Resolve a pasted RAWG URL or numeric id directly into a search result."""
    q = str(query or "").strip()
    target = ""
    if q.isdigit() and 1 <= len(q) <= 12:
        target = q
    else:
        try:
            parsed = urlparse(q)
        except Exception:
            parsed = None
        if parsed and parsed.scheme in {"http", "https"} and (parsed.hostname or "").lower().endswith("rawg.io"):
            parts = [x for x in (parsed.path or "").split("/") if x]
            if "games" in parts:
                idx = parts.index("games")
                if idx + 1 < len(parts):
                    target = parts[idx + 1]
    if not target:
        return None
    try:
        data = _rawg_request("/games/" + quote(target, safe=""))
    except Exception:
        return None
    return _rawg_result(data) if data.get("id") else None


def search_pc_game_metadata(payload: dict) -> dict:
    query = " ".join(str(payload.get("query") or payload.get("q") or "").strip().split())
    if len(query) < 2 or len(query) > 180:
        raise ValueError("metadata search query must contain 2-180 characters")
    terms = _metadata_search_terms(query)
    collected: dict[str, dict] = {}

    direct = _rawg_direct_lookup(query)
    if direct and direct.get("provider_id"):
        direct["matched_search_term"] = query
        direct["match_score"] = 1.0
        direct["match_reason"] = "direct RAWG record"
        return {
            "ok":True,
            "action":"pc-game-metadata-search",
            "provider":"rawg",
            "query":query,
            "search_terms":[query],
            "results":[direct],
            "attribution":{"name":"RAWG","url":"https://rawg.io/","required":True},
        }

    # Search both precise and broad modes.  The previous implementation only
    # broadened when RAWG returned *zero* PC results, which meant a few weak
    # matches could hide the correct legacy title entirely.
    plans: list[tuple[str, bool, bool]] = []
    if terms:
        plans.append((terms[0], True, True))
        plans.append((terms[0], False, True))
    for term in terms[1:]:
        plans.append((term, False, True))
    # Global fallback is useful for old Windows releases whose RAWG platform
    # tagging is incomplete.  Only one broad global request is needed.
    if terms:
        plans.append((terms[-1], False, False))

    seen_plans: set[tuple[str, bool, bool]] = set()
    for term, precise, pc_only in plans[:6]:
        key=(term.casefold(), precise, pc_only)
        if key in seen_plans:
            continue
        seen_plans.add(key)
        params={"search":term,"page_size":"24"}
        if precise:
            params["search_precise"]="true"
        if pc_only:
            params["platforms"]="4"
        try:
            data=_rawg_request("/games",params)
        except RuntimeError:
            # Preserve a useful result set when one fallback request fails after
            # an earlier provider request already succeeded.
            if not collected:
                raise
            continue
        rows=data.get("results") if isinstance(data.get("results"),list) else []
        for row in rows:
            if not isinstance(row,dict):
                continue
            item=_rawg_result(row)
            pid=str(item.get("provider_id") or "")
            if not pid:
                continue
            score=_metadata_match_score(terms,item)
            item["match_score"]=score
            item["matched_search_term"]=term
            item["match_reason"]=("precise PC" if precise and pc_only else "PC catalog" if pc_only else "global fallback")
            previous=collected.get(pid)
            if previous is None or score > float(previous.get("match_score") or 0):
                collected[pid]=item

    results=sorted(
        collected.values(),
        key=lambda x:(-float(x.get("match_score") or 0), -(int(x.get("release_year") or 0)), str(x.get("title") or "").casefold()),
    )[:30]
    return {
        "ok":True,
        "action":"pc-game-metadata-search",
        "provider":"rawg",
        "query":query,
        "search_terms":terms,
        "results":results,
        "attribution":{"name":"RAWG","url":"https://rawg.io/","required":True},
    }


def _strip_html(value: str) -> str:
    text=re.sub(r"<[^>]+>"," ",str(value or ""))
    return re.sub(r"\s+"," ",html_lib.unescape(text)).strip()


