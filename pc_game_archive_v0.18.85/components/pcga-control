def _download_game_db_asset(url: str, dest_base: Path, stem: str) -> str | None:
    if not url:
        return None
    parsed=urlparse(url)
    host=(parsed.hostname or "").lower()
    if parsed.scheme != "https" or not (host == "rawg.io" or host.endswith(".rawg.io")):
        return None
    req=urllib.request.Request(url,headers={"User-Agent":AUDIO_USER_AGENT,"Accept":"image/avif,image/webp,image/png,image/jpeg,*/*;q=0.5"})
    try:
        with urllib.request.urlopen(req,timeout=15) as resp:
            ctype=str(resp.headers.get("Content-Type") or "").split(";",1)[0].strip().lower()
            data=resp.read(12*1024*1024+1)
        if not data or len(data)>12*1024*1024:
            return None
        ext={"image/jpeg":".jpg","image/png":".png","image/webp":".webp"}.get(ctype)
        if not ext:
            return None
        dest_base.mkdir(parents=True,exist_ok=True)
        for old in dest_base.glob(stem+".*"):
            try: old.unlink()
            except OSError: pass
        out=dest_base/(stem+ext);out.write_bytes(data);return str(out)
    except Exception:
        return None


def _existing_pc_game_set_for_profile(profile: dict) -> str | None:
    pid=str((profile.get("external_ids") or {}).get("rawg") or "")
    norm=str(profile.get("normalized_title") or "")
    base=PC_GAME_INTAKE_ROOT/"sets"
    if not base.exists(): return None
    exact_title=None
    for path in base.glob("*.json"):
        rec=load_json(path)
        if not rec: continue
        ext=rec.get("external_ids") if isinstance(rec.get("external_ids"),dict) else {}
        if pid and str(ext.get("rawg") or "")==pid:
            return str(rec.get("id") or path.stem)
        if norm and str(rec.get("normalized_title") or "")==norm:
            exact_title=str(rec.get("id") or path.stem)
    return exact_title



def _pc_game_identity_aliases(value: object) -> set[str]:
    key=" ".join(re.sub(r"[^a-z0-9]+"," ",str(value or "").casefold()).split())
    if not key:
        return set()
    key=re.sub(r"(?:^|\s)(?:disc|disk|cd|dvd)\s*\d+(?:\s*(?:of|/)\s*\d+)?$"," ",key).strip()
    key=re.sub(r"(?:disc|disk|cd|dvd)\d+(?:of\d+)?$","",key).strip()
    words=re.findall(r"[a-z]+|\d+",key)
    aliases=set()
    compact="".join(words)
    if len(compact)>=4:
        aliases.add(compact)
    if len(words)>=2:
        acronym="".join((w if w.isdigit() else w[0]) for w in words if w)
        if len(acronym)>=4:
            aliases.add(acronym)
    return aliases


def _pc_game_metadata_runtime_score(set_id: str, group_disc_count: int = 0) -> tuple:
    state=load_json(PC_GAME_STATE_ROOT/f"{set_id}.json")
    game=load_json(PC_GAME_INTAKE_ROOT/"sets"/f"{set_id}.json")
    status=str(state.get("status") or "")
    stream=str(state.get("stream_state") or "")
    score=0
    if status=="ready":score+=1000
    elif status=="setup-required":score+=600
    elif status=="installing":score+=450
    elif status in {"queued","source"}:score+=250
    if state.get("launch_executable"):score+=220
    if state.get("runtime_image"):score+=120
    if stream=="ready":score+=180
    elif stream=="setup-ready":score+=90
    media=game.get("media") if isinstance(game.get("media"),dict) else {}
    try:
        disc_count=max(int(media.get("disc_count") or 0),int(state.get("source_logical_disc_count") or 0),int(group_disc_count or 0))
    except (TypeError,ValueError):
        disc_count=0
    if str(state.get("install_method") or "").casefold()=="portable-copy" and disc_count>1:
        # Never redirect selected metadata onto a known-invalid multi-disc
        # portable migration when a real setup/prefix sibling exists.
        score-=1200
    return (score,str(state.get("updated_at") or state.get("created_at") or ""),set_id)


def _pc_game_metadata_target(requested: str, fingerprint: str, profile: dict) -> str:
    """Resolve metadata onto the strongest linked install/runtime UUID.

    A metadata choice must decorate the working game; it must not create a
    parallel pretty card while the usable Wine prefix remains under a raw disc
    label UUID. Links come from persisted duplicate history and, for ordinary
    single-title media, shared disc fingerprints.
    """
    sets_dir=PC_GAME_INTAKE_ROOT/"sets"
    if not sets_dir.exists():
        return requested
    docs={}
    for path in sets_dir.glob("*.json"):
        rec=load_json(path)
        if rec:docs[str(rec.get("id") or path.stem)]=rec
    candidates=set()
    if requested and requested in docs:candidates.add(requested)
    rawg=str((profile.get("external_ids") or {}).get("rawg") or "").strip()
    if rawg:
        for sid,rec in docs.items():
            ext=rec.get("external_ids") if isinstance(rec.get("external_ids"),dict) else {}
            if str(ext.get("rawg") or "").strip()==rawg:candidates.add(sid)
    # A user-selected retail title can identify a working runtime that still
    # carries a mastering-label acronym (cod2 <-> Call of Duty 2). Keep this
    # conservative and require aliases of at least four characters.
    profile_aliases=_pc_game_identity_aliases(profile.get("title"))
    requested_aliases=_pc_game_identity_aliases((docs.get(requested) or {}).get("title")) if requested else set()
    wanted_aliases=profile_aliases|requested_aliases
    if wanted_aliases:
        for other,rec in docs.items():
            if wanted_aliases & _pc_game_identity_aliases(rec.get("title")):
                candidates.add(other)
    if fingerprint:
        disc=load_json(PC_GAME_INTAKE_ROOT/"discs"/f"{fingerprint}.json")
        owners=disc.get("game_set_ids") if isinstance(disc.get("game_set_ids"),list) else [disc.get("game_set_id")]
        candidates.update(str(x) for x in owners if str(x or "") in docs)
    # Expand persisted duplicate relationships and ordinary single-title media
    # fingerprints transitively. Compilation media is excluded because one disc
    # legitimately owns multiple different games.
    changed=True
    while changed:
        changed=False
        known_fps=set()
        for sid in list(candidates):
            rec=docs.get(sid,{})
            target=str(rec.get("superseded_by") or "")
            if target in docs and target not in candidates:
                candidates.add(target);changed=True
            for other in rec.get("merged_set_ids") or []:
                other=str(other or "")
                if other in docs and other not in candidates:
                    candidates.add(other);changed=True
            media=rec.get("media") if isinstance(rec.get("media"),dict) else {}
            discs=media.get("discs") if isinstance(media.get("discs"),list) else []
            compilation=any(str(x.get("layout") or "").casefold()=="compilation" for x in discs if isinstance(x,dict))
            if not compilation:
                known_fps.update(str(x) for x in (rec.get("disc_fingerprints") or []) if str(x))
        for sid,rec in docs.items():
            if sid in candidates:continue
            merged={str(x) for x in rec.get("merged_set_ids") or [] if str(x)}
            if merged & candidates or str(rec.get("superseded_by") or "") in candidates:
                candidates.add(sid);changed=True;continue
            media=rec.get("media") if isinstance(rec.get("media"),dict) else {}
            discs=media.get("discs") if isinstance(media.get("discs"),list) else []
            compilation=any(str(x.get("layout") or "").casefold()=="compilation" for x in discs if isinstance(x,dict))
            if not compilation and known_fps & {str(x) for x in (rec.get("disc_fingerprints") or []) if str(x)}:
                candidates.add(sid);changed=True
    if not candidates:
        return requested
    group_disc_count=0
    for sid in candidates:
        state=load_json(PC_GAME_STATE_ROOT/f"{sid}.json")
        rec=docs.get(sid,{})
        media=rec.get("media") if isinstance(rec.get("media"),dict) else {}
        try:
            group_disc_count=max(group_disc_count,int(media.get("disc_count") or 0),int(state.get("source_logical_disc_count") or 0))
        except (TypeError,ValueError):
            pass
    return max(candidates,key=lambda sid:_pc_game_metadata_runtime_score(sid,group_disc_count))


def apply_pc_game_metadata(payload: dict) -> dict:
    provider=str(payload.get("provider") or "rawg").strip().lower()
    if provider!="rawg": raise ValueError("unsupported PC game database provider")
    provider_id=str(payload.get("provider_id") or payload.get("id") or "").strip()
    profile=_rawg_profile(provider_id)
    requested=str(payload.get("game_set_id") or payload.get("set_id") or "").strip()
    requested=_validate_game_set_id(requested) if requested else ""
    fp=str(payload.get("fingerprint") or "").strip()
    seed=requested or (_existing_pc_game_set_for_profile(profile) or "")
    sid=_pc_game_metadata_target(seed,fp,profile) if (seed or fp) else ""
    created=False
    if not sid:
        proc=run(["/usr/local/sbin/pcga-game-intake","create-set","--title",str(profile["title"]),"--confirm"],timeout=20)
        if proc.returncode!=0:
            raise RuntimeError(((proc.stderr or proc.stdout) or "title creation failed")[-1200:])
        try: created_doc=json.loads(proc.stdout or "{}")
        except Exception: created_doc={}
        sid=_validate_game_set_id(created_doc.get("id") or "")
        created=True
    path=PC_GAME_INTAKE_ROOT/"sets"/f"{sid}.json"
    current=load_json(path)
    if not current:
        raise FileNotFoundError("PC game title record not found")
    # Preserve ownership/provenance/install-facing fields while replacing only the
    # canonical profile fields chosen by the user from the external database.
    preserved={k:current.get(k) for k in ("id","schema","created_at","media","disc_fingerprints","collection_id","source") if k in current}
    merged=dict(current)
    for key,value in profile.items():
        if key in {"external_ids","marketing_assets"}: continue
        if value is not None: merged[key]=value
    ext=dict(current.get("external_ids") or {});ext.update(profile.get("external_ids") or {});merged["external_ids"]=ext
    marketing=dict(current.get("marketing_assets") or {});marketing.update({k:v for k,v in (profile.get("marketing_assets") or {}).items() if v});merged["marketing_assets"]=marketing
    merged.update({k:v for k,v in preserved.items() if v is not None})
    merged["id"]=sid;merged["updated_at"]=datetime.now(timezone.utc).isoformat(timespec="seconds")
    asset_dir=PC_GAME_INTAKE_ROOT/"assets"/sid
    local=dict(marketing.get("local") or {})
    if marketing.get("cover_remote"):
        saved=_download_game_db_asset(str(marketing["cover_remote"]),asset_dir,"cover")
        if saved: local["cover"]=saved
    if marketing.get("header_remote"):
        saved=_download_game_db_asset(str(marketing["header_remote"]),asset_dir,"hero")
        if saved: local["hero"]=saved
    shot_paths=[]
    for idx,url in enumerate(marketing.get("screenshots_remote") or [],1):
        if idx>4: break
        saved=_download_game_db_asset(str(url),asset_dir,f"screenshot-{idx}")
        if saved: shot_paths.append(saved)
    if shot_paths: local["screenshots"]=shot_paths
    marketing["local"]=local;merged["marketing_assets"]=marketing
    atomic_json(path,merged)
    disc_result=None
    if fp:
        assign_payload={"fingerprint":fp,"game_set_id":sid}
        for key in ("disc_number","disc_count","disc_role"):
            if payload.get(key) not in (None,""): assign_payload[key]=payload.get(key)
        disc_result=assign_pc_game_disc(assign_payload)
        if disc_result.get("ok") is False:
            return {"ok":False,"action":"pc-game-metadata-apply","game_set_id":sid,"error":"disc-assignment-failed","detail":disc_result.get("detail"),"profile":merged}
    else:
        _pcga_start_reconcile(list(dict.fromkeys([sid, requested] if requested else [sid])))
    return {
        "ok":True,
        "action":"pc-game-metadata-apply",
        "game_set_id":sid,
        "created":created,
        "metadata_target_redirected":bool(requested and requested!=sid),
        "requested_game_set_id":requested or None,
        "set":merged,
        "disc_assignment":disc_result,
        "source_url":(profile.get("metadata_profile") or {}).get("source_url"),
        "detail":f"Applied RAWG metadata to {merged.get('title') or 'PC game'}" + (" on the linked working runtime" if requested and requested!=sid else "") + (" and assigned the preserved disc." if fp else "."),
    }

def create_pc_game_title(payload: dict) -> dict:
    title=' '.join(str(payload.get('title') or '').strip().split())
    if not title or len(title)>180: raise ValueError('title must contain 1-180 characters')
    if any(ord(c)<32 for c in title): raise ValueError('invalid title')
    proc=run(['/usr/local/sbin/pcga-game-intake','create-set','--title',title,'--confirm'],timeout=20)
    if proc.returncode!=0:
        return {"ok":False,"action":"pc-game-title-create","error":"create-failed","detail":((proc.stderr or proc.stdout) or 'title creation failed')[-1200:]}
    try:rec=json.loads(proc.stdout or '{}')
    except Exception:rec={}
    return {"ok":True,"action":"pc-game-title-create","set":rec,"game_set_id":rec.get('id'),"detail":f'Created PC game title {title}.'}


def switch_pc_game_disc(payload: dict) -> dict:
    """Switch D: for a live multi-disc session without affecting other clients.

    The portal sends both its stable client id and the selected Wolf child
    container.  Older callers that omit container_id retain the legacy
    game-set-wide behavior.
    """
    sid=_validate_game_set_id(str(payload.get("game_set_id") or payload.get("set_id") or "").strip())
    try: disc=int(payload.get("disc") or payload.get("disc_number") or 0)
    except (TypeError,ValueError): disc=0
    if disc < 1 or disc > 16: raise ValueError("disc must be between 1 and 16")
    client_raw=str(payload.get("client_id") or "").strip()
    client_id=_validate_pcga_client_id(client_raw) if client_raw else ""
    target_id=str(payload.get("container_id") or "").strip()
    if target_id and not re.fullmatch(r"[0-9a-fA-F]{12,64}", target_id):
        raise ValueError("invalid PC game runtime container id")

    listing=pc_game_sessions({"client_id":client_id} if client_id else None)
    if not listing.get("ok"):
        return listing
    targets=[x for x in listing.get("sessions") or [] if x.get("game_set_id")==sid]
    if target_id:
        targets=[x for x in targets if str(x.get("container_id") or "").startswith(target_id)]
    if not targets:
        return {
            "ok":False,"action":"pc-game-disc-switch","game_set_id":sid,"disc":disc,
            "error":"no-active-session",
            "detail":"The selected PC game session is no longer active or is not owned by this portal client." if client_id else "Start the game/setup session before changing discs.",
        }

    changed=[]; failed=[]
    for target in targets:
        cid=str(target.get("container_id") or "")
        # Revalidate immediately before docker exec.  This prevents a stale
        # browser tab from switching media in a replacement/unrelated container.
        verify=run(["docker","inspect",cid],timeout=12)
        if verify.returncode!=0:
            failed.append({**target,"detail":"Runtime container ended before the disc switch completed"}); continue
        try:
            rows=json.loads(verify.stdout)
            current=_pc_game_runtime_record(rows[0] if isinstance(rows,list) and rows else {})
        except Exception:
            current=None
        if not current or current.get("container_id")!=cid or current.get("game_set_id")!=sid:
            failed.append({**target,"detail":"Container no longer matches this managed PCGA game session"}); continue
        proc=run(["docker","exec","-u","retro",cid,"/tmp/pcga-disc-switch",str(disc)],timeout=20)
        if proc.returncode==0:
            changed.append({**target,"active_disc":disc,"output":(proc.stdout or "")[-800:]})
        else:
            failed.append({**target,"detail":((proc.stderr or proc.stdout) or "disc switch failed")[-800:]})

    if changed:
        # Per-session active disc is ownership state, not title-global state.
        # This lets two clients install/play the same title on different discs.
        with PC_GAME_SESSION_OWNER_LOCK:
            owner_state=_pc_game_session_owner_state()
            for row in changed:
                cid=str(row.get("container_id") or "")
                owner=owner_state["containers"].get(cid)
                if isinstance(owner,dict):
                    owner["active_disc"]=disc
                    rid=str(owner.get("reservation_id") or "")
                    if rid and isinstance(owner_state["reservations"].get(rid),dict):
                        owner_state["reservations"][rid]["active_disc"]=disc
            _pc_game_session_owner_save(owner_state)
        # Preserve the old title-level default only for legacy broad callers.
        if not target_id:
            state_path=PC_GAME_STATE_ROOT/f"{sid}.json"
            try: state_doc=json.loads(state_path.read_text(encoding="utf-8")) if state_path.is_file() else {}
            except Exception: state_doc={}
            if isinstance(state_doc,dict):
                state_doc["runtime_active_disc"]=disc
                state_doc["updated_at"]=datetime.now(timezone.utc).isoformat(timespec="seconds")
                atomic_json(state_path,state_doc)
    return {
        "ok":not failed,"action":"pc-game-disc-switch","game_set_id":sid,"disc":disc,
        "changed":changed,"failed":failed,
        "detail":f"Active optical drive D: switched to title disc {disc} for {len(changed)} session(s)." if not failed else f"Disc {disc} could not be applied to every selected session.",
    }


def reinstall_pc_game(payload: dict) -> dict:
    """Reinstall one PCGA game from preserved source without touching the archive copy."""
    sid = _validate_game_set_id(payload.get("game_set_id") or payload.get("set_id"))
    orchestrator = Path("/usr/local/sbin/pcga-game-orchestrator")
    if not orchestrator.is_file() or not os.access(orchestrator, os.X_OK):
        return {
            "ok": False,
            "action": "pc-game-reinstall",
            "game_set_id": sid,
            "error": "orchestrator-unavailable",
            "detail": f"Host component missing or not executable: {orchestrator}",
        }
    try:
        runtime = Path("/run/pcga-game-orchestrator")
        docker_cfg = runtime / "docker"
        config_home = runtime / "config"
        cache_home = runtime / "cache"
        for path in (runtime, docker_cfg, config_home, cache_home):
            path.mkdir(parents=True, exist_ok=True)
        child_env = os.environ.copy()
        child_env.update({
            "HOME": str(runtime),
            "DOCKER_CONFIG": str(docker_cfg),
            "XDG_CONFIG_HOME": str(config_home),
            "XDG_CACHE_HOME": str(cache_home),
        })
        proc = subprocess.Popen(
            [str(orchestrator), "--set-id", sid, "--reinstall", "--force"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
            close_fds=True,
            env=child_env,
        )
    except OSError as exc:
        return {
            "ok": False,
            "action": "pc-game-reinstall",
            "game_set_id": sid,
            "error": type(exc).__name__,
            "detail": str(exc)[:400],
        }
    return {
        "ok": True,
        "action": "pc-game-reinstall",
        "game_set_id": sid,
        "pid": proc.pid,
        "detail": "Reinstall started from the preserved PCGA source. The archived disc/image is retained; only mutable install and runtime state are reset.",
    }


def _version_tuple(value: str) -> tuple[int, ...]:
    if not re.fullmatch(r"\d+(?:\.\d+){2,3}(?:-[0-9A-Za-z.-]+)?", value or ""):
        raise ValueError("invalid patch version")
    base = value.split("-",1)[0]
    return tuple(int(x) for x in base.split("."))


def _safe_extract_patch(zip_path: Path, dest: Path) -> tuple[str, Path, Path]:
    with zipfile.ZipFile(zip_path) as zf:
        infos = zf.infolist()
        if not infos or len(infos) > 4000:
            raise ValueError("patch archive has an invalid file count")
        total = 0; roots = set()
        for info in infos:
            name = info.filename.replace("\\", "/")
            pp = Path(name)
            if not name or name.startswith("/") or ".." in pp.parts:
                raise ValueError("patch archive contains an unsafe path")
            mode = (info.external_attr >> 16) & 0o170000
            if mode == 0o120000:
                raise ValueError("patch archive contains a symbolic link")
            total += max(0, int(info.file_size))
            if total > 256 * 1024 * 1024:
                raise ValueError("patch archive expands beyond the safety limit")
            if pp.parts: roots.add(pp.parts[0])
        if len(roots) != 1:
            raise ValueError("patch ZIP must contain one PCGA release directory")
        root_name = next(iter(roots))
        m = re.fullmatch(r"pc_game_archive_v(\d+(?:\.\d+){2,3}(?:-[0-9A-Za-z.-]+)?)", root_name)
        if not m:
            raise ValueError("patch root must be named pc_game_archive_v<version>")
        version = m.group(1)
        if _version_tuple(version) <= _version_tuple(VERSION):
            raise ValueError(f"patch version {version} is not newer than installed {VERSION}")
        zf.extractall(dest)
    release = (dest / root_name).resolve()
    release.relative_to(dest.resolve())
    upgrade = release / f"upgrade_to_v{version}.sh"
    if not upgrade.is_file():
        raise ValueError("patch is missing its versioned upgrade script")
    manifest = release / "MANIFEST.sha256"
    if manifest.is_file():
        check = subprocess.run(["sha256sum","-c",manifest.name], cwd=release, capture_output=True, text=True, timeout=60)
        if check.returncode != 0:
            raise ValueError("patch manifest verification failed: " + (check.stderr or check.stdout)[-500:])
    upgrade.chmod(upgrade.stat().st_mode | 0o111)
    return version, release, upgrade


def install_patch_from_stream(handler, length: int, filename: str) -> dict:
    if length <= 0 or length > PATCH_MAX_BYTES:
        raise ValueError("invalid patch size")
    if not str(filename or "").lower().endswith(".zip"):
        raise ValueError("PCGA patches must be ZIP files")
    PATCH_ROOT.mkdir(parents=True, exist_ok=True)
    incoming = PATCH_ROOT / "incoming"; jobs = PATCH_ROOT / "jobs"
    incoming.mkdir(parents=True, exist_ok=True); jobs.mkdir(parents=True, exist_ok=True)
    job_id = time.strftime("%Y%m%d-%H%M%S") + "-" + os.urandom(4).hex()
    zip_path = incoming / f"{job_id}.zip"
    remaining = length
    with zip_path.open("wb") as fh:
        while remaining:
            chunk = handler.rfile.read(min(1024*1024, remaining))
            if not chunk: raise ValueError("patch upload ended early")
            fh.write(chunk); remaining -= len(chunk)
    extract_root = PATCH_ROOT / "releases" / job_id
    extract_root.mkdir(parents=True, exist_ok=False)
    try:
        version, release, upgrade = _safe_extract_patch(zip_path, extract_root)
    except Exception:
        shutil.rmtree(extract_root, ignore_errors=True); zip_path.unlink(missing_ok=True); raise
    log_path = jobs / f"{job_id}.log"
    exit_path = jobs / f"{job_id}.exit"
    meta_path = jobs / f"{job_id}.json"
    unit = "pcga-patch-" + re.sub(r"[^A-Za-z0-9_.-]", "-", job_id)
    runner = jobs / f"{job_id}.sh"
    runner.write_text(
        "#!/bin/bash\n"
        "set -uo pipefail\n"
        "exec >>" + shlex.quote(str(log_path)) + " 2>&1\n"
        "echo '[pcga-patch] starting v" + version + " at '$(date -Is)\n"
        "cd " + shlex.quote(str(release)) + "\n"
        "set +e\n"
        + shlex.quote(str(upgrade)) + "\n"
        "rc=$?\n"
        "tmp=" + shlex.quote(str(exit_path)) + ".tmp.$$\n"
        "printf '%s\n' \"$rc\" >\"$tmp\"\n"
        "mv -f \"$tmp\" " + shlex.quote(str(exit_path)) + "\n"
        "echo '[pcga-patch] finished v" + version + " rc='\"$rc\"' at '$(date -Is)\n"
        "exit \"$rc\"\n",
        encoding="utf-8",
    )
    runner.chmod(0o700)
    meta = {"id":job_id,"version":version,"filename":Path(filename).name,"unit":unit,"log":str(log_path),"exit_file":str(exit_path),"release":str(release),"created_at":time.time(),"state":"queued"}
    atomic_json(meta_path, meta)
    cmd=["systemd-run","--unit",unit,"--collect","--property=Type=exec","--property=TimeoutStartSec=0","/bin/bash",str(runner)]
    proc=run(cmd, timeout=20)
    if proc.returncode != 0:
        meta["state"]="failed-to-start"; meta["detail"]=(proc.stderr or proc.stdout)[-1200:]; atomic_json(meta_path,meta)
        raise RuntimeError(meta["detail"] or "systemd-run failed")
    meta["state"]="running"; atomic_json(meta_path,meta)
    return {"ok":True,"job_id":job_id,"version":version,"state":"running","detail":f"PCGA v{version} patch accepted and installation started"}


def patch_status(job_id: str) -> dict:
    if not re.fullmatch(r"[0-9]{8}-[0-9]{6}-[0-9a-f]{8}", job_id or ""):
        raise ValueError("invalid patch job id")
    meta_path=PATCH_ROOT/"jobs"/f"{job_id}.json"; meta=load_json(meta_path)
    if not meta: raise FileNotFoundError("patch job not found")
    unit=str(meta.get("unit") or "")
    props={}
    exit_path=Path(str(meta.get("exit_file") or (PATCH_ROOT/"jobs"/f"{job_id}.exit")))
    if exit_path.is_file():
        try:
            code=int(exit_path.read_text(encoding="utf-8").strip())
        except (OSError, ValueError):
            code=1
        meta["state"]="complete" if code==0 else "failed"
        meta["exit_code"]=code; atomic_json(meta_path,meta)
    else:
        p=run(["systemctl","show",unit,"--property=ActiveState,SubState,Result,ExecMainStatus","--no-pager"], timeout=10)
        for line in p.stdout.splitlines():
            if "=" in line:
                k,v=line.split("=",1); props[k]=v
        active=props.get("ActiveState","")
        if active in {"inactive","failed"}:
            code=int(props.get("ExecMainStatus") or 0)
            meta["state"]="complete" if active=="inactive" and code==0 and props.get("Result") in {"success",""} else "failed"
            meta["exit_code"]=code; atomic_json(meta_path,meta)
    log_path=Path(str(meta.get("log") or "")); tail=""
    try: tail="\n".join(log_path.read_text(errors="replace").splitlines()[-80:])
    except OSError: pass
    return {"ok":True,**meta,"systemd":props,"log_tail":tail}


def action(name: str, payload: dict) -> dict:
