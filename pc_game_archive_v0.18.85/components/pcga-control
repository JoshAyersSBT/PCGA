def read_root() -> Path:
    root = Path(ROOT_FILE.read_text(encoding="utf-8").strip())
    if not root.is_absolute():
        raise RuntimeError("invalid archive root")
    return root


def merge(base, override):
    out = deepcopy(base)
    if isinstance(out, dict) and isinstance(override, dict):
        for k, v in override.items():
            if k in out and isinstance(out[k], dict) and isinstance(v, dict):
                out[k] = merge(out[k], v)
            elif k in out:
                out[k] = v
    return out


def load_config() -> dict:
    try:
        raw = json.loads(CONFIG_PATH.read_text(encoding="utf-8"))
        if not isinstance(raw, dict):
            raw = {}
    except Exception:
        raw = {}
    cfg = merge(DEFAULTS, raw)
    cfg["version"] = VERSION
    return validate_config(cfg)


def load_json(path: Path) -> dict:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return {}
    return value if isinstance(value, dict) else {}



def atomic_json(path: Path, value: dict, mode: int = 0o644) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=path.name + ".", dir=str(path.parent))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(value, f, indent=2, sort_keys=True)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    finally:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass


def clamp_int(value, lo, hi, default):
    try:
        n = int(value)
    except (TypeError, ValueError):
        return default
    return max(lo, min(hi, n))



def _audio_default_state() -> dict:
    return {"schema": 2, "version": VERSION, "podcast_subscriptions": {}, "audiobooks": {}, "progress": {}, "jobs": {}, "gpodder": {"counter": 0, "devices": {}, "subscription_events": [], "episode_actions": []}}


def audio_state() -> dict:
    with AUDIO_STATE_LOCK:
        raw = load_json(AUDIO_STATE_PATH)
        out = _audio_default_state()
        for key in ("podcast_subscriptions", "audiobooks", "progress", "jobs", "gpodder"):
            if isinstance(raw.get(key), dict):
                out[key] = raw[key]
        out["version"] = VERSION
        # A service restart interrupts an in-process collector. Make this explicit
        # instead of leaving the portal showing an eternal "downloading" state.
        changed = False
        for job in out["jobs"].values():
            if isinstance(job, dict) and job.get("state") == "downloading":
                job["state"] = "interrupted"
                job["detail"] = "Collection was interrupted by a PCGA service restart; select Collect locally to resume."
                changed = True
        if changed:
            atomic_json(AUDIO_STATE_PATH, out)
        return out


def save_audio_state(value: dict) -> None:
    with AUDIO_STATE_LOCK:
        value["version"] = VERSION
        atomic_json(AUDIO_STATE_PATH, value)


def _audio_update(mutator):
    with AUDIO_STATE_LOCK:
        state = audio_state()
        result = mutator(state)
        save_audio_state(state)
        return result



