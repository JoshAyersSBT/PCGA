def apply_config(cfg: dict) -> list[dict]:
    results = []
    # Host automation.
    results.append(set_unit("pcga-optical-watch.service", cfg["ingest"]["auto_rip"]))
    # Keep ARM aligned with the appliance-owned ingest policy. This helper is
    # idempotent and refuses to rewrite arm.yaml while a rip is active; if a
    # user changes the setting mid-rip, pcga-arm-rip applies it after the job.
    arm = run(["/usr/local/sbin/pcga-arm-configure", "--ensure"], timeout=45)
    results.append({
        "ok": arm.returncode in {0, 75},
        "service": "arm-config",
        "pending": arm.returncode == 75,
        "detail": (arm.stderr or arm.stdout)[-800:],
    })
    for unit in ("pcga-media-sort.path", "pcga-media-sort.timer"):
        results.append(set_unit(unit, cfg["automation"]["sorter_enabled"]))
    classifier_enabled = cfg["automation"]["classifier_enabled"] and cfg["review"]["auto_classify"]
    for unit in ("pcga-metadata-classify.path", "pcga-metadata-classify.timer"):
        results.append(set_unit(unit, classifier_enabled))
    results.append(set_unit("pcga-dedupe.timer", cfg["automation"]["dedupe_enabled"]))

    # Dedupe policy.
    existing = DEDUPE_CONF.read_text(encoding="utf-8", errors="replace") if DEDUPE_CONF.exists() else ""
    if "PCGA_DEDUPE_LIBRARY_DUPLICATES=" not in existing:
        existing += "\nPCGA_DEDUPE_LIBRARY_DUPLICATES=0\n"
    DEDUPE_CONF.parent.mkdir(parents=True, exist_ok=True)
    DEDUPE_CONF.write_text(existing, encoding="utf-8")

    # PC-game compatibility knowledge providers. These are host-side cached
    # metadata lookups; changing them does not require rebuilding game services.
    patch_env(GAME_METADATA_ENV, {
        "PCGA_PROTONDB_ENABLED": "1" if cfg["games"]["compat_protondb"] else "0",
        "PCGA_PLAYONLINUX_ENABLED": "1" if cfg["games"]["compat_playonlinux"] else "0",
    })
    # PCGA launches Wine directly rather than through Lutris' runner. Keep the
    # Direct3D translation backend explicit so every streamed title receives the
    # same appliance policy. The orchestrator propagates this into Wolf apps.
    patch_env(RUNTIME_ENV, {
        "PCGA_GRAPHICS_BACKEND": cfg["games"]["graphics_backend"],
        "PCGA_DXVK_WINETRICKS_VERB": "dxvk2062",
    })

    # RomM background defaults. Recreate the container so env-file changes apply.
    if ROMM_ENV.exists():
        patch_env(ROMM_ENV, {
            "ENABLE_RESCAN_ON_FILESYSTEM_CHANGE": "true" if cfg["games"]["filesystem_watch"] else "false",
            "RESCAN_ON_FILESYSTEM_CHANGE_DELAY": str(max(1, cfg["games"]["watch_debounce_seconds"] // 60)),
            "ENABLE_SCHEDULED_RESCAN": "true",
            "SCHEDULED_RESCAN_CRON": cfg["games"]["scheduled_rescan"],
            "HASHEOUS_API_ENABLED": "true" if cfg["games"]["metadata_hasheous"] else "false",
            "PLAYMATCH_API_ENABLED": "true" if cfg["games"]["metadata_playmatch"] else "false",
        })
        if cfg["games"]["romm_enabled"]:
            p = run(["docker", "compose", *compose_files(), "up", "-d", "romm-db", "romm"], timeout=180)
            results.append({"ok": p.returncode == 0, "service": "romm", "enabled": True, "detail": (p.stderr or p.stdout)[-800:]})
        else:
            p = run(["docker", "stop", "romm", "romm-db"], timeout=60)
            results.append({"ok": p.returncode == 0, "service": "romm", "enabled": False, "detail": (p.stderr or p.stdout)[-500:]})

    if cfg["photos"]["immich_enabled"]:
        p = run(["docker", "compose", *compose_files(), "up", "-d", "immich-database", "immich-redis", "immich-machine-learning", "immich-server"], timeout=240)
        results.append({"ok": p.returncode == 0, "service": "immich", "enabled": True, "detail": (p.stderr or p.stdout)[-800:]})
    else:
        p = run(["docker", "stop", "immich_server", "immich_machine_learning", "immich_redis", "immich_postgres"], timeout=60)
        results.append({"ok": p.returncode == 0, "service": "immich", "enabled": False, "detail": (p.stderr or p.stdout)[-500:]})
    if cfg["media"]["jellyfin_enabled"]:
        results.append(compose_up("jellyfin"))
    else:
        p = run(["docker", "stop", "jellyfin"], timeout=30)
        results.append({"ok": p.returncode == 0, "service": "jellyfin", "enabled": False, "detail": (p.stderr or p.stdout)[-500:]})
    return results


def update_config(payload: dict) -> dict:
    cfg = load_config()
    patch = payload.get("config") if isinstance(payload, dict) else None
    if not isinstance(patch, dict):
        raise ValueError("config object required")
    cfg = merge(cfg, patch)
    cfg = validate_config(cfg)
    atomic_json(CONFIG_PATH, cfg)
    if payload.get("apply", True):
        with game_stack_lock():
            results = apply_config(cfg)
    else:
        results = []
    return {"ok": all(r.get("ok", True) for r in results), "config": cfg, "results": results}


def _validate_game_set_id(value) -> str:
    sid = str(value or "").strip()
    if not re.fullmatch(r"[0-9A-Za-z._-]{8,80}", sid):
        raise ValueError("invalid game set id")
    return sid


def retry_pc_game(payload: dict) -> dict:
    """Run the host-side game reconciler for one PCGA-managed game.

    This action exists specifically so the containerized portal never tries to
    execute host binaries directly.  The browser talks to pcga-status, which
    forwards the authenticated request to this privileged host control plane.
    """
    sid = _validate_game_set_id(payload.get("game_set_id") or payload.get("set_id"))
    orchestrator = Path("/usr/local/sbin/pcga-game-orchestrator")
    if not orchestrator.is_file() or not os.access(orchestrator, os.X_OK):
        return {
            "ok": False,
            "action": "pc-game-retry",
            "game_set_id": sid,
            "error": "orchestrator-unavailable",
            "detail": f"Host component missing or not executable: {orchestrator}",
        }
    try:
        runtime = Path("/run/pcga-game-orchestrator")
        docker_cfg = runtime / "docker"
        config_home = runtime / "config"
        cache_home = runtime / "cache"
        for path in (runtime, docker_cfg, config_home, cache_home):
            path.mkdir(parents=True, exist_ok=True)
        child_env = os.environ.copy()
        child_env.update({
            "HOME": str(runtime),
            "DOCKER_CONFIG": str(docker_cfg),
            "XDG_CONFIG_HOME": str(config_home),
            "XDG_CACHE_HOME": str(cache_home),
        })
        proc = subprocess.Popen(
            [str(orchestrator), "--set-id", sid, "--force"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
            close_fds=True,
            env=child_env,
        )
    except OSError as exc:
        return {
            "ok": False,
            "action": "pc-game-retry",
            "game_set_id": sid,
            "error": type(exc).__name__,
            "detail": str(exc)[:400],
        }
    return {
        "ok": True,
        "action": "pc-game-retry",
        "game_set_id": sid,
        "pid": proc.pid,
        "detail": "Source identity, metadata, installation and Wolf registration are being reconciled on the host.",
    }


def refresh_pc_game_compatibility(payload: dict) -> dict:
    """Refresh external compatibility evidence without reinstalling the game."""
    sid = _validate_game_set_id(payload.get("game_set_id") or payload.get("set_id"))
    resolver = Path("/usr/local/sbin/pcga-game-compat-resolver")
    if not resolver.is_file() or not os.access(resolver, os.X_OK):
        return {"ok": False, "action": "pc-game-compat-refresh", "game_set_id": sid,
                "error": "resolver-unavailable", "detail": f"Host component missing or not executable: {resolver}"}
    proc = run([str(resolver), "--set-id", sid, "--force", "--print"], timeout=75)
    profile = {}
    if proc.returncode == 0:
        try:
            profile = json.loads(proc.stdout or "{}")
        except Exception:
            profile = {}
    return {
        "ok": proc.returncode == 0, "action": "pc-game-compat-refresh", "game_set_id": sid,
        "compatibility": profile if isinstance(profile, dict) else {},
        "stdout": (proc.stdout or "")[-6000:] if proc.returncode else "",
        "stderr": (proc.stderr or "")[-3000:],
        "detail": "Compatibility evidence refreshed from enabled providers." if proc.returncode == 0 else "Compatibility refresh failed; existing cached profile was left intact.",
    }


def reconcile_pc_game_stream(payload: dict) -> dict:
    """Reconcile one game's Wolf registration without reinstalling or network metadata work."""
    sid = _validate_game_set_id(payload.get("game_set_id") or payload.get("set_id"))
    orchestrator = Path("/usr/local/sbin/pcga-game-orchestrator")
    if not orchestrator.is_file() or not os.access(orchestrator, os.X_OK):
        return {"ok": False, "action": "pc-game-stream-reconcile", "game_set_id": sid,
                "error": "orchestrator-unavailable", "detail": f"Host component missing or not executable: {orchestrator}"}
    runtime = Path("/run/pcga-game-orchestrator")
    docker_cfg = runtime / "docker"
    config_home = runtime / "config"
    cache_home = runtime / "cache"
    for path in (runtime, docker_cfg, config_home, cache_home):
        path.mkdir(parents=True, exist_ok=True)
    child_env = os.environ.copy()
    child_env.update({
        "HOME": str(runtime),
        "DOCKER_CONFIG": str(docker_cfg),
        "XDG_CONFIG_HOME": str(config_home),
        "XDG_CACHE_HOME": str(cache_home),
    })
    proc = run([str(orchestrator), "--set-id", sid, "--metadata-only", "--no-network", "--force"], timeout=180, env=child_env)
    return {
        "ok": proc.returncode == 0, "action": "pc-game-stream-reconcile", "game_set_id": sid,
        "stdout": (proc.stdout or "")[-4000:], "stderr": (proc.stderr or "")[-2000:],
        "detail": "Wolf registration reconciliation completed." if proc.returncode == 0 else "Wolf registration reconciliation failed.",
    }



def _validate_pcga_client_id(value) -> str:
    client_id = str(value or "").strip()
    if not re.fullmatch(r"[A-Za-z0-9._:-]{8,128}", client_id):
        raise ValueError("invalid PCGA client id")
    return client_id


def _pc_game_session_owner_state() -> dict:
    raw = load_json(PC_GAME_SESSION_OWNER_PATH)
    return {
        "schema": 1,
        "version": VERSION,
        "reservations": raw.get("reservations") if isinstance(raw.get("reservations"), dict) else {},
        "containers": raw.get("containers") if isinstance(raw.get("containers"), dict) else {},
    }


def _pc_game_session_owner_save(state: dict) -> None:
    state["schema"] = 1
    state["version"] = VERSION
    atomic_json(PC_GAME_SESSION_OWNER_PATH, state, 0o600)


def _pc_game_started_epoch(value: str) -> float:
    try:
        return datetime.fromisoformat(str(value or "").replace("Z", "+00:00")).timestamp()
    except Exception:
        return 0.0


def _pc_game_reconcile_session_owners(sessions: list[dict]) -> tuple[list[dict], dict]:
    """Attach durable portal-client ownership to newly created Wolf containers.

    Wolf names a Docker child only after GameStream launch. PCGA therefore
    reserves a Moonlight lane first, then claims the first matching runtime
    container created after that reservation. The mapping lives on the host and
    survives portal reloads while the container remains active.
    """
    now_ts = time.time()
    active_ids = {str(x.get("container_id") or "") for x in sessions if x.get("container_id")}
    with PC_GAME_SESSION_OWNER_LOCK:
        state = _pc_game_session_owner_state()
        reservations = state["reservations"]
        containers = state["containers"]
        changed = False

        for cid in list(containers):
            if cid not in active_ids:
                owner = containers.pop(cid, None)
                rid = str(owner.get("reservation_id") or "") if isinstance(owner, dict) else ""
                if rid and isinstance(reservations.get(rid), dict) and str(reservations[rid].get("container_id") or "") == cid:
                    reservations.pop(rid, None)
                changed = True

        for rid, row in list(reservations.items()):
            if not isinstance(row, dict):
                reservations.pop(rid, None); changed = True; continue
            cid = str(row.get("container_id") or "")
            age = now_ts - float(row.get("reserved_at") or 0)
            if cid and cid in active_ids:
                continue
            if age > 300:
                reservations.pop(rid, None); changed = True

        claimed_reservations = {str(v.get("reservation_id") or "") for v in containers.values() if isinstance(v, dict)}
        for session in sorted(sessions, key=lambda x: str(x.get("started_at") or "")):
            cid = str(session.get("container_id") or "")
            if not cid or cid in containers:
                continue
            sid = str(session.get("game_set_id") or "")
            started = _pc_game_started_epoch(str(session.get("started_at") or ""))
            candidates = []
            for rid, row in reservations.items():
                if rid in claimed_reservations or not isinstance(row, dict):
                    continue
                if str(row.get("game_set_id") or "") != sid:
                    continue
                requested_variant = str(row.get("launch_variant") or "")
                session_variant = str(session.get("launch_variant") or "")
                if requested_variant and session_variant and requested_variant != session_variant:
                    continue
                reserved_at = float(row.get("reserved_at") or 0)
                if started and reserved_at and started < reserved_at - 2:
                    continue
                candidates.append((reserved_at, rid, row))
            if not candidates:
                continue
            _, rid, row = sorted(candidates, key=lambda x: x[0])[0]
            owner = {
                "client_id": str(row.get("client_id") or ""),
                "lane": int(row.get("lane") or 0),
                "reservation_id": rid,
                "game_set_id": sid,
                "launch_variant": row.get("launch_variant") or session.get("launch_variant") or None,
                "active_disc": int(row.get("active_disc") or 1),
                "claimed_at": now_ts,
            }
            containers[cid] = owner
            row["container_id"] = cid
            row["claimed_at"] = now_ts
            claimed_reservations.add(rid)
            changed = True

        decorated = []
        for session in sessions:
            row = dict(session)
            owner = containers.get(str(row.get("container_id") or ""))
            if isinstance(owner, dict):
                row.update({
                    "owner_client_id": owner.get("client_id") or None,
                    "lane": owner.get("lane") or None,
                    "reservation_id": owner.get("reservation_id") or None,
                    "launch_variant": owner.get("launch_variant") or row.get("launch_variant") or None,
                    "active_disc": owner.get("active_disc") or 1,
                    "resumable": bool(owner.get("reservation_id") and owner.get("lane")),
                    "stream_id": "pcga:" + str(row.get("game_set_id") or ""),
                })
            else:
                row.update({"owner_client_id": None, "lane": None, "reservation_id": None, "active_disc": None, "resumable": False, "stream_id": "pcga:" + str(row.get("game_set_id") or "")})
            decorated.append(row)
        if changed:
            _pc_game_session_owner_save(state)
        return decorated, state


def reserve_pc_game_session(payload: dict) -> dict:
    client_id = _validate_pcga_client_id(payload.get("client_id"))
    sid = _validate_game_set_id(payload.get("game_set_id") or payload.get("set_id"))
    variant = str(payload.get("launch_variant") or payload.get("variant") or "").strip().casefold()
    if variant and not re.fullmatch(r"[a-z0-9._-]{1,40}", variant):
        raise ValueError("invalid PC game launch variant")
    lane_count = max(1, min(PC_GAME_SESSION_LANES, int(payload.get("lane_count") or PC_GAME_SESSION_LANES)))
    listing = pc_game_sessions()
    if not listing.get("ok"):
        return listing
    now_ts = time.time()
    with PC_GAME_SESSION_OWNER_LOCK:
        state = _pc_game_session_owner_state()
        used = {int(x.get("lane") or 0) for x in listing.get("sessions") or [] if int(x.get("lane") or 0) > 0}
        for row in state["reservations"].values():
            if not isinstance(row, dict):
                continue
            pending = now_ts - float(row.get("reserved_at") or 0) <= 300 and not row.get("container_id")
            if pending and str(row.get("game_set_id") or "") == sid:
                return {
                    "ok": False, "action": "pc-game-session-reserve", "error": "same-game-launch-pending",
                    "detail": "Another launch of this same PC game is still being claimed by Wolf. Wait for that desktop to open, then launch the next instance.",
                }
            if pending:
                lane = int(row.get("lane") or 0)
                if lane:
                    used.add(lane)
        lane = next((n for n in range(1, lane_count + 1) if n not in used), 0)
        if not lane:
            return {
                "ok": False, "action": "pc-game-session-reserve", "error": "no-stream-lane",
                "detail": f"All {lane_count} browser-stream lanes are in use. End one of your sessions, or wait for another appliance client to free a lane.",
                "active": len(listing.get("sessions") or []), "reserved_lanes": len(used), "lane_count": lane_count,
            }
        rid = uuid.uuid4().hex
        state["reservations"][rid] = {
            "client_id": client_id, "game_set_id": sid, "lane": lane,
            "launch_variant": variant or None,
            "active_disc": 1, "reserved_at": now_ts, "container_id": None,
        }
        _pc_game_session_owner_save(state)
    return {
        "ok": True, "action": "pc-game-session-reserve", "reservation_id": rid,
        "client_id": client_id, "game_set_id": sid, "lane": lane, "launch_variant": variant or None,
        "browser_port": 8100 + lane, "lane_count": lane_count,
        "detail": f"Reserved browser-stream lane {lane} for this client.",
    }


def claim_pc_game_session(payload: dict) -> dict:
    client_id = _validate_pcga_client_id(payload.get("client_id"))
    rid = str(payload.get("reservation_id") or "").strip()
    if not re.fullmatch(r"[0-9a-f]{32}", rid):
        raise ValueError("invalid PC game session reservation id")
    listing = pc_game_sessions()
    if not listing.get("ok"):
        return listing
    for row in listing.get("sessions") or []:
        if row.get("reservation_id") == rid and row.get("owner_client_id") == client_id:
            return {"ok": True, "action": "pc-game-session-claim", "claimed": True, "session": row, "container_id": row.get("container_id")}
    with PC_GAME_SESSION_OWNER_LOCK:
        state = _pc_game_session_owner_state()
        reservation = state["reservations"].get(rid)
    if not isinstance(reservation, dict) or reservation.get("client_id") != client_id:
        return {"ok": False, "action": "pc-game-session-claim", "error": "reservation-not-found", "detail": "The stream reservation is no longer active."}
    return {"ok": True, "action": "pc-game-session-claim", "claimed": False, "reservation_id": rid, "lane": reservation.get("lane")}


def release_pc_game_session(payload: dict) -> dict:
    client_id = _validate_pcga_client_id(payload.get("client_id"))
    rid = str(payload.get("reservation_id") or "").strip()
    if not re.fullmatch(r"[0-9a-f]{32}", rid):
        raise ValueError("invalid PC game session reservation id")
    with PC_GAME_SESSION_OWNER_LOCK:
        state = _pc_game_session_owner_state()
        row = state["reservations"].get(rid)
        if isinstance(row, dict) and row.get("client_id") == client_id and not row.get("container_id"):
            state["reservations"].pop(rid, None)
            _pc_game_session_owner_save(state)
            return {"ok": True, "action": "pc-game-session-release", "released": True}
    return {"ok": True, "action": "pc-game-session-release", "released": False}

def _pc_game_runtime_record(raw: dict, *, include_stopped: bool = False) -> dict|None:
    """Return a safe summary for one Wolf-owned PCGA runtime container.

    The control plane never accepts a container name alone as authority. A
    session must carry PCGA_GAME_SET_ID and use a PCGA runtime image before the
    portal may terminate it. This keeps the session manager from becoming an
    arbitrary Docker stop endpoint.
    """
    if not isinstance(raw, dict):
        return None
    config = raw.get("Config") if isinstance(raw.get("Config"), dict) else {}
    state = raw.get("State") if isinstance(raw.get("State"), dict) else {}
    running = bool(state.get("Running"))
    if not running and not include_stopped:
        return None
    name = str(raw.get("Name") or "").lstrip("/")
    image = str(config.get("Image") or "")
    env = {}
    for item in config.get("Env") or []:
        if isinstance(item, str) and "=" in item:
            key, value = item.split("=", 1)
            env[key] = value
    sid = str(env.get("PCGA_GAME_SET_ID") or "").strip()
    if not re.fullmatch(r"[0-9A-Za-z._-]{8,80}", sid):
        return None
    managed_name = bool(re.fullmatch(r"PCGA-(?:Setup-)?[A-Za-z0-9_.-]+", name))
    managed_image = image.startswith("pcga/game-") or image.startswith("pcga/setup-")
    if not (managed_name and managed_image):
        return None
    setup = name.startswith("PCGA-Setup-") or image.startswith("pcga/setup-")
    launch_variant = str(env.get("PCGA_LAUNCH_VARIANT") or "").strip() or None
    title = ""
    try:
        state_doc = json.loads((PC_GAME_STATE_ROOT / f"{sid}.json").read_text(encoding="utf-8"))
        if isinstance(state_doc, dict):
            title = str(state_doc.get("title") or "").strip()
    except Exception:
        pass
    if not title:
        prefix = "PCGA-Setup-" if setup else "PCGA-"
        title = re.sub(r"[_-][0-9]{8,}$", "", name.removeprefix(prefix)).replace("-", " ").strip() or "PC Game"
    started = str(state.get("StartedAt") or "")
    age_seconds = None
    if started:
        try:
            dt = datetime.fromisoformat(started.replace("Z", "+00:00"))
            age_seconds = max(0, int((datetime.now(timezone.utc) - dt.astimezone(timezone.utc)).total_seconds()))
        except Exception:
            pass
    host_config = raw.get("HostConfig") if isinstance(raw.get("HostConfig"), dict) else {}
    network_settings = raw.get("NetworkSettings") if isinstance(raw.get("NetworkSettings"), dict) else {}
    networks = network_settings.get("Networks") if isinstance(network_settings.get("Networks"), dict) else {}
    lan = networks.get("legacy-games") if isinstance(networks.get("legacy-games"), dict) else {}
    cid = str(raw.get("Id") or "")
    return {
        "container_id": cid,
        "container_short_id": cid[:12],
        "name": name,
        "game_set_id": sid,
        "title": title,
        "launch_variant": launch_variant,
        "kind": "setup" if setup else "game",
        "image": image,
        "started_at": started,
        "age_seconds": age_seconds,
        "network_mode": str(host_config.get("NetworkMode") or ""),
        "lan_network": "legacy-games" if lan else "",
        "lan_ip": str(lan.get("IPAddress") or ""),
        "running": running,
        "container_status": str(state.get("Status") or ""),
    }


def pc_game_sessions(payload: dict|None = None) -> dict:
    """List active Wolf-created PCGA runtimes with optional client ownership scope.

    Pending stream reservations are reported as counts as well. This lets a
    browser client release a launch that never reached the Wolf-container claim
    step instead of silently occupying a Moonlight lane for the full timeout.
    """
    ps = run(["docker", "ps", "-q"], timeout=15)
    if ps.returncode != 0:
        return {"ok": False, "action": "pc-game-session-list", "error": "docker-unavailable", "detail": (ps.stderr or ps.stdout)[-800:]}
    ids = [x.strip() for x in ps.stdout.splitlines() if x.strip()]
    sessions = []
    if ids:
        inspected = run(["docker", "inspect", *ids], timeout=25)
        if inspected.returncode != 0:
            return {"ok": False, "action": "pc-game-session-list", "error": "docker-inspect-failed", "detail": (inspected.stderr or inspected.stdout)[-800:]}
        try:
            raw = json.loads(inspected.stdout)
        except Exception as exc:
            return {"ok": False, "action": "pc-game-session-list", "error": "invalid-docker-inspect", "detail": str(exc)[:300]}
        for item in raw if isinstance(raw, list) else []:
            record = _pc_game_runtime_record(item)
            if record:
                sessions.append(record)
    sessions.sort(key=lambda x: str(x.get("started_at") or ""))
    sessions, owner_state = _pc_game_reconcile_session_owners(sessions)
    total_count = len(sessions)
    pending_rows = [
        row for row in owner_state.get("reservations", {}).values()
        if isinstance(row, dict) and not row.get("container_id")
    ]
    total_pending_count = len(pending_rows)
    payload = payload if isinstance(payload, dict) else {}
    client_raw = str(payload.get("client_id") or "").strip()
    pending_count = total_pending_count
    if client_raw:
        client_id = _validate_pcga_client_id(client_raw)
        sessions = [dict(x, owned_by_request=True) for x in sessions if x.get("owner_client_id") == client_id]
        pending_count = sum(1 for row in pending_rows if row.get("client_id") == client_id)
    return {
        "ok": True, "action": "pc-game-session-list", "sessions": sessions,
        "count": len(sessions), "total_count": total_count,
        "pending_count": pending_count, "total_pending_count": total_pending_count,
    }

def stop_pc_game_session(payload: dict) -> dict:
    """Terminate selected PCGA runtime sessions, then nudge deferred Wolf work.

    docker stop provides a short graceful window so the generated runtime can
    forward SIGTERM to Wine. Docker performs the forced kill if the process does
    not exit before that window expires.
    """
    listing = pc_game_sessions()
    if not listing.get("ok"):
        return listing
    sessions = list(listing.get("sessions") or [])
    target_id = str(payload.get("container_id") or "").strip()
    target_sid = str(payload.get("game_set_id") or payload.get("set_id") or "").strip()
    reservation_id = str(payload.get("reservation_id") or "").strip()
    client_raw = str(payload.get("client_id") or "").strip()
    client_id = _validate_pcga_client_id(client_raw) if client_raw else ""
    stop_all = bool(payload.get("all"))
    if target_id and not re.fullmatch(r"[0-9a-fA-F]{12,64}", target_id):
        raise ValueError("invalid PC game runtime container id")
    if target_sid:
        target_sid = _validate_game_set_id(target_sid)
    if reservation_id and not re.fullmatch(r"[0-9a-f]{32}", reservation_id):
        raise ValueError("invalid PC game session reservation id")
    visible = [x for x in sessions if (not client_id or x.get("owner_client_id") == client_id)]
    released_pending = []
    if stop_all and client_id:
        with PC_GAME_SESSION_OWNER_LOCK:
            owner_state = _pc_game_session_owner_state()
            for rid, row in list(owner_state["reservations"].items()):
                if isinstance(row, dict) and row.get("client_id") == client_id and not row.get("container_id"):
                    released_pending.append(rid)
                    owner_state["reservations"].pop(rid, None)
            if released_pending:
                _pc_game_session_owner_save(owner_state)
    if stop_all:
        targets = visible
    elif reservation_id:
        targets = [x for x in visible if x.get("reservation_id") == reservation_id]
    elif target_id:
        targets = [x for x in visible if str(x.get("container_id") or "").startswith(target_id)]
    elif target_sid:
        targets = [x for x in visible if x.get("game_set_id") == target_sid]
    else:
        raise ValueError("container_id, reservation_id, game_set_id, or all=true is required")
    if not targets:
        released = False
        removed_inactive = []
        if reservation_id and client_id:
            release = release_pc_game_session({"client_id": client_id, "reservation_id": reservation_id})
            released = bool(release.get("released")) if isinstance(release, dict) else False
        # The runtime may have exited between the browser's last session poll and
        # this request. It is still safe and useful to remove that transient
        # Docker object after validating its PCGA name/image/environment.
        if target_id:
            inspect = run(["docker", "inspect", target_id], timeout=12)
            if inspect.returncode == 0:
                try:
                    rows = json.loads(inspect.stdout)
                    stale = _pc_game_runtime_record(rows[0] if isinstance(rows, list) and rows else {}, include_stopped=True)
                except Exception:
                    stale = None
                if stale and not stale.get("running"):
                    rm = run(["docker", "rm", "-f", str(stale.get("container_id") or target_id)], timeout=15)
                    if rm.returncode == 0 or "No such container" in ((rm.stderr or "") + (rm.stdout or "")):
                        removed_inactive.append({**stale, "result": "removed-after-exit"})
        return {
            "ok": True,
            "action": "pc-game-session-stop",
            "stopped": removed_inactive,
            "released_reservation": released,
            "released_reservations": released_pending,
            "remaining": len(sessions),
            "detail": (
                "Removed the already-exited PCGA runtime container."
                if removed_inactive else
                f"Released {len(released_pending)} pending browser-stream reservation(s) for this client."
                if released_pending else
                "Released the pending browser-stream reservation before a runtime container was created."
                if released else "The selected PCGA game session had already ended."
            ),
        }
    stopped = []
    failed = []
    # Re-check each target immediately before stopping so a stale browser list
    # cannot be used to terminate a replacement container with the same name.
    for target in targets:
        cid = str(target.get("container_id") or "")
        verify = run(["docker", "inspect", cid], timeout=12)
        if verify.returncode != 0:
            stopped.append({**target, "result": "already-ended"})
            continue
        try:
            rows = json.loads(verify.stdout)
            current = _pc_game_runtime_record(rows[0] if isinstance(rows, list) and rows else {})
        except Exception:
            current = None
        if not current or current.get("container_id") != cid:
            failed.append({**target, "detail": "Container no longer matches a managed PCGA runtime session"})
            continue
        proc = run(["docker", "stop", "-t", "6", cid], timeout=20)
        # Stopping the game process is not enough: Wolf child containers are
        # disposable desktops. Remove the container object as well so a stale
        # compositor/helper cannot keep a lane busy or block the next Wolf reload.
        rm = run(["docker", "rm", "-f", cid], timeout=20)
        rm_missing = "No such container" in ((rm.stderr or "") + (rm.stdout or ""))
        if (proc.returncode == 0 or rm.returncode == 0 or rm_missing) and (rm.returncode == 0 or rm_missing):
            stopped.append({
                **current,
                "owner_client_id": target.get("owner_client_id"),
                "lane": target.get("lane"),
                "reservation_id": target.get("reservation_id"),
                "result": "stopped-and-removed" if proc.returncode == 0 else "force-removed",
            })
        else:
            detail = ((rm.stderr or rm.stdout) if rm.returncode else (proc.stderr or proc.stdout))[-500:]
            failed.append({**current, "detail": detail or "docker stop/remove failed"})
    if stopped:
        with PC_GAME_SESSION_OWNER_LOCK:
            owner_state = _pc_game_session_owner_state()
            stopped_ids = {str(x.get("container_id") or "") for x in stopped}
            stopped_reservations = {str(x.get("reservation_id") or "") for x in stopped if x.get("reservation_id")}
            for cid in stopped_ids:
                owner_state["containers"].pop(cid, None)
            for rid in stopped_reservations:
                owner_state["reservations"].pop(rid, None)
            _pc_game_session_owner_save(owner_state)
    remaining_result = pc_game_sessions()
    remaining = int(remaining_result.get("count") or 0) if remaining_result.get("ok") else None
    # A completed interactive installer is persistent host state. Finalize each
    # stopped setup synchronously so End Session transitions the portal from the
    # Setup app to the direct game app instead of making the user launch Setup
    # again and wait for the periodic timer.
    finalized=[]
    setup_ids=sorted({str(x.get("game_set_id") or "") for x in stopped if x.get("kind") == "setup" and x.get("game_set_id")})
    orchestrator=Path("/usr/local/sbin/pcga-game-orchestrator")
    if setup_ids and orchestrator.is_file() and os.access(orchestrator, os.X_OK):
        runtime=Path("/run/pcga-game-orchestrator"); docker_cfg=runtime/"docker"; config_home=runtime/"config"; cache_home=runtime/"cache"
        for path in (runtime,docker_cfg,config_home,cache_home): path.mkdir(parents=True, exist_ok=True)
        child_env=os.environ.copy(); child_env.update({"HOME":str(runtime),"DOCKER_CONFIG":str(docker_cfg),"XDG_CONFIG_HOME":str(config_home),"XDG_CACHE_HOME":str(cache_home)})
        for sid in setup_ids:
            proc=run([str(orchestrator),"--set-id",sid,"--metadata-only","--no-network"],timeout=180,env=child_env)
            finalized.append({"game_set_id":sid,"ok":proc.returncode==0,"detail":((proc.stderr or proc.stdout)[-800:] if proc.returncode else "Installation finalized and stream registration reconciled.")})
    # When the final session is gone, also wake the periodic orchestrator so any
    # unrelated deferred Wolf app-catalog reload can complete immediately.
    if remaining == 0:
        run(["systemctl", "start", "--no-block", "pcga-game-orchestrator.service"], timeout=10)
    ok = not failed and all(x.get("ok") for x in finalized)
    return {
        "ok": ok,
        "action": "pc-game-session-stop",
        "stopped": stopped,
        "failed": failed,
        "finalized": finalized,
        "released_reservations": released_pending,
        "remaining": remaining,
        "detail": (
            f"Ended {len(stopped)} PCGA game session{'s' if len(stopped) != 1 else ''}."
            if ok else f"Ended {len(stopped)} session(s); {len(failed)} could not be terminated."
        ),
    }


def _pcga_disc_image_files(bundle: Path) -> list[dict]:
    """Describe preserved optical artifacts without reading or mutating payload data."""
    rows=[]
    allowed={".iso",".bin",".cue",".toc",".img",".nrg",".mdf",".mds",".ccd",".sub"}
    try: children=sorted(bundle.iterdir(), key=lambda x:x.name.casefold())
    except OSError: return rows
    for q in children:
        if not q.is_file() or q.suffix.casefold() not in allowed: continue
        try:size=q.stat().st_size
        except OSError:size=0
        rows.append({"name":q.name,"format":q.suffix.casefold().lstrip('.'),"bytes":size})
    return rows


def _pcga_preserved_disc_copies() -> dict[str,list[dict]]:
    root=read_root()
    search_roots=[
        root/"ingest/inbox/pc-games", root/"ingest/inbox/software", root/"ingest/inbox/disc-images",
        root/"media/metadata-pending", root/"media/quarantine/unidentified", root/"media/quarantine/duplicates",
    ]
    found:dict[str,list[dict]]={}; seen=set()
    for base in search_roots:
        if not base.exists(): continue
        # Canonical preservation bundles carry .pcga-game.json.  A fallback to
        # .pcga-optical.json keeps partially-classified but successfully-ripped
        # images visible to the user as well.
        markers=list(base.rglob('.pcga-game.json'))
        marker_parents={m.parent.resolve() for m in markers}
        for marker in markers:
            meta=load_json(marker); fp=str(meta.get('fingerprint') or '').strip()
            if not fp: continue
            bundle=marker.parent
            key=(fp,str(bundle.resolve()))
            if key in seen: continue
            seen.add(key)
            files=_pcga_disc_image_files(bundle)
            try:rel=str(bundle.resolve().relative_to(root.resolve()))
            except Exception:rel=bundle.name
            found.setdefault(fp,[]).append({"path":rel,"files":files,"bytes":sum(int(x.get('bytes') or 0) for x in files if x.get('format') in {'iso','bin','img','nrg','mdf'}),"source":"game-sidecar"})
        for optical in base.rglob('.pcga-optical.json'):
            bundle=optical.parent
            try: resolved=bundle.resolve()
            except OSError: resolved=bundle
            if resolved in marker_parents: continue
            meta=load_json(optical); fp=str(meta.get('fingerprint') or '').strip()
            if not fp: continue
            files=_pcga_disc_image_files(bundle)
            if not files: continue
            key=(fp,str(resolved))
            if key in seen: continue
            seen.add(key)
            try:rel=str(resolved.relative_to(root.resolve()))
            except Exception:rel=bundle.name
            found.setdefault(fp,[]).append({"path":rel,"files":files,"bytes":sum(int(x.get('bytes') or 0) for x in files if x.get('format') in {'iso','bin','img','nrg','mdf'}),"source":"optical-sidecar"})
    return found


def pc_game_disc_library(payload: dict|None=None) -> dict:
    """Return title records plus every preservation-backed PC-game optical image."""
    sets_dir=PC_GAME_INTAKE_ROOT/'sets'; discs_dir=PC_GAME_INTAKE_ROOT/'discs'
    sets=[]; set_map={}
    for p in sorted(sets_dir.glob('*.json')) if sets_dir.exists() else []:
        d=load_json(p)
        if not d: continue
        sid=str(d.get('id') or p.stem)
        row={"id":sid,"title":str(d.get('title') or 'Unidentified PC Game'),"sort_title":str(d.get('sort_title') or d.get('title') or ''),"provisional":bool(d.get('provisional')),"user_confirmed":bool(d.get('user_confirmed')),"disc_count":len((d.get('media') or {}).get('discs') or []) if isinstance(d.get('media'),dict) else len(d.get('disc_fingerprints') or [])}
        sets.append(row);set_map[sid]=row
    copies=_pcga_preserved_disc_copies(); rows=[]; seen=set()
    for p in sorted(discs_dir.glob('*.json')) if discs_dir.exists() else []:
        d=load_json(p)
        if not d: continue
        fp=str(d.get('fingerprint') or p.stem); seen.add(fp)
        ids=[str(x) for x in (d.get('game_set_ids') or ([d.get('game_set_id')] if d.get('game_set_id') else [])) if x]
        owners=[set_map[x] for x in ids if x in set_map]
        cp=copies.get(fp,[])
        rows.append({
            "fingerprint":fp,"volume_label":d.get('volume_label'),"filesystem_type":d.get('filesystem_type'),
            "layout":d.get('layout'),"disc_number":d.get('disc_number'),"disc_count":d.get('disc_count'),"disc_role":d.get('disc_role'),
            "metadata_status":d.get('metadata_status'),"game_set_ids":ids,"owners":owners,"assigned":bool(ids),
            "copies":cp,"copy_count":len(cp),"preserved":bool(cp),"bytes":sum(int(x.get('bytes') or 0) for x in cp),
            "match":d.get('match') if isinstance(d.get('match'),dict) else {},"updated_at":d.get('updated_at'),
        })
    # A successful rip may be visible before metadata classification created the
    # canonical fingerprint record. Keep it in the browser as an unassigned image.
    for fp,cp in copies.items():
        if fp in seen: continue
        rows.append({"fingerprint":fp,"volume_label":None,"filesystem_type":None,"layout":"unknown","disc_number":None,"disc_count":None,"disc_role":None,"metadata_status":"preserved-unclassified","game_set_ids":[],"owners":[],"assigned":False,"copies":cp,"copy_count":len(cp),"preserved":True,"bytes":sum(int(x.get('bytes') or 0) for x in cp),"match":{},"updated_at":None})
    rows.sort(key=lambda x:(not bool(x.get('preserved')), bool(x.get('assigned')), str(x.get('volume_label') or '').casefold(), str(x.get('fingerprint') or '')))
    sets.sort(key=lambda x:str(x.get('sort_title') or x.get('title') or '').casefold())
    return {"ok":True,"action":"pc-game-disc-library","version":VERSION,"items":rows,"sets":sets,"count":len(rows),"unassigned":sum(1 for x in rows if not x.get('assigned'))}


def _pcga_start_reconcile(set_ids:list[str]) -> list[dict]:
    out=[]; orchestrator=Path('/usr/local/sbin/pcga-game-orchestrator')
    if not orchestrator.is_file(): return out
    runtime=Path('/run/pcga-game-orchestrator'); docker_cfg=runtime/'docker'; config_home=runtime/'config'; cache_home=runtime/'cache'
    for path in (runtime,docker_cfg,config_home,cache_home): path.mkdir(parents=True,exist_ok=True)
    child_env=os.environ.copy();child_env.update({"HOME":str(runtime),"DOCKER_CONFIG":str(docker_cfg),"XDG_CONFIG_HOME":str(config_home),"XDG_CACHE_HOME":str(cache_home)})
    for sid in dict.fromkeys(x for x in set_ids if x):
        try:
            proc=subprocess.Popen([str(orchestrator),'--set-id',sid,'--force'],stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,start_new_session=True,close_fds=True,env=child_env)
            out.append({"game_set_id":sid,"pid":proc.pid})
        except OSError as exc: out.append({"game_set_id":sid,"error":type(exc).__name__,"detail":str(exc)[:200]})
    return out


def assign_pc_game_disc(payload: dict) -> dict:
    fp=str(payload.get('fingerprint') or '').strip(); sid=_validate_game_set_id(payload.get('game_set_id') or payload.get('set_id'))
    if not fp or len(fp)>256 or not re.fullmatch(r'[0-9A-Za-z._:+-]+',fp): raise ValueError('invalid disc fingerprint')
    disc_path=PC_GAME_INTAKE_ROOT/'discs'/f'{fp}.json'; before=load_json(disc_path)
    if not before:
        # A freshly-preserved image can reach the inventory before the game
        # classifier has emitted its canonical disc record. Recover enough
        # metadata from the preservation sidecars to let the user own it now.
        root=read_root(); recovered={}
        for base in (root/'ingest/inbox/pc-games',root/'ingest/inbox/software',root/'ingest/inbox/disc-images',root/'media/metadata-pending',root/'media/quarantine/unidentified'):
            if not base.exists(): continue
            for marker in list(base.rglob('.pcga-game.json'))+list(base.rglob('.pcga-optical.json')):
                doc=load_json(marker)
                if str(doc.get('fingerprint') or '')!=fp: continue
                if marker.name=='.pcga-game.json': recovered=dict(doc)
                else:
                    fs=doc.get('filesystem') if isinstance(doc.get('filesystem'),dict) else {}
                    recovered={'schema':2,'fingerprint':fp,'layout':'unknown','game_set_id':None,'game_set_ids':[],'contents':[],
                               'volume_label':fs.get('label'),'filesystem_type':fs.get('type'),'metadata_status':'preserved-unclassified',
                               'metadata_sources':['preservation-sidecar'],'created_at':datetime.now(timezone.utc).isoformat(timespec='seconds'),
                               'updated_at':datetime.now(timezone.utc).isoformat(timespec='seconds')}
                if recovered: break
            if recovered: break
        if recovered:
            disc_path.parent.mkdir(parents=True,exist_ok=True);atomic_json(disc_path,recovered);before=recovered
    if not before: raise FileNotFoundError('disc metadata record not found')
    previous=[str(x) for x in (before.get('game_set_ids') or ([before.get('game_set_id')] if before.get('game_set_id') else [])) if x]
    cmd=['/usr/local/sbin/pcga-game-intake','assign-disc',fp,sid,'--confirm']
    for key,flag in (('disc_number','--number'),('disc_count','--count')):
        value=payload.get(key)
        if value not in (None,''):
            try:n=int(value)
            except (TypeError,ValueError): raise ValueError(f'{key} must be an integer')
            if n<1 or n>99: raise ValueError(f'{key} must be between 1 and 99')
            cmd += [flag,str(n)]
    role=str(payload.get('disc_role') or payload.get('role') or '').strip()
    if role:
        if len(role)>64 or any(ord(c)<32 for c in role): raise ValueError('invalid disc role')
        cmd += ['--role',role]
    if bool(payload.get('replace_compilation')): cmd.append('--replace-compilation')
    proc=run(cmd,timeout=30)
    if proc.returncode!=0:
        return {"ok":False,"action":"pc-game-disc-assign","fingerprint":fp,"game_set_id":sid,"error":"assignment-failed","detail":((proc.stderr or proc.stdout) or 'assignment failed')[-1600:]}
    try:disc=json.loads(proc.stdout or '{}')
    except Exception:disc=load_json(disc_path)
    reconcile=_pcga_start_reconcile(previous+[sid])
    return {"ok":True,"action":"pc-game-disc-assign","fingerprint":fp,"game_set_id":sid,"disc":disc,"reconcile":reconcile,"detail":"Preserved disc ownership updated. The image payload and preservation checksums were not modified."}




def _simple_env(path: Path) -> dict[str, str]:
    out: dict[str, str] = {}
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return out
    for raw in lines:
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        out[key.strip()] = value.strip().strip('"').strip("'")
    return out


