def validate_config(cfg: dict) -> dict:
    out = merge(DEFAULTS, cfg)
    for sec, key in [
        ("ingest", "auto_rip"), ("ingest", "keep_raw"),
        ("review", "auto_classify"),
        ("games", "romm_enabled"), ("games", "filesystem_watch"),
        ("games", "metadata_hasheous"), ("games", "metadata_playmatch"),
        ("games", "compat_protondb"), ("games", "compat_playonlinux"),
        ("photos", "immich_enabled"), ("media", "jellyfin_enabled"),
        ("automation", "sorter_enabled"), ("automation", "classifier_enabled"),
        ("automation", "dedupe_enabled"), ("remote_access", "tailscale_enabled"),
        ("nas", "enabled"), ("nas", "schedule_enabled"),
    ]:
        out[sec][key] = bool(out[sec].get(key))
    try:
        threshold = float(out["review"].get("auto_threshold", .90))
    except (TypeError, ValueError):
        threshold = .90
    out["review"]["auto_threshold"] = max(.50, min(1.0, threshold))
    out["games"]["watch_debounce_seconds"] = clamp_int(out["games"].get("watch_debounce_seconds"), 30, 3600, 300)
    graphics_backend = str(out["games"].get("graphics_backend") or "auto").strip().lower()
    out["games"]["graphics_backend"] = graphics_backend if graphics_backend in {"auto", "dxvk", "wined3d"} else "auto"
    cron = str(out["games"].get("scheduled_rescan") or "25 3 * * *").strip()
    if len(cron) > 80 or any(c in cron for c in "\n\r\0"):
        cron = "25 3 * * *"
    out["games"]["scheduled_rescan"] = cron
    out["media"]["background_video_max_width"] = clamp_int(out["media"].get("background_video_max_width"), 640, 3840, 1920)
    out["media"]["background_video_max_height"] = clamp_int(out["media"].get("background_video_max_height"), 360, 2160, 1080)
    out["media"]["background_video_bitrate"] = clamp_int(out["media"].get("background_video_bitrate"), 500000, 50000000, 8000000)
    nas = out["nas"]
    nas["protocol"] = str(nas.get("protocol") or "smb").lower()
    if nas["protocol"] not in {"smb", "nfs"}: nas["protocol"] = "smb"
    nas["mode"] = str(nas.get("mode") or "mirror").lower()
    if nas["mode"] not in {"mirror", "offload"}: nas["mode"] = "mirror"
    nas["host"] = str(nas.get("host") or "").strip()[:255]
    nas["share"] = str(nas.get("share") or "").strip()[:512]
    nas["username"] = str(nas.get("username") or "").strip()[:255]
    nas["domain"] = str(nas.get("domain") or "").strip()[:255]
    base_dir = str(nas.get("base_dir") or "PCGA").strip().strip("/")
    nas["base_dir"] = base_dir if re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._ -]{0,79}", base_dir) else "PCGA"
    allowed_libs = {"movies", "tv", "music", "home-videos", "photos"}
    libs = nas.get("libraries") if isinstance(nas.get("libraries"), list) else []
    nas["libraries"] = [x for x in libs if x in allowed_libs] or ["movies", "tv", "music", "home-videos", "photos"]
    nas["local_reserve_gib"] = clamp_int(nas.get("local_reserve_gib"), 1, 16384, 100)
    nas["min_age_days"] = clamp_int(nas.get("min_age_days"), 0, 3650, 30)
    out["schema"] = 2
    out["version"] = VERSION
    return out


def patch_env(path: Path, values: dict[str, str]) -> None:
    lines = path.read_text(encoding="utf-8", errors="replace").splitlines() if path.exists() else []
    remaining = dict(values)
    out = []
    for line in lines:
        if "=" in line and not line.lstrip().startswith("#"):
            key = line.split("=", 1)[0].strip()
            if key in remaining:
                out.append(f"{key}={remaining.pop(key)}")
                continue
        out.append(line)
    if out and out[-1] != "":
        out.append("")
    for key, value in remaining.items():
        out.append(f"{key}={value}")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(out).rstrip() + "\n", encoding="utf-8")
    os.chmod(path, 0o600)


def set_unit(unit: str, enabled: bool) -> dict:
