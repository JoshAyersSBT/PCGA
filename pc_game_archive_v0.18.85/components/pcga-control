def _game_activity_key(kind: str, game_id: str) -> str:
    kind = str(kind or "").strip().lower()
    game_id = str(game_id or "").strip()
    if kind not in {"console-game", "pc-game"}:
        raise ValueError("invalid game activity kind")
    if not game_id or len(game_id) > 240 or any(ord(c) < 32 for c in game_id):
        raise ValueError("invalid game activity id")
    return kind + ":" + game_id


def game_activity_record(payload: dict) -> dict:
    kind = str(payload.get("kind") or "").strip().lower()
    game_id = str(payload.get("id") or "").strip()
    key = _game_activity_key(kind, game_id)
    now = time.time()
    title = str(payload.get("title") or payload.get("name") or ("Console Game" if kind == "console-game" else "PC Game"))[:240]
    subtitle = str(payload.get("subtitle") or payload.get("platform") or ("Console Game" if kind == "console-game" else "PC Game"))[:320]
    art_url = str(payload.get("art_url") or payload.get("cover_url") or "")[:4096]
    platform = str(payload.get("platform") or "")[:160]
    platform_slug = str(payload.get("platform_slug") or "")[:160]
    stream_id = str(payload.get("stream_id") or "")[:240]
    with GAME_ACTIVITY_LOCK:
        state = game_activity_state()
        previous = state["items"].get(key, {}) if isinstance(state["items"].get(key), dict) else {}
        row = {
            "key": key,
            "kind": kind,
            "id": game_id,
            "title": title,
            "subtitle": subtitle,
            "art_url": art_url or None,
            "platform": platform or None,
            "platform_slug": platform_slug or None,
            "stream_id": stream_id or None,
            "launched_at": now,
            "launch_count": max(0, int(previous.get("launch_count") or 0)) + 1,
            "first_launched_at": float(previous.get("first_launched_at") or now),
        }
        state["items"][key] = row
        # Keep bounded history. The newest 300 unique games is more than enough
        # for the home shelves while preventing an unbounded operational file.
        ordered = sorted(
            (x for x in state["items"].values() if isinstance(x, dict)),
            key=lambda x: float(x.get("launched_at") or 0), reverse=True,
        )[:300]
        state["items"] = {str(x.get("key") or _game_activity_key(x.get("kind"), x.get("id"))): x for x in ordered}
        state["version"] = VERSION
        atomic_json(GAME_ACTIVITY_PATH, state)
        return {"ok": True, "activity": row}


