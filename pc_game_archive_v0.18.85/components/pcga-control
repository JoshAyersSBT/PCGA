    if name == "pc-game-disc-assign":
        return assign_pc_game_disc(payload)
    if name == "pc-game-title-create":
        return create_pc_game_title(payload)
    if name == "pc-game-stream-reconcile":
        return reconcile_pc_game_stream(payload)
    allowed_restart = {
        "romm": ["docker", "restart", "romm"],
        "jellyfin": ["docker", "restart", "jellyfin"],
        "immich": ["docker", "restart", "immich_server"],
        "public-media": ["systemctl", "restart", "pcga-public-media.service"],
        "optical-watch": ["systemctl", "restart", "pcga-optical-watch.service"],
    }
    if name.startswith("restart:"):
        target = name.split(":", 1)[1]
        if target not in allowed_restart:
            raise ValueError("unsupported restart target")
        if target in {"romm", "jellyfin", "immich"}:
            with game_stack_lock():
                p = run(allowed_restart[target], timeout=90)
        else:
            p = run(allowed_restart[target], timeout=90)
        return {"ok": p.returncode == 0, "action": name, "detail": (p.stderr or p.stdout)[-1200:]}
    commands = {
        "ingest-reconcile": ["/usr/local/sbin/pcga-ingest-reconcile", "reconcile"],
        "classify": ["/usr/local/sbin/pcga-classify"],
        "dedupe-audit": ["/usr/local/sbin/pcga-dedupe", "audit"],
        "dedupe-run": ["/usr/local/sbin/pcga-dedupe", "run"],
        "jellyfin-configure": ["/usr/local/sbin/pcga-jellyfin-configure", "--non-interactive", "--no-restart"],
        "optical-health": ["/usr/local/sbin/pcga-optical-health", "--all"],
        "moonlight-reconcile": ["/usr/local/sbin/pcga-moonlight-web-bootstrap"],
    }
    if name not in commands:
        raise ValueError("unsupported action")
    p = run(commands[name], timeout=600)
    return {"ok": p.returncode == 0, "action": name, "stdout": p.stdout[-6000:], "stderr": p.stderr[-3000:]}


class Handler(BaseHTTPRequestHandler):
    server_version = f"PCGAControl/{VERSION}"

    def log_message(self, fmt, *args):
        if urlparse(self.path).path != "/health":
            super().log_message(fmt, *args)

    def send_json(self, status: int, value: dict):
        body = (json.dumps(value, separators=(",", ":"), default=str) + "\n").encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.end_headers()
        self.wfile.write(body)

    def authorized(self) -> bool:
        try:
            token = TOKEN_PATH.read_text(encoding="utf-8").strip()
        except OSError:
            return False
        supplied = self.headers.get("Authorization", "")
        return bool(token) and supplied == f"Bearer {token}"

    def json_body(self, limit=65536):
        try:
            length = int(self.headers.get("Content-Length", "0"))
        except ValueError:
            raise ValueError("invalid content length")
        if length < 0 or length > limit:
            raise ValueError("invalid request size")
        if not length:
            return {}
        data = json.loads(self.rfile.read(length).decode("utf-8", "replace"))
        if not isinstance(data, dict):
            raise ValueError("JSON object required")
        return data

    def do_GET(self):
        path = urlparse(self.path).path
        if path == "/health":
            self.send_json(HTTPStatus.OK, {"ok": True, "version": VERSION})
            return
        if not self.authorized():
            self.send_json(HTTPStatus.UNAUTHORIZED, {"ok": False, "error": "unauthorized"})
            return
        if path == "/game-activity":
            try:
                q = parse_qs(urlparse(self.path).query)
                limit = int((q.get("limit") or ["48"])[0])
                self.send_json(HTTPStatus.OK, game_activity_recent(limit))
            except ValueError as exc:
                self.send_json(HTTPStatus.BAD_REQUEST, {"ok": False, "error": str(exc)[:300]})
            except Exception as exc:
                self.send_json(HTTPStatus.INTERNAL_SERVER_ERROR, {"ok": False, "error": type(exc).__name__, "detail": str(exc)[:400]})
            return
        if path.startswith("/audio/"):
            try:
                self.send_json(HTTPStatus.OK, audio_get(path, parse_qs(urlparse(self.path).query)))
            except ValueError as exc:
                self.send_json(HTTPStatus.BAD_REQUEST, {"ok": False, "error": str(exc)[:300]})
            except FileNotFoundError as exc:
                self.send_json(HTTPStatus.NOT_FOUND, {"ok": False, "error": str(exc)[:300]})
            except urllib.error.HTTPError as exc:
                self.send_json(HTTPStatus.BAD_GATEWAY, {"ok": False, "error": "provider-http-error", "detail": f"HTTP {exc.code}"})
            except Exception as exc:
                self.send_json(HTTPStatus.BAD_GATEWAY, {"ok": False, "error": type(exc).__name__, "detail": str(exc)[:400]})
            return
        if path == "/patch/status":
            try:
                q=parse_qs(urlparse(self.path).query); job=str((q.get("id") or [""])[0])
                self.send_json(HTTPStatus.OK, patch_status(job))
            except ValueError as exc:
                self.send_json(HTTPStatus.BAD_REQUEST,{"ok":False,"error":str(exc)})
            except FileNotFoundError as exc:
                self.send_json(HTTPStatus.NOT_FOUND,{"ok":False,"error":str(exc)})
            except Exception as exc:
                self.send_json(HTTPStatus.INTERNAL_SERVER_ERROR,{"ok":False,"error":type(exc).__name__,"detail":str(exc)[:400]})
            return
        if path in {"/state", "/config"}:
            try:
                value = state_payload() if path == "/state" else {"ok": True, "version": VERSION, "config": load_config()}
                self.send_json(HTTPStatus.OK, value)
            except Exception as exc:
                self.send_json(HTTPStatus.INTERNAL_SERVER_ERROR, {"ok": False, "error": type(exc).__name__, "detail": str(exc)[:400]})
            return
        if path == "/logs/catalog":
            try:
                self.send_json(HTTPStatus.OK, log_catalog())
            except Exception as exc:
                self.send_json(HTTPStatus.INTERNAL_SERVER_ERROR, {"ok": False, "error": type(exc).__name__, "detail": str(exc)[:400]})
            return
        if path == "/logs":
            try:
                q = parse_qs(urlparse(self.path).query)
                service_id = str((q.get("service") or [""])[0])[:200]
                lines = int((q.get("lines") or ["160"])[0])
                seconds = int((q.get("seconds") or ["900"])[0])
                self.send_json(HTTPStatus.OK, service_log(service_id, lines, seconds))
            except ValueError as exc:
                self.send_json(HTTPStatus.BAD_REQUEST, {"ok": False, "error": str(exc)[:200]})
            except Exception as exc:
                self.send_json(HTTPStatus.INTERNAL_SERVER_ERROR, {"ok": False, "error": type(exc).__name__, "detail": str(exc)[:400]})
            return
        self.send_json(HTTPStatus.NOT_FOUND, {"ok": False, "error": "not-found"})

    def do_DELETE(self):
        path = urlparse(self.path).path
        if not self.authorized():
            self.send_json(HTTPStatus.UNAUTHORIZED, {"ok": False, "error": "unauthorized"})
            return
        if path.startswith("/audio/open-podcast/v1/subscriptions/"):
            try:
                self.send_json(HTTPStatus.ACCEPTED, open_podcast_delete(path.rsplit("/", 1)[-1]))
            except ValueError as exc:
                self.send_json(HTTPStatus.BAD_REQUEST, {"code": 405, "message": str(exc)[:300]})
            except FileNotFoundError:
                self.send_json(HTTPStatus.NOT_FOUND, {"code": 404, "message": "Resource not found"})
            return
        self.send_json(HTTPStatus.NOT_FOUND, {"ok": False, "error": "not-found"})


    def do_PATCH(self):
        path = urlparse(self.path).path
        if not self.authorized():
            self.send_json(HTTPStatus.UNAUTHORIZED, {"ok": False, "error": "unauthorized"})
            return
        if path != "/config":
            self.send_json(HTTPStatus.NOT_FOUND, {"ok": False, "error": "not-found"})
            return
        try:
            result = update_config(self.json_body())
            self.send_json(HTTPStatus.OK if result.get("ok") else HTTPStatus.MULTI_STATUS, result)
        except ValueError as exc:
            self.send_json(HTTPStatus.BAD_REQUEST, {"ok": False, "error": str(exc)})
        except Exception as exc:
            self.send_json(HTTPStatus.INTERNAL_SERVER_ERROR, {"ok": False, "error": type(exc).__name__, "detail": str(exc)[:400]})

    def do_POST(self):
        path = urlparse(self.path).path
        if not self.authorized():
            self.send_json(HTTPStatus.UNAUTHORIZED, {"ok": False, "error": "unauthorized"})
            return
        if path == "/game-activity":
            try:
                self.send_json(HTTPStatus.OK, game_activity_record(self.json_body()))
            except ValueError as exc:
                self.send_json(HTTPStatus.BAD_REQUEST, {"ok": False, "error": str(exc)[:300]})
            except Exception as exc:
                self.send_json(HTTPStatus.INTERNAL_SERVER_ERROR, {"ok": False, "error": type(exc).__name__, "detail": str(exc)[:400]})
            return
        if path.startswith("/audio/"):
            try:
                result = audio_post(path, self.json_body())
                code = HTTPStatus.ACCEPTED if path == "/audio/librivox/collect" else HTTPStatus.OK
                self.send_json(code, result)
            except ValueError as exc:
                self.send_json(HTTPStatus.BAD_REQUEST, {"ok": False, "error": str(exc)[:300]})
            except FileNotFoundError as exc:
                self.send_json(HTTPStatus.NOT_FOUND, {"ok": False, "error": str(exc)[:300]})
            except Exception as exc:
                self.send_json(HTTPStatus.BAD_GATEWAY, {"ok": False, "error": type(exc).__name__, "detail": str(exc)[:400]})
            return
        if path == "/patch":
            try:
                length=int(self.headers.get("Content-Length","0")); filename=self.headers.get("X-PCGA-Filename", "pcga-patch.zip")
                result=install_patch_from_stream(self,length,filename)
                self.send_json(HTTPStatus.ACCEPTED,result)
            except ValueError as exc:
                self.send_json(HTTPStatus.BAD_REQUEST,{"ok":False,"error":str(exc)})
            except Exception as exc:
                self.send_json(HTTPStatus.INTERNAL_SERVER_ERROR,{"ok":False,"error":type(exc).__name__,"detail":str(exc)[:400]})
            return
        if path != "/action":
            self.send_json(HTTPStatus.NOT_FOUND, {"ok": False, "error": "not-found"})
            return
        try:
            payload = self.json_body()
            name = str(payload.get("action") or "")[:80]
            result = action(name, payload)
            self.send_json(HTTPStatus.OK if result.get("ok") else HTTPStatus.INTERNAL_SERVER_ERROR, result)
        except ValueError as exc:
            self.send_json(HTTPStatus.BAD_REQUEST, {"ok": False, "error": str(exc)})
        except Exception as exc:
            self.send_json(HTTPStatus.INTERNAL_SERVER_ERROR, {"ok": False, "error": type(exc).__name__, "detail": str(exc)[:400]})


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--bind", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=8100)
    args = parser.parse_args()
    ETC.mkdir(parents=True, exist_ok=True)
    if not CONFIG_PATH.exists():
        atomic_json(CONFIG_PATH, validate_config(DEFAULTS))
    server = ThreadingHTTPServer((args.bind, args.port), Handler)
    server.daemon_threads = True
    print(f"PCGA control plane v{VERSION} listening on {args.bind}:{args.port}", flush=True)
    try:
        server.serve_forever(poll_interval=.5)
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()

if __name__ == "__main__":
    main()
