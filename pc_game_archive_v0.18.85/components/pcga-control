def _log_display_name(source: str, kind: str) -> str:
    if kind == "systemd" and source in LOG_STATIC_SYSTEMD:
        return LOG_STATIC_SYSTEMD[source]
    if kind == "docker" and source in LOG_STATIC_DOCKER:
        return LOG_STATIC_DOCKER[source]
    name = source.removesuffix(".service")
    name = re.sub(r"^pcga[-_]", "", name, flags=re.I)
    name = re.sub(r"[-_]", " ", name)
    return " ".join(x.capitalize() for x in name.split()) or source


def _log_tags(source: str, kind: str) -> list[str]:
    s = source.lower()
    tags = {"all"}
    if kind == "systemd" and s.startswith("pcga-"):
        tags.add("system")
    if kind == "docker" and (s.startswith("pcga-") or s.startswith("pcga_") or s in LOG_STATIC_DOCKER):
        tags.add("system")
    if any(x in s for x in ("moonlight", "wolf", "game-stack", "game-orchestrator", "service-auth", "cdemu")) or s.startswith("pcga-setup-") or s.startswith("pcga-game-") or s.startswith("pcga_") and "game" in s:
        tags.update({"streaming", "pc-games"})
    if s == "pcga-status":
        tags.add("streaming")
    if s.startswith("pcga-") and ("setup" in s or "game" in s):
        tags.update({"streaming", "pc-games"})
    if "lancommander" in s:
        tags.add("pc-games")
    if any(x in s for x in ("arm-rip", "arm-rippers", "optical", "pc-disc-rip", "media-sort", "metadata-classify", "public-media")):
        tags.add("ingest")
    if any(x in s for x in ("jellyfin", "media-sort", "metadata-classify", "public-media", "dedupe")):
        tags.add("media")
    if "romm" in s:
        tags.add("emulation")
    if "immich" in s:
        tags.add("photos")
    return sorted(tags)


def _redact_log_text(text: str) -> str:
    """Remove common credentials before any log text reaches a browser."""
    if not text:
        return ""
    # Authorization headers and shell-style bearer tokens.
    text = re.sub(r"(?i)(authorization\s*[:=]\s*bearer\s+)[^\s,;]+", r"\1[REDACTED]", text)
    text = re.sub(r"(?i)(bearer\s+)[A-Za-z0-9._~+/=-]{12,}", r"\1[REDACTED]", text)
    # JSON, env, and key/value credential fields. Keep the key so diagnostics
    # remain understandable while replacing only the value.
    secret = r"(?:password|passwd|token|secret|api[_-]?key|access[_-]?token|refresh[_-]?token|client[_-]?secret|pin)"
    text = re.sub(
        rf"(?i)((?:[\"']?{secret}[\"']?)\s*[:=]\s*)([\"'][^\"'\n]*[\"']|[^\s,;]+)",
        lambda m: m.group(1) + "[REDACTED]",
        text,
    )
    text = re.sub(r"(?i)([?&](?:token|key|password|secret|api_key)=)[^&#\s]+", r"\1[REDACTED]", text)
    # Avoid pathological single lines monopolizing the thin client.
    return "\n".join(line if len(line) <= 4096 else line[:4093] + "..." for line in text.splitlines())


def _docker_log_candidates() -> list[tuple[str, str, str, str]]:
    p = run(["docker", "ps", "-a", "--format", "{{.Names}}\\t{{.Image}}\\t{{.Status}}\\t{{.Labels}}"], timeout=8)
    if p.returncode:
        return []
    out = []
    for raw in p.stdout.splitlines():
        parts = raw.split("\t", 3)
        if len(parts) < 3:
            continue
        name, image, status = parts[:3]
        labels = parts[3] if len(parts) > 3 else ""
        managed = (
            name in LOG_STATIC_DOCKER
            or name.lower().startswith(("pcga-", "pcga_"))
            or name.startswith("PCGA-")
            or "com.docker.compose.project=pc-game-archive" in labels
        )
        if managed:
            out.append((name, image, status, labels))
    return out


def _systemd_log_candidates() -> list[str]:
    units = set(LOG_STATIC_SYSTEMD)
    p = run(["systemctl", "list-units", "--all", "--type=service", "--no-legend", "--plain", "pcga-*.service"], timeout=8)
    if p.returncode == 0:
        for line in p.stdout.splitlines():
            match = re.search(r"\b(pcga-[A-Za-z0-9_.@:-]+\.service)\b", line)
            if match:
                units.add(match.group(1))
    return sorted(units)


def _setup_session_log_candidates() -> list[dict]:
    """Expose the current PC-game log surface without historical duplicates.

    Setup and runtime logs remain on disk for recovery, but the streaming
    diagnostic profile should represent the current canonical game state.  Older
    snapshots listed both logs for every title and also listed superseded UUIDs,
    which made one logical game appear several times in the status JSON.
    """
    root = Path("/srv/pc-game-archive/games/installed")
    state_root = Path("/var/lib/pc-game-archive/game-installs")
    sets_root = Path("/var/lib/pc-game-archive/game-intake/sets")
    out = []
    if not root.exists():
        return out

    def record(sid: str) -> tuple[dict,dict,bool,str]:
        state={};game={}
        try: state=json.loads((state_root/f"{sid}.json").read_text(encoding="utf-8"))
        except Exception: pass
        try: game=json.loads((sets_root/f"{sid}.json").read_text(encoding="utf-8"))
        except Exception: pass
        hidden=bool(
            state.get("catalog_hidden") or state.get("duplicate_of") or
            game.get("catalog_hidden") or game.get("superseded_by")
        )
        title=str(game.get("title") or state.get("title") or sid)
        return state,game,hidden,title

    setup_paths={p.parent.name:p for p in root.glob("*/pcga-setup-session.log")}
    runtime_paths={p.parent.parent.name:p for p in root.glob("*/runtime-logs/session.log")}
    for sid in sorted(set(setup_paths)|set(runtime_paths)):
        if not re.fullmatch(r"[0-9A-Za-z._-]{8,80}", sid):
            continue
        state,_game,hidden,title=record(sid)
        if hidden:
            continue
        status=str(state.get("status") or "")
        # A ready game is represented by its runtime log.  A setup-required game
        # is represented by its installer log.  If only one log exists, retain
        # it so diagnostics never hide the sole useful failure history.
        prefer_runtime=status=="ready"
        path=None;kind=""
        if prefer_runtime and sid in runtime_paths:
            path=runtime_paths[sid];kind="runtime"
        elif not prefer_runtime and sid in setup_paths:
            path=setup_paths[sid];kind="setup"
        elif sid in runtime_paths:
            path=runtime_paths[sid];kind="runtime"
        elif sid in setup_paths:
            path=setup_paths[sid];kind="setup"
        if path is None:
            continue
        out.append({
            "id":f"file:pcga-{kind}:{sid}",
            "kind":"file",
            "source":str(path),
            "name":("Game runtime" if kind=="runtime" else "Setup session")+f" • {title}",
            "tags":["all","pc-games","streaming"],
            "state":"persisted",
            "active":False,
            "health":"",
        })
    return out


def log_catalog(force: bool = False) -> dict:
    now = time.monotonic()
    with _LOG_CATALOG_LOCK:
        cached = _LOG_CATALOG_CACHE.get("data")
        if not force and cached is not None and now - float(_LOG_CATALOG_CACHE.get("at") or 0) < 2.0:
            return deepcopy(cached)
        services = []
        for unit in _systemd_log_candidates():
            st = systemd_state(unit)
            services.append({
                "id": f"systemd:{unit}", "kind": "systemd", "source": unit,
                "name": _log_display_name(unit, "systemd"), "tags": _log_tags(unit, "systemd"),
                "state": st.get("state", "unknown"), "active": bool(st.get("active")), "health": "",
            })
        for name, image, status, _labels in _docker_log_candidates():
            st = docker_state(name)
            services.append({
                "id": f"docker:{name}", "kind": "docker", "source": name,
                "name": _log_display_name(name, "docker"), "tags": _log_tags(name, "docker"),
                "state": st.get("state", "unknown"), "active": bool(st.get("active")),
                "health": st.get("health", ""), "image": image, "status_text": status,
            })
        services.extend(_setup_session_log_candidates())
        # Keep stable service positions between polls so the diagnostic grid does not
        # jump while an incident is being observed.
        services.sort(key=lambda x: (0 if "streaming" in x["tags"] else 1, x["kind"], x["name"].lower(), x["source"].lower()))
        profiles = {}
        for profile, label in LOG_PROFILE_LABELS.items():
            ids = [s["id"] for s in services if profile == "all" or profile in s["tags"]]
            profiles[profile] = {"label": label, "services": ids}
        value = {"ok": True, "version": VERSION, "generated_at": time.time(), "services": services, "profiles": profiles}
        _LOG_CATALOG_CACHE["at"] = now
        _LOG_CATALOG_CACHE["data"] = value
        return deepcopy(value)


def service_log(service_id: str, lines: int = 160, seconds: int = 900) -> dict:
    lines = max(20, min(1000, int(lines)))
    seconds = max(15, min(86400, int(seconds)))
    catalog = log_catalog()
    item = next((x for x in catalog["services"] if x["id"] == service_id), None)
    if not item:
        raise ValueError("unknown log service")
    source, kind = item["source"], item["kind"]
    if kind == "docker":
        p = run(["docker", "logs", "--timestamps", "--tail", str(lines), "--since", f"{seconds}s", source], timeout=15)
        raw_text = (p.stdout or "") + (p.stderr or "")
        returncode = p.returncode
    elif kind == "file":
        path = Path(source)
        allowed_root = Path("/srv/pc-game-archive/games/installed").resolve()
        try:
            resolved = path.resolve(strict=True)
            resolved.relative_to(allowed_root)
            rows = resolved.read_text(encoding="utf-8", errors="replace").splitlines()[-lines:]
            raw_text = "\n".join(rows) + ("\n" if rows else "")
            returncode = 0
        except Exception as exc:
            raw_text = f"Unable to read persisted PC-game log: {type(exc).__name__}: {exc}\n"
            returncode = 1
    else:
        p = run(["journalctl", "--no-pager", "-o", "short-iso", "-u", source, "-n", str(lines), "--since", f"{seconds} seconds ago"], timeout=15)
        raw_text = (p.stdout or "") + (p.stderr or "")
        returncode = p.returncode
    text = _redact_log_text(raw_text)
    # Hard cap protects the portal and low-power TV clients even when a service
    # emits extremely verbose structured errors.
    if len(text) > 512_000:
        text = "[...truncated to most recent 512 KiB...]\n" + text[-512_000:]
    return {
        "ok": returncode == 0, "version": VERSION, "generated_at": time.time(),
        "service": item, "lines": lines, "seconds": seconds, "log": text,
        "returncode": returncode,
    }


@contextmanager
def game_stack_lock(timeout: float = 180.0):
    """Serialize Control Center container mutations with boot/auth/bootstrap work."""
    GAME_STACK_LOCK.parent.mkdir(parents=True, exist_ok=True)
    with GAME_STACK_LOCK.open("a+") as fh:
        deadline = time.monotonic() + timeout
        while True:
            try:
                fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise TimeoutError("timed out waiting for PCGA game-stack reconciliation lock")
                time.sleep(0.2)
        try:
            yield
        finally:
            fcntl.flock(fh.fileno(), fcntl.LOCK_UN)


def tailscale_remote(command: str = "status") -> dict:
    helper = Path("/usr/local/sbin/pcga-tailscale-remote")
    if not helper.is_file():
        return {"ok": False, "available": False, "configured": False, "state": "unavailable", "detail": "PCGA Tailscale helper is not installed."}
    p = run([str(helper), command], timeout=45)
    try:
        value = json.loads(p.stdout or "{}")
        if not isinstance(value, dict):
            value = {}
    except Exception:
        value = {}
    value.setdefault("ok", p.returncode == 0)
    if p.returncode != 0:
        value.setdefault("error", "tailscale-action-failed")
        value.setdefault("detail", (p.stderr or p.stdout or f"pcga-tailscale-remote {command} failed")[-1200:])
    return value


def set_tailscale_remote(enabled: bool) -> dict:
    result = tailscale_remote("enable" if enabled else "disable")
    if result.get("ok") and (result.get("configured") == enabled or not enabled):
        cfg = load_config()
        cfg["remote_access"]["tailscale_enabled"] = enabled
        atomic_json(CONFIG_PATH, validate_config(cfg))
    return result


def nas_storage(command: str = "status") -> dict:
    if not NAS_HELPER.is_file():
        return {"ok": False, "available": False, "mounted": False, "error": "nas-helper-unavailable", "detail": "PCGA NAS storage helper is not installed."}
    p = run([str(NAS_HELPER), command], timeout=7200 if command in {"sync", "offload"} else 120)
    try:
        value = json.loads(p.stdout or "{}")
        if not isinstance(value, dict): value = {}
    except Exception:
        value = {}
    value.setdefault("available", True)
    value.setdefault("ok", p.returncode == 0)
    if p.returncode != 0:
        value.setdefault("error", "nas-action-failed")
        value.setdefault("detail", (p.stderr or p.stdout or f"pcga-nas-storage {command} failed")[-1600:])
    return value


def _safe_nas_text(value, field: str, max_len: int = 255) -> str:
    text = str(value or "").strip()
    if len(text) > max_len or any(ch in text for ch in "\r\n\0"):
        raise ValueError(f"invalid NAS {field}")
    return text


def _write_nas_credentials(username: str, domain: str, password_value) -> None:
    existing = {}
    if NAS_CREDS.is_file():
        for line in NAS_CREDS.read_text(encoding="utf-8", errors="replace").splitlines():
            if "=" in line:
                key, value = line.split("=", 1); existing[key.strip()] = value
    if password_value is None or password_value == "":
        password = existing.get("password", "")
    else:
        password = str(password_value)
        if any(ch in password for ch in "\r\n\0") or len(password) > 1024:
            raise ValueError("invalid NAS password")
    if not username:
        NAS_CREDS.unlink(missing_ok=True)
        return
    NAS_CREDS.parent.mkdir(parents=True, exist_ok=True)
    lines = [f"username={username}", f"password={password}"]
    if domain: lines.append(f"domain={domain}")
    NAS_CREDS.write_text("\n".join(lines) + "\n", encoding="utf-8")
    os.chmod(NAS_CREDS, 0o600)


def start_nas_job(command: str) -> dict:
    if command not in {"sync", "offload", "archive"}: raise ValueError("invalid NAS job")
    unit = f"pcga-nas-manual-{command}"
    current = run(["systemctl", "is-active", unit], timeout=5).stdout.strip()
    if current in {"active", "activating"}:
        return {"ok": True, "action": f"nas-{command}", "state": "already-running", "detail": f"NAS {command} is already running."}
    # A prior transient unit can briefly remain in systemd's failed-unit cache.
    # Clearing that state makes repeated manual mirror/archive actions reliable.
    run(["systemctl", "reset-failed", unit], timeout=5)
    p = run(["systemd-run", "--unit", unit, "--collect", "--property=Type=exec", "--property=TimeoutStartSec=0", str(NAS_HELPER), command], timeout=20)
    return {"ok": p.returncode == 0, "action": f"nas-{command}", "state": "started" if p.returncode == 0 else "failed", "detail": (p.stderr or p.stdout or f"NAS {command} started.")[-1200:]}


def configure_nas(payload: dict) -> dict:
    settings = payload.get("nas")
    if not isinstance(settings, dict):
        raise ValueError("nas settings object required")
    cfg = load_config()
    old_nas = deepcopy(cfg.get("nas") or {})
    patch = {}
    for key in ("enabled", "schedule_enabled"):
        if key in settings: patch[key] = bool(settings[key])
    for key in ("protocol", "host", "share", "username", "domain", "base_dir", "mode"):
        if key in settings: patch[key] = _safe_nas_text(settings[key], key, 512 if key == "share" else 255)
    if "libraries" in settings:
        if not isinstance(settings["libraries"], list): raise ValueError("NAS libraries must be a list")
        patch["libraries"] = [str(x) for x in settings["libraries"]]
    for key in ("local_reserve_gib", "min_age_days"):
        if key in settings: patch[key] = settings[key]
    cfg["nas"] = merge(cfg["nas"], patch)
    cfg = validate_config(cfg)
    nas = cfg["nas"]
    if nas["enabled"]:
        if not nas["host"] or not nas["share"]: raise ValueError("NAS host and share/export are required")
        if not re.fullmatch(r"[A-Za-z0-9_.:\-\[\]]+", nas["host"]): raise ValueError("NAS host contains unsupported characters")
        if nas["protocol"] == "smb" and "/" in nas["share"].strip("/"): raise ValueError("SMB share must be a share name, not a nested path; use the PCGA base folder for subdirectories")
    endpoint_keys = {"protocol", "host", "share", "username", "domain"}
    endpoint_changed = any(old_nas.get(k) != nas.get(k) for k in endpoint_keys)
    password_changed = nas["protocol"] == "smb" and bool(settings.get("password"))
    if old_nas.get("enabled") and (endpoint_changed or password_changed):
        detached = nas_storage("unmount")
        if not detached.get("ok"):
            detached["detail"] = "PCGA could not detach the existing NAS mount, so the new endpoint was not applied. " + str(detached.get("detail") or "")
            return detached
    if nas["protocol"] == "smb":
        _write_nas_credentials(nas["username"], nas["domain"], settings.get("password") if "password" in settings else None)
    atomic_json(CONFIG_PATH, cfg)
    result = nas_storage("reconcile")
    result["config"] = cfg
    return result


def state_payload() -> dict:
    cfg = load_config()
