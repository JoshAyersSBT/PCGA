def audio_set_progress(payload: dict) -> dict:
    key = str(payload.get("key") or "")[:240]
    if not key or not re.fullmatch(r"[A-Za-z0-9:_\-.]{1,240}", key):
        raise ValueError("invalid audio progress key")
    try:
        seconds = max(0.0, float(payload.get("seconds") or 0))
        duration = max(0.0, float(payload.get("duration") or 0))
    except (TypeError, ValueError):
        raise ValueError("invalid playback progress")
    feed_url = str(payload.get("feed_url") or "").strip()
    episode_url = str(payload.get("episode_url") or "").strip()
    def mutate(state):
        state["progress"][key] = {"seconds": round(seconds, 2), "duration": round(duration, 2), "updated": int(time.time())}
        if feed_url and episode_url:
            try:
                purl=_public_remote_url(feed_url); eurl=_public_remote_url(episode_url)
                _gpodder_record_episode(state,{"podcast":purl,"episode":eurl,"device":"pcga-portal","action":"play","timestamp":_iso_now(),"started":0,"position":int(seconds),"total":int(duration)})
            except ValueError:
                pass
        return state["progress"][key]
    return {"ok": True, "progress": _audio_update(mutate)}


def _cached_json(key: str, ttl: int, loader):
    now = time.time()
    with AUDIO_API_LOCK:
        cached = AUDIO_SEARCH_CACHE.get(key)
        if cached and now - cached[0] < ttl:
            return cached[1]
    value = loader()
    with AUDIO_API_LOCK:
        AUDIO_SEARCH_CACHE[key] = (time.time(), value)
    return value


def _iso_now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


def _open_podcast_guid(feed_url: str, feed_guid: str = "") -> str:
    feed_guid = str(feed_guid or "").strip()
    try:
        return str(uuid.UUID(feed_guid)) if feed_guid else str(uuid.uuid5(uuid.NAMESPACE_URL, feed_url))
    except ValueError:
        return str(uuid.uuid5(uuid.NAMESPACE_URL, feed_url + "#" + feed_guid))


def _gpodder_state(state: dict) -> dict:
    gp = state.setdefault("gpodder", {})
    if not isinstance(gp, dict):
        gp = {}; state["gpodder"] = gp
    gp.setdefault("counter", 0)
    gp.setdefault("devices", {})
    gp.setdefault("subscription_events", [])
    gp.setdefault("episode_actions", [])
    if not isinstance(gp["devices"], dict): gp["devices"] = {}
    if not isinstance(gp["subscription_events"], list): gp["subscription_events"] = []
    if not isinstance(gp["episode_actions"], list): gp["episode_actions"] = []
    return gp


def _gpodder_next(gp: dict) -> int:
    now = int(time.time() * 1000)
    gp["counter"] = max(int(gp.get("counter") or 0) + 1, now)
    return int(gp["counter"])


def _gpodder_record_subscription(state: dict, feed_url: str, added: bool, device: str = "pcga-portal") -> int:
    gp = _gpodder_state(state); stamp = _gpodder_next(gp)
    gp["subscription_events"].append({"id": stamp, "url": feed_url, "added": bool(added), "device": device})
    if len(gp["subscription_events"]) > 5000:
        gp["subscription_events"] = gp["subscription_events"][-5000:]
    return stamp


def _gpodder_record_episode(state: dict, action: dict) -> int:
    gp = _gpodder_state(state); stamp = _gpodder_next(gp)
    row = dict(action); row["_id"] = stamp
    gp["episode_actions"].append(row)
    if len(gp["episode_actions"]) > 10000:
        gp["episode_actions"] = gp["episode_actions"][-10000:]
    return stamp


def gpodder_devices() -> list:
    def mutate(state):
        gp = _gpodder_state(state)
        gp["devices"].setdefault("pcga-portal", {"caption": "PCGA Portal", "type": "server"})
        count = sum(1 for x in state.get("podcast_subscriptions", {}).values() if isinstance(x, dict) and x.get("is_subscribed", True) and not x.get("deleted"))
        return [{"id": did, "caption": str(v.get("caption") or ""), "type": str(v.get("type") or "other"), "subscriptions": count} for did, v in sorted(gp["devices"].items())]
    return _audio_update(mutate)


def gpodder_update_device(device: str, payload: dict) -> dict:
    if not re.fullmatch(r"[\w.-]{1,120}", device or ""):
        raise ValueError("invalid gPodder device id")
    def mutate(state):
        gp = _gpodder_state(state); cur = gp["devices"].setdefault(device, {})
        if "caption" in payload: cur["caption"] = str(payload.get("caption") or "")[:160]
        if "type" in payload:
            typ = str(payload.get("type") or "other")
            cur["type"] = typ if typ in {"desktop","laptop","mobile","server","other"} else "other"
        cur.setdefault("caption", device); cur.setdefault("type", "other")
        return {}
    return _audio_update(mutate)


def gpodder_subscription_changes(device: str, since: int) -> dict:
    since = max(0, int(since or 0))
    def mutate(state):
        gp = _gpodder_state(state)
        gp["devices"].setdefault(device, {"caption": device, "type": "mobile"})
        if int(gp.get("counter") or 0) <= 0: _gpodder_next(gp)
        if since == 0:
            add = [str(x.get("feed_url")) for x in state.get("podcast_subscriptions", {}).values() if isinstance(x, dict) and x.get("feed_url") and x.get("is_subscribed", True) and not x.get("deleted")]
            return {"add": sorted(set(add)), "remove": [], "timestamp": int(gp["counter"])}
        add=[]; remove=[]
        for ev in gp.get("subscription_events", []):
            if int(ev.get("id") or 0) <= since: continue
            url=str(ev.get("url") or "")
            if not url: continue
            (add if ev.get("added") else remove).append(url)
        return {"add": list(dict.fromkeys(add)), "remove": list(dict.fromkeys(remove)), "timestamp": int(gp["counter"])}
    return _audio_update(mutate)


def gpodder_update_subscriptions(device: str, payload: dict) -> dict:
    adds = payload.get("add") or []; removes = payload.get("remove") or []
    if not isinstance(adds, list) or not isinstance(removes, list): raise ValueError("gPodder subscription payload requires add/remove arrays")
    overlap = set(map(str, adds)) & set(map(str, removes))
    if overlap: raise ValueError("the same feed cannot be added and removed")
    for feed in adds[:200]: podcast_subscribe({"feed_url": str(feed), "_gpodder_device": device})
    for feed in removes[:200]: podcast_unsubscribe({"feed_url": str(feed), "_gpodder_device": device})
    state=audio_state(); gp=_gpodder_state(state)
    return {"timestamp": int(gp.get("counter") or 0), "update_urls": []}


def gpodder_episode_actions(query: dict) -> dict:
    try: since=max(0,int((query.get("since") or ["0"])[0] or 0))
    except ValueError: since=0
    podcast=str((query.get("podcast") or [""])[0] or "")
    device=str((query.get("device") or [""])[0] or "")
    state=audio_state(); gp=_gpodder_state(state); rows=[]
    device_feeds=None
    if device:
        # The gPodder device form means actions for podcasts subscribed by that device.
        # PCGA currently has one shared subscription set, so all active feeds apply.
        device_feeds={str(x.get("feed_url")) for x in state.get("podcast_subscriptions",{}).values() if isinstance(x,dict) and x.get("feed_url") and x.get("is_subscribed",True) and not x.get("deleted")}
    for raw in gp.get("episode_actions", []):
        if int(raw.get("_id") or 0) <= since: continue
        if podcast and str(raw.get("podcast") or "") != podcast: continue
        if device_feeds is not None and str(raw.get("podcast") or "") not in device_feeds: continue
        rows.append({k:v for k,v in raw.items() if k != "_id"})
    aggregated=str((query.get("aggregated") or ["false"])[0]).lower() in {"1","true","yes"}
    if aggregated:
        latest={}
        for row in rows: latest[(str(row.get("podcast") or ""),str(row.get("episode") or ""))]=row
        rows=list(latest.values())
    return {"actions": rows[-5000:], "timestamp": int(gp.get("counter") or 0)}


def gpodder_update_episode_actions(actions) -> dict:
    if not isinstance(actions, list): raise ValueError("gPodder episode action payload must be an array")
    def mutate(state):
        last=0
        for raw in actions[:1000]:
            if not isinstance(raw, dict): continue
            podcast=str(raw.get("podcast") or "").strip(); episode=str(raw.get("episode") or "").strip(); action=str(raw.get("action") or "").strip()
            if action not in {"download","play","delete","new"} or not podcast or not episode: continue
            try: podcast=_public_remote_url(podcast); episode=_public_remote_url(episode)
            except ValueError: continue
            row={"podcast":podcast,"episode":episode,"action":action}
            for key in ("device","timestamp"):
                if raw.get(key) is not None: row[key]=str(raw.get(key))[:200]
            for key in ("started","position","total"):
                if raw.get(key) is not None:
                    try: row[key]=int(float(raw.get(key)))
                    except (TypeError,ValueError): pass
            last=_gpodder_record_episode(state,row)
            if action=="play" and "position" in row:
                key="podcast-url:"+hashlib.sha1(episode.encode()).hexdigest()
                state["progress"][key]={"seconds":float(row.get("position") or 0),"duration":float(row.get("total") or 0),"updated":int(time.time())}
        gp=_gpodder_state(state)
        return {"timestamp": int(gp.get("counter") or last or 0), "update_urls": []}
    return _audio_update(mutate)


def podcast_search(query: str, limit: int = 24) -> dict:
    """Search an open podcast directory without depending on Apple.

    PCGA uses gPodder's public directory endpoint only to discover RSS/Atom
    feed URLs. Subscription and listening state are exposed through a local
    gPodder-compatible sync API so AntennaPod can use PCGA as its sync server.
    Playback always comes from the publisher feed.
    """
    query = str(query or "").strip()[:140]
    if not query:
        return {"ok": True, "provider": "gPodder directory + AntennaPod sync + publisher RSS", "items": []}
    limit = max(1, min(40, int(limit or 24)))
    def load():
        raw, _ = _fetch_remote(PODCAST_SEARCH_URL + "?" + urlencode({"q": query, "scale_logo": "256"}), max_bytes=4 * 1024 * 1024)
        data = json.loads(raw.decode("utf-8", "replace") or "[]")
        rows = data if isinstance(data, list) else (data.get("podcasts") or data.get("results") or []) if isinstance(data, dict) else []
        items = []
        for row in rows:
            if not isinstance(row, dict):
                continue
            feed_value = row.get("url") or row.get("feed_url") or row.get("feedUrl")
            if not feed_value:
                continue
            try:
                feed = _public_remote_url(str(feed_value))
            except ValueError:
                continue
            artwork = str(row.get("scaled_logo_url") or row.get("logo_url") or row.get("image") or row.get("artwork") or "")
            try: artwork_proxy = _media_proxy_url(artwork) if artwork else None
            except Exception: artwork_proxy = None
            items.append({
                "id": hashlib.sha1(feed.encode()).hexdigest()[:20],
                "title": str(row.get("title") or "Untitled podcast"),
                "author": str(row.get("author") or row.get("publisher") or row.get("owner") or ""),
                "description": _strip_markup(row.get("description"), 1200),
                "feed_url": feed,
                "art_url": artwork_proxy,
                "website": str(row.get("website") or row.get("link") or ""),
                "subscribers": int(row.get("subscribers") or 0) if str(row.get("subscribers") or "0").isdigit() else 0,
            })
            if len(items) >= limit:
                break
        return items
    items = _cached_json("podcast-search:gpodder:" + query.lower(), 15 * 60, load)
    return {"ok": True, "provider": "gPodder directory + AntennaPod sync + publisher RSS", "query": query, "items": items}

def _xml_local(tag: str) -> str:
    return str(tag).rsplit("}", 1)[-1].split(":")[-1].lower()


def _xml_child_text(node, names: set[str]) -> str:
    for child in list(node):
        if _xml_local(child.tag) in names and (child.text or "").strip():
            return (child.text or "").strip()
    return ""


def _podcast_duration(value: str) -> float:
    value = str(value or "").strip()
    if not value: return 0.0
    try:
        if ":" not in value: return float(value)
        parts = [float(x) for x in value.split(":")]
        if len(parts) == 2: return parts[0] * 60 + parts[1]
        if len(parts) == 3: return parts[0] * 3600 + parts[1] * 60 + parts[2]
    except ValueError:
        return 0.0
    return 0.0


def podcast_feed(feed_url: str, limit: int = 100) -> dict:
    feed_url = _public_remote_url(feed_url)
    limit = max(1, min(200, int(limit or 100)))
    def load():
        raw, final_url = _fetch_remote(feed_url, max_bytes=6 * 1024 * 1024)
        try: root = ET.fromstring(raw)
        except ET.ParseError as exc: raise ValueError("podcast feed is not valid RSS/Atom XML") from exc
        is_atom = _xml_local(root.tag) == "feed"
        channel = root if is_atom else next((x for x in list(root) if _xml_local(x.tag) == "channel"), root)
        title = _xml_child_text(channel, {"title"}) or "Podcast"
        description = _strip_markup(_xml_child_text(channel, {"description", "subtitle", "summary"}), 2500)
        author = _xml_child_text(channel, {"author", "managingeditor", "owner"})
        art = ""
        for node in channel.iter():
            lname = _xml_local(node.tag)
            if lname == "image":
                href = node.attrib.get("href") or _xml_child_text(node, {"url"})
                if href: art = href; break
        entries = [x for x in list(channel) if _xml_local(x.tag) in ({"entry"} if is_atom else {"item"})]
        episodes = []
        for entry in entries[:limit]:
            enclosure = ""; mime = ""
            for child in list(entry):
                lname = _xml_local(child.tag)
                if lname == "enclosure":
                    enclosure = child.attrib.get("url") or ""; mime = child.attrib.get("type") or ""; break
                if is_atom and lname == "link" and child.attrib.get("rel") == "enclosure":
                    enclosure = child.attrib.get("href") or ""; mime = child.attrib.get("type") or ""; break
            if not enclosure:
                continue
            try:
                stream = _media_proxy_url(enclosure)
            except Exception:
                continue
            guid = _xml_child_text(entry, {"guid", "id"}) or enclosure
            legacy_key = "podcast:" + hashlib.sha1(guid.encode("utf-8", "replace")).hexdigest()
            key = "podcast-url:" + hashlib.sha1(enclosure.encode("utf-8", "replace")).hexdigest()
            ep_art = ""
            for node in entry.iter():
                if _xml_local(node.tag) == "image" and node.attrib.get("href"):
                    ep_art = node.attrib.get("href") or ""; break
            try: ep_art_proxy = _media_proxy_url(ep_art) if ep_art else None
            except Exception: ep_art_proxy = None
            episodes.append({
                "id": hashlib.sha1(guid.encode("utf-8", "replace")).hexdigest()[:20],
                "key": key,
                "title": _xml_child_text(entry, {"title"}) or "Untitled episode",
                "description": _strip_markup(_xml_child_text(entry, {"description", "summary", "content"}), 3000),
                "published": _xml_child_text(entry, {"pubdate", "published", "updated"}),
                "duration_seconds": _podcast_duration(_xml_child_text(entry, {"duration"})),
                "stream_url": stream,
                "source_url": enclosure,
                "feed_url": final_url,
                "mime_type": mime,
                "art_url": ep_art_proxy,
                "resume_seconds": float((_audio_progress(key) or _audio_progress(legacy_key)).get("seconds") or 0),
            })
        try: art_proxy = _media_proxy_url(art) if art else None
        except Exception: art_proxy = None
        feed_guid = _xml_child_text(channel, {"guid"})
        return {"feed_url": final_url, "feed_guid": feed_guid, "title": title, "description": description, "author": author, "art_url": art_proxy, "episodes": episodes}
    data = _cached_json("podcast-feed:" + hashlib.sha1(feed_url.encode()).hexdigest(), 10 * 60, load)
    # Resume positions change much more frequently than feed metadata. Refresh
    # them after cache lookup instead of making RSS caching stale the player UI.
    data = dict(data)
    data["episodes"] = [dict(x) for x in (data.get("episodes") or [])]
    for episode in data["episodes"]:
        if episode.get("key"):
            episode["resume_seconds"] = float(_audio_progress(str(episode["key"])).get("seconds") or 0)
    state = audio_state(); canonical = str(data.get("feed_url") or feed_url); sid = hashlib.sha1(canonical.encode()).hexdigest()
    return {"ok": True, **data, "subscribed": sid in state.get("podcast_subscriptions", {})}


def _podcast_entry_by_guid(state: dict, guid: str):
    for key, value in state.get("podcast_subscriptions", {}).items():
        if isinstance(value, dict) and str(value.get("guid") or "") == str(guid):
            return key, value
    return None, None


def _podcast_entry_by_feed(state: dict, feed_url: str):
    for key, value in state.get("podcast_subscriptions", {}).items():
        if isinstance(value, dict) and str(value.get("feed_url") or "") == str(feed_url):
            return key, value
    return None, None


def podcast_subscribe(payload: dict) -> dict:
    feed_url = _public_remote_url(str(payload.get("feed_url") or ""))
    detail = podcast_feed(feed_url, 12)
    canonical = _public_remote_url(str(detail.get("feed_url") or feed_url))
    requested_guid = str(payload.get("guid") or "").strip()
    guid = _open_podcast_guid(canonical, requested_guid or str(detail.get("feed_guid") or ""))
    sid = hashlib.sha1(canonical.encode()).hexdigest()
    now = _iso_now()
    entry = {
        "id": sid,
        "feed_url": canonical,
        "guid": guid,
        "is_subscribed": True,
        "subscription_changed": now,
        "guid_changed": now,
        "new_guid": None,
        "deleted": None,
        "title": detail.get("title") or "Podcast",
        "author": detail.get("author") or "",
        "description": detail.get("description") or "",
        "art_url": detail.get("art_url"),
        "subscribed": int(time.time()),
    }
    def mutate(state):
        old_key, old = _podcast_entry_by_feed(state, canonical)
        if old_key and isinstance(old, dict):
            # Preserve the established Open Podcast API GUID unless the caller
            # supplied an authoritative feed GUID.
            if not requested_guid and old.get("guid"):
                entry["guid"] = str(old["guid"])
                entry["guid_changed"] = old.get("guid_changed") or now
            state["podcast_subscriptions"].pop(old_key, None)
        state["podcast_subscriptions"][sid] = entry
        _gpodder_record_subscription(state, canonical, True, str(payload.get("_gpodder_device") or "pcga-portal"))
        return entry
    return {"ok": True, "subscription": _audio_update(mutate)}


def podcast_unsubscribe(payload: dict) -> dict:
    feed_url = str(payload.get("feed_url") or "").strip()
    guid = str(payload.get("guid") or "").strip()
    sid = str(payload.get("id") or (hashlib.sha1(feed_url.encode()).hexdigest() if feed_url else ""))
    now = _iso_now()
    def mutate(state):
        key = sid if sid in state["podcast_subscriptions"] else None
        entry = state["podcast_subscriptions"].get(key) if key else None
        if entry is None and guid:
            key, entry = _podcast_entry_by_guid(state, guid)
        if not isinstance(entry, dict):
            return False
        entry["is_subscribed"] = False
        entry["subscription_changed"] = now
        entry["deleted"] = now
        if entry.get("feed_url"):
            _gpodder_record_subscription(state, str(entry.get("feed_url")), False, str(payload.get("_gpodder_device") or "pcga-portal"))
        return True
    return {"ok": True, "removed": _audio_update(mutate)}


