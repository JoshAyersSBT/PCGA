def docker_state(container: str) -> dict:
    p = run(["docker", "inspect", "-f", "{{.State.Status}}|{{if .State.Health}}{{.State.Health.Status}}{{end}}", container], timeout=5)
    if p.returncode:
        return {"present": False, "active": False, "state": "missing"}
    text = p.stdout.strip()
    state, _, health = text.partition("|")
    return {"present": True, "active": state == "running", "state": state, "health": health if health != "<no value>" else ""}


def systemd_state(unit: str) -> dict:
    active = run(["systemctl", "is-active", unit], timeout=5).stdout.strip()
    enabled = run(["systemctl", "is-enabled", unit], timeout=5).stdout.strip()
    return {"unit": unit, "active": active == "active", "state": active or "unknown", "enabled": enabled in {"enabled", "static", "indirect"}, "enable_state": enabled or "unknown"}


