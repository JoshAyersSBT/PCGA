def _librivox_api(params: dict, ttl: int = 1800):
    global LIBRIVOX_API_LAST
    clean = {str(k): str(v) for k, v in params.items() if v is not None and str(v) != ""}
    clean.setdefault("format", "json")
    key = "librivox:" + urlencode(sorted(clean.items()))
    def load():
        global LIBRIVOX_API_LAST
        with AUDIO_API_LOCK:
            delay = 3.0 - (time.monotonic() - LIBRIVOX_API_LAST)
            if delay > 0: time.sleep(delay)
            raw, _ = _fetch_remote(LIBRIVOX_API_URL + "?" + urlencode(clean), max_bytes=12 * 1024 * 1024, timeout=30)
            LIBRIVOX_API_LAST = time.monotonic()
        return json.loads(raw.decode("utf-8", "replace") or "{}")
    return _cached_json(key, ttl, load)


