def _strip_markup(value, limit=6000) -> str:
    text = str(value or "")
    text = re.sub(r"<script\b[^>]*>.*?</script>", " ", text, flags=re.I | re.S)
    text = re.sub(r"<style\b[^>]*>.*?</style>", " ", text, flags=re.I | re.S)
    text = re.sub(r"<[^>]+>", " ", text)
    text = html_lib.unescape(text)
    text = re.sub(r"\s+", " ", text).strip()
    return text[:limit]


def _safe_slug(value: str, fallback="item") -> str:
    value = re.sub(r"[^A-Za-z0-9._ -]+", "", str(value or "")).strip().replace(" ", "-")
    value = re.sub(r"-+", "-", value).strip("-._")
    return (value[:100] or fallback)


def _public_remote_url(url: str) -> str:
    url = str(url or "").strip()
    if len(url) > 4096:
        raise ValueError("remote URL is too long")
    parsed = urlparse(url)
    if parsed.scheme not in {"http", "https"} or not parsed.hostname:
        raise ValueError("remote URL must use http or https")
    if parsed.username or parsed.password:
        raise ValueError("remote URL credentials are not permitted")
    if parsed.port not in {None, 80, 443}:
        raise ValueError("remote media must use port 80 or 443")
    host = parsed.hostname.rstrip(".").lower()
    if host in {"localhost", "localhost.localdomain"} or host.endswith(".local"):
        raise ValueError("local-network URLs are not permitted for public audio providers")
    try:
        infos = socket.getaddrinfo(host, parsed.port or (443 if parsed.scheme == "https" else 80), type=socket.SOCK_STREAM)
    except socket.gaierror as exc:
        raise ValueError(f"remote host could not be resolved: {host}") from exc
    for info in infos:
        addr = ipaddress.ip_address(info[4][0].split("%", 1)[0])
        if not addr.is_global:
            raise ValueError("private, loopback, link-local, or reserved remote addresses are not permitted")
    return url


def _fetch_remote(url: str, *, max_bytes: int = 8 * 1024 * 1024, timeout: int = 20) -> tuple[bytes, str]:
    url = _public_remote_url(url)
    req = urllib.request.Request(url, headers={"User-Agent": AUDIO_USER_AGENT, "Accept": "application/json, application/rss+xml, application/atom+xml, application/xml, text/xml, */*"})
    class SafeRedirect(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, req, fp, code, msg, headers, newurl):
            _public_remote_url(newurl)
            return super().redirect_request(req, fp, code, msg, headers, newurl)
    with urllib.request.build_opener(SafeRedirect()).open(req, timeout=timeout) as response:
        final = _public_remote_url(response.geturl())
        length = response.headers.get("Content-Length")
        if length and int(length) > max_bytes:
            raise ValueError("remote response is too large")
        data = response.read(max_bytes + 1)
        if len(data) > max_bytes:
            raise ValueError("remote response is too large")
        return data, final


def _media_proxy_url(url: str) -> str:
    url = _public_remote_url(url)
    token = TOKEN_PATH.read_text(encoding="utf-8").strip().encode()
    encoded = base64.urlsafe_b64encode(url.encode()).decode().rstrip("=")
    sig = hmac.new(token, encoded.encode(), hashlib.sha256).hexdigest()
    return f"/api/audio/remote?u={quote(encoded, safe='')}&sig={sig}"


def _audio_progress(key: str) -> dict:
    value = audio_state().get("progress", {}).get(str(key), {})
