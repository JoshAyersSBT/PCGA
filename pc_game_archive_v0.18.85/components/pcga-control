def open_podcast_subscriptions(query: dict) -> dict:
    """Open Podcast API v1-compatible subscription collection view.

    PCGA is currently a single-user appliance, so the authenticated-user
    concept maps to the PCGA portal/control-plane identity.
    """
    page = max(1, int((query.get("page") or ["1"])[0] or 1))
    per_page = max(1, min(100, int((query.get("per_page") or ["50"])[0] or 50)))
    since = str((query.get("since") or [""])[0] or "").strip()
    rows = []
    for entry in audio_state().get("podcast_subscriptions", {}).values():
        if not isinstance(entry, dict):
            continue
        row = {k: entry.get(k) for k in ("feed_url", "guid", "is_subscribed", "subscription_changed", "guid_changed", "new_guid", "deleted")}
        if not row.get("guid"):
            row["guid"] = _open_podcast_guid(str(row.get("feed_url") or ""))
        row["is_subscribed"] = bool(row.get("is_subscribed", True))
        if since:
            stamps = [str(row.get(k) or "") for k in ("subscription_changed", "guid_changed", "deleted")]
            if not any(x and x > since for x in stamps):
                continue
        rows.append(row)
    rows.sort(key=lambda x: str(x.get("subscription_changed") or ""), reverse=True)
    total = len(rows); start = (page - 1) * per_page; items = rows[start:start + per_page]
    result = {"total": total, "page": page, "per_page": per_page, "subscriptions": items}
    if start + per_page < total: result["next"] = f"/api/open-podcast/v1/subscriptions?page={page+1}&per_page={per_page}"
    if page > 1: result["previous"] = f"/api/open-podcast/v1/subscriptions?page={page-1}&per_page={per_page}"
    return result


def open_podcast_add(payload: dict) -> dict:
    rows = payload.get("subscriptions")
    if not isinstance(rows, list):
        raise ValueError("subscriptions array required")
    success=[]; failure=[]
    for row in rows[:100]:
        if not isinstance(row, dict):
            continue
        feed = str(row.get("feed_url") or "")
        try:
            result = podcast_subscribe({"feed_url": feed, "guid": row.get("guid")})["subscription"]
            success.append({k: result.get(k) for k in ("feed_url", "guid", "is_subscribed", "subscription_changed")})
        except Exception as exc:
            failure.append({"feed_url": feed, "message": str(exc)[:240]})
    return {"success": success, "failure": failure}


