def _download_file(url: str, dest: Path, job_id: str, section_index: int, section_total: int) -> None:
    url=_public_remote_url(url); dest.parent.mkdir(parents=True,exist_ok=True); tmp=dest.with_name(dest.name+".part")
    class SafeRedirect(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, req, fp, code, msg, headers, newurl):
            return super().redirect_request(req, fp, code, msg, headers, _public_remote_url(newurl))
    req=urllib.request.Request(url,headers={"User-Agent":AUDIO_USER_AGENT,"Accept":"audio/*,application/octet-stream,*/*"})
    opener=urllib.request.build_opener(SafeRedirect())
    with opener.open(req,timeout=45) as response, tmp.open("wb") as out:
        total=int(response.headers.get("Content-Length") or 0); done=0
        while True:
            chunk=response.read(1024*1024)
            if not chunk: break
            out.write(chunk); done+=len(chunk)
            if total and (done==total or done%(8*1024*1024)<len(chunk)):
                def mutate(state):
                    job=state["jobs"].setdefault(job_id,{})
                    job.update({"state":"downloading","section":section_index,"sections":section_total,"bytes":done,"section_bytes":total,"updated":int(time.time())})
                _audio_update(mutate)
        out.flush(); os.fsync(out.fileno())
    os.replace(tmp,dest)


def _collect_librivox_worker(book_id: str):
    job_id=f"librivox-{book_id}"
    try:
        data=_librivox_api({"id":book_id,"extended":"1","coverart":"1"},ttl=0); books=[x for x in (data.get("books") or []) if isinstance(x,dict)]
        if not books: raise RuntimeError("LibriVox book not found")
        book=books[0]; title=str(book.get("title") or f"LibriVox {book_id}"); root=read_root()/"media/library/audio/audiobooks/librivox"/(book_id+"-"+_safe_slug(title,"book")); root.mkdir(parents=True,exist_ok=True)
        sections=[x for x in (book.get("sections") or []) if isinstance(x,dict) and x.get("listen_url")]
        files={}
        for idx,sec in enumerate(sections,1):
            sid=str(sec.get("id") or idx); src=str(sec.get("listen_url") or ""); ext=Path(urlparse(src).path).suffix.lower(); ext=ext if ext in {".mp3",".m4a",".ogg",".opus",".flac",".wav",".m4b"} else ".mp3"
            name=f"{idx:03d}-{_safe_slug(str(sec.get('title') or f'Section-{idx}'),'section')}{ext}"; dest=root/name
            if not dest.is_file() or dest.stat().st_size==0: _download_file(src,dest,job_id,idx,len(sections))
            files[sid]=str(dest.relative_to(read_root()/"media/library"))
        cover=str(book.get("coverart_jpg") or "")
        if cover:
            try:
                ext=Path(urlparse(cover).path).suffix.lower(); ext=ext if ext in {".jpg",".jpeg",".png",".webp"} else ".jpg"; c=root/("cover"+ext)
                if not c.exists(): _download_file(cover,c,job_id,len(sections),len(sections))
            except Exception: pass
        normalized=_librivox_book(book); normalized.update({"state":"complete","path":str(root.relative_to(read_root()/"media/library")),"section_files":files,"collected_at":int(time.time())})
        atomic_json(root/"metadata.json",normalized)
        def done(state): state["audiobooks"][book_id]=normalized; state["jobs"][job_id]={"state":"complete","sections":len(sections),"updated":int(time.time()),"detail":"Audiobook collected locally."}
        _audio_update(done)
    except Exception as exc:
        def failed(state): state["jobs"][job_id]={"state":"failed","updated":int(time.time()),"detail":f"{type(exc).__name__}: {str(exc)[:320]}"}
        _audio_update(failed)


def librivox_collect(payload: dict) -> dict:
    book_id=str(payload.get("id") or "")
    if not book_id.isdigit(): raise ValueError("invalid LibriVox book id")
    job_id=f"librivox-{book_id}"
    def start(state):
        existing=state["jobs"].get(job_id,{})
        if isinstance(existing,dict) and existing.get("state")=="downloading": return False
        state["jobs"][job_id]={"state":"downloading","section":0,"sections":0,"bytes":0,"updated":int(time.time()),"detail":"Preparing LibriVox collection…"}; return True
    created=_audio_update(start)
    if created: threading.Thread(target=_collect_librivox_worker,args=(book_id,),daemon=True,name=f"pcga-librivox-{book_id}").start()
    return {"ok":True,"job_id":job_id,"state":"downloading" if created else "already-running"}


def librivox_remove(payload: dict) -> dict:
    book_id=str(payload.get("id") or "")
