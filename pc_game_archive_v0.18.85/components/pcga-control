        return switch_pc_game_disc(payload)
    if name == "pc-game-metadata-configure":
        return configure_pc_game_metadata(payload)
    if name == "pc-game-metadata-search":
        return search_pc_game_metadata(payload)
    if name == "pc-game-metadata-preview":
        return preview_pc_game_metadata(payload)
    if name == "pc-game-metadata-apply":
