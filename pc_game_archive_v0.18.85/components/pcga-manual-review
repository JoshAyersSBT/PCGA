VERSION = "0.18.9"
ROOT_FILE = Path("/etc/pc-game-archive/archive-root")
TOKEN_FILE = Path("/etc/pc-game-archive/manual-review-token")
CONF_FILE = Path("/etc/pc-game-archive/manual-review.conf")
JELLYFIN_TOKEN_FILE = Path("/etc/pc-game-archive/jellyfin-api-key")
STACK_ENV = Path("/opt/pc-game-archive/.env")
MEDIA_EXTS = {
    ".mkv", ".mp4", ".m4v", ".avi", ".mov", ".webm", ".ts", ".m2ts", ".mpg", ".mpeg", ".vob",
    ".mp3", ".flac", ".wav", ".m4a", ".aac", ".ogg", ".opus", ".wma",
}
VIDEO_EXTS = {".mkv", ".mp4", ".m4v", ".avi", ".mov", ".webm", ".ts", ".m2ts", ".mpg", ".mpeg", ".vob"}
AUDIO_EXTS = MEDIA_EXTS - VIDEO_EXTS
IMAGE_EXTS = {'.jpg', '.jpeg', '.png', '.webp', '.bmp', '.gif'}
PREVIEW_CLIP_SECONDS = 20
TIMESTAMP_PREFIX = re.compile(r"^\d{8}-\d{6}-")
ARM_SUFFIX = re.compile(r"_\d{9,}$")
YEAR_RE = re.compile(r"\((19\d{2}|20\d{2})\)")
EPISODE_TOKEN_PATTERNS = [
    re.compile(r"(?i)(?:^|[ ._\-])s(?P<season>\d{1,2})e(?P<episode>\d{1,3})(?:[ ._\-]*e(?P<episode_end>\d{1,3}))?(?=$|[ ._\-])"),
    re.compile(r"(?i)(?:^|[ ._\-])(?P<season>\d{1,2})x(?P<episode>\d{1,3})(?=$|[ ._\-])"),
]


def log(message: str) -> None:
    print(f"[manual-review] {message}")
    try:
        subprocess.run(["logger", "-t", "PCGA-REVIEW", "--", message], check=False,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


def archive_root() -> Path:
    override = os.environ.get("PCGA_ROOT_OVERRIDE")
    if override:
        root = Path(override)
    elif ROOT_FILE.is_file():
        root = Path(ROOT_FILE.read_text(encoding="utf-8").strip())
    else:
        root = Path("/srv/pc-game-archive")
    if not root.is_absolute():
        raise RuntimeError(f"archive root must be absolute: {root}")
    return root.resolve()


def queue_roots(root: Path) -> list[tuple[str, Path]]:
    return [
        ("metadata-pending", root / "media/metadata-pending"),
        ("quarantine", root / "media/quarantine/unidentified"),
        ("duplicates", root / "media/quarantine/duplicates"),
    ]


def library_root(root: Path, kind: str) -> Path:
    mapping = {
        "movie": root / "media/library/movies",
        "tv": root / "media/library/tv",
        "music": root / "media/library/music",
        "home": root / "media/library/home-videos",
    }
    try:
        return mapping[kind]
    except KeyError as exc:
        raise ValueError(f"unknown media type: {kind}") from exc


def media_files(path: Path) -> list[Path]:
    if path.is_file():
        return [path] if path.suffix.lower() in MEDIA_EXTS and path.stat().st_size > 0 else []
    if not path.is_dir():
        return []
    files: list[Path] = []
    try:
        for p in path.rglob("*"):
            if p.is_file() and p.suffix.lower() in MEDIA_EXTS and p.stat().st_size > 0:
                files.append(p)
    except (OSError, PermissionError):
        return []
    return sorted(files)


def all_regular_files(path: Path) -> list[Path]:
    if path.is_file():
        if path.name.endswith(".pcga-classification.json"):
            return []
        return [path] if path.stat().st_size >= 0 else []
    if not path.is_dir():
        return []
    files: list[Path] = []
    try:
        for p in path.rglob("*"):
            if p.is_file() and p.name != ".pcga-classification.json" and not p.name.endswith(".pcga-classification.json"):
                files.append(p)
    except (OSError, PermissionError):
        return []
    return sorted(files)


def classification_manifest(path: Path) -> dict:
    manifest = path / ".pcga-classification.json" if path.is_dir() else path.with_name(path.name + ".pcga-classification.json")
    try:
        return json.loads(manifest.read_text(encoding="utf-8")) if manifest.is_file() else {}
    except Exception:
        return {}


def optical_media_manifest(path: Path) -> dict:
    if not path.is_dir():
        return {}
    manifest=path/'.pcga-media.json'
    try:
        data=json.loads(manifest.read_text(encoding='utf-8')) if manifest.is_file() else {}
        return data if isinstance(data,dict) else {}
    except Exception:
        return {}


def unwrap_single_media_dir(path: Path) -> Path:
    """Peel legacy wrapper dirs when exactly one child directory contains all media."""
    current = path
    for _ in range(4):
        if not current.is_dir():
            break
        direct_media = [p for p in current.iterdir() if p.is_file() and p.suffix.lower() in MEDIA_EXTS and p.stat().st_size > 0]
        if direct_media:
            break
        child_dirs = [p for p in current.iterdir() if p.is_dir() and media_files(p)]
        # Only unwrap an unambiguous single nested media directory.
        if len(child_dirs) != 1:
            break
        current = child_dirs[0]
    return current


def total_size(files: Iterable[Path]) -> int:
    size = 0
    for p in files:
        try:
            size += p.stat().st_size
        except OSError:
            pass
    return size


def human_size(value: int) -> str:
    size = float(value)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if size < 1024.0 or unit == "TB":
            return f"{size:.1f} {unit}" if unit != "B" else f"{int(size)} B"
        size /= 1024.0
    return f"{value} B"


def safe_component(value: str, field: str) -> str:
    value = value.strip().replace("\x00", "")
    value = re.sub(r"[\\/]", "-", value)
    value = re.sub(r"\s+", " ", value).strip(" .")
    if not value or value in {".", ".."}:
        raise ValueError(f"{field} is required")
    if len(value) > 180:
        value = value[:180].rstrip()
    return value


def normalize_year(value: str) -> str:
    value = value.strip()
    if not value:
        return ""
    if not re.fullmatch(r"(?:19|20)\d{2}", value):
        raise ValueError("year must be a four-digit year or blank")
    return value


def infer_title_year(name: str) -> tuple[str, str]:
    n = TIMESTAMP_PREFIX.sub("", name)
    n = ARM_SUFFIX.sub("", n)
    if n.lower().endswith(tuple(MEDIA_EXTS)):
        n = Path(n).stem
    year = ""
    m = YEAR_RE.search(n)
    if m:
        year = m.group(1)
        n = (n[:m.start()] + n[m.end():]).strip()
    n = n.rstrip("-_ ")
    n = n.replace("_", " ")
    n = re.sub(r"\s+", " ", n).strip()
    return n or "Untitled", year


def parse_episode_identity(name: str) -> dict | None:
    raw = TIMESTAMP_PREFIX.sub('', Path(name).stem)
    match = next((rx.search(raw) for rx in EPISODE_TOKEN_PATTERNS if rx.search(raw)), None)
    if not match:
        return None
    prefix = raw[:match.start()].strip(' ._-')
    suffix = raw[match.end():].strip(' ._-')
    series, year = infer_title_year(prefix)
    if not series or series == 'Untitled':
        return None
    try:
        season = int(match.group('season')); episode = int(match.group('episode'))
        end_raw = match.groupdict().get('episode_end')
        episode_end = int(end_raw) if end_raw else None
    except (TypeError, ValueError):
        return None
    episode_title, _ = infer_title_year(suffix) if suffix else ('', '')
    return {'series':series,'year':year,'season':season,'episode':episode,
            'episode_end':episode_end,'episode_title':episode_title if episode_title != 'Untitled' else ''}


def video_sequence_key(path: Path) -> tuple:
    """Sort MakeMKV/ARM tracks by numeric title/track number when present."""
    stem = TIMESTAMP_PREFIX.sub('', path.stem)
    match = re.search(r'(?i)(?:^|[._ -])(?:title|track)?[_ -]*t?(\d{1,4})(?=$|[._ -])', stem)
    if not match:
        match = re.search(r'(?i)(?:title|track)[_ -]*(\d{1,4})', stem)
    if match:
        try:
            return (0, int(match.group(1)), stem.lower())
        except (TypeError, ValueError):
            pass
    parts = re.split(r'(\d+)', stem.lower())
    natural = tuple(int(x) if x.isdigit() else x for x in parts)
    return (1, natural, stem.lower())


def provider_folder_tag(provider: str, provider_id: str) -> str:
    p=(provider or '').strip().lower(); pid=(provider_id or '').strip()
    if not pid:
        return ''
    if p == 'tmdb' and re.fullmatch(r'\d+', pid): return f'[tmdbid-{pid}]'
    if p == 'tvdb' and re.fullmatch(r'\d+', pid): return f'[tvdbid-{pid}]'
    if (p in {'omdb','imdb'} or pid.startswith('tt')) and re.fullmatch(r'tt\d+', pid): return f'[imdbid-{pid}]'
    return ''


def provider_from_ids(ids: dict) -> tuple[str,str]:
    normalized={str(k).lower():str(v) for k,v in (ids or {}).items() if v is not None}
    for key,provider in (('tmdb','tmdb'),('imdb','imdb'),('tvdb','tvdb')):
        if normalized.get(key): return provider, normalized[key]
    return '', ''


def jellyfin_port() -> int:
    env=os.environ.get('PCGA_JELLYFIN_PORT','').strip()
    if env.isdigit(): return int(env)
    try:
        for line in STACK_ENV.read_text(encoding='utf-8').splitlines():
            if line.startswith('JELLYFIN_PORT='):
                value=line.split('=',1)[1].strip().strip('"\\\'')
                if value.isdigit(): return int(value)
    except OSError:
        pass
    return 8096


def jellyfin_token() -> str:
    try: return JELLYFIN_TOKEN_FILE.read_text(encoding='utf-8').strip()
    except OSError: return ''


def http_json(url: str, payload: dict | None = None, token: str = '', timeout: float = 8.0):
    data=None if payload is None else json.dumps(payload).encode('utf-8')
    headers={'User-Agent':f'PCGameArchive/{VERSION}','Accept':'application/json'}
    if data is not None: headers['Content-Type']='application/json'
    if token: headers['X-Emby-Token']=token
    req=urllib.request.Request(url,data=data,headers=headers,method='POST' if data is not None else 'GET')
    with urllib.request.urlopen(req,timeout=timeout) as resp:
        return json.loads(resp.read().decode('utf-8'))


def jellyfin_metadata_search(query: str, kind: str, year: str='') -> list[dict]:
    token=jellyfin_token()
    if not token:
        return []
    base=os.environ.get('PCGA_JELLYFIN_BASE_URL',f'http://127.0.0.1:{jellyfin_port()}').rstrip('/')
    kinds=['movie','tv'] if kind == 'all' else [kind]
    out=[]
    for media_kind in kinds:
        endpoint='Movie' if media_kind == 'movie' else 'Series'
        info={'Name':query}
        if year.isdigit(): info['Year']=int(year)
        payload={'SearchInfo':info,'IncludeDisabledProviders':False}
        try:
            rows=http_json(f'{base}/Items/RemoteSearch/{endpoint}',payload,token)
        except Exception as exc:
            log(f'Jellyfin remote metadata search {endpoint} failed: {type(exc).__name__}')
            continue
        for row in (rows if isinstance(rows,list) else [])[:12]:
            ids=row.get('ProviderIds') or {}
            provider,pid=provider_from_ids(ids)
            out.append({
                'kind':media_kind,'title':str(row.get('Name') or '').strip(),
                'year':str(row.get('ProductionYear') or '')[:4],
                'provider':provider,'provider_id':pid,'provider_ids':ids,
                'source':str(row.get('SearchProviderName') or 'Jellyfin provider'),
                'overview':str(row.get('Overview') or '').strip(),
            })
    return [r for r in out if r['title']]


def direct_metadata_search(query: str, kind: str, year: str='') -> list[dict]:
    pf=Path('/etc/pc-game-archive/arm-metadata-provider')
    provider=(pf.read_text().strip().lower() if pf.exists() else 'omdb')
    if provider not in ('omdb','tmdb'): provider='omdb'
    keyfile=Path('/etc/pc-game-archive/arm-omdb-key' if provider=='omdb' else '/etc/pc-game-archive/arm-tmdb-key')
    try: key=keyfile.read_text().strip()
    except OSError: key=''
    if not key: return []
    out=[]
    if provider == 'omdb':
        params={'apikey':key,'s':query}
        if kind == 'movie': params['type']='movie'
        elif kind == 'tv': params['type']='series'
        data=http_json(os.environ.get('PCGA_OMDB_ENDPOINT','https://www.omdbapi.com/')+'?'+urllib.parse.urlencode(params))
        for row in data.get('Search',[])[:12]:
            typ=str(row.get('Type') or '')
            mk='tv' if typ=='series' else 'movie' if typ=='movie' else ''
            if not mk: continue
            out.append({'kind':mk,'title':str(row.get('Title') or ''),'year':str(row.get('Year') or '')[:4],
                        'provider':'imdb','provider_id':str(row.get('imdbID') or ''),'provider_ids':{'Imdb':row.get('imdbID')},
                        'source':'OMDb','overview':''})
    else:
        endpoints=[]
        if kind in ('all','movie'): endpoints.append(('movie','https://api.themoviedb.org/3/search/movie'))
        if kind in ('all','tv'): endpoints.append(('tv','https://api.themoviedb.org/3/search/tv'))
        for mk,endpoint in endpoints:
            params={'api_key':key,'query':query}
            if year.isdigit(): params['year' if mk=='tv' else 'primary_release_year']=year
            data=http_json(os.environ.get('PCGA_TMDB_ENDPOINT',endpoint)+'?'+urllib.parse.urlencode(params))
            for row in data.get('results',[])[:12]:
                title=str(row.get('name') or row.get('title') or '')
                date=str(row.get('first_air_date') or row.get('release_date') or '')
                out.append({'kind':mk,'title':title,'year':date[:4],'provider':'tmdb','provider_id':str(row.get('id') or ''),
                            'provider_ids':{'Tmdb':row.get('id')},'source':'TMDb','overview':str(row.get('overview') or '')})
    return [r for r in out if r['title']]


def metadata_search(query: str, kind: str, year: str='') -> tuple[list[dict],str]:
    query=query.strip()
    if not query: raise ValueError('metadata search requires a title or series name')
    if kind not in {'all','movie','tv'}: kind='all'
    rows=jellyfin_metadata_search(query,kind,year)
    if rows: return rows,'Jellyfin metadata providers'
    rows=direct_metadata_search(query,kind,year)
    if rows: return rows,'PCGA configured metadata provider'
    raise ValueError('No metadata results. Check Jellyfin metadata providers/network access or configure a PCGA OMDb/TMDb key.')


def update_selected_metadata(source: Path, selection: dict[str,str]) -> str:
    manifest_path = source/'.pcga-classification.json' if source.is_dir() else source.with_name(source.name+'.pcga-classification.json')
    try: data=json.loads(manifest_path.read_text(encoding='utf-8')) if manifest_path.exists() else {}
    except Exception: data={}
    kind=selection.get('kind','')
    title=safe_component(selection.get('title',''),'metadata title')
    year=normalize_year(selection.get('year',''))
    provider=selection.get('provider','').strip().lower()[:20]
    provider_id=selection.get('provider_id','').strip()[:80]
    data.update({'classification':'tv' if kind=='tv' else 'movie','title':title,'year':year,
                 'provider':provider,'provider_id':provider_id,'action':'review','confidence':1.0})
    assignment_note=''
    if kind == 'tv':
        data['series']=title
        videos=sorted([f for f in media_files(source) if f.suffix.lower() in VIDEO_EXTS], key=video_sequence_key)
        parsed=[parse_episode_identity(v.name) for v in videos]
        if videos and not any(parsed):
            # Metadata identifies the series, not the episode numbers. Prepare a visible,
            # editable sequential plan instead of failing later at promotion time.
            try: season_num=int(str(data.get('season') or '1'))
            except ValueError: season_num=1
            try: episode_num=int(str(data.get('episode') or '1'))
            except ValueError: episode_num=1
            if season_num < 0 or season_num > 999: season_num=1
            if episode_num < 0 or episode_num > 9999: episode_num=1
            data['season']=str(season_num); data['episode']=str(episode_num)
            data['episode_assignment']='sequential'
            data['episode_assignment_count']=len(videos)
            assignment_note=(f' Prepared {len(videos)} unnumbered video track(s) for sequential assignment '
                             f'starting S{season_num:02d}E{episode_num:02d}; review the episode plan before routing.')
        elif videos and all(parsed):
            data['episode_assignment']='filename'
            data.pop('episode_assignment_count',None)
            assignment_note=' Episode numbers will be taken from the SxxEyy/1x02 filenames.'
        elif videos:
            data['episode_assignment']='mixed'
            data.pop('episode_assignment_count',None)
            assignment_note=' This item mixes numbered and unnumbered episode filenames; review the assignment before routing.'
    evidence=[str(x) for x in (data.get('evidence') or [])]
    evidence.append(f'Manual metadata selection: {title}' + (f' ({year})' if year else '') + (f' [{provider}:{provider_id}]' if provider_id else ''))
    data['evidence']=evidence[-8:]
    tmp=manifest_path.with_suffix(manifest_path.suffix+'.tmp')
    tmp.write_text(json.dumps(data,indent=2,sort_keys=True)+'\n',encoding='utf-8'); tmp.replace(manifest_path)
    return f'Selected metadata: {title}.' + assignment_note


def item_id(root: Path, path: Path) -> str:
    rel = path.resolve().relative_to(root.resolve()).as_posix().encode("utf-8")
    return base64.urlsafe_b64encode(rel).decode("ascii").rstrip("=")


def path_from_id(root: Path, encoded: str) -> Path:
    try:
        raw = encoded + "=" * (-len(encoded) % 4)
        rel = base64.urlsafe_b64decode(raw.encode("ascii")).decode("utf-8")
    except Exception as exc:
        raise ValueError("invalid item id") from exc
    candidate = (root / rel).resolve()
    allowed = [q.resolve() for _, q in queue_roots(root)]
    if not any(candidate == q or q in candidate.parents for q in allowed):
        raise ValueError("item is outside manual-review queues")
    if candidate in allowed:
        raise ValueError("queue root itself is not an item")
    return candidate


@dataclass
class ReviewItem:
    id: str
    source: str
    path: Path
    files: list[Path]
    size: int
    title: str
    year: str
    media_kind: str
    confidence: float | None
    evidence: list[str]
    provider: str = ""
    provider_id: str = ""
    series: str = ""
    season: str = ""
    episode: str = ""
    episode_title: str = ""

    @property
    def display_path(self) -> str:
        return str(self.path)

    @property
    def sample_names(self) -> list[str]:
        return [p.name for p in self.files[:5]]


def scan_items(root: Path) -> list[ReviewItem]:
    items: list[ReviewItem] = []
    for source_name, queue in queue_roots(root):
        queue.mkdir(parents=True, exist_ok=True)
        for child in sorted(queue.iterdir(), key=lambda p: p.name.lower()):
            if child.name.endswith(".pcga-classification.json"):
                continue
            candidate = unwrap_single_media_dir(child)
            media = media_files(candidate)
            files = media or all_regular_files(candidate)
            if not files:
                continue
            manifest = classification_manifest(candidate)
            title, year = infer_title_year(candidate.name)
            title = str(manifest.get("title") or title)
            year = str(manifest.get("year") or year or "")[:4]
            exts = {p.suffix.lower() for p in files}
            detected = str(manifest.get("classification") or "")
            if not detected:
                if media and exts and exts <= AUDIO_EXTS:
                    detected = "audio"
                elif media and exts & VIDEO_EXTS:
                    detected = "video"
                else:
                    detected = "data"
            conf = manifest.get("confidence")
            try: conf = float(conf) if conf is not None else None
            except (TypeError, ValueError): conf = None
            evidence = [str(x) for x in (manifest.get("evidence") or [])[:4]]
            items.append(ReviewItem(
                id=item_id(root, candidate), source=source_name, path=candidate,
                files=files, size=total_size(files), title=title, year=year, media_kind=detected,
                confidence=conf, evidence=evidence,
                provider=str(manifest.get("provider") or ""),
                provider_id=str(manifest.get("provider_id") or ""),
                series=str(manifest.get("series") or (title if detected == "tv" else "")),
                season=str(manifest.get("season") or ""),
                episode=str(manifest.get("episode") or ""),
                episode_title=str(manifest.get("episode_title") or ""),
            ))
    return items


def _safe_stat_size(path: Path) -> int:
    try:
        return int(path.stat().st_size)
    except OSError:
        return 0


def preview_source(item: ReviewItem) -> tuple[str, Path] | tuple[None, None]:
    """Choose a deterministic, representative file for portal Manual Review.

    Prefer the largest video so DVD/BD extras and tiny menu tracks do not become
    the only useful clue. Images and audio are used when no video exists.
    """
    videos=[p for p in item.files if p.suffix.lower() in VIDEO_EXTS and p.exists()]
    if videos:
        return 'video', max(videos, key=_safe_stat_size)
    regular=all_regular_files(item.path)
    images=[p for p in regular if p.suffix.lower() in IMAGE_EXTS and p.exists()]
    if images:
        return 'image', max(images, key=_safe_stat_size)
    audio=[p for p in item.files if p.suffix.lower() in AUDIO_EXTS and p.exists()]
    if audio:
        return 'audio', max(audio, key=_safe_stat_size)
    return None, None


def media_duration_seconds(path: Path) -> float:
    try:
        proc=subprocess.run([
            'ffprobe','-v','error','-show_entries','format=duration',
            '-of','default=noprint_wrappers=1:nokey=1',str(path)
        ],check=False,capture_output=True,text=True,timeout=12)
        value=float((proc.stdout or '').strip() or 0)
        return value if value > 0 else 0.0
    except Exception:
        return 0.0


def review_preview_payload(item: ReviewItem) -> dict:
    kind,path=preview_source(item)
    if not path or not kind:
        return {'available':False}
    return {
        'available':True,
        'kind':kind,
        'name':path.name,
        'size':_safe_stat_size(path),
        'size_human':human_size(_safe_stat_size(path)),
        # Keep queue enumeration cheap. Duration is probed only when a preview
        # is actually opened rather than once per item on every portal refresh.
        'duration_seconds':0,
        'clip_seconds':PREVIEW_CLIP_SECONDS if kind in {'video','audio'} else 0,
    }


def review_item_payload(item: ReviewItem) -> dict:
    videos = sorted([f for f in item.files if f.suffix.lower() in VIDEO_EXTS], key=video_sequence_key)
    episode_plan = {"mode": "none", "rows": []}
    if videos and (item.media_kind == "tv" or item.series):
        parsed = [parse_episode_identity(v.name) for v in videos]
        if all(parsed):
            episode_plan["mode"] = "filename"
            for video, ep in zip(videos, parsed):
                token = f"S{int(ep['season']):02d}E{int(ep['episode']):02d}"
                if ep.get("episode_end") is not None and int(ep["episode_end"]) != int(ep["episode"]):
                    token += f"-E{int(ep['episode_end']):02d}"
                episode_plan["rows"].append({"file": video.name, "target": token})
        elif any(parsed):
            episode_plan["mode"] = "mixed"
            for video, ep in zip(videos, parsed):
                token = f"S{int(ep['season']):02d}E{int(ep['episode']):02d}" if ep else "Needs assignment"
                episode_plan["rows"].append({"file": video.name, "target": token})
        else:
            episode_plan["mode"] = "sequential"
            episode_plan["rows"] = [{"file": video.name, "offset": index} for index, video in enumerate(videos)]
    return {
        "id": item.id, "source": item.source, "path": item.display_path, "title": item.title,
        "year": item.year, "media_kind": item.media_kind, "confidence": item.confidence,
        "evidence": item.evidence, "provider": item.provider, "provider_id": item.provider_id,
        "series": item.series, "season": item.season, "episode": item.episode,
        "episode_title": item.episode_title, "size": item.size, "size_human": human_size(item.size),
        "file_count": len(item.files), "files": [x.name for x in item.files[:24]],
        "files_truncated": max(0, len(item.files) - 24), "episode_plan": episode_plan,
        "preview": review_preview_payload(item),
    }


def find_review_item(root: Path, encoded: str) -> ReviewItem:
    for item in scan_items(root):
        if secrets.compare_digest(item.id, encoded):
            return item
    path_from_id(root, encoded)
    raise FileNotFoundError("review item is no longer queued")


def tv_assignment_preview(item: ReviewItem) -> str:
    videos=sorted([f for f in item.files if f.suffix.lower() in VIDEO_EXTS], key=video_sequence_key)
    if not videos or not (item.media_kind == 'tv' or item.series):
        return ''
    parsed=[parse_episode_identity(v.name) for v in videos]
    if all(parsed):
        rows=[]
        for video,ep in zip(videos,parsed):
            token=f"S{int(ep['season']):02d}E{int(ep['episode']):02d}"
            if ep.get('episode_end') is not None and int(ep['episode_end']) != int(ep['episode']):
                token += f"-E{int(ep['episode_end']):02d}"
            rows.append(f'<tr><td>{html.escape(video.name)}</td><td><strong>{html.escape(token)}</strong></td></tr>')
        return '<section class="episode-plan"><strong>Episode assignment</strong><div class="muted">Episode numbers are already encoded in the filenames.</div><table><thead><tr><th>Source track</th><th>Jellyfin episode</th></tr></thead><tbody>'+''.join(rows)+'</tbody></table></section>'
    if any(parsed):
        rows=[]
        for video,ep in zip(videos,parsed):
            token=(f"S{int(ep['season']):02d}E{int(ep['episode']):02d}" if ep else 'Needs assignment')
            rows.append(f'<tr><td>{html.escape(video.name)}</td><td><strong>{html.escape(token)}</strong></td></tr>')
        return '<section class="episode-plan warning"><strong>Episode assignment needs review</strong><div class="muted">This folder mixes numbered and unnumbered tracks. PCGA will not guess a mixed mapping.</div><table><tbody>'+''.join(rows)+'</tbody></table></section>'
    season=item.season if item.season.isdigit() else '1'
    start=item.episode if item.episode.isdigit() else '1'
    rows=[]
    for offset,video in enumerate(videos):
        target=f'S{int(season):02d}E{int(start)+offset:02d}'
        rows.append(f'<tr><td>{html.escape(video.name)}</td><td><strong class="episode-target" data-offset="{offset}">{target}</strong></td></tr>')
    return '<section class="episode-plan sequential"><strong>Episode assignment</strong><div class="muted">These tracks have no episode tokens. PCGA will number them sequentially in the order below. Edit Season or Starting episode before routing if this disc begins later in the season.</div><table><thead><tr><th>Source track</th><th>Will become</th></tr></thead><tbody>'+''.join(rows)+'</tbody></table></section>'


def ensure_source_valid(root: Path, source: Path) -> list[Path]:
    source = source.resolve()
    # Revalidate immediately before every move.
    _ = path_from_id(root, item_id(root, source))
    files = all_regular_files(source)
    if not files:
        raise ValueError("item contains no reviewable files")
    return files


def merge_move_directory(source: Path, destination: Path) -> None:
    destination.mkdir(parents=True, exist_ok=True)
    children = list(source.iterdir())
    collisions = [destination / child.name for child in children if (destination / child.name).exists()]
    if collisions:
        names = ", ".join(p.name for p in collisions[:5])
        raise FileExistsError(f"destination already contains: {names}")
    for child in children:
        shutil.move(str(child), str(destination / child.name))
    try:
        source.rmdir()
    except OSError:
        pass


def move_source(source: Path, destination_dir: Path, rename_file_to: str | None = None) -> None:
    destination_dir.mkdir(parents=True, exist_ok=True)
    if source.is_file():
        name = source.name
        if rename_file_to:
            name = rename_file_to + source.suffix.lower()
        target = destination_dir / name
        if target.exists():
            raise FileExistsError(f"destination already exists: {target}")
        sidecar = source.with_name(source.name + ".pcga-classification.json")
        shutil.move(str(source), str(target))
        if sidecar.exists():
            shutil.move(str(sidecar), str(target.with_name(target.name + ".pcga-classification.json")))
    elif source.is_dir():
        merge_move_directory(source, destination_dir)
    else:
        raise FileNotFoundError(source)


def write_manifest(destination: Path, payload: dict) -> None:
    manifest = destination / ".pcga-manual-review.json"
    data = dict(payload)
    data["promoted_at"] = dt.datetime.now(dt.timezone.utc).isoformat()
    tmp = manifest.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    tmp.replace(manifest)


def refresh_jellyfin() -> None:
    if os.environ.get("PCGA_DISABLE_JELLYFIN_REFRESH") == "1":
        return
    helper = Path("/usr/local/sbin/pcga-jellyfin-refresh")
    if helper.exists():
        subprocess.run([str(helper)], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def series_folder_name(series: str, year: str, provider: str, provider_id: str) -> tuple[str,str]:
    base = f"{series} ({year})" if year else series
    tag = provider_folder_tag(provider, provider_id)
    return base + (f" {tag}" if tag else ""), base


def find_existing_series_root(root: Path, series: str, year: str, provider: str, provider_id: str) -> Path:
    tvroot=library_root(root,'tv'); tvroot.mkdir(parents=True,exist_ok=True)
    preferred_name, base_name=series_folder_name(series,year,provider,provider_id)
    preferred=tvroot/preferred_name; base=tvroot/base_name
    # Provider identity is the strongest join key across separately reviewed episodes.
    if provider_id:
        for child in tvroot.iterdir():
            if not child.is_dir(): continue
            identity=child/'.pcga-series.json'
            try: data=json.loads(identity.read_text(encoding='utf-8')) if identity.exists() else {}
            except Exception: data={}
            if str(data.get('provider_id') or '') == provider_id and str(data.get('provider') or '').lower() == provider.lower():
                return child
    if preferred.exists(): return preferred
    if provider_id and base.exists() and base != preferred:
        # Upgrade an existing untagged series folder to the provider-qualified name.
        try:
            base.rename(preferred)
            return preferred
        except OSError:
            return base
    if base.exists(): return base
    return preferred


def write_series_manifest(series_root: Path, series: str, year: str, provider: str, provider_id: str) -> None:
    series_root.mkdir(parents=True,exist_ok=True)
    payload={'pcga_manual_review_version':VERSION,'series':series,'year':year,
             'provider':provider,'provider_id':provider_id,
             'updated_at':dt.datetime.now(dt.timezone.utc).isoformat()}
    tmp=series_root/'.pcga-series.json.tmp'
    tmp.write_text(json.dumps(payload,indent=2,sort_keys=True)+'\n',encoding='utf-8')
    tmp.replace(series_root/'.pcga-series.json')


def canonical_episode_stem(series: str, season: int, episode: int, episode_end: int | None = None,
                           episode_title: str = '') -> str:
    token=f'S{season:02d}E{episode:02d}'
    if episode_end is not None and episode_end != episode:
        token += f'-E{episode_end:02d}'
    name=f'{series} - {token}'
    if episode_title:
        name += ' - ' + safe_component(episode_title,'episode title')
    return safe_component(name,'episode filename')


def promote_tv_item(root: Path, source: Path, fields: dict[str,str], files: list[Path]) -> tuple[Path,dict]:
    series=safe_component(fields.get('series',fields.get('title','')),'series')
    year=normalize_year(fields.get('year',''))
    provider=fields.get('provider','').strip().lower()[:20]
    provider_id=fields.get('provider_id','').strip()[:80]
    try: default_season=int(fields.get('season','1') or '1')
    except ValueError as exc: raise ValueError('season must be a number') from exc
    if default_season < 0 or default_season > 999: raise ValueError('season must be between 0 and 999')
    start_raw=(fields.get('episode') or '').strip()
    start_episode=None
    if start_raw:
        try: start_episode=int(start_raw)
        except ValueError as exc: raise ValueError('episode/start episode must be a number') from exc
        if start_episode < 0 or start_episode > 9999: raise ValueError('episode must be between 0 and 9999')
    ep_title=(fields.get('episode_title') or '').strip()
    series_root=find_existing_series_root(root,series,year,provider,provider_id)
    videos=sorted([f for f in files if f.suffix.lower() in VIDEO_EXTS], key=video_sequence_key)
    if not videos: raise ValueError('TV routing requires at least one video file')
    parsed_flags=[parse_episode_identity(video.name) is not None for video in videos]
    if source.is_dir() and any(parsed_flags) and not all(parsed_flags):
        raise ValueError('TV folder mixes numbered and unnumbered tracks. Rename the unnumbered files with SxxEyy/1x02 tokens or separate them into a sequential-only review item before routing.')
    plan=[]
    for index,video in enumerate(videos):
        parsed=parse_episode_identity(video.name)
        if source.is_file():
            season=default_season
            episode=start_episode if start_episode is not None else (parsed['episode'] if parsed else None)
            episode_end=parsed.get('episode_end') if parsed else None
            title=ep_title or (parsed.get('episode_title','') if parsed else '')
        elif parsed:
            season=int(parsed['season']); episode=int(parsed['episode']); episode_end=parsed.get('episode_end'); title=parsed.get('episode_title','')
        elif start_episode is not None:
            season=default_season; episode=start_episode+index; episode_end=None; title=''
        else:
            raise ValueError('TV item has unnumbered video tracks. Set a Starting episode in the Episode Assignment section (for example 1), or rename every episode with an SxxEyy/1x02 token.')
        if episode is None: raise ValueError('episode number is required for TV promotion')
        season_dir=series_root/f'Season {season:02d}'
        final=season_dir/(canonical_episode_stem(series,season,episode,episode_end,title)+video.suffix.lower())
        plan.append((video,final,season,episode,title))
    collisions=[final for _,final,_,_,_ in plan if final.exists()]
    if collisions: raise FileExistsError('destination already contains: '+', '.join(x.name for x in collisions[:5]))
    for video,final,_,_,_ in plan:
        final.parent.mkdir(parents=True,exist_ok=True)
        shutil.move(str(video),str(final))
    # Preserve non-video files without letting them disrupt Jellyfin's episode parser.
    if source.is_dir():
        media_source=source/'.pcga-media.json'
        if media_source.is_file():
            try:
                data=json.loads(media_source.read_text(encoding='utf-8'));finger=str(data.get('fingerprint') or '')[:16] or dt.datetime.now().strftime('%Y%m%d%H%M%S')
                shutil.copy2(media_source,series_root/f'.pcga-optical-source-{finger}.json')
            except Exception:
                pass
        internal={'.pcga-classification.json','.pcga-source-hint','.pcga-media.json'}
        leftovers=[]
        for f in list(source.rglob('*')):
            if f.is_file() and f.name not in internal:
                leftovers.append(f)
        if leftovers:
            extras=series_root/'extras'/safe_component(source.name,'source folder')
            extras.mkdir(parents=True,exist_ok=True)
            for f in leftovers:
                target=extras/f.name
                if target.exists():
                    target=extras/(dt.datetime.now().strftime('%Y%m%d-%H%M%S')+'-'+f.name)
                shutil.move(str(f),str(target))
        for internal_name in internal:
            try: (source/internal_name).unlink()
            except OSError: pass
        for d in sorted([x for x in source.rglob('*') if x.is_dir()],key=lambda x:len(x.parts),reverse=True):
            try:d.rmdir()
            except OSError:pass
        try:source.rmdir()
        except OSError:pass
    else:
        sidecar=source.with_name(source.name+'.pcga-classification.json')
        try: sidecar.unlink()
        except OSError: pass
    write_series_manifest(series_root,series,year,provider,provider_id)
    metadata={'type':'tv','series':series,'year':year,'provider':provider,'provider_id':provider_id,
              'season':default_season,'episode':start_raw,'episode_title':ep_title,
              'episodes_promoted':[{'file':str(final),'season':season,'episode':episode,'title':title} for _,final,season,episode,title in plan]}
    return series_root,metadata


def promote(root: Path, source: Path, kind: str, fields: dict[str, str]) -> Path:
    files = ensure_source_valid(root, source)
    original = str(source)
    kind = kind.strip().lower()
    media_source=optical_media_manifest(source)
    if media_source and kind in {"movie","tv"}:
        layout=str(media_source.get('layout') or '').strip().lower()
        contents=media_source.get('contents') if isinstance(media_source.get('contents'),list) else []
        if layout in {'multi-title','multi-title-candidate','collection'} or len(contents)>1:
            raise ValueError('This optical source contains multiple logical titles. Map its MakeMKV title indices with `game-archive media-intake` before Jellyfin promotion; PCGA will not merge the anthology into one library item.')
        if kind=='movie' and layout=='multi-disc-title':
            raise ValueError('This movie is part of a multi-disc source. Confirm its disc/part role before Jellyfin promotion; PCGA will not collapse separate movie discs into one unstacked folder.')
    year = normalize_year(fields.get("year", ""))
    provider=fields.get('provider','').strip().lower()[:20]
    provider_id=fields.get('provider_id','').strip()[:80]

    if kind == "movie":
        title = safe_component(fields.get("title", ""), "title")
        base=f"{title} ({year})" if year else title
        tag=provider_folder_tag(provider,provider_id)
        folder=base+(f" {tag}" if tag else "")
        destination = library_root(root, kind) / folder
        rename = folder if source.is_file() else None
        move_source(source, destination, rename)
        metadata = {"type": "movie", "title": title, "year": year, "provider":provider,"provider_id":provider_id}

    elif kind == "tv":
        destination,metadata=promote_tv_item(root,source,fields,files)

    elif kind == "music":
        artist = safe_component(fields.get("artist", ""), "artist")
        album = safe_component(fields.get("album", fields.get("title", "")), "album")
        album_folder = f"{album} ({year})" if year else album
        destination = library_root(root, kind) / artist / album_folder
        move_source(source, destination, None)
        metadata = {"type": "music", "artist": artist, "album": album, "year": year}

    elif kind == "home":
        title = safe_component(fields.get("title", ""), "title")
        folder = f"{title} ({year})" if year else title
        destination = library_root(root, kind) / folder
        rename = folder if source.is_file() else None
        move_source(source, destination, rename)
        metadata = {"type": "home", "title": title, "year": year}

    elif kind in {"game", "software", "disc"}:
        title = safe_component(fields.get("title", ""), "title")
        folder = f"{title} ({year})" if year else title
        base = {
            "game": root / "ingest/inbox/pc-games",
            "software": root / "ingest/inbox/software",
            "disc": root / "ingest/inbox/disc-images",
        }[kind]
        destination = base / folder
        move_source(source, destination, None)
        metadata = {"type": kind, "title": title, "year": year}

    else:
        raise ValueError("type must be movie, tv, music, home, game, software, or disc")

    write_manifest(destination, {
        "pcga_manual_review_version": VERSION,
        "source": original,
        "files_before_move": [str(p) for p in files],
        **metadata,
    })
    log(f"Promoted {original} -> {destination} ({kind})")
    if kind in {"movie", "tv", "music", "home"}:
        refresh_jellyfin()
    return destination

def move_to_quarantine(root: Path, source: Path) -> Path:
    ensure_source_valid(root, source)
    quarantine = root / "media/quarantine/unidentified"
    quarantine.mkdir(parents=True, exist_ok=True)
    if quarantine.resolve() in source.resolve().parents:
        return source
    target = quarantine / source.name
    if target.exists():
        stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
        target = quarantine / f"{stamp}-{source.name}"
    sidecar = source.with_name(source.name + ".pcga-classification.json") if source.is_file() else None
    shutil.move(str(source), str(target))
    if sidecar is not None and sidecar.exists():
        shutil.move(str(sidecar), str(target.with_name(target.name + ".pcga-classification.json")))
    log(f"Moved manual-review item to quarantine: {target}")
    return target


def delete_review_item(root: Path, source: Path) -> dict:
    """Permanently delete one explicitly selected manual-review item.

    The source is revalidated against the review queues immediately before
    deletion.  A small audit receipt is retained outside the archive so an
    operator can tell what was intentionally removed without retaining another
    copy of the media itself.
    """
    files=ensure_source_valid(root,source)
    source=source.resolve()
    rel=str(source.relative_to(root.resolve()))
    manifest=classification_manifest(source)
    size=total_size(files)
    count=len(files)
    sidecars=[]
    if source.is_file():
        for suffix in ('.pcga-classification.json','.pcga-source-hint'):
            q=source.with_name(source.name+suffix)
            if q.exists(): sidecars.append(q)
        source.unlink()
        for q in sidecars:
            try:q.unlink()
            except OSError:pass
    elif source.is_dir():
        shutil.rmtree(source)
    else:
        raise FileNotFoundError(source)
    audit_dir=Path('/var/lib/pc-game-archive/review-deletions')
    audit_dir.mkdir(parents=True,exist_ok=True)
    stamp=dt.datetime.now(dt.timezone.utc)
    payload={
        'schema':1,'pcga_version':VERSION,'deleted_at':stamp.isoformat(),
        'path':rel,'bytes':size,'files':count,
        'classification':manifest.get('classification'),
        'title':manifest.get('title'),
        'reason':'manual-review-delete',
    }
    receipt=audit_dir/(stamp.strftime('%Y%m%d-%H%M%S-%f')+'.json')
    receipt.write_text(json.dumps(payload,indent=2,sort_keys=True)+'\n',encoding='utf-8')
    log(f"Deleted manual-review item: {rel} ({count} file(s), {human_size(size)})")
    return payload


def load_token(create: bool = False) -> str:
    env = os.environ.get("PCGA_REVIEW_TOKEN")
    if env:
        return env.strip()
    if TOKEN_FILE.is_file():
        return TOKEN_FILE.read_text(encoding="utf-8").strip()
    if create:
        TOKEN_FILE.parent.mkdir(parents=True, exist_ok=True)
        token = secrets.token_urlsafe(32)
        TOKEN_FILE.write_text(token + "\n", encoding="utf-8")
        os.chmod(TOKEN_FILE, 0o600)
        return token
    raise RuntimeError(f"missing review token: {TOKEN_FILE}")


def parse_conf() -> dict[str, str]:
    result = {"BIND": "0.0.0.0", "PORT": "8097"}
    if CONF_FILE.is_file():
        for raw in CONF_FILE.read_text(encoding="utf-8").splitlines():
            raw = raw.strip()
            if not raw or raw.startswith("#") or "=" not in raw:
                continue
            k, v = raw.split("=", 1)
            result[k.strip()] = v.strip().strip('"\'')
    return result


