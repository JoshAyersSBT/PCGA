<main>{notice}{err}{''.join(cards)}</main>{TV_ASSIGNMENT_SCRIPT}{PORTAL_THEME_SCRIPT}</body></html>"""


class ReviewHandler(BaseHTTPRequestHandler):
    server_version = f"PCGAReview/{VERSION}"

    @property
    def root(self) -> Path:
        return self.server.root  # type: ignore[attr-defined]

    @property
    def token(self) -> str:
        return self.server.token  # type: ignore[attr-defined]

    def log_message(self, fmt: str, *args) -> None:
        log(f"web {self.address_string()} {fmt % args}")

    def authenticated(self) -> bool:
        cookies = http.cookies.SimpleCookie(self.headers.get("Cookie", ""))
        supplied = cookies.get("pcga_review")
        return bool(supplied and secrets.compare_digest(supplied.value, self.token))

    def send_html(self, body: str, status: int = 200, headers: dict[str, str] | None = None) -> None:
        data = body.encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("Referrer-Policy", "no-referrer")
        if headers:
            for k, v in headers.items():
                self.send_header(k, v)
        self.end_headers()
        self.wfile.write(data)

    def send_json(self, payload: dict | list, status: int = 200) -> None:
        data = (json.dumps(payload, separators=(",", ":"), default=str) + "\n").encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        self.end_headers()
        self.wfile.write(data)

    def api_authenticated(self) -> bool:
        supplied = self.headers.get("X-PCGA-Review-Token", "")
        return bool(supplied and secrets.compare_digest(supplied, self.token))

    def read_json(self) -> dict:
        try:
            length = int(self.headers.get("Content-Length", "0"))
        except ValueError:
            length = 0
        if length <= 0 or length > 128 * 1024:
            raise ValueError("invalid request size")
        payload = json.loads(self.rfile.read(length).decode("utf-8", "replace"))
        if not isinstance(payload, dict):
            raise ValueError("JSON object required")
        return payload

    def redirect(self, location: str, set_cookie: bool = False) -> None:
        self.send_response(303)
        self.send_header("Location", location)
        if set_cookie:
            self.send_header("Set-Cookie", f"pcga_review={self.token}; Path=/; HttpOnly; SameSite=Strict")
        self.send_header("Cache-Control", "no-store")
        self.end_headers()

    def login_page(self, error: str = "") -> str:
        err = f'<p class="error">{html.escape(error)}</p>' if error else ""
        return f"""<!doctype html><html><head><meta name=viewport content="width=device-width,initial-scale=1"><title>PCGA Review Login</title><style>{PORTAL_THEME_STYLE}.login-shell{{max-width:560px;margin:10vh auto;padding:24px}}.login-card{{background:var(--panel-surface);border:1px solid var(--line);border-radius:var(--ui-radius);padding:24px;backdrop-filter:blur(16px)}}.login-card input,.login-card button{{font:inherit;padding:12px;width:100%;margin-top:10px;min-height:52px}}</style></head><body data-bg-pattern="ambient"><video id="review-background-video" class="review-background-video" muted loop playsinline preload="metadata" aria-hidden="true"></video><main class="login-shell"><section class="login-card"><h1>PCGA Manual Media Review</h1><p>Enter the review token from <code>sudo game-archive manual-review-token</code>.</p>{err}<form method=post action=/login><input type=password name=token autofocus required><button>Sign in</button></form></section></main>{PORTAL_THEME_SCRIPT}</body></html>"""

    def _send_preview_bytes(self, data: bytes, content_type: str) -> None:
        self.send_response(200)
        self.send_header('Content-Type', content_type)
        self.send_header('Content-Length', str(len(data)))
        self.send_header('Cache-Control', 'private, max-age=300')
        self.send_header('X-Content-Type-Options', 'nosniff')
        self.send_header('Referrer-Policy', 'no-referrer')
        self.end_headers()
        try:
            self.wfile.write(data)
        except (BrokenPipeError, ConnectionResetError):
            pass

    def _preview_start(self, path: Path) -> float:
        duration=media_duration_seconds(path)
        if duration <= 0:
            return 0.0
        if duration > 12*60:
            return min(max(60.0, duration*0.12), max(0.0, duration-PREVIEW_CLIP_SECONDS-5))
        if duration > 90:
            return min(30.0, max(0.0, duration-PREVIEW_CLIP_SECONDS-2))
        return max(0.0, duration*0.08)

    def send_review_preview(self, encoded: str, mode: str) -> None:
        item=find_review_item(self.root, encoded)
        kind,path=preview_source(item)
        if not path or not kind:
            self.send_error(404, 'No previewable media in review item'); return
        if mode == 'poster':
            if kind == 'image':
                ctype={'.png':'image/png','.webp':'image/webp','.gif':'image/gif','.bmp':'image/bmp'}.get(path.suffix.lower(),'image/jpeg')
                try:
                    data=path.read_bytes()
                except OSError:
                    self.send_error(404); return
                # Do not accidentally load an enormous source image into the portal.
                if len(data) <= 12*1024*1024:
                    self._send_preview_bytes(data,ctype); return
            if kind != 'video':
                self.send_error(404, 'Poster preview is only available for video/images'); return
            if not shutil.which('ffmpeg'):
                self.send_error(503, 'ffmpeg is unavailable'); return
            start=self._preview_start(path)
            cmd=['ffmpeg','-nostdin','-loglevel','error']
            if start > 0: cmd += ['-ss',f'{start:.3f}']
            cmd += ['-i',str(path),'-frames:v','1','-vf','scale=960:-2:force_original_aspect_ratio=decrease','-q:v','4','-f','image2pipe','-vcodec','mjpeg','pipe:1']
            try:
                proc=subprocess.run(cmd,check=False,capture_output=True,timeout=30)
            except subprocess.TimeoutExpired:
                self.send_error(504,'Preview frame timed out'); return
            if proc.returncode != 0 or not proc.stdout:
                self.send_error(502,'Unable to decode a preview frame'); return
            self._send_preview_bytes(proc.stdout,'image/jpeg'); return
        if mode != 'clip':
            self.send_error(400,'Unknown preview mode'); return
        if kind not in {'video','audio'}:
            self.send_error(400,'This review item has no playable preview'); return
        if not shutil.which('ffmpeg'):
            self.send_error(503,'ffmpeg is unavailable'); return
        start=self._preview_start(path)
        cmd=['ffmpeg','-nostdin','-loglevel','error']
        if start > 0: cmd += ['-ss',f'{start:.3f}']
        cmd += ['-i',str(path),'-t',str(PREVIEW_CLIP_SECONDS)]
        if kind == 'video':
            cmd += ['-map','0:v:0','-map','0:a:0?','-vf','scale=960:-2:force_original_aspect_ratio=decrease','-c:v','libx264','-preset','veryfast','-crf','27','-pix_fmt','yuv420p','-c:a','aac','-b:a','96k']
        else:
            cmd += ['-vn','-map','0:a:0','-c:a','aac','-b:a','128k']
        cmd += ['-movflags','frag_keyframe+empty_moov+default_base_moof','-f','mp4','pipe:1']
        self.send_response(200)
        self.send_header('Content-Type','video/mp4' if kind == 'video' else 'audio/mp4')
        self.send_header('Cache-Control','no-store')
        self.send_header('X-Content-Type-Options','nosniff')
        self.send_header('Referrer-Policy','no-referrer')
        self.end_headers()
        proc=None
        try:
            proc=subprocess.Popen(cmd,stdout=subprocess.PIPE,stderr=subprocess.DEVNULL)
            assert proc.stdout is not None
            while True:
                chunk=proc.stdout.read(128*1024)
                if not chunk: break
                self.wfile.write(chunk)
        except (BrokenPipeError,ConnectionResetError):
            pass
        finally:
            if proc is not None:
                try:
                    proc.terminate()
                    proc.wait(timeout=2)
                except Exception:
                    try: proc.kill()
                    except Exception: pass

    def do_GET(self) -> None:
        parsed = urllib.parse.urlsplit(self.path)
        if parsed.path == "/health":
            payload = b"ok\n"
            self.send_response(200); self.send_header("Content-Type", "text/plain"); self.send_header("Content-Length", str(len(payload))); self.end_headers(); self.wfile.write(payload)
            return
        if parsed.path == "/api/preview":
            if not self.api_authenticated():
                self.send_json({"ok": False, "error": "unauthorized"}, 401); return
            query = urllib.parse.parse_qs(parsed.query)
            encoded = str((query.get("item") or [""])[0])
            mode = str((query.get("mode") or ["poster"])[0]).lower()
            try:
                self.send_review_preview(encoded, mode)
            except FileNotFoundError as exc:
                self.send_error(404, str(exc))
            except ValueError as exc:
                self.send_error(400, str(exc))
            return
        if parsed.path == "/api/items":
            if not self.api_authenticated():
                self.send_json({"ok": False, "error": "unauthorized"}, 401); return
            items = [review_item_payload(item) for item in scan_items(self.root)]
            self.send_json({"ok": True, "items": items, "count": len(items)}); return
        query = urllib.parse.parse_qs(parsed.query)
        token = query.get("token", [""])[0]
        if token and secrets.compare_digest(token, self.token):
            self.redirect("/", set_cookie=True)
            return
        if parsed.path != "/":
            self.send_error(404); return
        if not self.authenticated():
            self.send_html(self.login_page(), 401); return
        self.send_html(page(self.root, self.token))

    def read_form(self) -> dict[str, str]:
        try:
            length = int(self.headers.get("Content-Length", "0"))
        except ValueError:
            length = 0
        if length <= 0 or length > 128 * 1024:
            raise ValueError("invalid request size")
        body = self.rfile.read(length).decode("utf-8", "replace")
        parsed = urllib.parse.parse_qs(body, keep_blank_values=True)
        return {k: v[-1] for k, v in parsed.items()}

    def do_POST(self) -> None:
        if self.path.startswith("/api/"):
            if not self.api_authenticated():
                self.send_json({"ok": False, "error": "unauthorized"}, 401); return
            try:
                payload = self.read_json()
                item_id_value = str(payload.get("item") or "")
                if self.path == "/api/metadata-search":
                    item = find_review_item(self.root, item_id_value)
                    query = str(payload.get("query") or item.series or item.title).strip()
                    kind = str(payload.get("kind") or "all")
                    year = str(payload.get("year") or item.year or "")
                    results, source_name = metadata_search(query, kind, year)
                    self.send_json({"ok": True, "results": results, "source": source_name}); return
                source = path_from_id(self.root, item_id_value)
                if self.path == "/api/metadata-apply":
                    selection = {k: str(payload.get(k) or "") for k in ("kind", "title", "year", "provider", "provider_id")}
                    if selection["kind"] not in {"movie", "tv"}:
                        raise ValueError("metadata result must be a movie or TV series")
                    message = update_selected_metadata(source, selection)
                    self.send_json({"ok": True, "message": message, "item": review_item_payload(find_review_item(self.root, item_id_value))}); return
                if self.path == "/api/promote":
                    kind = str(payload.get("kind") or "")
                    fields = {str(k): str(v) for k, v in payload.items() if k not in {"item", "kind"} and v is not None}
                    destination = promote(self.root, source, kind, fields)
                    self.send_json({"ok": True, "message": f"Promoted to {destination}", "destination": str(destination), "remaining": len(scan_items(self.root))}); return
                if self.path == "/api/quarantine":
                    target = move_to_quarantine(self.root, source)
                    self.send_json({"ok": True, "message": f"Quarantined: {target}", "destination": str(target), "remaining": len(scan_items(self.root))}); return
                if self.path == "/api/delete":
                    if str(payload.get("confirm") or "") != "DELETE":
                        raise ValueError("delete confirmation token missing")
                    deleted = delete_review_item(self.root, source)
                    self.send_json({"ok": True, "message": "Deleted review item", "deleted": deleted, "remaining": len(scan_items(self.root))}); return
                self.send_json({"ok": False, "error": "not-found"}, 404); return
            except FileNotFoundError as exc:
                self.send_json({"ok": False, "error": "not-found", "detail": str(exc)}, 404); return
            except Exception as exc:
                self.send_json({"ok": False, "error": type(exc).__name__, "detail": str(exc)}, 400); return
        if self.path == "/login":
            try:
                form = self.read_form()
            except Exception:
                self.send_html(self.login_page("Invalid request"), 400); return
            supplied = form.get("token", "")
            if secrets.compare_digest(supplied, self.token):
                self.redirect("/", set_cookie=True)
            else:
                self.send_html(self.login_page("Incorrect token"), 401)
            return
        if not self.authenticated():
            self.send_html(self.login_page(), 401); return
        try:
            form = self.read_form()
            if not secrets.compare_digest(form.get("csrf", ""), self.token):
                raise PermissionError("invalid request token")
            source = path_from_id(self.root, form.get("item", ""))
            if self.path == "/metadata-search":
                kind=form.get("search_kind","all")
                query=form.get("query","").strip()
                results,search_source=metadata_search(query,kind)
                self.send_html(page(self.root,self.token,search_state={"item":form.get("item",""),"query":query,"kind":kind,"results":results,"source":search_source}))
            elif self.path == "/metadata-apply":
                selection={k:form.get(k,"") for k in ("kind","title","year","provider","provider_id")}
                if selection["kind"] not in {"movie","tv"}: raise ValueError("metadata result must be a movie or TV series")
                selected_message=update_selected_metadata(source,selection)
                self.send_html(page(self.root,self.token,message=selected_message))
            elif self.path == "/promote":
                destination = promote(self.root, source, form.get("kind", ""), form)
                self.send_html(page(self.root, self.token, message=f"Promoted to {destination}"))
            elif self.path == "/quarantine":
                target = move_to_quarantine(self.root, source)
                self.send_html(page(self.root, self.token, message=f"Quarantined: {target}"))
            elif self.path == "/delete":
                if form.get("confirm") != "DELETE": raise ValueError("delete confirmation token missing")
                deleted = delete_review_item(self.root, source)
                self.send_html(page(self.root, self.token, message=f"Deleted: {deleted.get('path')}"))
            else:
                self.send_error(404)
        except Exception as exc:
            self.send_html(page(self.root, self.token, error=str(exc)), 400)


def interactive(root: Path) -> int:
    while True:
        items = scan_items(root)
        if not items:
            print("No items are awaiting manual review.")
            return 0
        print("\nItems awaiting manual review:")
        for i, item in enumerate(items, 1):
            print(f"  {i:2d}. [{item.source}] {item.title} {f'({item.year})' if item.year else ''} — {human_size(item.size)}, {len(item.files)} file(s)")
            print(f"      {item.path}")
        print("   q. quit")
        answer = input("Select item: ").strip().lower()
        if answer in {"q", "quit", "exit", ""}:
            return 0
        try:
            item = items[int(answer) - 1]
        except (ValueError, IndexError):
            print("Invalid selection.")
            continue
        print("\nDestination: 1=Movie  2=TV  3=Music  4=Home video  5=Quarantine  6=PC game  7=Software  8=Disc image/data  s=Skip")
        choice = input("Choice: ").strip().lower()
        if choice in {"s", "skip", ""}:
            continue
        if choice == "5":
            print(f"Quarantined: {move_to_quarantine(root, item.path)}")
            continue
        kind = {"1": "movie", "2": "tv", "3": "music", "4": "home", "6": "game", "7": "software", "8": "disc"}.get(choice)
        if not kind:
            print("Invalid destination.")
            continue
        fields: dict[str, str] = {}
        if kind in {"movie", "home", "game", "software", "disc"}:
            fields["title"] = input(f"Title [{item.title}]: ").strip() or item.title
            fields["year"] = input(f"Year [{item.year}]: ").strip() or item.year
        elif kind == "tv":
            fields["series"] = input(f"Series [{item.title}]: ").strip() or item.title
            fields["year"] = input(f"Series year [{item.year}]: ").strip() or item.year
            fields["season"] = input("Season [1]: ").strip() or "1"
            if item.path.is_file():
                fields["episode"] = input("Episode number (optional): ").strip()
                fields["episode_title"] = input("Episode title (optional): ").strip()
        elif kind == "music":
            fields["artist"] = input("Artist: ").strip()
            fields["album"] = input(f"Album [{item.title}]: ").strip() or item.title
            fields["year"] = input(f"Year [{item.year}]: ").strip() or item.year
        try:
            destination = promote(root, item.path, kind, fields)
            print(f"Promoted to: {destination}")
        except Exception as exc:
            print(f"ERROR: {exc}", file=sys.stderr)


def cmd_list(root: Path) -> int:
    items = scan_items(root)
    if not items:
        print("No items are awaiting manual review.")
        return 0
    for i, item in enumerate(items, 1):
        print(f"{i}\t{item.id}\t{item.source}\t{item.media_kind}\t{human_size(item.size)}\t{item.title}\t{item.year}\t{item.path}")
    return 0


def serve(root: Path, bind: str, port: int) -> int:
    token = load_token(create=True)
    server = ThreadingHTTPServer((bind, port), ReviewHandler)
    server.root = root  # type: ignore[attr-defined]
    server.token = token  # type: ignore[attr-defined]
    log(f"Manual review web UI listening on {bind}:{port}; queue items={len(scan_items(root))}")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
    return 0


def main() -> int:
    conf = parse_conf()
    parser = argparse.ArgumentParser(description="PC Game Archive manual classification review")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("list")
    sub.add_parser("interactive")
    sub.add_parser("token")
    pserve = sub.add_parser("serve")
    pserve.add_argument("--bind", default=conf.get("BIND", "0.0.0.0"))
    pserve.add_argument("--port", type=int, default=int(conf.get("PORT", "8097")))
    pp = sub.add_parser("promote")
    pp.add_argument("item")
    pp.add_argument("kind", choices=["movie", "tv", "music", "home", "game", "software", "disc"])
    pp.add_argument("--title", default=""); pp.add_argument("--year", default="")
    pp.add_argument("--series", default=""); pp.add_argument("--season", default="1")
    pp.add_argument("--episode", default=""); pp.add_argument("--episode-title", default="")
    pp.add_argument("--artist", default=""); pp.add_argument("--album", default="")
    pp.add_argument("--provider", default=""); pp.add_argument("--provider-id", default="")
    args = parser.parse_args()
    root = archive_root()
    for _, q in queue_roots(root): q.mkdir(parents=True, exist_ok=True)
    for k in ("movie", "tv", "music", "home"): library_root(root, k).mkdir(parents=True, exist_ok=True)
    for rel in ("ingest/inbox/pc-games", "ingest/inbox/software", "ingest/inbox/disc-images"):
        (root / rel).mkdir(parents=True, exist_ok=True)

    if args.command == "list": return cmd_list(root)
    if args.command == "interactive": return interactive(root)
    if args.command == "token": print(load_token(create=True)); return 0
    if args.command == "serve": return serve(root, args.bind, args.port)
    if args.command == "promote":
        source = path_from_id(root, args.item)
        destination = promote(root, source, args.kind, {
            "title": args.title, "year": args.year, "series": args.series, "season": args.season,
            "episode": args.episode, "episode_title": args.episode_title, "artist": args.artist, "album": args.album,
            "provider": args.provider, "provider_id": args.provider_id,
        })
        print(destination); return 0
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
