    if not cards:
        cards.append('<div class="empty"><h2>No items awaiting manual review.</h2><p>High-confidence items are routed automatically; ambiguous media/data remains here with classifier evidence.</p></div>')
    notice = f'<div class="notice">{html.escape(message)}</div>' if message else ""
    err = f'<div class="error">{html.escape(error)}</div>' if error else ""
    return f"""<!doctype html>
