#!/usr/bin/env python3
"""PC Game Archive manual media review and promotion service.

Queues:
  <root>/media/metadata-pending
  <root>/media/quarantine/unidentified

Destinations:
  <root>/media/library/{movies,tv,music,home-videos}

The service deliberately never touches ARM raw/transcode/completed staging.
"""
