            if rows:
                metadata_results_html=f'<div class="muted">Results from {html.escape(search_source)}</div><div class="metadata-results">{"".join(rows)}</div>'
            else:
                metadata_results_html='<div class="muted">No matching metadata results.</div>'
        q_value=html.escape(search_query if search_item == item.id else (item.series or item.title))
        episode_plan_html=tv_assignment_preview(item)
        cards.append(f"""
