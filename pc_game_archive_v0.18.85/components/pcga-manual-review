TV_ASSIGNMENT_SCRIPT = r"""
<script>
(()=>{
  for(const form of document.querySelectorAll('.review-form')){
    const plan=form.querySelector('.episode-plan.sequential');
    if(!plan) continue;
    const season=form.querySelector('input[name="season"]');
    const episode=form.querySelector('input[name="episode"]');
    const update=()=>{
      let s=parseInt(season?.value||'1',10), e=parseInt(episode?.value||'1',10);
      if(!Number.isFinite(s)||s<0) s=1;
      if(!Number.isFinite(e)||e<0) e=1;
      for(const node of plan.querySelectorAll('.episode-target')){
        const off=parseInt(node.dataset.offset||'0',10)||0;
        node.textContent=`S${String(s).padStart(2,'0')}E${String(e+off).padStart(2,'0')}`;
      }
    };
    season?.addEventListener('input',update);
    episode?.addEventListener('input',update);
    update();
  }
})();
</script>
"""

def page(root: Path, token: str, message: str = "", error: str = "", search_state: dict | None = None) -> str:
    items = scan_items(root)
    cards = []
    search_state=search_state or {}
    search_item=str(search_state.get('item') or '')
    search_results=search_state.get('results') or []
    search_query=str(search_state.get('query') or '')
    search_kind=str(search_state.get('kind') or 'all')
    search_source=str(search_state.get('source') or '')
    for item in items:
        sample = "".join(f"<li>{html.escape(name)}</li>" for name in item.sample_names)
        if len(item.files) > 5:
            sample += f"<li>… {len(item.files)-5} more</li>"
        title = html.escape(item.title)
        year = html.escape(item.year)
        series_value=html.escape(item.series or item.title)
        confidence = f" · confidence {item.confidence:.2f}" if item.confidence is not None else ""
        evidence = "".join(f"<li>{html.escape(x)}</li>" for x in item.evidence)
        evidence_html = f"<details open><summary>Classifier evidence</summary><ul>{evidence}</ul></details>" if evidence else ""
        provider_badge=''
        if item.provider_id:
            provider_badge=f' · {html.escape(item.provider or "metadata")}:{html.escape(item.provider_id)}'
        detected=item.media_kind
        checked_kind = 'tv' if detected == 'tv' else 'movie' if detected == 'movie' else 'music' if detected in {'music','audio'} else 'home' if detected=='home-video' else ''
        def checked(k: str) -> str: return ' checked' if checked_kind == k else ''
        metadata_results_html=''
        if search_item == item.id:
            rows=[]
            for result in search_results:
                rtitle=html.escape(str(result.get('title') or ''))
                ryear=html.escape(str(result.get('year') or ''))
                rkind=str(result.get('kind') or '')
                provider=html.escape(str(result.get('provider') or ''))
                provider_id=html.escape(str(result.get('provider_id') or ''))
                src=html.escape(str(result.get('source') or ''))
                overview=html.escape(str(result.get('overview') or ''))
