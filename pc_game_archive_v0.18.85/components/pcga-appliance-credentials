#!/usr/bin/env bash
set -Eeuo pipefail
SECRETS=/etc/pc-game-archive/secrets
CREDS="$SECRETS/appliance-admin.env"
ROMM_LEGACY="$SECRETS/romm-bootstrap.env"
LAN_LEGACY="$SECRETS/lancommander-bootstrap.env"
install -d -m 0700 "$SECRETS"

valid_file(){ [[ -s "$1" ]] && grep -q '^PCGA_APPLIANCE_ADMIN_USER=' "$1" && grep -q '^PCGA_APPLIANCE_ADMIN_PASSWORD=' "$1"; }

if ! valid_file "$CREDS"; then
  user=pcga-admin
  email=pcga-admin@pcga.invalid
  pass=''
  # Preserve the already-managed RomM password during the v0.17.10 shared-credential migration
  # migration so RomM does not need a password reset merely to unify services.
  if [[ -s "$ROMM_LEGACY" ]]; then
    # shellcheck disable=SC1090
    . "$ROMM_LEGACY" || true
    if [[ "${PCGA_ROMM_ADMIN_USER:-}" == pcga-admin && -n "${PCGA_ROMM_ADMIN_PASSWORD:-}" ]]; then
      pass="$PCGA_ROMM_ADMIN_PASSWORD"
    fi
  fi
  if [[ -z "$pass" && -s "$LAN_LEGACY" ]]; then
    # shellcheck disable=SC1090
    . "$LAN_LEGACY" || true
    if [[ "${PCGA_LANCOMMANDER_ADMIN_USER:-}" == pcga-admin && -n "${PCGA_LANCOMMANDER_ADMIN_PASSWORD:-}" ]]; then
      pass="$PCGA_LANCOMMANDER_ADMIN_PASSWORD"
    fi
  fi
  if [[ -z "$pass" ]]; then
    pass="$(python3 - <<'PY'
import secrets,string
alphabet=string.ascii_letters+string.digits+'_-'
print(''.join(secrets.choice(alphabet) for _ in range(40)))
PY
)"
  fi
  umask 077
  cat >"$CREDS" <<EOF_CREDS
PCGA_APPLIANCE_ADMIN_USER=$user
PCGA_APPLIANCE_ADMIN_EMAIL=$email
PCGA_APPLIANCE_ADMIN_PASSWORD=$pass
EOF_CREDS
  chmod 0600 "$CREDS"
  chown root:root "$CREDS" 2>/dev/null || true
fi

# shellcheck disable=SC1090
. "$CREDS"
: "${PCGA_APPLIANCE_ADMIN_USER:?missing appliance username}"
: "${PCGA_APPLIANCE_ADMIN_EMAIL:?missing appliance email}"
: "${PCGA_APPLIANCE_ADMIN_PASSWORD:?missing appliance password}"

# Keep the legacy per-service files as generated compatibility mirrors. They are
# not independent credentials anymore; appliance-admin.env is the source of truth.
umask 077
cat >"$ROMM_LEGACY" <<EOF_ROMM
PCGA_ROMM_ADMIN_USER=$PCGA_APPLIANCE_ADMIN_USER
PCGA_ROMM_ADMIN_PASSWORD=$PCGA_APPLIANCE_ADMIN_PASSWORD
EOF_ROMM
cat >"$LAN_LEGACY" <<EOF_LAN
PCGA_LANCOMMANDER_ADMIN_USER=$PCGA_APPLIANCE_ADMIN_USER
PCGA_LANCOMMANDER_ADMIN_PASSWORD=$PCGA_APPLIANCE_ADMIN_PASSWORD
EOF_LAN
chmod 0600 "$ROMM_LEGACY" "$LAN_LEGACY"
chown root:root "$ROMM_LEGACY" "$LAN_LEGACY" 2>/dev/null || true
