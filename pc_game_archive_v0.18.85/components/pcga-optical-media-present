#!/usr/bin/env python3
import argparse
import errno
import fcntl
import os
import subprocess
import sys
from pathlib import Path

CDROM_DRIVE_STATUS = 0x5326
CDSL_CURRENT = 0x7FFFFFFF
STATUS = {
    0: "no_info",
    1: "no_disc",
    2: "tray_open",
    3: "drive_not_ready",
    4: "disc_ok",
}


def normalize(value: str) -> str:
    if value.startswith("/dev/"):
        return value
    return "/dev/" + value.removeprefix("/dev/")


def ioctl_status(dev: str):
    flags = os.O_RDONLY | os.O_NONBLOCK
    fd = os.open(dev, flags)
    try:
        result = fcntl.ioctl(fd, CDROM_DRIVE_STATUS, CDSL_CURRENT)
        return int(result), None
    finally:
        os.close(fd)


def udev_has_media(dev: str) -> bool:
    try:
        p = subprocess.run(
            ["udevadm", "info", "--query=property", f"--name={dev}"],
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        )
    except Exception:
        return False
    props = set(line.strip() for line in p.stdout.splitlines())
    return "ID_CDROM_MEDIA=1" in props and "ID_CDROM_MEDIA_STATE=blank" not in props


def scsi_generic_for(dev: str):
    name = Path(dev).name
    base = Path("/sys/class/block") / name / "device" / "scsi_generic"
    try:
        entries = sorted(base.iterdir())
    except OSError:
        return None
    for entry in entries:
        p = Path("/dev") / entry.name
        if p.exists():
            return str(p)
    return None


def sg_ready(dev: str) -> bool:
    sg = scsi_generic_for(dev)
    if not sg:
        return False
    try:
        p = subprocess.run(
            ["sg_turs", sg],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=8,
            check=False,
        )
    except Exception:
        return False
    return p.returncode == 0


def main() -> int:
    ap = argparse.ArgumentParser(description="Authoritative optical-media presence probe")
    ap.add_argument("--status", action="store_true", help="print symbolic drive status")
    ap.add_argument("device")
    args = ap.parse_args()

    dev = normalize(args.device)
    if not Path(dev).exists():
        if args.status:
            print("missing")
        return 1

    # The Linux CDROM_DRIVE_STATUS ioctl is authoritative when supported.
    # It cleanly distinguishes DISC_OK from NO_DISC, TRAY_OPEN, and
    # DRIVE_NOT_READY. This avoids stale optical capacity values causing a
    # false insertion event.
    try:
        code, _ = ioctl_status(dev)
        symbolic = STATUS.get(code, f"unknown_{code}")
        if args.status:
            print(symbolic)
        return 0 if code == 4 else 1
    except OSError as exc:
        # Only fall back when the ioctl itself is unavailable. Do not treat
        # nonzero block-device capacity as proof of media; some optical drives
        # retain stale capacity after removal or while their tray is open.
        if exc.errno not in (errno.ENOTTY, errno.EINVAL, errno.ENOSYS, errno.EACCES, errno.EPERM):
            if args.status:
                print(f"ioctl_error_{exc.errno}")
            return 1

    if udev_has_media(dev):
        if args.status:
            print("disc_ok_udev")
        return 0

    if sg_ready(dev):
        if args.status:
            print("disc_ok_sg")
        return 0

    if args.status:
        print("no_disc_fallback")
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
