#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

STACK_DIR=/opt/pc-game-archive
STACK_ENV="$STACK_DIR/.env"
STATE_DIR=/var/lib/pc-game-archive/bootstrap
STATE_FILE="$STATE_DIR/network-identity.json"
SECURE_STATE="$STATE_DIR/secure-context.json"

log(){ printf '[pcga-network-identity] %s\n' "$*"; }
fail(){ printf '[pcga-network-identity:error] %s\n' "$*" >&2; exit 1; }

[[ ${EUID:-$(id -u)} -eq 0 ]] || exec sudo -E "$0" "$@"
[[ -d "$STACK_DIR" ]] || fail "PCGA stack directory is missing: $STACK_DIR"
[[ -x /usr/local/sbin/pcga-secure-context-bootstrap ]] || fail 'pcga-secure-context-bootstrap is not installed'

# The secure-context helper is authoritative for LAN-address discovery and the
# atomic .env update. Do not trust a persisted PCGA_LAN_IP here: that value is
# exactly what this boot-time reconciliation exists to repair after DHCP moves.
old_ip="$(awk -F= '$1=="PCGA_LAN_IP"{print substr($0,index($0,"=")+1)}' "$STACK_ENV" 2>/dev/null | tail -n1 || true)"
old_cert_fp="$(openssl x509 -in /etc/pc-game-archive/tls/pcga-server.crt -noout -fingerprint -sha256 2>/dev/null | sed 's/.*=//;s/://g' || true)"

PCGA_DISCOVER_LAN_IP=1 PCGA_REQUIRE_LIVE_LAN_IP=1 /usr/local/sbin/pcga-secure-context-bootstrap

# Keep the handoff independent of the script-wide IFS.  v0.18.36 emitted one
# space-delimited line here while IFS intentionally excluded spaces, causing
# `read` to assign e.g. "192.168.4.31 0 0" entirely to new_ip.  Emit one field
# per line and consume it with mapfile instead.
mapfile -t secure_identity_fields < <(python3 - "$SECURE_STATE" <<'PY'
import json,sys
try: d=json.load(open(sys.argv[1],encoding='utf-8'))
except Exception: d={}
print(str(d.get('lan_ip') or ''))
print('1' if d.get('certificate_reissued') else '0')
print('1' if d.get('lan_ip_changed') else '0')
PY
)
((${#secure_identity_fields[@]} >= 3)) || fail "Secure-context reconciliation returned an incomplete identity state"
new_ip="${secure_identity_fields[0]:-}"
cert_reissued="${secure_identity_fields[1]:-}"
lan_changed="${secure_identity_fields[2]:-}"
[[ "$new_ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail "Secure-context reconciliation did not produce a LAN IPv4 address (got '$new_ip')"
[[ "$cert_reissued" =~ ^[01]$ ]] || fail "Secure-context reconciliation returned an invalid certificate flag (got '$cert_reissued')"
[[ "$lan_changed" =~ ^[01]$ ]] || fail "Secure-context reconciliation returned an invalid LAN-change flag (got '$lan_changed')"
new_cert_fp="$(openssl x509 -in /etc/pc-game-archive/tls/pcga-server.crt -noout -fingerprint -sha256 2>/dev/null | sed 's/.*=//;s/://g' || true)"
[[ "$old_cert_fp" != "$new_cert_fp" ]] && cert_reissued=1
[[ "$old_ip" != "$new_ip" ]] && lan_changed=1

# A running TLS server keeps its certificate in memory. Docker's restart policy
# may have brought these containers up before network-online.target, so reload
# the portal certificate and recreate Moonlight lanes only when identity changed.
if [[ "$cert_reissued" == 1 ]] && command -v docker >/dev/null 2>&1; then
  if [[ "$(docker inspect -f '{{.State.Running}}' pcga-status 2>/dev/null || true)" == true ]]; then
    log 'Reloading the secure portal after appliance certificate refresh'
    docker restart pcga-status >/dev/null || fail 'Unable to reload pcga-status after certificate refresh'
  fi
fi

if [[ "$lan_changed" == 1 || "$cert_reissued" == 1 ]] && command -v docker >/dev/null 2>&1 && [[ -f "$STACK_DIR/compose.moonlight-web.yml" ]]; then
  # Compose safely creates missing lanes and preserves each lane's persistent
  # Moonlight pairing volume while replacing only the container process/config.
  services=(moonlight-web moonlight-web-2 moonlight-web-3 moonlight-web-4)
  log "Recreating browser streaming lanes for LAN identity ${new_ip}"
  (cd "$STACK_DIR" && docker compose -f compose.moonlight-web.yml up -d --no-deps --force-recreate "${services[@]}") \
    >/dev/null || fail 'Unable to recreate Moonlight Web lanes with the current DHCP address'
fi

# If this helper is run manually after boot, refresh the LAN DNS daemon too. On
# normal startup it has an explicit After= dependency and has not started yet.
if [[ "$lan_changed" == 1 ]] && systemctl is-active --quiet pcga-lan-dns.service 2>/dev/null; then
  log 'Restarting PCGA LAN DNS for the new DHCP address'
  systemctl restart pcga-lan-dns.service || fail 'Unable to restart PCGA LAN DNS after address change'
fi

install -d -m 0755 "$STATE_DIR"
python3 - "$STATE_FILE" "$old_ip" "$new_ip" "$lan_changed" "$cert_reissued" "$old_cert_fp" "$new_cert_fp" <<'PY'
import datetime,json,sys,os
path,old_ip,new_ip,changed,reissued,old_fp,new_fp=sys.argv[1:]
data={
  'version':'0.18.85',
  'state':'ready',
  'previous_lan_ip':old_ip,
  'lan_ip':new_ip,
  'lan_ip_changed':changed=='1',
  'certificate_reissued':reissued=='1',
  'previous_server_certificate_sha256':old_fp,
  'server_certificate_sha256':new_fp,
  'updated_at':datetime.datetime.now(datetime.timezone.utc).isoformat(),
}
tmp=path+'.tmp'
with open(tmp,'w',encoding='utf-8') as f:
    json.dump(data,f,indent=2,sort_keys=True); f.write('\n')
os.chmod(tmp,0o644); os.replace(tmp,path)
PY

if [[ "$lan_changed" == 1 ]]; then
  log "DHCP/LAN identity changed: ${old_ip:-<unset>} -> ${new_ip}; runtime environment and TLS identity reconciled"
else
  log "LAN identity is current: ${new_ip}"
fi
