#!/usr/bin/env python3
from __future__ import annotations
import argparse,csv,datetime as dt,json,os,re,subprocess,uuid
from pathlib import Path

STATE=Path('/var/lib/pc-game-archive/media-intake')
ITEMS=STATE/'items'; DISCS=STATE/'discs'; COLLECTIONS=STATE/'collections'
DISC_RE=re.compile(r'(?i)(?:^|[ _\-.])(?:disc|disk|dvd|bd|blu[ -]?ray)[ _\-.]*(\d+)(?:[ _\-.]*(?:of|/)[ _\-.]*(\d+))?(?:$|[ _\-.])')
SEASON_RE=re.compile(r'(?i)(?:^|[ _\-.])(?:season|s)[ _\-.]*(\d{1,2})(?:$|[ _\-.])')
COLLECTION_WORDS=('collection','anthology','double feature','triple feature','box set','boxed set','movie pack','film pack')
GENERIC_TITLE_NAMES={'title','main title','feature','feature film','video','dvd','blu ray','bluray'}

def run(cmd,timeout=90):
    try:return subprocess.run(cmd,text=True,capture_output=True,timeout=timeout,check=False)
    except Exception:return None

def norm(v:str)->str:
    v=str(v or '').replace('_',' ').casefold()
    v=DISC_RE.sub(' ', ' '+v+' ');v=SEASON_RE.sub(' ',v)
    v=re.sub(r'[^a-z0-9]+',' ',v);return ' '.join(v.split())

def titlecase(v:str)->str:
    v=str(v or '').replace('_',' ').strip();v=DISC_RE.sub(' ',' '+v+' ');v=re.sub(r'\s+',' ',v).strip(' -_.')
    return v.title() if v and v.upper()==v else v

def parse_disc(*vals):
    for v in vals:
        m=DISC_RE.search(' '+str(v or '')+' ')
        if m:return int(m.group(1)),int(m.group(2)) if m.group(2) else None
    return None,None

def parse_season(*vals):
    for v in vals:
        m=SEASON_RE.search(' '+str(v or '')+' ')
        if m:return int(m.group(1))
    return None

def save(path:Path,data):
    path.parent.mkdir(parents=True,exist_ok=True);tmp=path.with_suffix(path.suffix+'.tmp');tmp.write_text(json.dumps(data,indent=2,sort_keys=True)+'\n');os.replace(tmp,path)

def load_dir(path:Path):
    out=[]
    for p in path.glob('*.json') if path.exists() else []:
        try:
            d=json.loads(p.read_text());
            if isinstance(d,dict):out.append(d)
        except Exception:pass
    return out

def parse_hms(v:str):
    m=re.fullmatch(r'\s*(\d+):(\d{2}):(\d{2})\s*',str(v or ''))
    return int(m.group(1))*3600+int(m.group(2))*60+int(m.group(3)) if m else None

def makemkv_titles(dev:str):
    if run(['docker','inspect','-f','{{.State.Running}}','arm-rippers'],8) is None:return [],'container-unavailable'
    cmd=['docker','exec','--user','arm','--workdir','/home/arm','arm-rippers','makemkvcon','--robot','--messages=-stdout','--progress=-stdout','--minlength=120','info',f'dev:{dev}']
    p=run(cmd,90)
    if not p:return [],'probe-unavailable'
    text=(p.stdout or '')+'\n'+(p.stderr or '')
    rows={}
    for line in text.splitlines():
        if not line.startswith('TINFO:'):continue
        try:
            fields=next(csv.reader([line[6:]])); idx=int(fields[0]); code=int(fields[1]); value=fields[3] if len(fields)>3 else ''
        except Exception:continue
        rows.setdefault(idx,{})[code]=value
    out=[]
    for idx,attrs in sorted(rows.items()):
        name=str(attrs.get(2) or '').strip(); dur=str(attrs.get(9) or '').strip(); secs=parse_hms(dur)
        try:size=int(str(attrs.get(10) or '0').replace(',',''))
        except ValueError:size=0
        try:chapters=int(attrs.get(8) or 0)
        except (ValueError,TypeError):chapters=0
        source=str(attrs.get(16) or '').strip()
        out.append({'index':idx,'name':name or None,'duration':dur or None,'duration_seconds':secs,'size_bytes':size,'chapters':chapters or None,'source_file':source or None})
    return out,('ok' if p.returncode==0 else f'exit-{p.returncode}')

def find_or_create_item(title,kind,items,now,season=None):
    key=norm(title)
    for x in items:
        if x.get('normalized_title')==key and str(x.get('kind'))==kind and (season is None or x.get('season')==season):return x,False
    iid=str(uuid.uuid4());rec={'schema':1,'id':iid,'kind':kind,'title':title or 'Unidentified Video','sort_title':title or 'Unidentified Video','normalized_title':key,'series':title if kind=='tv' else None,'season':season,'release_year':None,'edition':None,'publisher':None,'studio':None,'language':None,'region':None,'external_ids':{},'provisional':True,'created_at':now,'updated_at':now};items.append(rec);return rec,True

def find_or_create_collection(title,collections,now):
    key=norm(title)
    for x in collections:
        if x.get('normalized_title')==key and key:return x,False
    cid=str(uuid.uuid4());rec={'schema':1,'id':cid,'title':title or 'Unidentified Video Collection','sort_title':title or 'Unidentified Video Collection','normalized_title':key,'release_year':None,'edition':None,'publisher':None,'studio':None,'language':None,'region':None,'external_ids':{},'media_item_ids':[],'provisional':True,'created_at':now,'updated_at':now};collections.append(rec);return rec,True

def main():
    ap=argparse.ArgumentParser(description='Collect pre-rip movie/TV optical metadata and model multi-disc/multi-title releases')
    ap.add_argument('device');ap.add_argument('--probe',required=True);ap.add_argument('--record',action='store_true');args=ap.parse_args()
    dev=args.device if args.device.startswith('/dev/') else '/dev/'+args.device
    probe=json.load(open(args.probe));fp=str(probe.get('fingerprint') or '')
    if not fp:raise SystemExit('probe is missing fingerprint')
    fs=probe.get('filesystem') if isinstance(probe.get('filesystem'),dict) else {};label=str(fs.get('label') or '').strip()
    titles,probe_status=makemkv_titles(dev)
    substantial=[x for x in titles if int(x.get('duration_seconds') or 0)>=15*60]
    feature=[x for x in titles if int(x.get('duration_seconds') or 0)>=50*60]
    episodic=[x for x in titles if 15*60<=int(x.get('duration_seconds') or 0)<=75*60]
    disc_no,disc_count=parse_disc(label);season=parse_season(label)
    base=titlecase(label) or 'Unidentified Video'
    if season is not None:
        base=SEASON_RE.sub(' ',' '+base+' ');base=re.sub(r'\s+',' ',base).strip(' -_.') or 'Unidentified TV Series'
    now=dt.datetime.now(dt.timezone.utc).isoformat(timespec='seconds')
    items=load_dir(ITEMS);collections=load_dir(COLLECTIONS)
    old={};oldp=DISCS/f'{fp}.json'
    if oldp.is_file():
        try:old=json.loads(oldp.read_text())
        except Exception:old={}
    locked=(old.get('metadata_status')=='confirmed')
    layout=str(old.get('layout') or '') if locked else ''
    kind=str(old.get('kind') or '') if locked else ''
    if not kind:
        if season is not None and len(episodic)>=2:kind='tv'
        elif len(episodic)>=3 and not feature:kind='tv'
        else:kind='movie'
    if not layout:
        if kind=='tv' and (season is not None or len(episodic)>=3):layout='tv-season-disc'
        elif disc_no is not None:layout='multi-disc-title'
        elif len(feature)>=2:layout='multi-title-candidate'
        else:layout='single-title'
    collection_hint=any(w in label.casefold().replace('_',' ') for w in COLLECTION_WORDS)
    contents=[];created=[];collection=None
    if locked and isinstance(old.get('contents'),list):
        contents=old['contents']
    else:
        distinct=[]
        for t in substantial:
            n=titlecase(t.get('name') or '')
            if not n or norm(n) in GENERIC_TITLE_NAMES or norm(n)==norm(base):continue
            if norm(n) not in {norm(x) for x in distinct}:distinct.append(n)
        if collection_hint and len(distinct)>=2:
            layout='multi-title';collection,_=find_or_create_collection(base,collections,now)
            for idx,n in enumerate(distinct):
                item,new=find_or_create_item(n,'movie',items,now)
                if new:created.append(item['id'])
                indexes=[x['index'] for x in substantial if norm(x.get('name') or '')==norm(n)]
                contents.append({'media_item_id':item['id'],'title':item['title'],'kind':'movie','source_title_indexes':indexes,'role':'feature','status':'provisional'})
        else:
            item,new=find_or_create_item(base,kind,items,now,season)
            if new:created.append(item['id'])
            role='episodes' if kind=='tv' else 'feature'
            indexes=[x['index'] for x in (episodic if kind=='tv' else substantial)]
            contents=[{'media_item_id':item['id'],'title':item['title'],'kind':kind,'season':season,'source_title_indexes':indexes,'role':role,'status':'provisional'}]
            if collection_hint:
                collection,_=find_or_create_collection(base,collections,now);layout='collection'
    if old.get('collection_id') and not collection:
        collection=next((x for x in collections if x.get('id')==old.get('collection_id')),None)
    ids=[]
    for c in contents:
        iid=str(c.get('media_item_id') or '')
        if iid and iid not in ids:ids.append(iid)
    rec=dict(old)
    rec.update({'schema':2,'fingerprint':fp,'device':dev,'layout':layout,'kind':kind,'collection_id':collection.get('id') if collection else old.get('collection_id'),'collection_title':collection.get('title') if collection else old.get('collection_title'),'media_item_ids':ids,'media_item_id':ids[0] if len(ids)==1 else None,'title':contents[0].get('title') if len(contents)==1 else (collection.get('title') if collection else base),'disc_number':old.get('disc_number') if locked else disc_no,'disc_count':old.get('disc_count') if locked else disc_count,'disc_role':old.get('disc_role') or ('season-disc' if kind=='tv' else 'feature-disc'),'volume_label':label or None,'filesystem_type':fs.get('type'),'title_table':titles,'title_probe_status':probe_status,'contents':contents,'metadata_status':old.get('metadata_status') or 'provisional','match':old.get('match') or {'method':'volume-label+title-table','confidence':0.88 if label else 0.62},'updated_at':now})
    rec.setdefault('created_at',now);rec['last_seen_at']=now
    if collection:
        mids=list(collection.get('media_item_ids') or [])
        for iid in ids:
            if iid not in mids:mids.append(iid)
        collection['media_item_ids']=mids;collection['updated_at']=now
    if args.record:
        for x in items:
            if x.get('id') in created or not (ITEMS/f"{x.get('id')}.json").exists():save(ITEMS/f"{x['id']}.json",x)
        if collection:save(COLLECTIONS/f"{collection['id']}.json",collection)
        save(DISCS/f'{fp}.json',rec)
    print(json.dumps(rec,indent=2,sort_keys=True))
if __name__=='__main__':main()
