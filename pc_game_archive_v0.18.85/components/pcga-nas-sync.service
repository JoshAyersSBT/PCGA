[Unit]
Description=PCGA NAS mirror/offload maintenance
Wants=pcga-nas-mount.service
After=network-online.target pcga-nas-mount.service
ConditionPathExists=/etc/pc-game-archive/appliance.json

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/pcga-nas-storage scheduled
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=infinity
