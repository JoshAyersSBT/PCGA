#!/usr/bin/env python3
from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import sqlite3
import stat
import subprocess
import sys
import time
import uuid
from collections import defaultdict
from dataclasses import dataclass
from pathlib import Path
from typing import Iterable

VERSION = "0.15.0"
DEFAULT_MIN_SIZE = 16 * 1024 * 1024
SAMPLE_SIZE = 1024 * 1024
STATE_DIR = Path("/var/lib/pc-game-archive/dedupe")
DB_PATH = STATE_DIR / "index.sqlite3"
REPORT_PATH = STATE_DIR / "last-report.json"

MEDIA_EXTS = {
    ".mkv", ".mp4", ".m4v", ".avi", ".mov", ".mpg", ".mpeg", ".ts", ".m2ts", ".vob",
    ".webm", ".wmv", ".flv", ".iso", ".img", ".bin",
    ".flac", ".mp3", ".m4a", ".aac", ".ogg", ".opus", ".wav", ".wma", ".ape", ".wv", ".mka",
}
SKIP_SUFFIXES = {".part", ".partial", ".tmp", ".download", ".crdownload"}


@dataclass(frozen=True)
class FileRec:
    path: Path
    dev: int
    ino: int
    size: int
    mtime_ns: int
    uid: int
    gid: int
    mode: int
    blocks: int
    area: str

    @property
    def identity(self) -> tuple[int, int]:
        return (self.dev, self.ino)


AREA_PRIORITY = {
    "library": 0,
    "metadata-pending": 1,
    "completed": 2,
    "quarantine": 3,
    "transcode": 4,
    "raw": 5,
    "arm-music": 6,
    "other": 9,
}


def archive_root() -> Path:
    override = os.environ.get("PCGA_ROOT_OVERRIDE")
    if override:
        return Path(override).resolve()
    p = Path("/etc/pc-game-archive/archive-root")
    if not p.is_file():
        raise SystemExit(f"missing {p}")
    root = Path(p.read_text().strip())
    if not root.is_absolute():
        raise SystemExit(f"invalid archive root: {root}")
    return root


def arm_active() -> bool:
    if os.environ.get("PCGA_DEDUPE_IGNORE_ARM") == "1":
        return False
    try:
        cp = subprocess.run(
            ["systemctl", "list-units", "--all", "--state=active,activating", "--plain", "--no-legend", "pcga-arm-rip@*.service"],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=3,
        )
        if "pcga-arm-rip@" in cp.stdout:
            return True
    except Exception:
        pass
    try:
        cp = subprocess.run(
            ["docker", "exec", "arm-rippers", "sh", "-lc", "ps -eo args | grep -q '[p]ython3 /opt/arm/arm/ripper/main.py'"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3,
        )
        return cp.returncode == 0
    except Exception:
        return False


def classify_area(root: Path, p: Path) -> str:
    checks = [
        (root / "media/library", "library"),
        (root / "media/metadata-pending", "metadata-pending"),
        (root / "media/arm/work/completed", "completed"),
        (root / "media/quarantine", "quarantine"),
        (root / "media/arm/work/transcode", "transcode"),
        (root / "media/arm/work/raw", "raw"),
        (root / "media/arm/music", "arm-music"),
    ]
    for base, name in checks:
        try:
            p.relative_to(base)
            return name
        except ValueError:
            pass
    return "other"


def scan_roots(root: Path, active: bool) -> list[Path]:
    roots = [
        root / "media/library",
        root / "media/metadata-pending",
        root / "media/quarantine",
        root / "media/arm/music",
    ]
    if not active:
        roots += [
            root / "media/arm/work/completed",
            root / "media/arm/work/transcode",
            root / "media/arm/work/raw",
        ]
    for raw in os.environ.get("PCGA_DEDUPE_EXTRA_ROOTS", "").split(":"):
        raw = raw.strip()
        if not raw:
            continue
        p = Path(raw)
        if p.is_absolute():
            roots.append(p)
    out=[]
    seen=set()
    for p in roots:
        sp=str(p)
        if p.exists() and sp not in seen:
            out.append(p); seen.add(sp)
    return out


def eligible(path: Path, st: os.stat_result, min_size: int) -> bool:
    if not stat.S_ISREG(st.st_mode):
        return False
    if st.st_size < min_size:
        return False
    name = path.name.lower()
    if any(name.endswith(s) for s in SKIP_SUFFIXES):
        return False
    return path.suffix.lower() in MEDIA_EXTS


def iter_files(root: Path, roots: list[Path], min_size: int) -> Iterable[FileRec]:
    seen_paths: set[str] = set()
    for base in roots:
        for dirpath, dirnames, filenames in os.walk(base, followlinks=False):
            dirnames[:] = [d for d in dirnames if not d.startswith(".pcga-dedupe-")]
            for name in filenames:
                p = Path(dirpath) / name
                sp = str(p)
                if sp in seen_paths:
                    continue
                seen_paths.add(sp)
                try:
                    st = p.stat(follow_symlinks=False)
                except (FileNotFoundError, PermissionError, OSError):
                    continue
                if not eligible(p, st, min_size):
                    continue
                yield FileRec(
                    path=p, dev=st.st_dev, ino=st.st_ino, size=st.st_size, mtime_ns=st.st_mtime_ns,
                    uid=st.st_uid, gid=st.st_gid, mode=stat.S_IMODE(st.st_mode), blocks=getattr(st, "st_blocks", 0),
                    area=classify_area(root, p),
                )


def open_db(path: Path) -> sqlite3.Connection:
    path.parent.mkdir(parents=True, exist_ok=True)
    db = sqlite3.connect(path)
    db.execute("""
        CREATE TABLE IF NOT EXISTS hashes(
          path TEXT PRIMARY KEY,
          dev INTEGER NOT NULL,
          ino INTEGER NOT NULL,
          size INTEGER NOT NULL,
          mtime_ns INTEGER NOT NULL,
          sample TEXT,
          sha256 TEXT,
          last_seen INTEGER NOT NULL
        )
    """)
    return db


def cached_hash(db: sqlite3.Connection, rec: FileRec, full: bool) -> str:
    row = db.execute(
        "SELECT dev,ino,size,mtime_ns,sample,sha256 FROM hashes WHERE path=?", (str(rec.path),)
    ).fetchone()
    now = int(time.time())
    if row and tuple(row[:4]) == (rec.dev, rec.ino, rec.size, rec.mtime_ns):
        value = row[5] if full else row[4]
        if value:
            db.execute("UPDATE hashes SET last_seen=? WHERE path=?", (now, str(rec.path)))
            return value
    h = hashlib.sha256()
    with rec.path.open("rb", buffering=0) as f:
        if full:
            while True:
                b = f.read(8 * 1024 * 1024)
                if not b:
                    break
                h.update(b)
        else:
            h.update(rec.size.to_bytes(8, "little", signed=False))
            offsets = [0]
            if rec.size > 2 * SAMPLE_SIZE:
                offsets.append(max(0, rec.size // 2 - SAMPLE_SIZE // 2))
            if rec.size > SAMPLE_SIZE:
                offsets.append(max(0, rec.size - SAMPLE_SIZE))
            for off in sorted(set(offsets)):
                f.seek(off)
                h.update(f.read(SAMPLE_SIZE))
    value = h.hexdigest()
    sample = value if not full else (row[4] if row and tuple(row[:4]) == (rec.dev, rec.ino, rec.size, rec.mtime_ns) else None)
    sha = value if full else (row[5] if row and tuple(row[:4]) == (rec.dev, rec.ino, rec.size, rec.mtime_ns) else None)
    db.execute(
        "INSERT INTO hashes(path,dev,ino,size,mtime_ns,sample,sha256,last_seen) VALUES(?,?,?,?,?,?,?,?) "
        "ON CONFLICT(path) DO UPDATE SET dev=excluded.dev,ino=excluded.ino,size=excluded.size,mtime_ns=excluded.mtime_ns,sample=excluded.sample,sha256=excluded.sha256,last_seen=excluded.last_seen",
        (str(rec.path), rec.dev, rec.ino, rec.size, rec.mtime_ns, sample, sha, now),
    )
    return value


def same_xattrs(a: Path, b: Path) -> bool:
    try:
        names = set(os.listxattr(a, follow_symlinks=False)) | set(os.listxattr(b, follow_symlinks=False))
    except (AttributeError, OSError):
        return True
    for n in names:
        try:
            va = os.getxattr(a, n, follow_symlinks=False)
        except OSError:
            va = None
        try:
            vb = os.getxattr(b, n, follow_symlinks=False)
        except OSError:
            vb = None
        if va != vb:
            return False
    return True


def canonical_key(r: FileRec) -> tuple:
    return (AREA_PRIORITY.get(r.area, 9), str(r.path).lower())


def replace_with_hardlink(canon: FileRec, dup: FileRec) -> tuple[bool, str]:
    try:
        cs = canon.path.stat(follow_symlinks=False)
        ds = dup.path.stat(follow_symlinks=False)
    except OSError as exc:
        return False, f"stat failed: {exc}"
    if cs.st_dev != canon.dev or cs.st_ino != canon.ino or cs.st_size != canon.size or cs.st_mtime_ns != canon.mtime_ns:
        return False, "canonical changed during scan"
    if ds.st_dev != dup.dev or ds.st_ino != dup.ino or ds.st_size != dup.size or ds.st_mtime_ns != dup.mtime_ns:
        return False, "duplicate changed during scan"
    if (cs.st_uid, cs.st_gid, stat.S_IMODE(cs.st_mode)) != (ds.st_uid, ds.st_gid, stat.S_IMODE(ds.st_mode)):
        return False, "owner/mode differs"
    if not same_xattrs(canon.path, dup.path):
        return False, "extended attributes differ"
    tmp = dup.path.with_name(f".pcga-dedupe-{os.getpid()}-{uuid.uuid4().hex}.tmp")
    try:
        os.link(canon.path, tmp)
        os.replace(tmp, dup.path)
        try:
            dfd = os.open(dup.path.parent, os.O_DIRECTORY)
            try:
                os.fsync(dfd)
            finally:
                os.close(dfd)
        except OSError:
            pass
        return True, "hardlinked"
    except OSError as exc:
        try:
            tmp.unlink(missing_ok=True)
        except Exception:
            pass
        return False, str(exc)


def human(n: int) -> str:
    units = ["B", "KiB", "MiB", "GiB", "TiB"]
    x = float(n)
    for u in units:
        if x < 1024 or u == units[-1]:
            return f"{x:.1f} {u}" if u != "B" else f"{int(x)} B"
        x /= 1024
    return f"{n} B"


def analyze(root: Path, min_size: int, include_library_duplicates: bool, apply: bool) -> dict:
    active = arm_active()
    roots = scan_roots(root, active)
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    db = open_db(DB_PATH if not os.environ.get("PCGA_ROOT_OVERRIDE") else root / ".pcga-dedupe-test.sqlite3")
    try:
        records = list(iter_files(root, roots, min_size))
        by_size: dict[int, list[FileRec]] = defaultdict(list)
        for r in records:
            by_size[r.size].append(r)

        sample_groups: dict[tuple[int, str], list[FileRec]] = defaultdict(list)
        for size, group in by_size.items():
            if len(group) < 2:
                continue
            for r in group:
                try:
                    sample_groups[(size, cached_hash(db, r, False))].append(r)
                except (FileNotFoundError, PermissionError, OSError):
                    continue
        db.commit()

        full_groups: dict[tuple[int, str], list[FileRec]] = defaultdict(list)
        for (size, _), group in sample_groups.items():
            if len(group) < 2:
                continue
            for r in group:
                try:
                    full_groups[(size, cached_hash(db, r, True))].append(r)
                except (FileNotFoundError, PermissionError, OSError):
                    continue
        db.commit()

        groups_out = []
        reclaimable = 0
        reclaimed = 0
        changed = 0
        skipped = []
        for (size, digest), group in sorted(full_groups.items(), key=lambda kv: (-kv[0][0], kv[0][1])):
            # Collapse paths that are already aliases of the same inode.
            unique_inodes: dict[tuple[int, int], list[FileRec]] = defaultdict(list)
            for r in group:
                unique_inodes[r.identity].append(r)
            if len(unique_inodes) < 2:
                continue
            ordered = sorted(group, key=canonical_key)
            canonical = ordered[0]
            entries = []
            for dup in ordered[1:]:
                if dup.identity == canonical.identity:
                    entries.append({"path": str(dup.path), "action": "already-hardlinked"})
                    continue
                if dup.dev != canonical.dev:
                    entries.append({"path": str(dup.path), "action": "cross-filesystem"})
                    continue
                # Scheduled/default runs do not merge two independent final library entries.
                if canonical.area == "library" and dup.area == "library" and not include_library_duplicates:
                    entries.append({"path": str(dup.path), "action": "library-duplicate-reported"})
                    continue
                if (canonical.uid, canonical.gid, canonical.mode) != (dup.uid, dup.gid, dup.mode):
                    entries.append({"path": str(dup.path), "action": "metadata-mismatch"})
                    continue
                possible = dup.blocks * 512 if dup.blocks else dup.size
                reclaimable += possible
                if apply:
                    ok, reason = replace_with_hardlink(canonical, dup)
                    if ok:
                        changed += 1
                        reclaimed += possible
                        entries.append({"path": str(dup.path), "action": "hardlinked", "reclaimed_bytes": possible})
                    else:
                        skipped.append({"path": str(dup.path), "reason": reason})
                        entries.append({"path": str(dup.path), "action": "skipped", "reason": reason})
                else:
                    entries.append({"path": str(dup.path), "action": "would-hardlink", "reclaim_bytes": possible})
            if entries:
                groups_out.append({
                    "size": size, "sha256": digest, "canonical": str(canonical.path), "canonical_area": canonical.area,
                    "duplicates": entries,
                })
        report = {
            "version": VERSION,
            "timestamp": int(time.time()),
            "mode": "run" if apply else "audit",
            "archive_root": str(root),
            "arm_active": active,
            "scanned_roots": [str(p) for p in roots],
            "min_size": min_size,
            "files_scanned": len(records),
            "duplicate_groups": len(groups_out),
            "reclaimable_bytes": reclaimable,
            "reclaimed_bytes": reclaimed,
            "paths_hardlinked": changed,
            "groups": groups_out,
            "skipped": skipped,
        }
        report_path = REPORT_PATH if not os.environ.get("PCGA_ROOT_OVERRIDE") else root / ".pcga-dedupe-report.json"
        report_path.parent.mkdir(parents=True, exist_ok=True)
        report_path.write_text(json.dumps(report, indent=2) + "\n")
        # Prune cache entries not seen for 30d.
        db.execute("DELETE FROM hashes WHERE last_seen < ?", (int(time.time()) - 30 * 86400,))
        db.commit()
        return report
    finally:
        db.close()


def print_report(report: dict, verbose: bool = False) -> None:
    print(f"PCGA dedupe {report['mode']} v{report['version']}  ARM_active={'yes' if report['arm_active'] else 'no'}")
    print(f"Scanned {report['files_scanned']} media file(s); {report['duplicate_groups']} duplicate group(s)")
    if report["mode"] == "audit":
        print(f"Potential same-filesystem reclaim: {human(report['reclaimable_bytes'])}")
    else:
        print(f"Reclaimed: {human(report['reclaimed_bytes'])} across {report['paths_hardlinked']} path(s)")
    if report["arm_active"]:
        print("NOTE: ARM is active; raw/transcode/completed staging was excluded from this pass.")
    if verbose:
        for g in report["groups"]:
            print(f"\n{human(g['size'])}  {g['sha256'][:16]}…")
            print(f"  keep: {g['canonical']}")
            for d in g["duplicates"]:
                suffix = ""
                if d.get("reclaim_bytes") is not None:
                    suffix = f" ({human(d['reclaim_bytes'])})"
                if d.get("reclaimed_bytes") is not None:
                    suffix = f" ({human(d['reclaimed_bytes'])})"
                print(f"  {d['action']}: {d['path']}{suffix}")
    if report.get("skipped"):
        print(f"Skipped {len(report['skipped'])} path(s) that changed or had incompatible metadata.")


def parse_size(s: str) -> int:
    s = s.strip().lower()
    mult = 1
    for suffix, factor in (("tib", 1024**4), ("tb", 1000**4), ("gib", 1024**3), ("gb", 1000**3), ("mib", 1024**2), ("mb", 1000**2), ("kib", 1024), ("kb", 1000)):
        if s.endswith(suffix):
            mult = factor
            s = s[:-len(suffix)]
            break
    return int(float(s) * mult)


def main() -> int:
    ap = argparse.ArgumentParser(description="Audit and reclaim byte-identical media duplicates in PCGA-managed storage.")
    ap.add_argument("command", choices=["audit", "run"])
    ap.add_argument("--min-size", default=os.environ.get("PCGA_DEDUPE_MIN_SIZE", "16MiB"), help="minimum file size (default 16MiB)")
    ap.add_argument("--include-library-duplicates", action="store_true", help="also hardlink exact duplicates between two final library paths")
    ap.add_argument("--verbose", "-v", action="store_true")
    ap.add_argument("--scheduled", action="store_true", help=argparse.SUPPRESS)
    ns = ap.parse_args()
    lock_path = Path("/run/pcga-dedupe.lock")
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    with lock_path.open("w") as lock:
        try:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            if ns.scheduled:
                print("PCGA dedupe already running; scheduled pass skipped.")
                return 0
            print("Another PCGA dedupe pass is already running.", file=sys.stderr)
            return 75
        root = archive_root()
        min_size = parse_size(ns.min_size)
        include_library_duplicates = ns.include_library_duplicates or os.environ.get("PCGA_DEDUPE_LIBRARY_DUPLICATES", "0").strip().lower() in {"1", "yes", "true", "on"}
        report = analyze(root, min_size, include_library_duplicates, ns.command == "run")
        print_report(report, verbose=ns.verbose or not ns.scheduled)
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
