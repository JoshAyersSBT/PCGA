[Unit]
Description=PCGA LAN DNS alias (pcga.portal)
Wants=network-online.target pcga-network-identity.service
After=network-online.target pcga-network-identity.service avahi-daemon.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/pcga-lan-dns serve
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/run/pcga-lan-dns /var/lib/pc-game-archive/lan-dns /etc/avahi /etc/pc-game-archive /etc/hosts

[Install]
WantedBy=multi-user.target
