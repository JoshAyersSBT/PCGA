#!/usr/bin/env bash
set -Eeuo pipefail
name="${1#/dev/}"; dev="/dev/$name"
allowed=/etc/pc-game-archive/media-drives
state="/var/lib/pc-game-archive/optical-dispatch/${name}.json"
[[ -r "$allowed" ]] || exit 0
grep -Fxq "$dev" "$allowed" || exit 0
[[ -b "$dev" ]] || exit 0
exec 9>"/run/pcga-optical-${name}.lock"; flock -n 9 || exit 0
for _ in $(seq 1 60); do /usr/local/sbin/pcga-optical-media-present "$dev" && break; sleep 1; done
/usr/local/sbin/pcga-optical-media-present "$dev" || exit 75
probe="$(mktemp)"; trap 'rm -f "$probe"; [[ -n "${mnt:-}" ]] && umount "$mnt" >/dev/null 2>&1 || true; [[ -n "${mnt:-}" ]] && rmdir "$mnt" >/dev/null 2>&1 || true' EXIT
/usr/local/sbin/pcga-optical-identify "$dev" > "$probe" || exit 75
route="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("route",""))' "$probe")"
[[ "$route" == pc-data || "$route" == pc-mixed ]] || { logger -t PCGA-PCDISC "Refusing $dev because dispatcher classified route=$route"; exit 0; }
/usr/local/sbin/pcga-optical-health --host-only --quiet "$dev" || exit 74
ROOT="$(cat /etc/pc-game-archive/archive-root)"; [[ -n "$ROOT" && "$ROOT" = /* ]] || exit 70
stamp="$(date +%Y%m%d-%H%M%S)"
label="$(python3 -c 'import json,sys; print((json.load(open(sys.argv[1])).get("filesystem") or {}).get("label") or "PC-Data-Disc")' "$probe")"
safe="$(printf '%s' "$label" | sed -E 's#[/\\]#-#g;s/[^[:alnum:]. _()+-]+/_/g;s/^ +| +$//g')"; [[ -n "$safe" ]] || safe="PC-Data-Disc"
work="$ROOT/ingest/optical-work/${stamp}-${name}-${safe}"; final="$ROOT/media/metadata-pending/${stamp}-${safe}"
mkdir -p "$work" "$(dirname "$final")"
cp "$probe" "$work/.pcga-optical.json"; printf '%s\n' 'optical-data-disc' > "$work/.pcga-source-hint"
fp="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("fingerprint",""))' "$probe")"
meta="/var/lib/pc-game-archive/game-intake/discs/${fp}.json"
[[ -n "$fp" && -r "$meta" ]] && cp "$meta" "$work/.pcga-game.json"
expected="$(blockdev --getsize64 "$dev" 2>/dev/null || echo 0)"
state_update(){
  local status="$1" operation="$2" out="${3:-}" final_path="${4:-}"
  python3 - "$state" "$status" "$operation" "$out" "$expected" "$work" "$final_path" <<'PY'
import datetime,json,os,sys
p=sys.argv[1]
try:d=json.load(open(p))
except Exception:d={}
status,op,out,expected,work,final=sys.argv[2:8]
try:expected=int(expected)
except:expected=0
size=0
if out:
    try:size=os.path.getsize(out)
    except OSError:pass
pct=None
if expected>0 and size>=0:pct=max(0.0,min(99.9 if status in {'ripping','retrying'} else 100.0,100.0*size/expected))
phase={
    'ripping':'pc-disc-imaging',
    'retrying':'pc-disc-imaging',
    'verifying':'pc-disc-verifying',
    'complete':'preserved',
    'failed':'failed',
}.get(status,'pc-disc-processing')
d.update({'present':True,'dispatch_status':status,'phase':phase,'operation':op,'expected_bytes':expected,'output_bytes':size,'progress_percent':pct,'work_path':work,'updated_at':datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='seconds')})
if final:d['final_path']=final
if status=='ripping' and not d.get('started_at'):d['started_at']=d['updated_at']
if status=='complete':
    d['completed_at']=d['updated_at'];d['preserved_at']=d['updated_at'];d['progress_percent']=100.0
open(p,'w').write(json.dumps(d,indent=2,sort_keys=True)+'\n')
PY
}
run_monitored(){
  local output="$1" operation="$2"; shift 2
  "$@" & local pid=$!
  while kill -0 "$pid" 2>/dev/null; do state_update ripping "$operation" "$output"; sleep 2; done
  wait "$pid"
}
state_update ripping "Preparing PC/data-disc preservation"
if [[ "$route" == pc-mixed ]]; then
  command -v cdrdao >/dev/null 2>&1 || { logger -t PCGA-PCDISC 'cdrdao missing'; exit 75; }
  logger -t PCGA-PCDISC "Preserving mixed-mode PC/data CD from $dev as raw BIN/TOC"
  run_monitored "$work/disc.bin" "Reading mixed-mode disc as BIN/TOC" cdrdao read-cd --read-raw --device "$dev" --datafile "$work/disc.bin" "$work/disc.toc"
  command -v toc2cue >/dev/null 2>&1 && toc2cue "$work/disc.toc" "$work/disc.cue" >/dev/null 2>&1 || true
else
  command -v ddrescue >/dev/null 2>&1 || { logger -t PCGA-PCDISC 'GNU ddrescue missing'; exit 75; }
  bytes="$expected"; free="$(df -B1 --output=avail "$ROOT/ingest/optical-work" | tail -n1 | tr -d '[:space:]')"; reserve=$((2*1024*1024*1024))
  if [[ "$bytes" =~ ^[0-9]+$ && "$free" =~ ^[0-9]+$ && $bytes -gt 0 && $free -lt $((bytes+reserve)) ]]; then logger -t PCGA-PCDISC "Insufficient free space for $dev"; exit 73; fi
  logger -t PCGA-PCDISC "Preserving data disc from $dev as lossless ISO image"
  set +e
  run_monitored "$work/disc.iso" "Creating lossless ISO image" ddrescue -b 2048 -f -n "$dev" "$work/disc.iso" "$work/disc.map"; first_rc=$?
  state_update retrying "Retrying unreadable sectors" "$work/disc.iso"
  run_monitored "$work/disc.iso" "Retrying unreadable sectors" ddrescue -b 2048 -f -r2 "$dev" "$work/disc.iso" "$work/disc.map"; retry_rc=$?
  set -e
  if [[ $retry_rc -ne 0 ]]; then
    state_update failed "Disc imaging ended with unreadable sectors" "$work/disc.iso"
    logger -t PCGA-PCDISC "ddrescue could not complete $dev after retries (first=$first_rc final=$retry_rc); partial image retained in $work"
    exit 74
  fi
fi
state_update verifying "Verifying preservation checksums" "${work}/disc.iso"
(
  cd "$work"
  find . -maxdepth 1 -type f ! -name SHA256SUMS ! -name '*.map' -print0 | sort -z | xargs -0 -r sha256sum > SHA256SUMS
)
# Preserve a bounded directory index for classification/diagnostics without duplicating the disc payload.
mnt="$(mktemp -d /run/pcga-pcdisc-mount.XXXXXX)"
if mount -o ro,nosuid,nodev,noexec "$dev" "$mnt" 2>/dev/null; then
  python3 - "$mnt" "$work/.pcga-file-index.json" <<'PY'
import json,os,sys
from pathlib import Path
root=Path(sys.argv[1]); rows=[]
for base,dirs,files in os.walk(root):
    p=Path(base)
    try: depth=len(p.relative_to(root).parts)
    except ValueError: continue
    if depth>=4: dirs[:]=[]
    for name in files:
        q=p/name
        try: rows.append({'path':q.relative_to(root).as_posix(),'size':q.stat().st_size})
        except OSError: pass
        if len(rows)>=2000: break
    if len(rows)>=2000: break
Path(sys.argv[2]).write_text(json.dumps({'schema':1,'files':rows},indent=2)+'\n')
PY
  umount "$mnt" || true; rmdir "$mnt" || true; mnt=""
fi
# Re-copy the fingerprint-keyed record at commit time so any metadata correction
# made while the image was being read follows the preservation artifact.
[[ -n "$fp" && -r "$meta" ]] && cp "$meta" "$work/.pcga-game.json"
n=0; dest="$final"; while [[ -e "$dest" ]]; do n=$((n+1)); dest="${final}-${n}"; done
mv "$work" "$dest"
state_update complete "PC/data disc preserved and queued for classification" "" "$dest"
logger -t PCGA-PCDISC "PC/data disc preserved from $dev -> $dest; queued for classification"
systemctl --no-block start pcga-metadata-classify.service >/dev/null 2>&1 || true
