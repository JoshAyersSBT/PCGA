#!/usr/bin/env bash
set -Eeuo pipefail

# PCGA CDEmu/VHBA host bootstrap.
# Normal service starts are network-free.  --repair is used by the versioned
# upgrader and may fetch the pinned current upstream VHBA source if the distro
# DKMS package cannot provide a module for the running kernel.

MODE="${1:-}"
KERNEL="$(uname -r)"
VHBA_VERSION="20260313"
VHBA_SHA256="293003bf5d9dc2b386db0d05f595c5548355a535d6dfc06fd379fd98bb190174"
VHBA_SRC="/usr/src/vhba-${VHBA_VERSION}"
CACHE_DIR="/var/cache/pc-game-archive/cdemu"
TARBALL="$CACHE_DIR/vhba-module-${VHBA_VERSION}.tar.xz"

log(){ printf '[pcga-cdemu] %s\n' "$*" >&2; }

vhba_ready(){
  /sbin/modprobe vhba >/dev/null 2>&1 || return 1
  local i
  for i in {1..30}; do
    [[ -c /dev/vhba_ctl ]] && return 0
    sleep 0.1
  done
  return 1
}

if vhba_ready; then
  log "VHBA ready for kernel $KERNEL ($(modinfo -F version vhba 2>/dev/null || echo unknown))"
  exit 0
fi

log "VHBA is not loadable for running kernel $KERNEL"

# If the current upstream source was installed by an earlier PCGA upgrade,
# rebuild it locally for a new kernel before considering network repair.
if command -v dkms >/dev/null 2>&1 && [[ -d "$VHBA_SRC" && -e "/lib/modules/$KERNEL/build" ]]; then
  log "Attempting local DKMS rebuild from $VHBA_SRC"
  dkms add -m vhba -v "$VHBA_VERSION" >/dev/null 2>&1 || true
  dkms build -m vhba -v "$VHBA_VERSION" -k "$KERNEL" >/dev/null 2>&1 || true
  dkms install -m vhba -v "$VHBA_VERSION" -k "$KERNEL" --force >/dev/null 2>&1 || true
  depmod -a "$KERNEL" >/dev/null 2>&1 || true
  if vhba_ready; then
    log "VHBA repaired from installed upstream DKMS source"
    exit 0
  fi
fi

if [[ "$MODE" != "--repair" ]]; then
  log "VHBA remains unavailable; run the versioned PCGA upgrader repair path"
  exit 1
fi

for cmd in dkms tar sha256sum; do
  command -v "$cmd" >/dev/null 2>&1 || { log "repair prerequisite missing: $cmd"; exit 1; }
done
[[ -e "/lib/modules/$KERNEL/build" ]] || { log "kernel headers are missing for $KERNEL"; exit 1; }
command -v wget >/dev/null 2>&1 || { log "repair prerequisite missing: wget"; exit 1; }

mkdir -p "$CACHE_DIR"
rm -f "$TARBALL.part"

# Debian carries the exact upstream 20260313 tarball; Gentoo and SourceForge
# are secondary mirrors.  Integrity is pinned independently of transport.
urls=(
  "https://deb.debian.org/debian/pool/main/v/vhba-module/vhba-module_${VHBA_VERSION}.orig.tar.xz"
  "https://mirrors.mit.edu/gentoo-distfiles/distfiles/41/vhba-module-${VHBA_VERSION}.tar.xz"
  "https://downloads.sourceforge.net/project/cdemu/vhba-module/vhba-module-${VHBA_VERSION}.tar.xz"
)
need_download=1
if [[ -f "$TARBALL" ]] && printf '%s  %s\n' "$VHBA_SHA256" "$TARBALL" | sha256sum -c - >/dev/null 2>&1; then
  need_download=0
fi
if (( need_download )); then
  for url in "${urls[@]}"; do
    log "Fetching pinned VHBA $VHBA_VERSION source from $url"
    if wget -q --https-only --timeout=25 --tries=2 -O "$TARBALL.part" "$url"; then
      if printf '%s  %s\n' "$VHBA_SHA256" "$TARBALL.part" | sha256sum -c - >/dev/null 2>&1; then
        mv -f "$TARBALL.part" "$TARBALL"
        need_download=0
        break
      fi
      log "downloaded VHBA source failed SHA-256 verification"
    fi
    rm -f "$TARBALL.part"
  done
fi
(( need_download == 0 )) || { log "could not obtain verified VHBA $VHBA_VERSION source"; exit 1; }

work="$(mktemp -d /tmp/pcga-vhba.XXXXXX)"
trap 'rm -rf "$work"' EXIT
tar -xJf "$TARBALL" -C "$work"
src="$(find "$work" -mindepth 1 -maxdepth 1 -type d -name 'vhba-module-*' -print -quit)"
[[ -n "$src" && -f "$src/vhba.c" && -f "$src/Makefile" ]] || { log "verified VHBA archive has unexpected layout"; exit 1; }

rm -rf "$VHBA_SRC"
install -d -m 0755 "$VHBA_SRC"
cp -a "$src"/. "$VHBA_SRC"/
cat > "$VHBA_SRC/dkms.conf" <<DKMS
PACKAGE_NAME="vhba"
PACKAGE_VERSION="$VHBA_VERSION"
MAKE[0]="make KERNELRELEASE=\${kernelver}"
CLEAN="make clean"
BUILT_MODULE_NAME[0]="vhba"
DEST_MODULE_LOCATION[0]="/kernel/drivers/scsi"
AUTOINSTALL="yes"
DKMS

log "Building upstream VHBA $VHBA_VERSION for $KERNEL through DKMS"
dkms remove -m vhba -v "$VHBA_VERSION" -k "$KERNEL" >/dev/null 2>&1 || true
dkms add -m vhba -v "$VHBA_VERSION" >/dev/null 2>&1 || true
if ! dkms build -m vhba -v "$VHBA_VERSION" -k "$KERNEL"; then
  log "VHBA DKMS build failed; inspect /var/lib/dkms/vhba/$VHBA_VERSION/$KERNEL/*/log/make.log"
  exit 1
fi
if ! dkms install -m vhba -v "$VHBA_VERSION" -k "$KERNEL" --force; then
  log "VHBA DKMS install failed"
  exit 1
fi
depmod -a "$KERNEL"

if ! vhba_ready; then
  log "VHBA was built but cannot be loaded; Secure Boot/module-signing or kernel policy may be blocking it"
  /sbin/modprobe vhba || true
  if command -v mokutil >/dev/null 2>&1; then
    mokutil --sb-state 2>&1 | sed 's/^/[pcga-cdemu] /' >&2 || true
  fi
  exit 1
fi

install -d -m 0755 /etc/modules-load.d /etc/udev/rules.d
printf 'vhba\n' > /etc/modules-load.d/pcga-vhba.conf
cat > /etc/udev/rules.d/40-pcga-vhba.rules <<'RULE'
KERNEL=="vhba_ctl", SUBSYSTEM=="misc", MODE="0660", OWNER="root", GROUP="cdrom"
RULE
udevadm control --reload-rules >/dev/null 2>&1 || true
udevadm trigger --subsystem-match=misc --sysname-match=vhba_ctl >/dev/null 2>&1 || true
log "VHBA $VHBA_VERSION ready for $KERNEL"
