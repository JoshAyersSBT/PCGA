class State:
    def __init__(self, root: Path):
        self.root=root
        self.jobs_dir=Path('/var/lib/pc-game-archive/public-media')
        self.jobs_dir.mkdir(parents=True, exist_ok=True)
        self.upload_root=self.root/'ingest/user-uploads'
        self.upload_staging=self.upload_root/'staging'
        self.upload_staging.mkdir(parents=True, exist_ok=True)
        self.lock=threading.Lock()
        self.jobs={}
        for job_file in sorted(self.jobs_dir.glob('*.json'), key=lambda x:x.stat().st_mtime, reverse=True)[:80]:
            try:
                job=json.loads(job_file.read_text(encoding='utf-8'))
                if isinstance(job,dict) and job.get('id'): self.jobs[str(job['id'])]=job
            except Exception:
                pass

    def save_job(self,j):
        p=self.jobs_dir/f"{j['id']}.json"
        tmp=p.with_suffix('.tmp')
        tmp.write_text(json.dumps(j,indent=2,sort_keys=True),encoding='utf-8')
        os.replace(tmp,p)

