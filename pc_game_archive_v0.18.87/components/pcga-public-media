class Handler(BaseHTTPRequestHandler):
    server_version=f'PCGAPublicMedia/{VERSION}'
    def log_message(self,fmt,*args):
        if urllib.parse.urlparse(self.path).path not in {'/health','/api/rom/jobs'}: super().log_message(fmt,*args)
    def send_json(self,status,obj):
        body=json.dumps(obj,separators=(',',':')).encode(); self.send_response(status); self.send_header('Content-Type','application/json'); self.send_header('Content-Length',str(len(body))); self.send_header('Cache-Control','no-store'); self.end_headers(); self.wfile.write(body)
    def do_GET(self):
        u=urllib.parse.urlparse(self.path); p=u.path
        if p=='/health': return self.send_json(200,{'ok':True,'version':VERSION})
        if p in {'/','/index.html'}:
            b=page_html().encode(); self.send_response(200); self.send_header('Content-Type','text/html; charset=utf-8'); self.send_header('Content-Length',str(len(b))); self.send_header('Content-Security-Policy',"default-src 'self'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; connect-src 'self'; img-src 'self' data: https://archive.org; media-src 'self'"); self.end_headers(); self.wfile.write(b); return
        if p=='/api/search':
            q=urllib.parse.parse_qs(u.query); source=(q.get('source') or ['feature_films'])[0]; term=(q.get('q') or [''])[0]
            if source not in SOURCES:return self.send_json(400,{'error':'unknown source'})
            try:return self.send_json(200,search_archive(source,term))
            except Exception as e:return self.send_json(502,{'error':str(e)})
        if p=='/api/jobs':
            with STATE.lock: jobs=sorted((dict(x) for x in STATE.jobs.values()),key=lambda x:x.get('created_at',0),reverse=True)[:40]
            return self.send_json(200,{'jobs':jobs})
        if p in {'/api/rom/platforms','/api/user-upload/platforms'}:
            return self.send_json(200,{'items':[{'slug':k,'name':v['name'],'extensions':sorted(v['exts'])} for k,v in ROM_PLATFORMS.items()]})
        if p=='/api/user-upload/jobs':
            with STATE.lock: jobs=sorted((dict(x) for x in STATE.jobs.values() if x.get('kind')=='user-upload'),key=lambda x:x.get('created_at',0),reverse=True)[:24]
            return self.send_json(200,{'jobs':jobs})
        if p=='/api/rom/jobs':
            with STATE.lock: jobs=sorted((dict(x) for x in STATE.jobs.values() if x.get('kind')=='rom'),key=lambda x:x.get('created_at',0),reverse=True)[:24]
            return self.send_json(200,{'jobs':jobs})
        if p=='/api/rom/search':
            q=urllib.parse.parse_qs(u.query); term=(q.get('q') or [''])[0]; platform=(q.get('platform') or [''])[0]; page=intish((q.get('page') or ['1'])[0]) or 1
            try:return self.send_json(200,search_archive_roms(term,platform,page))
            except Exception as e:return self.send_json(502,{'error':str(e)})
        if p=='/api/rom/item':
            q=urllib.parse.parse_qs(u.query); ident=(q.get('identifier') or [''])[0]; platform=(q.get('platform') or [''])[0]
            try:return self.send_json(200,rom_item(ident,platform))
            except Exception as e:return self.send_json(400,{'error':str(e)})
        return self.send_json(404,{'error':'not found'})
    def do_POST(self):
        u=urllib.parse.urlparse(self.path); post_path=u.path
        if post_path=='/api/user-upload/file':
            try:
                n=int(self.headers.get('Content-Length','0'))
                q=urllib.parse.parse_qs(u.query); sid=(q.get('session') or [''])[0]; rel=(q.get('path') or [''])[0]
                result=receive_user_upload(self,sid,rel,n); return self.send_json(201,result)
            except Exception as e:
                # A rejected raw-body upload may still have unread bytes on the
                # connection. Do not allow those bytes to be parsed as a second
                # HTTP request on this socket.
                self.close_connection=True
                return self.send_json(400,{'error':str(e)})
        if post_path not in {'/api/import','/api/rom/import','/api/user-upload/session','/api/user-upload/commit'}: return self.send_json(404,{'error':'not found'})
        try:
            n=int(self.headers.get('Content-Length','0')); assert 0<n<=65536
            payload=json.loads(self.rfile.read(n))
            if post_path=='/api/rom/import': job=start_rom_import(payload)
            elif post_path=='/api/user-upload/session': return self.send_json(201,start_user_upload_session(payload))
            elif post_path=='/api/user-upload/commit': job=start_user_upload_commit(payload)
            else: job=start_import(payload)
            return self.send_json(202,job)
        except Exception as e:return self.send_json(400,{'error':str(e)})

def main():
    global STATE
    ap=argparse.ArgumentParser(); ap.add_argument('command',nargs='?',default='serve'); ap.add_argument('--root',default=os.environ.get('PCGA_ARCHIVE_ROOT') or (Path('/etc/pc-game-archive/archive-root').read_text().strip() if Path('/etc/pc-game-archive/archive-root').exists() else '')); ap.add_argument('--bind',default='127.0.0.1'); ap.add_argument('--port',type=int,default=8099)
    a=ap.parse_args(); root=Path(a.root)
    if not root.is_absolute(): raise SystemExit('archive root must be absolute')
    STATE=State(root)
    if a.command=='serve': ThreadingHTTPServer((a.bind,a.port),Handler).serve_forever()
    elif a.command=='search': print(json.dumps(search_archive('feature_films',''),indent=2))
    else: raise SystemExit('unknown command')
if __name__=='__main__': main()
