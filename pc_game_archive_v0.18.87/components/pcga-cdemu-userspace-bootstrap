#!/usr/bin/env bash
set -Eeuo pipefail

# PCGA CDEmu userspace bootstrap for Ubuntu releases where the CDEmu suite is
# not published in the configured archive.  libMirage is a separate CDEmu
# component and is built first when Noble does not provide libmirage-dev.

MIRAGE_VERSION="3.3.3"
MIRAGE_SHA256="b480b08230b2255af40c3ac86344c0c77fc996866014e05a69d5554e9035d65b"
CDEMU_VERSION="3.3.0"
DAEMON_SHA256="0181e388e01076eebce6073aa748f640db429936135a2c75933590658bc63d65"
CLIENT_SHA256="5a22a6d3464a5037875fa448238f892abb80cd4c96cd95b2234899783aa4b270"
CACHE_DIR="/var/cache/pc-game-archive/cdemu"
MIRAGE_TARBALL="$CACHE_DIR/libmirage-${MIRAGE_VERSION}.tar.xz"
DAEMON_TARBALL="$CACHE_DIR/cdemu-daemon_${CDEMU_VERSION}.orig.tar.xz"
CLIENT_TARBALL="$CACHE_DIR/cdemu-client_${CDEMU_VERSION}.orig.tar.xz"
MARKER="/var/lib/pc-game-archive/cdemu/userspace-version"

log(){ printf '[pcga-cdemu] %s\n' "$*" >&2; }

for cmd in wget tar sha256sum cmake pkg-config make gcc python3 ldconfig; do
  command -v "$cmd" >/dev/null 2>&1 || { log "userspace build prerequisite missing: $cmd"; exit 1; }
done

# Noble supplies these lower-level libraries even when it does not publish
# libMirage/CDEmu itself.  Check the interfaces we actually compile against.
for module in glib-2.0 sndfile samplerate; do
  pkg-config --exists "$module" || { log "libMirage build prerequisite missing: pkg-config module $module"; exit 1; }
done
if ! pkg-config --exists ao; then
  log "CDEmu daemon build prerequisite missing: pkg-config module ao (install libao-dev)"
  exit 1
fi
python3 - <<'PY' >/dev/null 2>&1 || { log "CDEmu client runtime prerequisite missing: python3-gi"; exit 1; }
import gi
PY

mkdir -p "$CACHE_DIR" "$(dirname "$MARKER")"

fetch_verified(){
  local dst="$1" sha="$2"; shift 2
  if [[ -f "$dst" ]] && printf '%s  %s\n' "$sha" "$dst" | sha256sum -c - >/dev/null 2>&1; then
    return 0
  fi
  rm -f "$dst.part"
  local url
  for url in "$@"; do
    log "Fetching pinned CDEmu source from $url"
    if wget -q --https-only --timeout=30 --tries=2 -O "$dst.part" "$url"; then
      if printf '%s  %s\n' "$sha" "$dst.part" | sha256sum -c - >/dev/null 2>&1; then
        mv -f "$dst.part" "$dst"
        return 0
      fi
      log "downloaded source failed SHA-256 verification: $url"
    fi
    rm -f "$dst.part"
  done
  return 1
}

jobs="$(nproc 2>/dev/null || echo 2)"
[[ "$jobs" =~ ^[0-9]+$ ]] || jobs=2
(( jobs > 8 )) && jobs=8

# Ubuntu 24.04/Noble may have no libmirage-dev package at all.  Build the
# library from the CDEmu project's verified source before configuring daemon.
if ! pkg-config --exists libmirage; then
  fetch_verified "$MIRAGE_TARBALL" "$MIRAGE_SHA256" \
    "https://downloads.sourceforge.net/project/cdemu/libmirage/libmirage-${MIRAGE_VERSION}.tar.xz" \
    "https://sourceforge.net/projects/cdemu/files/libmirage/libmirage-${MIRAGE_VERSION}.tar.xz/download" \
    || { log "could not obtain verified libMirage $MIRAGE_VERSION source"; exit 1; }

  work_mirage="$(mktemp -d /tmp/pcga-libmirage.XXXXXX)"
  trap 'rm -rf "${work_mirage:-}" "${work_cdemu:-}"' EXIT
  tar -xJf "$MIRAGE_TARBALL" -C "$work_mirage"
  mirage_src="$(find "$work_mirage" -mindepth 1 -maxdepth 1 -type d -name 'libmirage-*' -print -quit)"
  [[ -n "$mirage_src" && -f "$mirage_src/CMakeLists.txt" ]] || { log "verified libMirage archive has unexpected layout"; exit 1; }

  log "Building libMirage $MIRAGE_VERSION from pinned upstream source"
  cmake -S "$mirage_src" -B "$work_mirage/build" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DGTKDOC_ENABLED=OFF
  cmake --build "$work_mirage/build" --parallel "$jobs"
  cmake --install "$work_mirage/build"
  ldconfig

  # Some CMake releases cache pkg-config paths in-process. Probe afresh.
  pkg-config --exists libmirage || { log "libMirage installed but pkg-config module libmirage is still unavailable"; exit 1; }
  log "libMirage ready: version=$(pkg-config --modversion libmirage)"
else
  log "libMirage already available: version=$(pkg-config --modversion libmirage)"
fi

if command -v cdemu >/dev/null 2>&1 && command -v cdemu-daemon >/dev/null 2>&1; then
  log "CDEmu userspace already available: client=$(command -v cdemu) daemon=$(command -v cdemu-daemon)"
  printf 'existing:libmirage=%s\n' "$(pkg-config --modversion libmirage)" > "$MARKER"
  exit 0
fi

fetch_verified "$DAEMON_TARBALL" "$DAEMON_SHA256" \
  "https://deb.debian.org/debian/pool/main/c/cdemu-daemon/cdemu-daemon_${CDEMU_VERSION}.orig.tar.xz" \
  "https://downloads.sourceforge.net/project/cdemu/cdemu-daemon/cdemu-daemon-${CDEMU_VERSION}.tar.xz" \
  || { log "could not obtain verified CDEmu daemon $CDEMU_VERSION source"; exit 1; }

fetch_verified "$CLIENT_TARBALL" "$CLIENT_SHA256" \
  "https://deb.debian.org/debian/pool/main/c/cdemu-client/cdemu-client_${CDEMU_VERSION}.orig.tar.xz" \
  "https://downloads.sourceforge.net/project/cdemu/cdemu-client/cdemu-client-${CDEMU_VERSION}.tar.xz" \
  || { log "could not obtain verified CDEmu client $CDEMU_VERSION source"; exit 1; }

work_cdemu="$(mktemp -d /tmp/pcga-cdemu-userspace.XXXXXX)"
trap 'rm -rf "${work_mirage:-}" "${work_cdemu:-}"' EXIT
mkdir -p "$work_cdemu/daemon" "$work_cdemu/client"
tar -xJf "$DAEMON_TARBALL" -C "$work_cdemu/daemon"
tar -xJf "$CLIENT_TARBALL" -C "$work_cdemu/client"
daemon_src="$(find "$work_cdemu/daemon" -mindepth 1 -maxdepth 1 -type d -name 'cdemu-daemon-*' -print -quit)"
client_src="$(find "$work_cdemu/client" -mindepth 1 -maxdepth 1 -type d -name 'cdemu-client-*' -print -quit)"
[[ -n "$daemon_src" && -f "$daemon_src/CMakeLists.txt" ]] || { log "verified daemon archive has unexpected layout"; exit 1; }
[[ -n "$client_src" && -f "$client_src/CMakeLists.txt" ]] || { log "verified client archive has unexpected layout"; exit 1; }

log "Building CDEmu daemon $CDEMU_VERSION against libMirage $(pkg-config --modversion libmirage)"
cmake -S "$daemon_src" -B "$work_cdemu/daemon-build" \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_INSTALL_PREFIX=/usr \
  -DCMAKE_INSTALL_SYSCONFDIR=/etc
cmake --build "$work_cdemu/daemon-build" --parallel "$jobs"
cmake --install "$work_cdemu/daemon-build"

log "Building CDEmu client $CDEMU_VERSION from pinned source"
cmake -S "$client_src" -B "$work_cdemu/client-build" \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_INSTALL_PREFIX=/usr
cmake --build "$work_cdemu/client-build" --parallel "$jobs"
cmake --install "$work_cdemu/client-build"
ldconfig

[[ -x /usr/bin/cdemu-daemon ]] || { log "source install did not create /usr/bin/cdemu-daemon"; exit 1; }
[[ -x /usr/bin/cdemu ]] || { log "source install did not create /usr/bin/cdemu"; exit 1; }
/usr/bin/cdemu --help >/dev/null 2>&1 || { log "installed CDEmu client failed its --help probe"; exit 1; }
/usr/bin/cdemu-daemon --help >/dev/null 2>&1 || { log "installed CDEmu daemon failed its --help probe"; exit 1; }
printf 'source:libmirage=%s cdemu=%s\n' "$MIRAGE_VERSION" "$CDEMU_VERSION" > "$MARKER"
log "CDEmu userspace installed: libMirage=$MIRAGE_VERSION daemon/client=$CDEMU_VERSION"
