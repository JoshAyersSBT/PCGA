[Unit]
Description=PC Game Archive appliance control plane
After=docker.service network-online.target
Wants=docker.service network-online.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/pcga-control --bind __PCGA_CONTROL_BIND__ --port 8100
Restart=on-failure
RestartSec=2
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/etc/pc-game-archive /var/lib/pc-game-archive /opt/pc-game-archive __PCGA_ARCHIVE_ROOT__ /run /var/run

[Install]
WantedBy=multi-user.target
