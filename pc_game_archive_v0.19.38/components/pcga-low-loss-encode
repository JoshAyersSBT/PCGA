#!/usr/bin/env python3
"""PCGA opt-in, quality-oriented (NOT mathematically lossless) playable encodes.

Encode -> preview/review -> publish -> rollback. Original is never deleted:
publish moves it to cold-archive/low-loss-masters and places the verified
playable MKV at the original library path. Keeping both consumes disk space.
"""
from __future__ import annotations
import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import shutil
import stat
import subprocess
import sys
import time
import uuid

ROOT_FILE = Path(os.environ.get('PCGA_ARCHIVE_ROOT_FILE', '/etc/pc-game-archive/archive-root'))
JOB_DIR = Path(os.environ.get('PCGA_LOW_LOSS_JOB_DIR', '/var/lib/pc-game-archive/low-loss-jobs'))
LIBRARIES = {'movies', 'tv', 'home-videos'}
MIN_AGE = int(os.environ.get('PCGA_LOW_LOSS_MIN_AGE_SECONDS', '3600'))
PROFILES = {
    'hevc': {'balanced': ('libx265', '20', 'medium'), 'high': ('libx265', '18', 'slow')},
    'av1': {'balanced': ('libsvtav1', '28', '6'), 'high': ('libsvtav1', '24', '4')},
}


def fail(message):
    raise ValueError(message)


def archive_root():
    root = Path(ROOT_FILE.read_text().strip()).resolve(strict=True)
    if not root.is_dir(): fail('archive root is invalid')
    return root


def relative_file(value):
    p = Path(str(value))
    if (not p.parts or p.is_absolute() or '..' in p.parts or '\\' in str(value)
            or p.parts[0] not in LIBRARIES or p.suffix.lower() != '.mkv'):
        fail('expected a managed movies/tv/home-videos relative .mkv path')
    return p


def locations(root, rel):
    rel = relative_file(rel)
    return (root / 'media/library' / rel,
            root / 'media/low-loss/staged' / rel,
            root / 'media/low-loss/records' / (str(rel) + '.json'),
            root / 'media/cold-archive/low-loss-masters' / rel)


def ensure_inside(root, path, boundary):
    if path.is_symlink(): fail('symlink file refused')
    if not path.resolve(strict=False).is_relative_to(boundary.resolve(strict=False)):
        fail('path escapes PCGA-managed storage')
    parent = path.parent
    while parent != boundary and parent != parent.parent:
        if parent.is_symlink(): fail('symlink parent refused')
        parent = parent.parent
    if path.is_symlink(): fail('symlink file refused')


def regular(path):
    if path.is_symlink(): fail('symlink refused')
    st = path.stat()
    if not stat.S_ISREG(st.st_mode): fail('expected a regular media file')
    return st


def library_source(root, rel, *, age=True):
    src, _, _, _ = locations(root, rel)
    ensure_inside(root, src, root / 'media/library')
    st = regular(src)
    if age and time.time() - st.st_mtime < MIN_AGE:
        fail('media is still settling after ingestion; try again later')
    return src, st


def lock(root):
    lock_file = root / 'media/cold-archive/.pcga-media-storage.lock'
    lock_file.parent.mkdir(parents=True, exist_ok=True)
    f = open(lock_file, 'a+')
    fcntl.flock(f, fcntl.LOCK_EX)
    return f


def checksum(path):
    h = hashlib.sha256()
    with open(path, 'rb') as f:
        for chunk in iter(lambda: f.read(4 << 20), b''):
            h.update(chunk)
    return h.hexdigest()


def save_record(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + '.tmp.' + uuid.uuid4().hex)
    try:
        with open(tmp, 'x') as f:
            json.dump(data, f, indent=2, sort_keys=True)
            f.write('\n'); f.flush(); os.fsync(f.fileno())
        os.replace(tmp, path)
    finally:
        tmp.unlink(missing_ok=True)


def probe(path):
    result = subprocess.run(['ffprobe', '-v', 'error', '-show_format', '-show_streams',
                             '-show_chapters', '-of', 'json', str(path)],
                            capture_output=True, text=True, timeout=120)
    if result.returncode: fail('FFprobe failed: ' + result.stderr[-320:])
    data = json.loads(result.stdout)
    if not data.get('streams'): fail('no playable media streams detected')
    return data


def stream_type_count(metadata, kind):
    return sum(s.get('codec_type') == kind for s in metadata.get('streams', []))


def video_stream(metadata):
    videos = [s for s in metadata['streams'] if s.get('codec_type') == 'video' and
              not s.get('disposition', {}).get('attached_pic')]
    if len(videos) != 1: fail('requires exactly one main video stream; select a simpler MKV')
    return videos[0]


def eligibility(metadata):
    v = video_stream(metadata)
    pix = v.get('pix_fmt', '')
    if pix not in {'yuv420p', 'yuv420p10le'}:
        fail('unsupported pixel format; conversion might change color fidelity: ' + pix)
    transfer = str(v.get('color_transfer') or '').lower()
    primaries = str(v.get('color_primaries') or '').lower()
    if transfer in {'smpte2084', 'arib-std-b67'} or primaries == 'bt2020':
        fail('HDR video requires color/HDR metadata handling; preserve the original, this release encodes SDR only')
    if any('DOVI' in str(entry.get('side_data_type','')).upper() for entry in v.get('side_data_list', [])):
        fail('Dolby Vision video is not supported by the SDR low-loss profile')
    if any(s.get('codec_type') not in {'video', 'audio', 'subtitle', 'attachment'} for s in metadata['streams']):
        fail('MKV has unknown/data streams; refusing a potentially destructive remux')
    return v


def compare_streams(original, output, codec):
    first = eligibility(original)
    second = video_stream(output)
    expected = 'hevc' if codec == 'hevc' else 'av1'
    if second.get('codec_name') != expected: fail('output video codec mismatch')
    if (first.get('width'), first.get('height')) != (second.get('width'), second.get('height')):
        fail('output video resolution mismatch')
    if (first.get('pix_fmt') == 'yuv420p10le') != (second.get('pix_fmt') == 'yuv420p10le'):
        fail('output lost original bit-depth class')
    for kind in ('audio', 'subtitle', 'attachment'):
        left = [s.get('codec_name') for s in original['streams'] if s.get('codec_type') == kind]
        right = [s.get('codec_name') for s in output['streams'] if s.get('codec_type') == kind]
        if left != right: fail(kind + ' streams are missing/reordered/changed')
    if len(original.get('chapters', [])) != len(output.get('chapters', [])):
        fail('chapter count changed')
    try:
        a = float(original['format']['duration']); b = float(output['format']['duration'])
        if a <= 0 or abs(a-b) > max(2.0, a*0.001): fail('output duration mismatch')
    except (KeyError, TypeError):
        fail('source and output duration must both be known')
    return {'duration_seconds': round(b, 2), 'chapter_count': len(output.get('chapters', [])),
            'audio_tracks': stream_type_count(output, 'audio'),
            'subtitle_tracks': stream_type_count(output, 'subtitle')}


def encoder_available(codec):
    if not shutil.which('ffmpeg') or not shutil.which('ffprobe'): return False
    proc = subprocess.run(['ffmpeg','-hide_banner','-encoders'], capture_output=True, text=True, timeout=15)
    return proc.returncode == 0 and (' ' + PROFILES[codec]['balanced'][0] + ' ') in proc.stdout


def new_state(operation, rel, state, **kw):
    return {'ok': True, 'operation': operation, 'source': str(rel), 'state': state,
            'updated_at': time.time(), **kw}


def encode(root, source, codec='hevc', quality='balanced', min_savings=10., progress=None):
    if codec not in PROFILES or quality not in PROFILES[codec]: fail('invalid encoder/profile')
    if not 0 <= min_savings <= 95: fail('invalid minimum savings percentage')
    rel = relative_file(source)
    with lock(root):
        src, st = library_source(root, rel)
        live, staged, record, master = locations(root, rel)
        for path, boundary in [(staged,root/'media/low-loss'),(record,root/'media/low-loss'),(master,root/'media/cold-archive')]:
            ensure_inside(root,path,boundary)
        if record.exists() or staged.exists() or master.exists():
            fail('an optimized copy/master already exists; inspect, publish or rollback first')
        if not encoder_available(codec): fail('selected FFmpeg encoder is unavailable: '+PROFILES[codec][quality][0])
        before = probe(src); v = eligibility(before)
        if st.st_size < (1<<20): fail('source file too small for a useful archival transcode')
        # Output staging can be on the same filesystem as live media; never touch source during encode.
        staged.parent.mkdir(parents=True, exist_ok=True)
        # A 150 GiB source need not require another 150 GiB free to encode.
        # Budget a conservative 35% of source size (up to the source size);
        # ENOSPC is safe: the original is never removed during encoding.
        reserved = min(st.st_size, max(512*(1<<20), int(st.st_size * 0.35))) + 64*(1<<20)
        if shutil.disk_usage(staged.parent).free < reserved:
            fail('not enough free space for a staged encode (need at least '+str(reserved//(1<<20))+' MiB)')
        tmp = staged.with_name(staged.stem+'.partial.'+uuid.uuid4().hex+'.mkv')
        video_encoder, crf, preset = PROFILES[codec][quality]
        opts = ['-c:v:0',video_encoder]
        if codec == 'hevc': opts += ['-crf',crf,'-preset',preset]
        else: opts += ['-crf',crf,'-preset',preset]
        opts += ['-pix_fmt', v['pix_fmt']]
        cmd = ['ffmpeg','-hide_banner','-nostdin','-loglevel','error','-stats_period','3',
               '-i',str(src),'-map','0','-map_metadata','0','-map_chapters','0',
               '-c','copy',*opts,'-max_muxing_queue_size','4096','-progress','pipe:1',str(tmp)]
        source_hash = checksum(src)
        if progress: progress(new_state('encode',rel,'encoding',codec=codec,quality=quality,percent=0))
        try:
            import tempfile
            with tempfile.TemporaryFile(mode='w+t') as errors:
                proc = subprocess.Popen(cmd,stdout=subprocess.PIPE,stderr=errors,text=True,bufsize=1)
                duration = float(before['format'].get('duration') or 0)
                try:
                    for line in proc.stdout or []:
                        if line.startswith('out_time_us='):
                            try:
                                pct = min(99.0, max(0.0,float(line.split('=',1)[1])/(duration*10000))) if duration else 0
                                if progress: progress(new_state('encode',rel,'encoding',codec=codec,quality=quality,percent=round(pct,1)))
                            except ValueError: pass
                    exit_code=proc.wait(timeout=90)
                except BaseException:
                    proc.kill();proc.wait();raise
                finally:
                    if proc.stdout: proc.stdout.close()
                if exit_code:
                    errors.seek(0)
                    fail('FFmpeg conversion failed: ' + errors.read()[-700:])
            if not tmp.is_file() or not tmp.stat().st_size: fail('FFmpeg produced no media')
            checks = compare_streams(before, probe(tmp), codec)
            size = tmp.stat().st_size
            savings = 100*(1-size/st.st_size)
            if savings < min_savings:
                return new_state('encode',rel,'skipped',savings_percent=round(savings,2),
                                 detail='low-loss copy did not meet minimum savings; original preserved')
            if src.stat().st_size != st.st_size or src.stat().st_mtime_ns != st.st_mtime_ns or checksum(src) != source_hash:
                fail('original changed during encoding; no output published')
            digest = checksum(tmp)
            os.replace(tmp,staged)
            obj = {'schema':1,'source':str(rel),'state':'encoded','codec':codec,'quality':quality,
                   'crf':int(crf),'encoder':video_encoder,'source_bytes':st.st_size,
                   'encoded_bytes':size,'source_sha256':source_hash,'encoded_sha256':digest,
                   'source_mtime_ns':st.st_mtime_ns,'created_at':time.time(),**checks}
            save_record(record,obj)
            return new_state('encode',rel,'encoded',codec=codec,quality=quality,
                             source_bytes=st.st_size,encoded_bytes=size,savings_percent=round(savings,2),
                             detail='Verified playable copy staged. Review before publishing.')
        finally:
            tmp.unlink(missing_ok=True)


def read_record(path, rel):
    if path.is_symlink() or not path.is_file(): fail('no conversion record found')
    data=json.loads(path.read_text())
    if data.get('source') != str(rel) or data.get('schema') != 1: fail('invalid conversion manifest')
    return data


def refresh_jellyfin():
    """Best-effort discovery of codec/size changes; never fail a safe swap for it."""
    cmd = Path('/usr/local/sbin/pcga-jellyfin-refresh')
    if cmd.is_file() and os.access(cmd, os.X_OK) and os.environ.get('PCGA_DISABLE_JELLYFIN_REFRESH') != '1':
        try:
            subprocess.Popen([str(cmd)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
        except OSError:
            pass


def publish(root, source):
    rel=relative_file(source)
    with lock(root):
        src, staged, record, master=locations(root,rel)
        for p, parent in [(src,root/'media/library'),(staged,root/'media/low-loss'),(master,root/'media/cold-archive')]: ensure_inside(root,p,parent)
        data=read_record(record,rel)
        if data.get('state') != 'encoded': fail('candidate is not awaiting publication')
        if master.exists() or master.is_symlink(): fail('master destination already occupied')
        if checksum(staged)!=data['encoded_sha256']: fail('staged MKV checksum mismatch')
        st=regular(src)
        if (st.st_size!=data['source_bytes'] or st.st_mtime_ns!=data['source_mtime_ns']
                or checksum(src)!=data['source_sha256']): fail('live source changed since conversion; refusing replacement')
        master.parent.mkdir(parents=True,exist_ok=True)
        if os.stat(master.parent).st_dev!=os.stat(src.parent).st_dev:
            fail('master and live library must be on same filesystem for atomic move')
        os.replace(src, master)
        try:
            os.replace(staged,src)
        except BaseException:
            os.replace(master,src)
            raise
        data['state']='published';data['published_at']=time.time()
        save_record(record,data)
        refresh_jellyfin()
        return new_state('publish',rel,'published',source_bytes=data['source_bytes'],
                         encoded_bytes=data['encoded_bytes'],detail='Optimized movie is live; lossless master retained for rollback.')


def rollback(root, source):
    rel=relative_file(source)
    with lock(root):
        src, staged, record, master=locations(root,rel)
        for p,parent in [(src,root/'media/library'),(staged,root/'media/low-loss'),(master,root/'media/cold-archive')]: ensure_inside(root,p,parent)
        data=read_record(record,rel)
        if data['state']!='published': fail('only published conversions can be rolled back')
        if not master.is_file(): fail('original master is offloaded; restore it from the NAS in Low-loss master storage before rollback')
        if checksum(master)!=data['source_sha256']: fail('master checksum mismatch; rollback blocked')
        if checksum(src)!=data['encoded_sha256']: fail('optimized live file modified; rollback blocked')
        if staged.exists() or staged.is_symlink(): fail('staged destination already occupied')
        staged.parent.mkdir(parents=True,exist_ok=True)
        if os.stat(staged.parent).st_dev != os.stat(src.parent).st_dev:
            fail('staged and live libraries must share filesystem for rollback')
        os.replace(src,staged)
        try:
            os.replace(master,src)
        except BaseException:
            os.replace(staged,src)
            raise
        data['state']='encoded';data['rolled_back_at']=time.time()
        save_record(record,data)
        refresh_jellyfin()
        return new_state('rollback',rel,'encoded',detail='Original restored; verified optimized copy retained as staged.')


def inventory(root):
    lib=root/'media/library'; records=root/'media/low-loss/records'
    items=[]; candidates=[]
    if records.exists():
        for p in sorted(records.rglob('*.mkv.json'))[:300]:
            try:
                if p.is_symlink(): continue
                data=json.loads(p.read_text());rel=relative_file(data.get('source',''))
                src,staged,record,master=locations(root,rel)
                if p!=record or data.get('state') not in {'encoded','published'}:continue
                path=staged if data['state']=='encoded' else master
                # Published copies stay in inventory even after their original master is safely tiered to NAS.
                if path.is_symlink() or not src.is_file() or (data['state']=='encoded' and not path.is_file()): continue
                items.append({k:data.get(k) for k in ('source','state','codec','quality','source_bytes','encoded_bytes','created_at')})
            except (OSError,ValueError,TypeError,KeyError,json.JSONDecodeError): continue
    known={x['source'] for x in items}
    for name in sorted(LIBRARIES):
        folder=lib/name
        if not folder.is_dir(): continue
        for base,dirs,files in os.walk(folder,followlinks=False):
            dirs[:]=[x for x in dirs if not (Path(base)/x).is_symlink()]
            for filename in files:
                p=Path(base)/filename
                if p.suffix.lower()!='.mkv' or p.is_symlink(): continue
                try:
                    st=p.stat();rel=str(p.relative_to(lib))
                    if rel in known or not stat.S_ISREG(st.st_mode) or st.st_size<(1<<20) or time.time()-st.st_mtime<MIN_AGE:continue
                    candidates.append({'source':rel,'bytes':st.st_size})
                except (OSError,ValueError): continue
    candidates.sort(key=lambda item:-item['bytes'])
    jobs=[]
    if JOB_DIR.is_dir():
        for p in sorted(JOB_DIR.glob('*.json'),key=lambda x:x.stat().st_mtime,reverse=True)[:12]:
            try: jobs.append(json.loads(p.read_text()))
            except (OSError,ValueError): pass
    available=bool(shutil.which('ffmpeg') and shutil.which('ffprobe'))
    return {'ok':True,'available':available,'encoders':{'hevc':encoder_available('hevc') if available else False,
            'av1':encoder_available('av1') if available else False},'candidates':candidates[:80],
            'conversions':items,'jobs':jobs,'detail':'Originals are retained; total disk use grows until masters are moved to another tier.'}


def job(root, operation, source, job_id, codec='hevc',quality='balanced'):
    if not job_id or len(job_id)>65 or not job_id.replace('-','').isalnum():fail('invalid job ID')
    def progress(state):
        JOB_DIR.mkdir(parents=True,exist_ok=True)
        save_record(JOB_DIR/(job_id+'.json'), {'job_id':job_id,**state})
    progress(new_state(operation,source,'running',percent=0))
    try:
        if operation=='encode': result=encode(root,source,codec,quality,progress=progress)
        elif operation=='publish': result=publish(root,source)
        elif operation=='rollback': result=rollback(root,source)
        else: fail('unknown job operation')
        progress(result);return result
    except Exception as exc:
        progress({'ok':False,'operation':operation,'source':source,'state':'error','detail':str(exc)[:900], 'finished_at':time.time()})
        raise


def main():
    p=argparse.ArgumentParser(description=__doc__)
    sub=p.add_subparsers(dest='cmd',required=True)
    sub.add_parser('inventory')
    for verb in ('encode','publish','rollback'):
        parser=sub.add_parser(verb);parser.add_argument('source')
        if verb=='encode':
            parser.add_argument('--codec',choices=tuple(PROFILES),default='hevc')
            parser.add_argument('--quality',choices=('balanced','high'),default='balanced')
            parser.add_argument('--min-savings',type=float,default=10.0)
    queued=sub.add_parser('job');queued.add_argument('operation',choices=('encode','publish','rollback'))
    queued.add_argument('source');queued.add_argument('job_id')
    queued.add_argument('--codec',choices=tuple(PROFILES),default='hevc')
    queued.add_argument('--quality',choices=('balanced','high'),default='balanced')
    args=p.parse_args()
    try:
        root=archive_root()
        if args.cmd=='inventory':result=inventory(root)
        elif args.cmd=='encode':result=encode(root,args.source,args.codec,args.quality,args.min_savings)
        elif args.cmd=='job':result=job(root,args.operation,args.source,args.job_id,args.codec,args.quality)
        elif args.cmd=='publish':result=publish(root,args.source)
        else:result=rollback(root,args.source)
        print(json.dumps(result,sort_keys=True));return 0
    except Exception as exc:
        print(json.dumps({'ok':False,'error':str(exc)}));return 1


if __name__=='__main__':sys.exit(main())
