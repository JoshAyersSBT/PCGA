#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

ROOT_FILE=/etc/pc-game-archive/archive-root
if [[ -n "${PCGA_ROOT_OVERRIDE:-}" ]]; then
  ROOT="$PCGA_ROOT_OVERRIDE"
else
  [[ -r "$ROOT_FILE" ]] || { echo "pcga-media-sort: missing $ROOT_FILE" >&2; exit 1; }
  ROOT="$(cat "$ROOT_FILE")"
fi
[[ -n "$ROOT" && "$ROOT" = /* ]] || { echo "pcga-media-sort: invalid archive root" >&2; exit 1; }

VIDEO_STAGE="$ROOT/media/arm/work/completed"
RAW_STAGE="$ROOT/media/arm/work/raw"
TRANSCODE_STAGE="$ROOT/media/arm/work/transcode"
MUSIC_STAGE="$ROOT/media/arm/music"
LIB="$ROOT/media/library"
QUAR="$ROOT/media/quarantine"
PENDING="$ROOT/media/metadata-pending"
SETTLE_MINUTES="${PCGA_SORT_SETTLE_MINUTES:-2}"
RECONCILE_BIN="${PCGA_INGEST_RECONCILE_BIN:-/usr/local/sbin/pcga-ingest-reconcile}"
MOVED=0

mkdir -p "$VIDEO_STAGE/movies" "$VIDEO_STAGE/tv" "$RAW_STAGE" "$TRANSCODE_STAGE" "$MUSIC_STAGE" \
         "$LIB/movies" "$LIB/tv" "$LIB/music" "$LIB/home-videos" \
         "$QUAR/unidentified" "$QUAR/duplicates" "$QUAR/invalid" "$PENDING"

exec 9>"${PCGA_SORT_LOCK:-/run/pcga-media-sort.lock}"
flock -n 9 || exit 0

# ARM owns the shared output namespace until it has attached the per-disc
# manifest. A background sorter must not win the gap between MakeMKV exit and
# provenance finalization. Only the synchronous drain called from the owning
# ARM service bypasses this second lock.
if [[ "${PCGA_ARM_WRITER_OWNED:-0}" != "1" ]]; then
  exec 8>/run/pcga-arm-shared-output.lock
  flock -n 8 || exit 0
fi

log() { logger -t PCGA-SORT -- "$*" 2>/dev/null || true; printf '[media-sort] %s\n' "$*"; }

# ARM creates its final completed/<category>/<title> directory before the rip is
# finished. Never move completed output while any ARM ripper job is active; the
# periodic timer will pick it up after ARM exits. This intentionally favors
# correctness over immediate promotion, especially on single-drive appliances.
arm_busy() {
  [[ "${PCGA_IGNORE_ARM_BUSY:-0}" == "1" ]] && return 1
  docker inspect -f '{{.State.Running}}' arm-rippers 2>/dev/null | grep -qx true || return 1
  docker exec arm-rippers sh -lc "ps -eo args 2>/dev/null | grep -q '[p]ython3 /opt/arm/arm/ripper/main.py'" 2>/dev/null
}

if arm_busy; then
  # Never move ARM staging output while another drive is still writing there.
  # Classification of items already isolated in metadata-pending is safe and
  # should not be blocked by an unrelated active optical drive.
  log "ARM ingest is active; leaving shared ARM staging in place but classifying existing pending items"
  if [[ "${PCGA_DISABLE_METADATA_CLASSIFY:-0}" != "1" ]]; then
    systemctl --no-block start pcga-metadata-classify.service >/dev/null 2>&1 || true
  fi
  exit 0
fi

has_regular_file() {
  local path="$1"
  if [[ -f "$path" ]]; then
    return 0
  fi
  [[ -d "$path" ]] || return 1
  find "$path" -type f -print -quit 2>/dev/null | grep -q .
}

is_video_file() {
  local f="${1,,}"
  case "$f" in
    *.mkv|*.mp4|*.m4v|*.avi|*.mov|*.mpg|*.mpeg|*.ts|*.m2ts|*.vob|*.webm) return 0 ;;
    *) return 1 ;;
  esac
}

is_audio_file() {
  local f="${1,,}"
  case "$f" in
    *.flac|*.mp3|*.m4a|*.aac|*.ogg|*.opus|*.wav|*.wma|*.alac|*.ape) return 0 ;;
    *) return 1 ;;
  esac
}

contains_video() {
  local path="$1" f
  [[ -d "$path/VIDEO_TS" || -d "$path/BDMV" ]] && return 0
  if [[ -f "$path" ]]; then
    is_video_file "$path"
    return
  fi
  while IFS= read -r -d '' f; do
    if is_video_file "$f"; then return 0; fi
  done < <(find "$path" -type f -print0 2>/dev/null)
  return 1
}

contains_audio() {
  local path="$1" f
  if [[ -f "$path" ]]; then
    is_audio_file "$path"
    return
  fi
  while IFS= read -r -d '' f; do
    if is_audio_file "$f"; then return 0; fi
  done < <(find "$path" -type f -print0 2>/dev/null)
  return 1
}

is_settled() {
  local path="$1"
  [[ "$SETTLE_MINUTES" =~ ^[0-9]+$ ]] || SETTLE_MINUTES=2

  # An empty directory is never a completed media item. ARM pre-creates these
  # directories before MakeMKV/HandBrake finishes, which previously allowed the
  # sorter to move them out from under ARM.
  has_regular_file "$path" || return 1

  (( SETTLE_MINUTES == 0 )) && return 0
  if [[ -f "$path" ]]; then
    ! find "$path" -mmin "-$SETTLE_MINUTES" -print -quit 2>/dev/null | grep -q .
  else
    ! find "$path" -type f -mmin "-$SETTLE_MINUTES" -print -quit 2>/dev/null | grep -q .
  fi
}

quarantine() {
  local src="$1" reason="$2" base stamp dest
  [[ -e "$src" ]] || return 0
  base="$(basename "$src")"
  stamp="$(date +%Y%m%d-%H%M%S)"
  dest="$QUAR/$reason/${stamp}-${base}"
  mkdir -p "$QUAR/$reason"
  local n=0
  while [[ -e "$dest" ]]; do
    ((n+=1))
    dest="$QUAR/$reason/${stamp}-${n}-${base}"
  done
  mv -- "$src" "$dest"
  ((MOVED+=1))
  log "Quarantined $src -> $dest"
}

metadata_pending() {
  local src="$1" hint="${2:-unknown}" base stamp dest n=0
  [[ -e "$src" ]] || return 0
  base="$(basename "$src")"
  stamp="$(date +%Y%m%d-%H%M%S)"
  dest="$PENDING/${stamp}-${base}"
  while [[ -e "$dest" ]]; do
    ((n+=1))
    dest="$PENDING/${stamp}-${n}-${base}"
  done
  # Wrap standalone optical videos so their per-artifact provenance travels
  # with the media and is visible to Manual Review. Never detach sidecars.
  if [[ -f "$src" ]] && is_video_file "$src"; then
    mkdir -p -- "$dest"
    mv -- "$src" "$dest/"
    if [[ -f "$src.pcga-media.json" ]]; then
      mv -- "$src.pcga-media.json" "$dest/.pcga-media.json"
    fi
  else
    mv -- "$src" "$dest"
  fi
  if [[ -d "$dest" ]]; then
    printf '%s\n' "$hint" > "$dest/.pcga-source-hint"
  else
    printf '%s\n' "$hint" > "$dest.pcga-source-hint"
  fi
  # If this came from a recently completed optical-video job, bind the exact
  # pre-rip disc relationship record to the artifact before classification.
  # Ambiguous matches intentionally no-op rather than attaching the wrong disc.
  # Provenance remains unbound: ARM has not supplied per-artifact drive proof.
  ((MOVED+=1))
  log "Queued item for local-first classification: $dest (ARM hint=$hint)"
}

# ARM has had multiple upstream failure modes where MakeMKV succeeds but the
# final raw->completed move fails. PCGA keeps DELRAWFILES=false and, once ARM is
# fully idle, hard-links any settled leftover raw video directory into the
# classification queue. This is non-destructive: the original raw artifact is
# retained until an operator chooses to prune it.
rescue_raw_video() {
  local src base stamp dest n marker method fingerprint prior
  [[ -d "$RAW_STAGE" ]] || return 0
  while IFS= read -r -d '' src; do
    marker="$src/.pcga-rescued"
    contains_video "$src" || continue
    is_settled "$src" || continue
    fingerprint="$(find "$src" -type f \( -iname '*.mkv' -o -iname '*.mp4' -o -iname '*.m4v' -o -iname '*.avi' -o -iname '*.mov' -o -iname '*.m2ts' -o -iname '*.vob' \) -printf '%P\t%s\t%T@\n' 2>/dev/null | sort | sha256sum | awk '{print $1}')"
    prior="$(awk -F= '$1=="fingerprint"{print $2; exit}' "$marker" 2>/dev/null || true)"
    [[ -n "$fingerprint" && "$fingerprint" == "$prior" ]] && continue
    base="$(basename "$src")"
    stamp="$(date +%Y%m%d-%H%M%S)"
    dest="$PENDING/${stamp}-raw-${base}"
    n=0
    while [[ -e "$dest" ]]; do
      ((n+=1)); dest="$PENDING/${stamp}-${n}-raw-${base}"
    done
    mkdir -p "$dest"
    method="hard-link"
    if ! cp -al -- "$src/." "$dest/" 2>/dev/null; then
      rm -rf -- "$dest"
      mkdir -p "$dest"
      method="copy"
      if ! cp -a -- "$src/." "$dest/"; then
        rm -rf -- "$dest"
        log "Raw rescue failed for $src"
        continue
      fi
    fi
    # Do not copy PCGA's own marker/state files into the review artifact.
    find "$dest" -type f -name '.pcga-*' -delete 2>/dev/null || true
    printf '%s\n' 'raw-recovery' > "$dest/.pcga-source-hint"
    # Provenance remains unbound: ARM has not supplied per-artifact drive proof.
    printf 'fingerprint=%s\nrescued_utc=%s\ndestination=%s\nmethod=%s\n' "$fingerprint" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$dest" "$method" > "$marker"
    ((MOVED+=1))
    log "Recovered leftover ARM raw video via $method: $src -> $dest"
  done < <(find "$RAW_STAGE" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null)
}

# Merge a directory tree without replacing any existing destination file.
promote_item() {
  local src="$1" destroot="$2" kind="$3" name dest
  [[ -e "$src" ]] || return 0
  is_settled "$src" || return 0
  name="$(basename "$src")"
  dest="$destroot/$name"

  if [[ ! -e "$dest" ]]; then
    mv -- "$src" "$dest"
    ((MOVED+=1))
    log "Promoted $kind: $name"
    return 0
  fi

  if [[ -d "$src" && -d "$dest" ]]; then
    rsync -a --remove-source-files --ignore-existing -- "$src/" "$dest/"
    find "$src" -depth -type d -empty -delete 2>/dev/null || true
    if [[ -e "$src" ]]; then
      quarantine "$src" duplicates
    else
      ((MOVED+=1))
      log "Merged $kind: $name"
    fi
    return 0
  fi

  quarantine "$src" duplicates
}

promote_movie() {
  local src="$1" stem ext destdir
  [[ -e "$src" ]] || return 0
  is_settled "$src" || return 0
  if ! contains_video "$src"; then
    quarantine "$src" invalid
    return 0
  fi

  # Jellyfin recommends one folder per movie. If ARM ever emits a standalone
  # video directly under completed/movies, wrap it rather than placing a bare
  # file in the Movies root.
  if [[ -f "$src" ]]; then
    stem="$(basename "$src")"
    ext="${stem##*.}"
    stem="${stem%.*}"
    destdir="$LIB/movies/$stem"
    mkdir -p "$destdir"
    if [[ -e "$destdir/$(basename "$src")" ]]; then
      quarantine "$src" duplicates
    else
      mv -- "$src" "$destdir/"
      ((MOVED+=1))
      log "Promoted movie file into folder: $stem"
    fi
    return 0
  fi
  promote_item "$src" "$LIB/movies" movie
}

promote_tv() {
  local src="$1"
  [[ -e "$src" ]] || return 0
  is_settled "$src" || return 0
  # A single loose file has no reliable series/season context. Never guess.
  if [[ -f "$src" ]] || ! contains_video "$src"; then
    quarantine "$src" invalid
    return 0
  fi
  promote_item "$src" "$LIB/tv" tv
}

promote_music() {
  local src="$1"
  [[ -e "$src" ]] || return 0
  is_settled "$src" || return 0
  # abcde normally creates Artist/Album or Various Album folders. Loose files
  # lack enough structure for reliable Jellyfin album organization.
  if [[ -f "$src" ]] || ! contains_audio "$src"; then
    quarantine "$src" invalid
    return 0
  fi
  promote_item "$src" "$LIB/music" music
}

process_category_dirs() {
  local category="$1" mode="$2" dir item
  while IFS= read -r -d '' dir; do
    while IFS= read -r -d '' item; do
      case "$mode" in
        movie) promote_movie "$item" ;;
        tv) promote_tv "$item" ;;
      esac
    done < <(find "$dir" -mindepth 1 -maxdepth 1 -print0 2>/dev/null)
  done < <(find "$VIDEO_STAGE" -mindepth 1 -maxdepth 1 -type d -iname "$category" -print0 2>/dev/null)
}

# Inventory raw and transcode staging before consuming completed output. The
# reconciler understands legacy rescue markers and can recover artifacts ARM
# stranded outside completed/ without deleting the source.
if [[ -x "$RECONCILE_BIN" ]]; then
  "$RECONCILE_BIN" reconcile --quiet || log "Ingest reconciliation pass failed; staging left untouched"
else
  rescue_raw_video
fi

# Do not trust ARM's completed/<category> directory as the final classification.
# PCGA intentionally disables ARM's synchronous metadata provider, while ARM's
# VIDEOTYPE=auto relies on that metadata path upstream. The same optical video
# can therefore land under movies, tv, or an unidentified/unknown directory.
# Route every completed VIDEO artifact through one classifier and preserve the
# ARM category only as a weak source hint.
queue_video_stage() {
  local top item base hint had_child
  [[ -d "$VIDEO_STAGE" ]] || return 0
  while IFS= read -r -d '' top; do
    base="$(basename "$top")"
    case "${base,,}" in
      movies|movie) hint="movie" ;;
      tv|series|shows) hint="tv" ;;
      unidentified|undefined|unknown) hint="unknown" ;;
      *) hint="${base,,}" ;;
    esac

    if [[ -d "$top" ]]; then
      had_child=0
      while IFS= read -r -d '' item; do
        had_child=1
        [[ "$(basename "$item")" != *.pcga-media.json ]] || continue
        is_settled "$item" || continue
        metadata_pending "$item" "$hint"
      done < <(find "$top" -mindepth 1 -maxdepth 1 -print0 2>/dev/null)
      rmdir "$top" 2>/dev/null || true
      if (( had_child == 0 )) && [[ -e "$top" ]] && is_settled "$top"; then
        metadata_pending "$top" "$hint"
      fi
    else
      is_settled "$top" || continue
      metadata_pending "$top" "$hint"
    fi
  done < <(find "$VIDEO_STAGE" -mindepth 1 -maxdepth 1 -print0 2>/dev/null)
}

queue_video_stage

# Audio CD output is configured by ARM's abcde.conf to /home/arm/music.
if [[ -d "$MUSIC_STAGE" ]]; then
  while IFS= read -r -d '' item; do
    promote_music "$item"
  done < <(find "$MUSIC_STAGE" -mindepth 1 -maxdepth 1 -print0)
fi

if (( MOVED > 0 )) && [[ "${PCGA_DISABLE_METADATA_CLASSIFY:-0}" != "1" ]]; then
  systemctl --no-block start pcga-metadata-classify.service >/dev/null 2>&1 || true
fi

if (( MOVED > 0 )) && [[ "${PCGA_DISABLE_JELLYFIN_REFRESH:-0}" != "1" ]] && [[ -x /usr/local/sbin/pcga-jellyfin-refresh ]]; then
  /usr/local/sbin/pcga-jellyfin-refresh >/dev/null 2>&1 || log "Jellyfin refresh request failed; periodic Jellyfin scans can still discover the files"
fi

log "Sort pass complete; filesystem changes: $MOVED"
