#!/usr/bin/env bash
set -Eeuo pipefail
STATE_DIR=/var/lib/pc-game-archive/bootstrap
STATE_FILE="$STATE_DIR/immich.state"
CREDS=/etc/pc-game-archive/secrets/appliance-admin.env
STACK_ENV=/opt/pc-game-archive/.env
install -d -m 0755 "$STATE_DIR"
state(){ printf '%s\n' "$1" >"$STATE_FILE"; chmod 0644 "$STATE_FILE"; }
[[ -x /usr/local/sbin/pcga-appliance-credentials ]] && /usr/local/sbin/pcga-appliance-credentials
[[ -r "$CREDS" ]] || { state failed; echo 'PCGA appliance credentials missing' >&2; exit 1; }
# shellcheck disable=SC1090
. "$CREDS"
port="${PCGA_IMMICH_PORT:-}"
if [[ -z "$port" && -r "$STACK_ENV" ]]; then port="$(awk -F= '$1=="IMMICH_PORT"{print $2}' "$STACK_ENV" | tail -n1)"; fi
port="${port:-2283}"
base="http://127.0.0.1:${port}"
for _ in $(seq 1 90); do curl -fsS --max-time 2 "$base/api/server/ping" >/dev/null 2>&1 && break; sleep 2; done
curl -fsS --max-time 3 "$base/api/server/ping" >/dev/null 2>&1 || { state failed; echo 'Immich unavailable' >&2; exit 1; }
login(){
  local out code
  out="$(mktemp)"
  code="$(curl -sS --max-time 8 -o "$out" -w '%{http_code}' -H 'Content-Type: application/json' \
    -d "$(python3 - "$PCGA_APPLIANCE_ADMIN_EMAIL" "$PCGA_APPLIANCE_ADMIN_PASSWORD" <<'PY'
import json,sys
print(json.dumps({'email':sys.argv[1],'password':sys.argv[2]}))
PY
)" "$base/api/auth/login" || true)"
  rm -f "$out"
  [[ "$code" == 200 || "$code" == 201 ]]
}
if login; then state ready; exit 0; fi
payload="$(python3 - "$PCGA_APPLIANCE_ADMIN_EMAIL" "$PCGA_APPLIANCE_ADMIN_PASSWORD" "$PCGA_APPLIANCE_ADMIN_USER" <<'PY'
import json,sys
print(json.dumps({'email':sys.argv[1],'password':sys.argv[2],'name':sys.argv[3]}))
PY
)"
out="$(mktemp)"
code="$(curl -sS --max-time 10 -o "$out" -w '%{http_code}' -H 'Content-Type: application/json' -d "$payload" "$base/api/auth/admin-sign-up" || true)"
if [[ "$code" == 200 || "$code" == 201 ]]; then
  rm -f "$out"
  login || { state failed; echo 'Immich appliance admin created but login failed' >&2; exit 1; }
  state ready
  exit 0
fi
# If signup is closed because an administrator already exists, preserve it. A
# non-PCGA preexisting Immich instance must never have accounts overwritten.
if [[ "$code" == 400 || "$code" == 401 || "$code" == 403 || "$code" == 409 ]]; then
  state external
  rm -f "$out"
  exit 0
fi
state failed
echo "Immich bootstrap failed (HTTP $code): $(cat "$out" 2>/dev/null)" >&2
rm -f "$out"
exit 1
