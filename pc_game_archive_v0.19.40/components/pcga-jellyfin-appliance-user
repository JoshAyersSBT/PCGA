#!/usr/bin/env bash
set -Eeuo pipefail
STACK_DIR=/opt/pc-game-archive
CREDS=/etc/pc-game-archive/secrets/appliance-admin.env
TOKEN_FILE=/etc/pc-game-archive/jellyfin-api-key
STATE_DIR=/var/lib/pc-game-archive/bootstrap
STATE_FILE="$STATE_DIR/jellyfin.state"
install -d -m 0755 "$STATE_DIR"
state(){ printf '%s\n' "$1" >"$STATE_FILE"; chmod 0644 "$STATE_FILE"; }
[[ -x /usr/local/sbin/pcga-appliance-credentials ]] && /usr/local/sbin/pcga-appliance-credentials
[[ -r "$CREDS" ]] || { echo 'PCGA appliance credentials missing' >&2; exit 1; }
# shellcheck disable=SC1090
. "$CREDS"
port=8096
if [[ -r "$STACK_DIR/.env" ]]; then p="$(awk -F= '$1=="JELLYFIN_PORT"{print $2}' "$STACK_DIR/.env" | tail -n1)"; [[ -n "$p" ]] && port="$p"; fi
base="http://127.0.0.1:${port}"
CLIENT='MediaBrowser Client="PCGameArchive", Device="PCGameArchiveServer", DeviceId="pcga-local", Version="0.18.6"'
authenticate(){
  local response
  response="$(curl -fsS --max-time 12 -H "Authorization: $CLIENT" -H 'Content-Type: application/json' \
    -d "$(python3 - "$PCGA_APPLIANCE_ADMIN_USER" "$PCGA_APPLIANCE_ADMIN_PASSWORD" <<'PY'
import json,sys
print(json.dumps({'Username':sys.argv[1],'Pw':sys.argv[2]}))
PY
)" "$base/Users/AuthenticateByName")" || return 1
  token="$(python3 -c 'import json,sys; print(json.load(sys.stdin).get("AccessToken", ""))' <<<"$response")"
  [[ -n "$token" ]] || return 1
  umask 077; printf '%s\n' "$token" >"$TOKEN_FILE"; chmod 0600 "$TOKEN_FILE"
}
if authenticate; then state ready; exit 0; fi
[[ -s "$TOKEN_FILE" ]] || { state failed; echo 'No authenticated Jellyfin admin session is available to create the PCGA account' >&2; exit 1; }
token="$(tr -d '\r\n' <"$TOKEN_FILE")"
headers=(-H "Authorization: ${CLIENT}, Token=\"${token}\"" -H 'Accept: application/json')
users="$(curl -fsS --max-time 12 "${headers[@]}" "$base/Users")" || exit 1
uid="$(python3 -c 'import json,sys; name=sys.argv[1].lower(); data=json.load(sys.stdin); print(next((u.get("Id","") for u in data if str(u.get("Name","")).lower()==name), ""))' "$PCGA_APPLIANCE_ADMIN_USER" <<<"$users")"
if [[ -z "$uid" ]]; then
  created="$(curl -fsS --max-time 12 -X POST "${headers[@]}" -H 'Content-Type: application/json' \
    -d "$(python3 - "$PCGA_APPLIANCE_ADMIN_USER" "$PCGA_APPLIANCE_ADMIN_PASSWORD" <<'PY'
import json,sys
print(json.dumps({'Name':sys.argv[1],'Password':sys.argv[2]}))
PY
)" "$base/Users/New")"
  uid="$(python3 -c 'import json,sys; print(json.load(sys.stdin).get("Id", ""))' <<<"$created")"
  [[ -n "$uid" ]] || { echo 'Jellyfin did not return an id for the PCGA appliance account' >&2; exit 1; }
else
  # Converge a PCGA-owned account back to the shared password. This uses an
  # authenticated administrator session and does not touch unrelated users.
  curl -fsS --max-time 12 -X POST "${headers[@]}" -H 'Content-Type: application/json' \
    -d "$(python3 - "$PCGA_APPLIANCE_ADMIN_PASSWORD" <<'PY'
import json,sys
print(json.dumps({'NewPw':sys.argv[1],'ResetPassword':False}))
PY
)" "$base/Users/$uid/Password" >/dev/null || true
fi
# Preserve Jellyfin's complete policy object and only assert administrator +
# LAN-appliance defaults so required policy fields remain intact.
user="$(curl -fsS --max-time 12 "${headers[@]}" "$base/Users/$uid")"
policy="$(python3 -c 'import json,sys; u=json.load(sys.stdin); p=dict(u.get("Policy") or {}); p["IsAdministrator"]=True; p["IsDisabled"]=False; p["EnableRemoteAccess"]=False; print(json.dumps(p,separators=(",",":")))' <<<"$user")"
curl -fsS --max-time 12 -X POST "${headers[@]}" -H 'Content-Type: application/json' -d "$policy" "$base/Users/$uid/Policy" >/dev/null
# End with a token belonging to the common PCGA account.
if authenticate; then state ready; else state failed; exit 1; fi
