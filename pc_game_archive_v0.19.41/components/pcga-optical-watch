#!/usr/bin/env bash
set -Eeuo pipefail
ALLOWED=/etc/pc-game-archive/media-drives
STATE_DIR=/run/pcga-optical-watch
DISPATCH_DIR=/run/pcga-optical-dispatch
mkdir -p "$STATE_DIR" "$DISPATCH_DIR"
# A service restart (including re-enabling Auto ingest) must re-evaluate media
# already sitting in a drive. The dispatcher fingerprint still prevents a
# duplicate backend launch for a job that was already dispatched.
rm -f "$STATE_DIR"/*.present 2>/dev/null || true
retry_target() {
  local name="$1" route target active status retry now last
  route="$(python3 - "/var/lib/pc-game-archive/optical-dispatch/${name}.json" <<'PY' 2>/dev/null || true
import json,sys
try: print(json.load(open(sys.argv[1])).get('route',''))
except Exception: pass
PY
)"
  case "$route" in arm-video|arm-audio) target="pcga-arm-rip@${name}.service";; pc-data|pc-mixed) target="pcga-pc-disc-rip@${name}.service";; *) return 1;; esac
  active="$(systemctl show "$target" -p ActiveState --value 2>/dev/null || true)"; [[ "$active" == failed ]] || return 1
  status="$(systemctl show "$target" -p ExecMainStatus --value 2>/dev/null || true)"; [[ "$status" == 75 ]] || return 1
  retry="$STATE_DIR/${name}.retry"; now="$(date +%s)"; last=0; [[ -r "$retry" ]] && read -r last < "$retry" || true; [[ "$last" =~ ^[0-9]+$ ]] || last=0
  (( now-last >= 30 )) || return 0
  printf '%s\n' "$now" > "$retry"; rm -f "$DISPATCH_DIR/${name}.fingerprint"
  systemctl reset-failed "$target" >/dev/null 2>&1 || true
  logger -t PCGA-OPTICAL "Retrying temporary optical ingest failure for /dev/$name"
  systemctl --no-block start "pcga-optical-dispatch@${name}.service" >/dev/null 2>&1 || true
}
while sleep 3; do
  [[ -r "$ALLOWED" ]] || continue
  while IFS= read -r dev; do
    [[ -b "$dev" ]] || continue
    name="${dev#/dev/}"; state="$STATE_DIR/${name}.present"
    if /usr/local/sbin/pcga-optical-media-present "$dev"; then
      if [[ ! -e "$state" ]]; then
        : > "$state"; rm -f "$STATE_DIR/${name}.retry"
        logger -t PCGA-OPTICAL "Detected readable media in $dev; requesting classification/dispatch"
        systemctl --no-block start "pcga-optical-dispatch@${name}.service" >/dev/null 2>&1 || true
      else retry_target "$name" || true; fi
    else
      if [[ -e "$state" ]]; then logger -t PCGA-OPTICAL "Detected media removal from $dev"; fi
      rm -f "$state" "$STATE_DIR/${name}.retry" "$DISPATCH_DIR/${name}.fingerprint"
      systemctl --no-block start "pcga-optical-dispatch@${name}.service" >/dev/null 2>&1 || true
    fi
  done < "$ALLOWED"
done
