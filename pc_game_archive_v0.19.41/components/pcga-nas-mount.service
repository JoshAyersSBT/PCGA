[Unit]
Description=PCGA managed NAS storage tier
Wants=network-online.target
After=network-online.target
Before=pcga-game-stack.service pcga-nas-sync.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/pcga-nas-storage reconcile
TimeoutStartSec=90
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
