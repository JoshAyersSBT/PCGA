#!/usr/bin/env bash
set -Eeuo pipefail
STATE_DIR=/var/lib/pc-game-archive/optical-health
DRIVES_FILE=/etc/pc-game-archive/media-drives
ROLES_FILE=/etc/pc-game-archive/optical-drive-roles.tsv
mkdir -p "$STATE_DIR"
ALL=0; DEEP=0; QUIET=0; HOST_ONLY=0; READ_MIB=16; DEV=""
usage(){ echo "Usage: pcga-optical-health [--all] [--deep] [--host-only] [--read-mib N] [--quiet] [DEV]" >&2; }
while (($#)); do
  case "$1" in
    --all|--monitor|--preflight) ALL=$([[ "$1" == --all ]] && echo 1 || echo "$ALL") ;;
    --deep) DEEP=1 ;;
    --host-only) HOST_ONLY=1 ;;
    --quiet) QUIET=1 ;;
    --read-mib) shift; READ_MIB="${1:-}" ;;
    -h|--help) usage; exit 0 ;;
    --*) usage; exit 64 ;;
    *) [[ -z "$DEV" ]] || { usage; exit 64; }; DEV="$1" ;;
  esac; shift
done
[[ "$READ_MIB" =~ ^[0-9]+$ ]] && ((READ_MIB>=1 && READ_MIB<=512)) || { echo "--read-mib must be 1..512" >&2; exit 64; }
normalize(){ local d="$1"; [[ "$d" == /dev/* ]] || d="/dev/${d#/dev/}"; echo "$d"; }
sg_for(){ lsscsi -g 2>/dev/null | awk -v d="$1" '{hit=0;for(i=1;i<=NF;i++)if($i==d)hit=1;if(hit)for(i=1;i<=NF;i++)if($i~/^\/dev\/sg[0-9]+$/){print $i;exit}}'; }
role_for(){ awk -F'\t' -v d="$1" '$1==d{print $2;exit}' "$ROLES_FILE" 2>/dev/null || true; }
probe(){
  local dev name sg role bytes fs model unit busy=no media=no drive_status=unknown overall=ok message="drive healthy"
  local block=no sgok=no inq=not_tested tur=not_tested arm=no armdev=no armsg=no deep=not_requested
  dev="$(normalize "$1")"; name="${dev#/dev/}"; sg="$(sg_for "$dev")"; role="$(role_for "$dev")"; role="${role:-optical}"
  [[ -b "$dev" ]] && block=yes
  [[ -n "$sg" && -c "$sg" ]] && sgok=yes
  bytes="$(blockdev --getsize64 "$dev" 2>/dev/null || echo 0)"; [[ "$bytes" =~ ^[0-9]+$ ]] || bytes=0
  fs="$(blkid -p -o value -s TYPE "$dev" 2>/dev/null || true)"
  model="$(tr -s ' ' < "/sys/class/block/$name/device/model" 2>/dev/null | sed 's/^ //;s/ $//' || true)"
  unit="$(systemctl is-active "pcga-arm-rip@${name}.service" 2>/dev/null || true)"; [[ "$unit" == active || "$unit" == activating ]] && busy=yes
  unit="$(systemctl is-active "pcga-pc-disc-rip@${name}.service" 2>/dev/null || true)"; [[ "$unit" == active || "$unit" == activating ]] && busy=yes
  drive_status="$(/usr/local/sbin/pcga-optical-media-present --status "$dev" 2>/dev/null || true)"
  /usr/local/sbin/pcga-optical-media-present "$dev" 2>/dev/null && media=yes
  if [[ "$block" != yes ]]; then overall=failed; message="optical block device missing"; fi
  if [[ "$sgok" != yes ]]; then overall=failed; message="generic SCSI partner missing"; fi
  if [[ "$sgok" == yes && "$busy" != yes ]]; then
    if command -v sg_inq >/dev/null 2>&1; then timeout 10 sg_inq "$sg" >/dev/null 2>&1 && inq=ok || { inq=failed; overall=failed; message="SCSI inquiry failed"; }; else inq=unavailable; fi
  else inq=skipped_busy; fi
  if [[ "$HOST_ONLY" -ne 1 ]]; then
    if docker inspect -f '{{.State.Running}}' arm-rippers 2>/dev/null | grep -qx true; then
      arm=yes; docker exec arm-rippers test -b "$dev" >/dev/null 2>&1 && armdev=yes
      [[ "$sgok" != yes ]] || docker exec arm-rippers test -c "$sg" >/dev/null 2>&1 && armsg=yes
    fi
    if [[ "$arm" != yes || "$armdev" != yes || ( "$sgok" == yes && "$armsg" != yes ) ]]; then overall=failed; message="ARM container cannot see complete optical device pair"; fi
  else
    arm=not_required; armdev=not_required; armsg=not_required
  fi
  if [[ "$media" == yes && "$busy" != yes && "$sgok" == yes ]]; then
    if command -v sg_turs >/dev/null 2>&1; then timeout 10 sg_turs "$sg" >/dev/null 2>&1 && tur=ready || { tur=failed; overall=failed; message="TEST UNIT READY failed with media present"; }; else tur=unavailable; fi
  elif [[ "$busy" == yes ]]; then tur=skipped_busy; else tur=no_media; fi
  if ((DEEP)); then
    if [[ "$busy" == yes ]]; then deep=refused_busy; [[ "$overall" == ok ]] && overall=degraded; message="deep read refused while ingest active"
    elif [[ "$media" != yes ]]; then deep=no_media
    elif [[ "$fs" =~ ^(udf|iso9660)$ ]]; then
      count=$((READ_MIB*512)); timeout 120 dd if="$dev" of=/dev/null bs=2048 count="$count" status=none 2>/dev/null && deep="ok_${READ_MIB}MiB" || { deep=failed; overall=failed; message="bounded optical data read failed"; }
    else deep=skipped_non_data_media; fi
  fi
  if [[ "$overall" == ok ]]; then
    if [[ "$busy" == yes ]]; then overall=busy; message="ingest active; invasive tests skipped"
    elif [[ "$media" == yes ]]; then message="drive and medium ready"
    else overall=empty; message="drive healthy; no medium"; fi
  fi
  tmp="$STATE_DIR/${name}.json.tmp.$$"; final="$STATE_DIR/${name}.json"
  GENERATED="$(date --iso-8601=seconds)" DEVICE="$dev" ROLE="$role" SG="$sg" MODEL="$model" BLOCK="$block" SGOK="$sgok" MEDIA="$media" DRIVE_STATUS="$drive_status" BYTES="$bytes" FS="$fs" UNIT="$unit" INQ="$inq" TUR="$tur" ARM="$arm" ARMDEV="$armdev" ARMSG="$armsg" DEEP="$deep" OVERALL="$overall" MESSAGE="$message" OUT="$tmp" python3 - <<'PY2'
import json,os
b=lambda k:os.environ[k]=='yes'
d={'generated_at':os.environ['GENERATED'],'device':os.environ['DEVICE'],'role':os.environ['ROLE'],'sg_device':os.environ['SG'] or None,'model':os.environ['MODEL'] or None,'block_exists':b('BLOCK'),'sg_exists':b('SGOK'),'media_present':b('MEDIA'),'drive_status':os.environ.get('DRIVE_STATUS') or None,'size_bytes':int(os.environ['BYTES'] or 0),'filesystem':os.environ['FS'] or None,'rip_unit':os.environ['UNIT'],'inquiry':os.environ['INQ'],'tur':os.environ['TUR'],'arm_running':b('ARM'),'arm_block_visible':b('ARMDEV'),'arm_sg_visible':b('ARMSG'),'deep_read':os.environ['DEEP'],'overall':os.environ['OVERALL'],'message':os.environ['MESSAGE']}
with open(os.environ['OUT'],'w') as f: json.dump(d,f,indent=2,sort_keys=True); f.write('\n')
PY2
  mv -f "$tmp" "$final"
  ((QUIET)) || python3 -m json.tool "$final"
  [[ "$overall" != failed ]]
}
if ((ALL)); then mapfile -t ds < <(grep -E '^/dev/sr[0-9]+$' "$DRIVES_FILE" 2>/dev/null || true); rc=0; for d in "${ds[@]}"; do probe "$d" || rc=2; done; exit "$rc"; fi
[[ -n "$DEV" ]] || { usage; exit 64; }; probe "$DEV"
