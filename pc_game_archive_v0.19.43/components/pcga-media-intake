#!/usr/bin/env python3
from __future__ import annotations
import argparse,datetime as dt,fcntl,json,os,re,shutil,uuid
from pathlib import Path
STATE=Path('/var/lib/pc-game-archive/media-intake');ITEMS=STATE/'items';DISCS=STATE/'discs';COLLECTIONS=STATE/'collections'
def now():return dt.datetime.now(dt.timezone.utc).isoformat(timespec='seconds')
def norm(v):return ' '.join(re.sub(r'[^a-z0-9]+',' ',str(v or '').casefold()).split())
def load(p):
    try:d=json.loads(p.read_text());return d if isinstance(d,dict) else {}
    except Exception:return {}
def all_json(p):return [load(x) for x in sorted(p.glob('*.json')) if load(x)] if p.exists() else []
def save(p,d):p.parent.mkdir(parents=True,exist_ok=True);q=p.with_suffix(p.suffix+'.tmp');q.write_text(json.dumps(d,indent=2,sort_keys=True)+'\n');os.replace(q,p)
def req_item(i):
    d=load(ITEMS/f'{i}.json');
    if not d:raise SystemExit('media item not found')
    return d
def artifact_title_key(path: Path) -> str:
    """Strip queue timestamps and ARM-generated numeric suffixes, never track names."""
    name=path.stem if path.is_file() else path.name
    name=re.sub(r'^\d{8}-\d{6}-(?:\d+-)?','',name)
    name=re.sub(r'^(?:raw|transcode)-','',name,flags=re.I)
    name=re.sub(r'_\d{9,}$','',name)
    return norm(name)


def strong_title_match(artifact: str, record: dict) -> bool:
    """Reject generic/partial/time-only associations between concurrent drives."""
    generic={'unidentified','unidentified video','unknown','undefined','movie',
             'video','dvd','dvd video','dvdvideo','bluray','blu ray','bdrom','bdmv','title','main movie','feature'}
    for field in ('volume_label','title'):
        title=norm(record.get(field))
        if not title or title in generic or len(title)<7:
            continue
        # Exact is best.  Common ARM file suffixes (years, title indexes) may
        # follow a complete title; never use Jaccard or a low-signal overlap.
        if artifact == title or artifact.startswith(title+' '):
            return True
    return False


def attach_artifact(path: Path, explicit_fingerprint: str = '') -> dict:
    """Bind only a uniquely proven disc; do not use completion time to guess."""
    if not path.exists():
        raise SystemExit('artifact not found')
    dest=(path/'.pcga-media.json') if path.is_dir() else path.with_name(path.name+'.pcga-media.json')
    STATE.mkdir(parents=True,exist_ok=True)
    with (STATE/'attach.lock').open('a+') as lock:
        fcntl.flock(lock.fileno(),fcntl.LOCK_EX)
        existing=load(dest) if dest.is_file() else {}
        if existing:
            if not explicit_fingerprint or existing.get('fingerprint')==explicit_fingerprint:
                return {'attached':str(path),'fingerprint':existing.get('fingerprint'),'already_attached':True}
            raise SystemExit('artifact has different provenance; refusing overwrite')
        # ARM uses a shared completed directory. A directory name or recent
        # completion timestamp cannot prove which of two concurrently inserted
        # discs produced an artifact. Only a trusted fingerprint supplied by
        # an upstream per-drive producer may bind a media identity.
        if not explicit_fingerprint:
            raise SystemExit(2)
        candidates=[d for d in all_json(DISCS)
                    if str(d.get('fingerprint') or '')==explicit_fingerprint
                    and d.get('rip_status')=='complete']
        if len(candidates)!=1:
            # A missing or ambiguous match stays in review without metadata.
            raise SystemExit(2)
        d=candidates[0]
        shutil.copyfile(DISCS/f"{d['fingerprint']}.json",dest)
        aps=list(d.get('artifact_paths') or []);sp=str(path)
        if sp not in aps:aps.append(sp)
        d['artifact_paths']=aps;d['updated_at']=now();save(DISCS/f"{d['fingerprint']}.json",d)
        return {'attached':sp,'fingerprint':d['fingerprint'],'match':'explicit-fingerprint' if explicit_fingerprint else 'unique-strong-title'}


