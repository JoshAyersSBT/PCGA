    re.compile(r"(?i)(?:^|[ ._\-])(?P<season>\d{1,2})x(?P<episode>\d{1,3})(?=$|[ ._\-])"),
]


def log(message: str) -> None:
    print(f"[manual-review] {message}")
    try:
        subprocess.run(["logger", "-t", "PCGA-REVIEW", "--", message], check=False,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


def archive_root() -> Path:
    override = os.environ.get("PCGA_ROOT_OVERRIDE")
    if override:
        root = Path(override)
    elif ROOT_FILE.is_file():
        root = Path(ROOT_FILE.read_text(encoding="utf-8").strip())
    else:
        root = Path("/srv/pc-game-archive")
    if not root.is_absolute():
        raise RuntimeError(f"archive root must be absolute: {root}")
    return root.resolve()


def queue_roots(root: Path) -> list[tuple[str, Path]]:
    return [
        ("metadata-pending", root / "media/metadata-pending"),
        ("quarantine", root / "media/quarantine/unidentified"),
        ("duplicates", root / "media/quarantine/duplicates"),
    ]


def library_root(root: Path, kind: str) -> Path:
    mapping = {
        "movie": root / "media/library/movies",
        "tv": root / "media/library/tv",
        "music": root / "media/library/music",
        "home": root / "media/library/home-videos",
    }
    try:
        return mapping[kind]
    except KeyError as exc:
        raise ValueError(f"unknown media type: {kind}") from exc


def media_files(path: Path) -> list[Path]:
    if path.is_file():
        return [path] if path.suffix.lower() in MEDIA_EXTS and path.stat().st_size > 0 else []
    if not path.is_dir():
        return []
    files: list[Path] = []
    try:
        for p in path.rglob("*"):
            if p.is_file() and p.suffix.lower() in MEDIA_EXTS and p.stat().st_size > 0:
                files.append(p)
    except (OSError, PermissionError):
        return []
    return sorted(files)


def all_regular_files(path: Path) -> list[Path]:
    if path.is_file():
        if path.name.endswith(".pcga-classification.json"):
            return []
        return [path] if path.stat().st_size >= 0 else []
    if not path.is_dir():
        return []
    files: list[Path] = []
    try:
        for p in path.rglob("*"):
            if p.is_file() and p.name != ".pcga-classification.json" and not p.name.endswith(".pcga-classification.json"):
                files.append(p)
    except (OSError, PermissionError):
        return []
    return sorted(files)


def classification_manifest(path: Path) -> dict:
    manifest = path / ".pcga-classification.json" if path.is_dir() else path.with_name(path.name + ".pcga-classification.json")
    try:
        return json.loads(manifest.read_text(encoding="utf-8")) if manifest.is_file() else {}
    except Exception:
        return {}


def optical_media_manifest(path: Path) -> dict:
    if not path.is_dir():
        return {}
    manifest=path/'.pcga-media.json'
    try:
        data=json.loads(manifest.read_text(encoding='utf-8')) if manifest.is_file() else {}
        return data if isinstance(data,dict) else {}
    except Exception:
        return {}


def unwrap_single_media_dir(path: Path) -> Path:
    """Peel legacy wrapper dirs when exactly one child directory contains all media."""
    current = path
    for _ in range(4):
        if not current.is_dir():
            break
        direct_media = [p for p in current.iterdir() if p.is_file() and p.suffix.lower() in MEDIA_EXTS and p.stat().st_size > 0]
        if direct_media:
            break
        child_dirs = [p for p in current.iterdir() if p.is_dir() and media_files(p)]
        # Only unwrap an unambiguous single nested media directory.
        if len(child_dirs) != 1:
            break
        current = child_dirs[0]
    return current


def total_size(files: Iterable[Path]) -> int:
    size = 0
    for p in files:
        try:
            size += p.stat().st_size
        except OSError:
            pass
    return size


def human_size(value: int) -> str:
    size = float(value)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if size < 1024.0 or unit == "TB":
            return f"{size:.1f} {unit}" if unit != "B" else f"{int(size)} B"
        size /= 1024.0
    return f"{value} B"


def safe_component(value: str, field: str) -> str:
    value = value.strip().replace("\x00", "")
    value = re.sub(r"[\\/]", "-", value)
    value = re.sub(r"\s+", " ", value).strip(" .")
    if not value or value in {".", ".."}:
        raise ValueError(f"{field} is required")
    if len(value) > 180:
        value = value[:180].rstrip()
    return value


def normalize_year(value: str) -> str:
    value = value.strip()
    if not value:
        return ""
    if not re.fullmatch(r"(?:19|20)\d{2}", value):
        raise ValueError("year must be a four-digit year or blank")
    return value


def infer_title_year(name: str) -> tuple[str, str]:
    n = TIMESTAMP_PREFIX.sub("", name)
    n = ARM_SUFFIX.sub("", n)
    if n.lower().endswith(tuple(MEDIA_EXTS)):
        n = Path(n).stem
    year = ""
    m = YEAR_RE.search(n)
    if m:
        year = m.group(1)
        n = (n[:m.start()] + n[m.end():]).strip()
    n = n.rstrip("-_ ")
    n = n.replace("_", " ")
    n = re.sub(r"\s+", " ", n).strip()
    return n or "Untitled", year


def parse_episode_identity(name: str) -> dict | None:
    raw = TIMESTAMP_PREFIX.sub('', Path(name).stem)
    match = next((rx.search(raw) for rx in EPISODE_TOKEN_PATTERNS if rx.search(raw)), None)
    if not match:
        return None
    prefix = raw[:match.start()].strip(' ._-')
    suffix = raw[match.end():].strip(' ._-')
    series, year = infer_title_year(prefix)
    if not series or series == 'Untitled':
        return None
    try:
        season = int(match.group('season')); episode = int(match.group('episode'))
        end_raw = match.groupdict().get('episode_end')
        episode_end = int(end_raw) if end_raw else None
    except (TypeError, ValueError):
        return None
    episode_title, _ = infer_title_year(suffix) if suffix else ('', '')
    return {'series':series,'year':year,'season':season,'episode':episode,
            'episode_end':episode_end,'episode_title':episode_title if episode_title != 'Untitled' else ''}


def video_sequence_key(path: Path) -> tuple:
    """Sort MakeMKV/ARM tracks by numeric title/track number when present."""
    stem = TIMESTAMP_PREFIX.sub('', path.stem)
    match = re.search(r'(?i)(?:^|[._ -])(?:title|track)?[_ -]*t?(\d{1,4})(?=$|[._ -])', stem)
    if not match:
        match = re.search(r'(?i)(?:title|track)[_ -]*(\d{1,4})', stem)
    if match:
        try:
            return (0, int(match.group(1)), stem.lower())
        except (TypeError, ValueError):
            pass
    parts = re.split(r'(\d+)', stem.lower())
    natural = tuple(int(x) if x.isdigit() else x for x in parts)
    return (1, natural, stem.lower())



def optical_title_index(path: Path) -> int | None:
    """Best-effort MakeMKV title index from a ripped filename."""
    stem = TIMESTAMP_PREFIX.sub("", path.stem)
    patterns = (
        r"(?i)(?:^|[._ -])title[_ -]*t?(\d{1,4})(?=$|[._ -])",
        r"(?i)(?:^|[._ -])t(\d{1,4})(?=$|[._ -])",
        r"(?i)(?:^|[._ -])track[_ -]*(\d{1,4})(?=$|[._ -])",
    )
    for pattern in patterns:
        match = re.search(pattern, stem)
        if match:
            try:
                return int(match.group(1))
            except (TypeError, ValueError):
                return None
    return None


def optical_title_rows(media_source: dict) -> list[dict]:
    rows = media_source.get("title_table") if isinstance(media_source, dict) else None
    return [row for row in rows if isinstance(row, dict)] if isinstance(rows, list) else []


def optical_title_row_for_file(path: Path, rows: list[dict]) -> dict:
    basename = path.name.casefold()
    by_source = {
        Path(str(row.get("source_file") or "")).name.casefold(): row
        for row in rows if str(row.get("source_file") or "").strip()
    }
    if basename in by_source:
        return by_source[basename]
    index = optical_title_index(path)
    if index is not None:
        for row in rows:
            try:
                if int(row.get("index")) == index:
                    return row
            except (TypeError, ValueError):
                continue
    return {}


def optical_extra_category(path: Path, row: dict) -> str:
    text = " ".join((str(row.get("name") or ""), path.stem)).casefold()
    if any(token in text for token in ("trailer", "teaser", "preview")):
        return "trailers"
    if any(token in text for token in ("deleted", "extended scene", "alternate scene")):
        return "deleted scenes"
    if any(token in text for token in ("behind the scenes", "behind-the-scenes", "making of", "making-of")):
        return "behind the scenes"
    if "interview" in text:
        return "interviews"
    if any(token in text for token in ("featurette", "featurette", "documentary")):
        return "featurettes"
    if any(token in text for token in ("short", "short film")):
        return "shorts"
    return "extras"


def normalize_optical_role(value: str, default: str = "extras") -> str:
    role = str(value or "").strip().lower().replace("_", "-")
    aliases = {
        "main": "main-feature", "feature": "main-feature", "movie": "main-feature",
        "extra": "extras", "featurette": "featurettes", "deleted-scene": "deleted scenes",
        "deleted-scenes": "deleted scenes", "trailer": "trailers",
        "behind-the-scenes": "behind the scenes", "interview": "interviews",
        "short": "shorts", "ignore": "archive-only", "archived": "archive-only",
    }
    role = aliases.get(role, role)
    return role if role in OPTICAL_ROLE_DIRS else default


def requested_optical_role(value: str) -> str:
    """Reject malformed browser selections instead of silently converting to extras."""
    sentinel = "!invalid-role!"
    role = normalize_optical_role(value, sentinel)
    if role == sentinel:
        raise ValueError(f"Unrecognized optical title role: {value!r}")
    return role


def optical_review_title_rows(item: "ReviewItem") -> list[dict]:
    source = item.path
    media_source = optical_media_manifest(source)
    if not source.is_dir():
        return []
    rows = optical_title_rows(media_source)
    disc_structure=media_source.get('pcga_disc_structure') or {}
    dvd_navigation=(disc_structure.get('dvd_navigation') or {})
    videos = sorted([p for p in media_files(source) if p.suffix.lower() in VIDEO_EXTS], key=video_sequence_key)
    if not videos or (len(videos) < 2 and not disc_structure):
        return []
    ranked = []
    for path in videos:
        row = optical_title_row_for_file(path, rows)
        try: duration = int(row.get("duration_seconds") or 0)
        except (TypeError, ValueError): duration = 0
        try: size = int(row.get("size_bytes") or path.stat().st_size)
        except (TypeError, ValueError, OSError): size = 0
        try: chapters = int(row.get("chapters") or 0)
        except (TypeError, ValueError): chapters = 0
        ranked.append((duration, size, chapters, path, row))
    # This is only a suggestion for the UI, never a validated title choice.
    # Optical TINFO durations can describe a different playlist when their
    # source filename is not an exact match; use actual file size as a tiebreak.
    default_main = max(ranked, key=lambda x: (x[0], x[1], x[2]))[3] if ranked else None
    out=[]
    for duration,size,chapters,path,row in ranked:
        # No main track is preselected: the owner must confirm the feature.
        inferred = optical_extra_category(path,row)
        index = row.get("index")
        key = path.relative_to(source).as_posix()  # Stable even for duplicate basenames.
        out.append({
            "key": key, "file": path.name, "title_index": index,
            "name": str(row.get("name") or path.stem), "duration_seconds": duration,
            "size_bytes": size, "chapters": chapters, "role": inferred,
            "suggested_main": path == default_main,
            "disc_job_id":disc_structure.get('job_id'),
            "dvd_navigation_available":dvd_navigation.get('status')=='ok',
            "disc_source":disc_structure.get('kind'),
            "source_file":row.get('source_file'),
            "source_chapters":row.get('chapters'),
        })
    return out


def promote_optical_movie_multititle(source: Path, destination: Path, folder: str,
                                      media_source: dict, role_overrides: dict | None = None) -> list[dict]:
    """Promote one logical movie while preserving additional disc titles as extras.

    This is intentionally conservative: true multi-item/anthology manifests are
    rejected by promote() before reaching this helper. No ripped title is deleted.
    """
    if not source.is_dir():
        raise ValueError("optical multi-title promotion requires a directory source")
    videos = sorted([p for p in media_files(source) if p.suffix.lower() in VIDEO_EXTS],
                    key=video_sequence_key)
    if not videos:
        raise ValueError("optical movie contains no video titles")
    rows = optical_title_rows(media_source)
    role_overrides = role_overrides if isinstance(role_overrides, dict) else {}

    def requested_role(path: Path, row: dict, default: str) -> str:
        index = row.get("index")
        key = path.relative_to(source).as_posix()
        # A disc title index is not a unique file key: prefer the exact relative path.
        raw = role_overrides.get(key, role_overrides.get(path.name, role_overrides.get(str(index), default)))
        return normalize_optical_role(str(raw or default), default)

    requested_main=[]
    for path in videos:
        row=optical_title_row_for_file(path,rows)
        if requested_role(path,row,"extras") == "main-feature":
            requested_main.append(path)
    if len(requested_main) > 1:
        raise ValueError("Choose exactly one main feature for this disc")
    if not requested_main:
        raise ValueError('Select exactly one main feature in Manual Review; the largest or longest ripped title may be a bonus feature')
    main = requested_main[0]
    destination.mkdir(parents=True, exist_ok=True)
    main_target = destination / f"{folder}{main.suffix.lower()}"
    if main_target.exists():
        raise FileExistsError(f"destination already exists: {main_target}")

    plan: list[dict] = []
    row = optical_title_row_for_file(main, rows)
    shutil.move(str(main), str(main_target))
    plan.append({
        "source": main.name, "destination": str(main_target), "role": "main-feature",
        "title_index": row.get("index"), "duration_seconds": row.get("duration_seconds"),
        "size_bytes": row.get("size_bytes"),
    })

    for video in videos:
        if video == main or not video.exists():
            continue
        row = optical_title_row_for_file(video, rows)
        category = requested_role(video, row, optical_extra_category(video, row))
        if category == "main-feature":
            category = "extras"
        extra_dir = destination / OPTICAL_ROLE_DIRS.get(category, "extras")
        extra_dir.mkdir(parents=True, exist_ok=True)
        target = extra_dir / video.name
        if target.exists():
            target = extra_dir / (dt.datetime.now().strftime("%Y%m%d-%H%M%S-") + video.name)
        shutil.move(str(video), str(target))
        plan.append({
            "source": video.name, "destination": str(target), "role": category,
            "title_index": row.get("index"), "duration_seconds": row.get("duration_seconds"),
            "size_bytes": row.get("size_bytes"),
        })

    # Preserve the optical provenance next to the library item while keeping
    # review-internal markers out of Jellyfin's visible media naming.
    provenance = destination / ".pcga-optical-source.json"
    if media_source and provenance.exists():
        fingerprint = str(media_source.get("fingerprint") or "unknown")[:24]
        provenance = destination / f".pcga-optical-source-{fingerprint}.json"
    if media_source:
        provenance.write_text(json.dumps(media_source, indent=2, sort_keys=True) + "\n", encoding="utf-8")

    internal_names = {".pcga-media.json", ".pcga-classification.json"}
    leftovers = [p for p in source.rglob("*") if p.is_file()]
    if leftovers:
        disc_files = destination / "extras" / "Disc Files"
        for item in leftovers:
            if item.name in internal_names or item.name.endswith(".pcga-classification.json"):
                try:
                    item.unlink()
                except OSError:
                    pass
                continue
            disc_files.mkdir(parents=True, exist_ok=True)
            target = disc_files / item.name
            if target.exists():
                target = disc_files / (dt.datetime.now().strftime("%Y%m%d-%H%M%S-") + item.name)
            shutil.move(str(item), str(target))

    for d in sorted([x for x in source.rglob("*") if x.is_dir()], key=lambda x: len(x.parts), reverse=True):
        try:
            d.rmdir()
        except OSError:
            pass
    try:
        (source / ".pcga-media.json").unlink()
    except OSError:
        pass
    try:
        (source / ".pcga-classification.json").unlink()
    except OSError:
        pass
    try:
        source.rmdir()
    except OSError:
        pass
    return plan

def provider_folder_tag(provider: str, provider_id: str) -> str:
    p=(provider or '').strip().lower(); pid=(provider_id or '').strip()
    if not pid:
        return ''
    if p == 'tmdb' and re.fullmatch(r'\d+', pid): return f'[tmdbid-{pid}]'
    if p == 'tvdb' and re.fullmatch(r'\d+', pid): return f'[tvdbid-{pid}]'
    if (p in {'omdb','imdb'} or pid.startswith('tt')) and re.fullmatch(r'tt\d+', pid): return f'[imdbid-{pid}]'
    return ''


def provider_from_ids(ids: dict) -> tuple[str,str]:
    normalized={str(k).lower():str(v) for k,v in (ids or {}).items() if v is not None}
    for key,provider in (('tmdb','tmdb'),('imdb','imdb'),('tvdb','tvdb')):
        if normalized.get(key): return provider, normalized[key]
    return '', ''


def jellyfin_port() -> int:
    env=os.environ.get('PCGA_JELLYFIN_PORT','').strip()
    if env.isdigit(): return int(env)
    try:
        for line in STACK_ENV.read_text(encoding='utf-8').splitlines():
            if line.startswith('JELLYFIN_PORT='):
                value=line.split('=',1)[1].strip().strip('"\\\'')
                if value.isdigit(): return int(value)
    except OSError:
        pass
    return 8096


def jellyfin_token() -> str:
    try: return JELLYFIN_TOKEN_FILE.read_text(encoding='utf-8').strip()
    except OSError: return ''


def http_json(url: str, payload: dict | None = None, token: str = '', timeout: float = 8.0):
    data=None if payload is None else json.dumps(payload).encode('utf-8')
    headers={'User-Agent':f'PCGameArchive/{VERSION}','Accept':'application/json'}
    if data is not None: headers['Content-Type']='application/json'
    if token: headers['X-Emby-Token']=token
    req=urllib.request.Request(url,data=data,headers=headers,method='POST' if data is not None else 'GET')
    with urllib.request.urlopen(req,timeout=timeout) as resp:
        return json.loads(resp.read().decode('utf-8'))


def jellyfin_metadata_search(query: str, kind: str, year: str='') -> list[dict]:
    token=jellyfin_token()
    if not token:
        return []
    base=os.environ.get('PCGA_JELLYFIN_BASE_URL',f'http://127.0.0.1:{jellyfin_port()}').rstrip('/')
    kinds=['movie','tv'] if kind == 'all' else [kind]
    out=[]
    for media_kind in kinds:
        endpoint='Movie' if media_kind == 'movie' else 'Series'
        info={'Name':query}
        if year.isdigit(): info['Year']=int(year)
        payload={'SearchInfo':info,'IncludeDisabledProviders':False}
        try:
            rows=http_json(f'{base}/Items/RemoteSearch/{endpoint}',payload,token)
        except Exception as exc:
            log(f'Jellyfin remote metadata search {endpoint} failed: {type(exc).__name__}')
            continue
        for row in (rows if isinstance(rows,list) else [])[:12]:
            ids=row.get('ProviderIds') or {}
            provider,pid=provider_from_ids(ids)
            out.append({
                'kind':media_kind,'title':str(row.get('Name') or '').strip(),
                'year':str(row.get('ProductionYear') or '')[:4],
                'provider':provider,'provider_id':pid,'provider_ids':ids,
                'source':str(row.get('SearchProviderName') or 'Jellyfin provider'),
                'overview':str(row.get('Overview') or '').strip(),
            })
    return [r for r in out if r['title']]


def direct_metadata_search(query: str, kind: str, year: str='') -> list[dict]:
    pf=Path('/etc/pc-game-archive/arm-metadata-provider')
    provider=(pf.read_text().strip().lower() if pf.exists() else 'omdb')
    if provider not in ('omdb','tmdb'): provider='omdb'
    keyfile=Path('/etc/pc-game-archive/arm-omdb-key' if provider=='omdb' else '/etc/pc-game-archive/arm-tmdb-key')
    try: key=keyfile.read_text().strip()
    except OSError: key=''
    if not key: return []
    out=[]
    if provider == 'omdb':
        params={'apikey':key,'s':query}
        if kind == 'movie': params['type']='movie'
        elif kind == 'tv': params['type']='series'
        data=http_json(os.environ.get('PCGA_OMDB_ENDPOINT','https://www.omdbapi.com/')+'?'+urllib.parse.urlencode(params))
        for row in data.get('Search',[])[:12]:
            typ=str(row.get('Type') or '')
            mk='tv' if typ=='series' else 'movie' if typ=='movie' else ''
            if not mk: continue
            out.append({'kind':mk,'title':str(row.get('Title') or ''),'year':str(row.get('Year') or '')[:4],
                        'provider':'imdb','provider_id':str(row.get('imdbID') or ''),'provider_ids':{'Imdb':row.get('imdbID')},
                        'source':'OMDb','overview':''})
    else:
        endpoints=[]
        if kind in ('all','movie'): endpoints.append(('movie','https://api.themoviedb.org/3/search/movie'))
        if kind in ('all','tv'): endpoints.append(('tv','https://api.themoviedb.org/3/search/tv'))
        for mk,endpoint in endpoints:
            params={'api_key':key,'query':query}
            if year.isdigit(): params['year' if mk=='tv' else 'primary_release_year']=year
            data=http_json(os.environ.get('PCGA_TMDB_ENDPOINT',endpoint)+'?'+urllib.parse.urlencode(params))
            for row in data.get('results',[])[:12]:
                title=str(row.get('name') or row.get('title') or '')
                date=str(row.get('first_air_date') or row.get('release_date') or '')
                out.append({'kind':mk,'title':title,'year':date[:4],'provider':'tmdb','provider_id':str(row.get('id') or ''),
                            'provider_ids':{'Tmdb':row.get('id')},'source':'TMDb','overview':str(row.get('overview') or '')})
    return [r for r in out if r['title']]


def metadata_search(query: str, kind: str, year: str='') -> tuple[list[dict],str]:
    query=query.strip()
    if not query: raise ValueError('metadata search requires a title or series name')
    if kind not in {'all','movie','tv'}: kind='all'
    rows=jellyfin_metadata_search(query,kind,year)
    if rows: return rows,'Jellyfin metadata providers'
    rows=direct_metadata_search(query,kind,year)
    if rows: return rows,'PCGA configured metadata provider'
    raise ValueError('No metadata results. Check Jellyfin metadata providers/network access or configure a PCGA OMDb/TMDb key.')


def update_selected_metadata(source: Path, selection: dict[str,str]) -> str:
    manifest_path = source/'.pcga-classification.json' if source.is_dir() else source.with_name(source.name+'.pcga-classification.json')
    try: data=json.loads(manifest_path.read_text(encoding='utf-8')) if manifest_path.exists() else {}
    except Exception: data={}
    kind=selection.get('kind','')
    title=safe_component(selection.get('title',''),'metadata title')
    year=normalize_year(selection.get('year',''))
    provider=selection.get('provider','').strip().lower()[:20]
    provider_id=selection.get('provider_id','').strip()[:80]
    data.update({'classification':'tv' if kind=='tv' else 'movie','title':title,'year':year,
                 'provider':provider,'provider_id':provider_id,'action':'review','confidence':1.0})
    assignment_note=''
    if kind == 'tv':
        data['series']=title
        videos=sorted([f for f in media_files(source) if f.suffix.lower() in VIDEO_EXTS], key=video_sequence_key)
        parsed=[parse_episode_identity(v.name) for v in videos]
        if videos and not any(parsed):
            # Metadata identifies the series, not the episode numbers. Prepare a visible,
            # editable sequential plan instead of failing later at promotion time.
            try: season_num=int(str(data.get('season') or '1'))
            except ValueError: season_num=1
            try: episode_num=int(str(data.get('episode') or '1'))
            except ValueError: episode_num=1
            if season_num < 0 or season_num > 999: season_num=1
            if episode_num < 0 or episode_num > 9999: episode_num=1
            data['season']=str(season_num); data['episode']=str(episode_num)
            data['episode_assignment']='sequential'
            data['episode_assignment_count']=len(videos)
            assignment_note=(f' Prepared {len(videos)} unnumbered video track(s) for sequential assignment '
                             f'starting S{season_num:02d}E{episode_num:02d}; review the episode plan before routing.')
        elif videos and all(parsed):
            data['episode_assignment']='filename'
            data.pop('episode_assignment_count',None)
            assignment_note=' Episode numbers will be taken from the SxxEyy/1x02 filenames.'
        elif videos:
            data['episode_assignment']='mixed'
            data.pop('episode_assignment_count',None)
            assignment_note=' This item mixes numbered and unnumbered episode filenames; review the assignment before routing.'
    evidence=[str(x) for x in (data.get('evidence') or [])]
    evidence.append(f'Manual metadata selection: {title}' + (f' ({year})' if year else '') + (f' [{provider}:{provider_id}]' if provider_id else ''))
    data['evidence']=evidence[-8:]
    tmp=manifest_path.with_suffix(manifest_path.suffix+'.tmp')
    tmp.write_text(json.dumps(data,indent=2,sort_keys=True)+'\n',encoding='utf-8'); tmp.replace(manifest_path)
    return f'Selected metadata: {title}.' + assignment_note


def item_id(root: Path, path: Path) -> str:
    rel = path.resolve().relative_to(root.resolve()).as_posix().encode("utf-8")
    return base64.urlsafe_b64encode(rel).decode("ascii").rstrip("=")


def path_from_id(root: Path, encoded: str) -> Path:
    try:
        raw = encoded + "=" * (-len(encoded) % 4)
        rel = base64.urlsafe_b64decode(raw.encode("ascii")).decode("utf-8")
    except Exception as exc:
        raise ValueError("invalid item id") from exc
    candidate = (root / rel).resolve()
    allowed = [q.resolve() for _, q in queue_roots(root)]
    if not any(candidate == q or q in candidate.parents for q in allowed):
        raise ValueError("item is outside manual-review queues")
    if candidate in allowed:
        raise ValueError("queue root itself is not an item")
    return candidate



def library_optical_id(root: Path, path: Path) -> str:
    rel = path.resolve().relative_to(root.resolve()).as_posix().encode("utf-8")
    return "library:" + base64.urlsafe_b64encode(rel).decode("ascii").rstrip("=")


def library_optical_path_from_id(root: Path, encoded: str) -> Path:
    if not str(encoded).startswith("library:"):
        raise ValueError("invalid library optical item id")
    token = str(encoded).split(":", 1)[1]
    try:
        raw = token + "=" * (-len(token) % 4)
        rel = base64.urlsafe_b64decode(raw.encode("ascii")).decode("utf-8")
    except Exception as exc:
        raise ValueError("invalid library optical item id") from exc
    candidate = (root / rel).resolve()
    movies = library_root(root, "movie").resolve()
    if candidate == movies or movies not in candidate.parents or not candidate.is_dir():
        raise ValueError("library item is outside the movie library")
    return candidate


def _load_json(path: Path) -> dict:
    try:
        value = json.loads(path.read_text(encoding="utf-8")) if path.is_file() else {}
        return value if isinstance(value, dict) else {}
    except Exception:
        return {}


def _optical_provenance(movie_dir: Path) -> list[dict]:
    rows=[]
    for path in sorted(movie_dir.glob(".pcga-optical-source*.json")):
        data=_load_json(path)
        if data:
            data=dict(data); data["_path"]=str(path)
            rows.append(data)
    return rows


def _role_from_library_path(movie_dir: Path, path: Path) -> str:
    try: rel=path.relative_to(movie_dir)
    except ValueError: return "extras"
    if len(rel.parts) == 1:
        return "main-feature"
    parent=rel.parts[0].casefold()
    for role, dirname in OPTICAL_ROLE_DIRS.items():
        if dirname and parent == dirname.casefold():
            return role
    if parent == "disc files" or "disc files" in [p.casefold() for p in rel.parts]:
        return "extras"
    return "extras"


def library_optical_item_payload(root: Path, movie_dir: Path) -> dict:
    manifest=_load_json(movie_dir/".pcga-manual-review.json")
    provenance=_optical_provenance(movie_dir)
    plan=manifest.get("optical_titles") if isinstance(manifest.get("optical_titles"),list) else []
    rows=[]; seen=set()
    title_tables=[]
    for prov in provenance:
        title_tables.extend(optical_title_rows(prov))
    for raw in plan:
        if not isinstance(raw,dict): continue
        path_value=str(raw.get("destination") or "")
        path=Path(path_value) if path_value else None
        if path and not path.is_absolute(): path=movie_dir/path
        if not path or not path.exists():
            source_name=str(raw.get("source") or "")
            matches=[x for x in movie_dir.rglob(source_name) if x.is_file()] if source_name else []
            path=matches[0] if len(matches)==1 else None
        if not path or not path.is_file() or path.suffix.lower() not in VIDEO_EXTS: continue
        try: rel=path.relative_to(movie_dir).as_posix()
        except ValueError: continue
        seen.add(path.resolve())
        idx=raw.get("title_index")
        key=rel  # Stable per-file key; disc title indices are not guaranteed unique.
        rows.append({
            "key":key,"file":path.name,"path":rel,"source":str(raw.get("source") or path.name),
            "title_index":idx,"role":normalize_optical_role(str(raw.get("role") or _role_from_library_path(movie_dir,path))),
            "duration_seconds":raw.get("duration_seconds"),"size_bytes":raw.get("size_bytes") or _safe_stat_size(path),
            "recovered":bool(raw.get("recovered")),
        })
    for path in sorted([x for x in movie_dir.rglob("*") if x.is_file() and x.suffix.lower() in VIDEO_EXTS], key=video_sequence_key):
        if path.resolve() in seen: continue
        row=optical_title_row_for_file(path,title_tables)
        idx=row.get("index")
        try: rel=path.relative_to(movie_dir).as_posix()
        except ValueError: continue
        rows.append({
            "key":rel,"file":path.name,"path":rel,"source":path.name,
            "title_index":idx,"role":_role_from_library_path(movie_dir,path),
            "duration_seconds":row.get("duration_seconds"),"size_bytes":row.get("size_bytes") or _safe_stat_size(path),
            "recovered":False,
        })
    fingerprints=[]
    for prov in provenance:
        fp=str(prov.get("fingerprint") or "")
        if fp and fp not in fingerprints: fingerprints.append(fp)
    title=str(manifest.get("title") or infer_title_year(movie_dir.name)[0])
    year=str(manifest.get("year") or infer_title_year(movie_dir.name)[1] or "")
    return {
        "id":library_optical_id(root,movie_dir),"title":title,"year":year,"path":str(movie_dir),
        "fingerprints":fingerprints,"titles":rows,"title_count":len(rows),
        "role_labels":OPTICAL_ROLE_LABELS,"provenance_count":len(provenance),
        "legacy_multi_video": len(provenance)==0 and not plan and len(rows)>1,
    }


def scan_library_optical_items(root: Path) -> list[dict]:
    movies=library_root(root,"movie")
    if not movies.exists(): return []
    items=[]
    for movie in sorted([x for x in movies.iterdir() if x.is_dir()],key=lambda p:p.name.casefold()):
        has_provenance=bool(list(movie.glob(".pcga-optical-source*.json")) or
                            _load_json(movie/".pcga-manual-review.json").get("optical_titles"))
        # Previous releases sometimes moved every MakeMKV title into the top
        # level of a movie directory without a .pcga-optical-source sidecar.
        # Surface these for *manual* correction; never rewrite them unattended.
        if not has_provenance:
            # Older releases published one-track optical rips without a usable
            # optical sidecar. They must be correctable too: a single making-of
            # may be the *only* video in a misidentified movie folder.
            videos=[x for x in movie.rglob('*') if x.is_file() and x.suffix.lower() in VIDEO_EXTS]
            if not videos:
                continue
        payload=library_optical_item_payload(root,movie)
        if payload.get("titles"): items.append(payload)
    return items


def _unique_destination(path: Path) -> Path:
    if not path.exists(): return path
    stem,suffix=path.stem,path.suffix
    n=2
    while True:
        candidate=path.with_name(f"{stem} ({n}){suffix}")
        if not candidate.exists(): return candidate
        n+=1


def reclassify_library_optical(root: Path, encoded: str, roles: dict) -> dict:
    movie=library_optical_path_from_id(root,encoded)
    payload=library_optical_item_payload(root,movie)
    rows=payload.get("titles") or []
    if not rows: raise ValueError("movie has no optical title records")
    clean={str(k):requested_optical_role(str(v)) for k,v in (roles or {}).items()}
    desired=[]
    for row in rows:
        role=clean.get(str(row.get("key")), normalize_optical_role(str(row.get("role") or "extras")))
        desired.append((row,role))
    mains=[x for x in desired if x[1]=="main-feature"]
    if len(mains)!=1:
        raise ValueError("Choose exactly one main feature before saving disc-title roles")
    main_row=mains[0][0]
    current_paths={str(row.get("key")): movie/str(row.get("path")) for row,_ in desired}
    canonical_ext=(current_paths[str(main_row.get("key"))].suffix or ".mkv").lower()
    canonical=movie/(movie.name+canonical_ext)
    # Move the current canonical file out of the way first when another title becomes main.
    for row,role in desired:
        key=str(row.get("key")); current=current_paths[key]
        if current == canonical and row is not main_row and current.exists():
            destdir=movie/OPTICAL_ROLE_DIRS.get(role,"extras"); destdir.mkdir(parents=True,exist_ok=True)
            target=_unique_destination(destdir/current.name)
            shutil.move(str(current),str(target)); current_paths[key]=target
    updated=[]
    # Promote the selected main title first.
    key=str(main_row.get("key")); current=current_paths[key]
    if current.resolve()!=canonical.resolve():
        if canonical.exists():
            raise FileExistsError(f"cannot replace existing main feature: {canonical}")
        canonical.parent.mkdir(parents=True,exist_ok=True); shutil.move(str(current),str(canonical)); current_paths[key]=canonical
    # Route remaining tracks into their requested Jellyfin extras folders.
    for row,role in desired:
        key=str(row.get("key")); current=current_paths[key]
        if role=="main-feature": target=current
        else:
            destdir=movie/OPTICAL_ROLE_DIRS.get(role,"extras"); destdir.mkdir(parents=True,exist_ok=True)
            if current.parent.resolve()==destdir.resolve(): target=current
            else:
                target=_unique_destination(destdir/current.name); shutil.move(str(current),str(target)); current_paths[key]=target
        updated.append({
            "source":str(row.get("source") or target.name),"destination":str(target),"role":role,
            "title_index":row.get("title_index"),"duration_seconds":row.get("duration_seconds"),
            "size_bytes":row.get("size_bytes") or _safe_stat_size(target),"recovered":bool(row.get("recovered")),
        })
    manifest_path=movie/".pcga-manual-review.json"; manifest=_load_json(manifest_path)
    manifest.update({"type":"movie","title":payload.get("title"),"year":payload.get("year"),"optical_titles":updated,
                     "optical_reclassified_at":dt.datetime.now(dt.timezone.utc).isoformat(),"pcga_manual_review_version":VERSION})
    tmp=manifest_path.with_suffix(".tmp"); tmp.write_text(json.dumps(manifest,indent=2,sort_keys=True)+"\n",encoding="utf-8"); tmp.replace(manifest_path)
    refresh_jellyfin()
    return {"ok":True,"message":f"Updated {len(updated)} disc title role(s) for {movie.name}","item":library_optical_item_payload(root,movie)}


def set_aside_incorrect_movie(root: Path, encoded: str) -> dict:
    """Move a falsely published movie to the review queue without deleting files.

    For discs that yielded only a making-of or for wrongly identified content,
    a valid main movie may not exist. Keeping a 22-minute documentary as the
    primary film is worse than withholding the media from Jellyfin until it is
    examined. No automatic reclassification or merge takes place here.
    """
    movie = library_optical_path_from_id(root, encoded)
    movies = library_root(root, 'movie').resolve()
    if movie.parent.resolve() != movies:
        raise ValueError('Only top-level movie folders can be set aside')
    entries = library_optical_item_payload(root, movie).get('titles') or []
    if not entries:
        raise ValueError('No video files found to preserve')
    queue = root / 'media/quarantine/unidentified'
    queue.mkdir(parents=True, exist_ok=True)
    stamp = dt.datetime.now(dt.timezone.utc).strftime('%Y%m%d-%H%M%S')
    candidate = queue / (stamp + '-needs-feature-' + movie.name)
    counter = 1
    while candidate.exists():
        candidate = queue / (stamp + f'-needs-feature-{counter}-' + movie.name)
        counter += 1
    movie.rename(candidate)
    manifest_path = candidate / '.pcga-manual-review.json'
    manifest = _load_json(manifest_path)
    manifest.update({'type': 'needs-feature-review', 'optical_reconciliation_blocked': True,
                     'optical_identity_unverified': True,
                     'optical_set_aside_at': dt.datetime.now(dt.timezone.utc).isoformat(),
                     'pcga_manual_review_version': VERSION,
                     'previous_library_path': str(movie)})
    temp=manifest_path.with_suffix('.tmp')
    temp.write_text(json.dumps(manifest,indent=2,sort_keys=True)+'\n',encoding='utf-8')
    temp.replace(manifest_path)
    (candidate / '.pcga-source-hint').write_text('optical-unverified\n',encoding='utf-8')
    # Reject stale automatic classification for preserved but unverified content.
    classification=candidate / '.pcga-classification.json'
    info=_load_json(classification)
    info.update({'action':'review','confidence':0.0,'classification':'video',
                 'subtype':'optical-unverified','evidence':['Published movie set aside: feature missing or disc identity incorrect']})
    ct=classification.with_suffix('.tmp')
    ct.write_text(json.dumps(info,indent=2,sort_keys=True)+'\n',encoding='utf-8')
    ct.replace(classification)
    refresh_jellyfin()
    return {'ok': True, 'message': 'Moved movie folder to Manual Review; all video files are preserved',
            'destination': str(candidate)}


def split_library_optical_title(root: Path, encoded: str, key: str, title: str, year: str = "") -> dict:
    """Separate an incorrectly joined feature into its own movie without overwrites.

    A deliberate user operation. Never merges into an existing library title,
    changes other discs' metadata, or deletes a movie/video.
    """
    movie = library_optical_path_from_id(root, encoded)
    payload = library_optical_item_payload(root, movie)
    rows = payload.get("titles") or []
    if len(rows) < 2:
        raise ValueError("Only multi-title movie folders can be split")
    matching = [row for row in rows if str(row.get("key")) == str(key)]
    if len(matching) != 1:
        raise ValueError("Selected title is no longer in this movie; refresh Manual Review")
    chosen = matching[0]
    # Prevent leaving a folder with extras but no playable main feature.
    if chosen.get("role") == "main-feature" and not any(
        row is not chosen and row.get("role") == "main-feature" for row in rows
    ):
        raise ValueError("First assign and save the correct main feature in the source movie, then separate this title")
    rel = Path(str(chosen.get("path") or ""))
    if rel.is_absolute() or ".." in rel.parts or str(rel) in {".", ""}:
        raise ValueError("Invalid title path")
    source = (movie / rel).resolve()
    if not source.is_file() or movie.resolve() not in source.parents or source.suffix.lower() not in VIDEO_EXTS:
        raise ValueError("Source title is missing or outside the movie folder")
    title = safe_component(title, "new movie title")
    year = normalize_year(year)
    basename = f"{title} ({year})" if year else title
    destdir = library_root(root, "movie") / basename
    if destdir.exists():
        raise FileExistsError(f"Destination already exists: {destdir}; refusing to merge two movies automatically")
    dest_video = destdir / f"{basename}{source.suffix.lower()}"
    destdir.mkdir(parents=True, exist_ok=False)
    try:
        shutil.move(str(source), str(dest_video))
    except Exception:
        destdir.rmdir()
        raise
    # Once the move succeeds, retain an explicit record of the new identity.
    stamp = dt.datetime.now(dt.timezone.utc).isoformat()
    source_record = {
        "type": "movie", "title": title, "year": year,
        "source": str(movie), "optical_split_from": str(movie),
        "optical_split_at": stamp, "pcga_manual_review_version": VERSION,
        "optical_reconciliation_blocked": True,
        "optical_titles": [{
            "source": chosen.get("source") or source.name, "destination": str(dest_video),
            "role": "main-feature", "title_index": chosen.get("title_index"),
            "duration_seconds": chosen.get("duration_seconds"),
            "size_bytes": chosen.get("size_bytes") or _safe_stat_size(dest_video),
            "recovered": bool(chosen.get("recovered")),
        }],
    }
    # Both folders must record human intervention: never reimport the deliberately
    # removed video as a "missing extra" during reconciliation.
    old_path = movie / ".pcga-manual-review.json"
    old = _load_json(old_path)
    old["optical_titles"] = [{
        "source": row.get("source") or row.get("file"),
        "destination": str(movie / str(row.get("path"))),
        "role": row.get("role"), "title_index": row.get("title_index"),
        "duration_seconds": row.get("duration_seconds"),
        "size_bytes": row.get("size_bytes"),
        "recovered": bool(row.get("recovered")),
    } for row in rows if row is not chosen]
    old.update({"optical_reconciliation_blocked": True, "optical_split_at": stamp,
                "pcga_manual_review_version": VERSION})
    for path, value in ((destdir / ".pcga-manual-review.json", source_record), (old_path, old)):
        temp = path.with_suffix(".tmp")
        temp.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        temp.replace(path)
    refresh_jellyfin()
    return {"ok": True, "message": f"Separated one video into {basename}; source title preserved",
            "source_item": library_optical_item_payload(root, movie),
            "new_item": library_optical_item_payload(root, destdir)}


def rename_library_optical_movie(root: Path, encoded: str, title: str, year: str = "") -> dict:
    """Fix an incorrectly assigned movie identity without merging library content."""
    movie = library_optical_path_from_id(root, encoded)
    movies = library_root(root, "movie").resolve()
    if movie.parent.resolve() != movies:
        raise ValueError("Movie identity edits require a top-level movie folder")
    payload = library_optical_item_payload(root, movie)
    rows = payload.get("titles") or []
    mains = [row for row in rows if row.get("role") == "main-feature"]
    if len(mains) != 1:
        raise ValueError("Choose exactly one main feature in the published-title review before changing the movie identity")
    title = safe_component(title, "correct movie title")
    year = normalize_year(year)
    newname = f"{title} ({year})" if year else title
    destination = movies / newname
    if destination != movie and destination.exists():
        raise FileExistsError(f"Destination already exists: {destination}; refusing an automatic merge")
    main_row = mains[0]
    oldmain_rel = Path(str(main_row.get("path") or ""))
    if oldmain_rel.is_absolute() or ".." in oldmain_rel.parts:
        raise ValueError("Unsafe movie filename")
    oldmain = (movie / oldmain_rel).resolve()
    if not oldmain.is_file() or movie.resolve() not in oldmain.parents:
        raise ValueError("Main feature is unavailable")
    newmain_rel = Path(newname + oldmain.suffix.lower())
    if (movie/newmain_rel).exists() and (movie/newmain_rel).resolve() != oldmain:
        raise FileExistsError("The corrected main-feature filename is already occupied")
    if destination != movie:
        movie.rename(destination)  # Atomic directory rename within the movie library.
    main_in_newdir = destination / oldmain_rel
    if main_in_newdir != destination / newmain_rel:
        main_in_newdir.rename(destination / newmain_rel)
    updated=[]
    for row in rows:
        rel = newmain_rel if row is main_row else Path(str(row.get("path")))
        target = destination / rel
        updated.append({
            "source": row.get("source") or row.get("file"), "destination": str(target),
            "role": row.get("role"), "title_index": row.get("title_index"),
            "duration_seconds": row.get("duration_seconds"),
            "size_bytes": row.get("size_bytes") or _safe_stat_size(target),
            "recovered": bool(row.get("recovered")),
        })
    manifest_path = destination/".pcga-manual-review.json"
    manifest = _load_json(manifest_path)
    manifest.update({"type": "movie", "title": title, "year": year,
                     "optical_titles": updated, "optical_reconciliation_blocked": True,
                     "optical_identity_corrected_at": dt.datetime.now(dt.timezone.utc).isoformat(),
                     "pcga_manual_review_version": VERSION})
    tmp = manifest_path.with_suffix('.tmp')
    tmp.write_text(json.dumps(manifest,indent=2,sort_keys=True)+"\n",encoding="utf-8")
    tmp.replace(manifest_path)
    refresh_jellyfin()
    return {"ok": True, "message": f"Corrected movie identity to {newname}",
            "item": library_optical_item_payload(root,destination)}


def _quick_video_signature(path: Path) -> str:
    st=path.stat(); size=st.st_size; h=__import__("hashlib").sha256(); h.update(str(size).encode()+b"\0")
    sample=1024*1024
    with path.open("rb",buffering=0) as f:
        offsets=[0]
        if size>sample*3: offsets.append(max(0,size//2-sample//2))
        if size>sample: offsets.append(max(0,size-sample))
        for off in sorted(set(offsets)):
            f.seek(off); h.update(f.read(sample))
    return h.hexdigest()


def reconcile_existing_optical(root: Path, quiet: bool=False) -> dict:
    """Recover missing MakeMKV titles for already-promoted optical movies.

    Sources are never deleted.  PCGA only imports a track when its optical
    fingerprint matches a promoted movie and its sampled content is not already
    represented in that movie folder.  Recovered tracks land in Extras and can
    then be reclassified from the portal.
    """
    candidates=[]
    search_roots=[q for _,q in queue_roots(root)]+[root/"media/arm/work/completed"]
    for base in search_roots:
        if not base.exists(): continue
        try:
            for manifest in base.rglob(".pcga-media.json"):
                data=_load_json(manifest); fp=str(data.get("fingerprint") or "")
                if fp: candidates.append((fp,manifest.parent,data))
        except OSError: continue
    imported=0; scanned=0; touched=[]
    for item in scan_library_optical_items(root):
        fps=set(str(x) for x in (item.get("fingerprints") or []) if x)
        if not fps: continue
        movie=library_optical_path_from_id(root,str(item["id"]))
        if _load_json(movie/".pcga-manual-review.json").get("optical_reconciliation_blocked"):
            continue  # A deliberate human split must never be reversed automatically.
        scanned+=1
        existing=[x for x in movie.rglob("*") if x.is_file() and x.suffix.lower() in VIDEO_EXTS]
        sigs=set()
        for path in existing:
            try: sigs.add(_quick_video_signature(path))
            except OSError: pass
        recovered=[]
        for fp,source,_meta in candidates:
            if fp not in fps: continue
            for video in sorted([x for x in media_files(source) if x.suffix.lower() in VIDEO_EXTS],key=video_sequence_key):
                try: sig=_quick_video_signature(video)
                except OSError: continue
                if sig in sigs: continue
                destdir=movie/"extras"/"Recovered Disc Titles"; destdir.mkdir(parents=True,exist_ok=True)
                target=_unique_destination(destdir/video.name)
                try: os.link(video,target); method="hard-link"
                except OSError: shutil.copy2(video,target); method="copy"
                sigs.add(sig); imported+=1; recovered.append((video,target,method))
        if recovered:
            manifest_path=movie/".pcga-manual-review.json"; manifest=_load_json(manifest_path)
            plan=manifest.get("optical_titles") if isinstance(manifest.get("optical_titles"),list) else []
            for source,target,method in recovered:
                plan.append({"source":source.name,"destination":str(target),"role":"extras","title_index":optical_title_index(source),
                             "size_bytes":_safe_stat_size(target),"recovered":True,"recovery_method":method})
            manifest.update({"type":"movie","title":item.get("title"),"year":item.get("year"),"optical_titles":plan,
                             "optical_reconciled_at":dt.datetime.now(dt.timezone.utc).isoformat(),"pcga_manual_review_version":VERSION})
            tmp=manifest_path.with_suffix(".tmp"); tmp.write_text(json.dumps(manifest,indent=2,sort_keys=True)+"\n",encoding="utf-8"); tmp.replace(manifest_path)
            touched.append(movie.name)
            if not quiet: log(f"Recovered {len(recovered)} missing optical title(s) for {movie.name}")
    if imported: refresh_jellyfin()
    return {"ok":True,"scanned":scanned,"imported":imported,"movies":touched,"message":f"Optical reconciliation scanned {scanned} movie(s) and recovered {imported} missing title(s)."}


@dataclass
class ReviewItem:
    id: str
    source: str
    path: Path
    files: list[Path]
    size: int
    title: str
    year: str
    media_kind: str
    confidence: float | None
    evidence: list[str]
    provider: str = ""
    provider_id: str = ""
    series: str = ""
    season: str = ""
    episode: str = ""
    episode_title: str = ""

    @property
    def display_path(self) -> str:
        return str(self.path)

    @property
    def sample_names(self) -> list[str]:
        return [p.name for p in self.files[:5]]


def scan_items(root: Path) -> list[ReviewItem]:
    items: list[ReviewItem] = []
    for source_name, queue in queue_roots(root):
        queue.mkdir(parents=True, exist_ok=True)
        for child in sorted(queue.iterdir(), key=lambda p: p.name.lower()):
            if child.name.startswith(".pcga-") or child.name.endswith(".pcga-classification.json"):
                continue
            candidate = unwrap_single_media_dir(child)
            media = media_files(candidate)
            files = media or all_regular_files(candidate)
            if not files:
                continue
            manifest = classification_manifest(candidate)
            title, year = infer_title_year(candidate.name)
            title = str(manifest.get("title") or title)
            year = str(manifest.get("year") or year or "")[:4]
            exts = {p.suffix.lower() for p in files}
            detected = str(manifest.get("classification") or "")
            if not detected:
                if media and exts and exts <= AUDIO_EXTS:
                    detected = "audio"
                elif media and exts & VIDEO_EXTS:
                    detected = "video"
                else:
                    detected = "data"
            conf = manifest.get("confidence")
            try: conf = float(conf) if conf is not None else None
            except (TypeError, ValueError): conf = None
            evidence = [str(x) for x in (manifest.get("evidence") or [])[:4]]
            items.append(ReviewItem(
                id=item_id(root, candidate), source=source_name, path=candidate,
                files=files, size=total_size(files), title=title, year=year, media_kind=detected,
                confidence=conf, evidence=evidence,
                provider=str(manifest.get("provider") or ""),
                provider_id=str(manifest.get("provider_id") or ""),
                series=str(manifest.get("series") or (title if detected == "tv" else "")),
                season=str(manifest.get("season") or ""),
                episode=str(manifest.get("episode") or ""),
                episode_title=str(manifest.get("episode_title") or ""),
            ))
    return items


def _safe_stat_size(path: Path) -> int:
    try:
        return int(path.stat().st_size)
    except OSError:
        return 0


def preview_source(item: ReviewItem) -> tuple[str, Path] | tuple[None, None]:
    """Choose a deterministic, representative file for portal Manual Review.

    Prefer the largest video so DVD/BD extras and tiny menu tracks do not become
    the only useful clue. Images and audio are used when no video exists.
    """
    videos=[p for p in item.files if p.suffix.lower() in VIDEO_EXTS and p.exists()]
    if videos:
        return 'video', max(videos, key=_safe_stat_size)
    regular=all_regular_files(item.path)
    images=[p for p in regular if p.suffix.lower() in IMAGE_EXTS and p.exists()]
    if images:
        return 'image', max(images, key=_safe_stat_size)
    audio=[p for p in item.files if p.suffix.lower() in AUDIO_EXTS and p.exists()]
    if audio:
        return 'audio', max(audio, key=_safe_stat_size)
    return None, None


def media_duration_seconds(path: Path) -> float:
    try:
        proc=subprocess.run([
            'ffprobe','-v','error','-show_entries','format=duration',
            '-of','default=noprint_wrappers=1:nokey=1',str(path)
        ],check=False,capture_output=True,text=True,timeout=12)
        value=float((proc.stdout or '').strip() or 0)
        return value if value > 0 else 0.0
    except Exception:
        return 0.0


def review_preview_payload(item: ReviewItem) -> dict:
    kind,path=preview_source(item)
    if not path or not kind:
        return {'available':False}
    return {
        'available':True,
        'kind':kind,
        'name':path.name,
        'size':_safe_stat_size(path),
        'size_human':human_size(_safe_stat_size(path)),
        # Keep queue enumeration cheap. Duration is probed only when a preview
        # is actually opened rather than once per item on every portal refresh.
        'duration_seconds':0,
        'clip_seconds':PREVIEW_CLIP_SECONDS if kind in {'video','audio'} else 0,
    }


def review_item_payload(item: ReviewItem) -> dict:
    videos = sorted([f for f in item.files if f.suffix.lower() in VIDEO_EXTS], key=video_sequence_key)
    episode_plan = {"mode": "none", "rows": []}
    if videos and (item.media_kind == "tv" or item.series):
        parsed = [parse_episode_identity(v.name) for v in videos]
        if all(parsed):
            episode_plan["mode"] = "filename"
            for video, ep in zip(videos, parsed):
                token = f"S{int(ep['season']):02d}E{int(ep['episode']):02d}"
                if ep.get("episode_end") is not None and int(ep["episode_end"]) != int(ep["episode"]):
                    token += f"-E{int(ep['episode_end']):02d}"
                episode_plan["rows"].append({"file": video.name, "target": token})
        elif any(parsed):
            episode_plan["mode"] = "mixed"
            for video, ep in zip(videos, parsed):
                token = f"S{int(ep['season']):02d}E{int(ep['episode']):02d}" if ep else "Needs assignment"
                episode_plan["rows"].append({"file": video.name, "target": token})
        else:
            episode_plan["mode"] = "sequential"
            episode_plan["rows"] = [{"file": video.name, "offset": index} for index, video in enumerate(videos)]
    return {
        "id": item.id, "source": item.source, "path": item.display_path, "title": item.title,
        "year": item.year, "media_kind": item.media_kind, "confidence": item.confidence,
        "evidence": item.evidence, "provider": item.provider, "provider_id": item.provider_id,
        "series": item.series, "season": item.season, "episode": item.episode,
        "episode_title": item.episode_title, "size": item.size, "size_human": human_size(item.size),
        "file_count": len(item.files), "files": [x.name for x in item.files[:24]],
        "files_truncated": max(0, len(item.files) - 24), "episode_plan": episode_plan,
        "preview": review_preview_payload(item), "optical_titles": optical_review_title_rows(item),
        "optical_role_labels": OPTICAL_ROLE_LABELS,
    }



# A DVD VOB chunk, a playlist clip and a separately ripped title are not
# interchangeable. We never infer chapter membership from matching disc names.
# An operator must select and order each source explicitly; originals stay put.
def _segment_job_dir(root: Path) -> Path:
    base = root / 'media' / 'segment-assembly-jobs'
    base.mkdir(parents=True, exist_ok=True)
    return base


def _segment_job_file(root: Path, job: str) -> Path:
    if not re.fullmatch(r'[0-9a-f]{32}', str(job)):
        raise ValueError('Invalid segment job ID')
    return _segment_job_dir(root) / f'{job}.json'


def _atomic_job_write(root: Path, job: str, info: dict) -> None:
    target = _segment_job_file(root, job)
    with tempfile.NamedTemporaryFile('w', dir=str(target.parent), prefix='.segment-', delete=False, encoding='utf-8') as stream:
        json.dump(info, stream, indent=2, sort_keys=True)
        stream.write('\n')
        tmp = Path(stream.name)
    tmp.replace(target)


def _segment_sources(root: Path, item_id_value: str, keys: list[str]) -> tuple[ReviewItem, list[Path]]:
    if not isinstance(keys, list) or not 2 <= len(keys) <= 64:
        raise ValueError('Select between 2 and 64 segments in their intended playback order')
    if any(not isinstance(k, str) for k in keys) or len(set(keys)) != len(keys):
        raise ValueError('Segments must be individually selected and cannot repeat')
    item = find_review_item(root, item_id_value)
    if not item.path.is_dir() or item.path.is_symlink():
        raise ValueError('Segment assembly requires one review directory')
    # Do not allow combining items from separate rip jobs or movie folders.
    valid = {x.relative_to(item.path).as_posix(): x for x in item.files
             if x.suffix.lower() in VIDEO_EXTS and x.is_file() and not x.is_symlink()}
    paths = []
    for key in keys:
        path = valid.get(key)
        if path is None:
            raise ValueError('A selected segment is outside this review item')
        if any(x.is_symlink() for x in (path, *list(path.parents)[:len(path.parents)-len(item.path.parents)])):
            raise ValueError('Symlinked source segments are unsupported')
        paths.append(path)
    return item, paths


def _probe_segment(path: Path) -> tuple[float, tuple]:
    proc = subprocess.run(['ffprobe', '-v', 'error', '-show_streams', '-show_format',
                           '-show_data_hash', 'sha256', '-of', 'json', str(path)],
                          capture_output=True, text=True, timeout=40, check=True)
    data = json.loads(proc.stdout)
    seconds = float((data.get('format') or {}).get('duration') or 0)
    if not 0 < seconds <= 6 * 3600:
        raise ValueError(f'Invalid or unknown duration: {path.name}')
    streams = [x for x in data.get('streams', []) if x.get('codec_type') in ('video','audio','subtitle')]
    if not any(x.get('codec_type') == 'video' for x in streams):
        raise ValueError(f'No video stream: {path.name}')
    signature = tuple((x.get('codec_type'), x.get('codec_name'), x.get('profile'),
                       x.get('width'), x.get('height'), x.get('pix_fmt'),
                       x.get('sample_rate'), x.get('channels'), x.get('channel_layout'),
                       x.get('extradata_hash')) for x in streams)
    return seconds, signature


def assemble_segment_job(root: Path, job: str) -> dict:
    state = json.loads(_segment_job_file(root, job).read_text(encoding='utf-8'))
    if state.get('status') != 'queued':
        raise ValueError('Job has already been started')
    state['status'] = 'running'
    state['phase'] = 'Checking streams and segment order'
    _atomic_job_write(root, job, state)
    workspace = root / 'media' / 'metadata-pending' / f'.pcga-segment-build-{job}'
    try:
        item, paths = _segment_sources(root, str(state['item']), state['tracks'])
        if not shutil.which('ffmpeg') or not shutil.which('ffprobe'):
            raise ValueError('ffmpeg and ffprobe are required to assemble segments')
        signatures=[]; durations=[]
        for path in paths:
            duration, signature = _probe_segment(path)
            durations.append(duration); signatures.append(signature)
        if any(x != signatures[0] for x in signatures[1:]):
            raise ValueError('Selected files have incompatible stream formats; no video was created. Check the original disc playlist/IFO instead.')
        if sum(durations) > 12*3600:
            raise ValueError('Selected segments exceed the 12-hour safety limit')
        workspace.mkdir(parents=True, exist_ok=False)
        output = workspace / 'assembled.mkv'
        # FFmpeg concat demuxer requires files listed in order, not time-based
        # filenames or a loosely correlated disc title. Absolute paths are
        # escaped, and -safe 0 is restricted to server-validated queue files.
        def ffquote(path: Path) -> str:
            return str(path).replace("'", "'\\''")
        playlist = workspace / '.pcga-concat.txt'
        playlist.write_text(''.join("file '" + ffquote(path) + "'\n" for path in paths), encoding='utf-8')
        state['phase'] = 'Assembling selected segments (stream copy, originals untouched)'
        _atomic_job_write(root, job, state)
        result=subprocess.run(['ffmpeg','-nostdin','-hide_banner','-loglevel','error',
                               '-f','concat','-safe','0','-i',str(playlist),
                               '-map','0','-c','copy','-avoid_negative_ts','make_zero',
                               '-f','matroska',str(output)], capture_output=True, text=True, timeout=7200)
        if result.returncode or not output.is_file() or output.stat().st_size < 1024:
            raise ValueError('FFmpeg could not assemble these clips: '+(result.stderr or 'empty output')[-500:])
        merged_duration, _ = _probe_segment(output)
        expected = sum(durations)
        if abs(merged_duration-expected) > max(10,expected*0.03):
            raise ValueError(f'Joined runtime ({merged_duration:.1f}s) does not match selected segments ({expected:.1f}s); originals preserved')
        # Output is a NEW review candidate, never silently promoted to Jellyfin.
        folder = safe_component(item.title or 'Segmented movie', 'title')[:90]
        result_path = root/'media'/'metadata-pending'/f'{dt.datetime.now():%Y%m%d-%H%M%S}-assembled-{folder}-{job[:8]}'
        if result_path.exists():
            raise FileExistsError('Segment output candidate already exists')
        manifest = {'schema':1,'type':'optical-segment-assembly','source_item':str(item.path),
                    'segment_keys':state['tracks'],'durations_seconds':durations,
                    'expected_duration_seconds':expected,'assembled_duration_seconds':merged_duration,
                    'original_files_preserved':True,'review_required':True,
                    'created_utc':dt.datetime.now(dt.timezone.utc).isoformat()}
        (workspace/'.pcga-segment-assembly.json').write_text(json.dumps(manifest, indent=2)+'\n',encoding='utf-8')
        (workspace/'.pcga-classification.json').write_text(json.dumps({
            'classification':'movie','subtype':'optical-segment-assembly','confidence':0.5,
            'action':'review','title':item.title,'year':item.year,
            'evidence':['Segments explicitly ordered by operator','Source files remain preserved; verify joined playback before promotion']
        },indent=2)+'\n', encoding='utf-8')
        (workspace/'.pcga-source-hint').write_text('optical-segments\n',encoding='utf-8')
        playlist.unlink()
        workspace.rename(result_path)
        state.update(status='complete',phase='Awaiting human review',result_item=item_id(root,result_path),
                     result_path=str(result_path),runtime_seconds=merged_duration)
        _atomic_job_write(root, job, state)
        return state
    except Exception as exc:
        state.update(status='failed', phase='Assembly failed', error=str(exc)[:600])
        _atomic_job_write(root, job, state)
        raise
    finally:
        # Never touch the original disc media or source queue item.
        if workspace.exists():
            shutil.rmtree(workspace)


def schedule_segment_job(root: Path, item_id_value: str, tracks: list[str]) -> dict:
    _segment_sources(root, item_id_value, tracks)
    # Avoid duplicate job creation from repeat clicks; retain metadata for
    # previously completed/failed jobs, but never run two for one source.
    for old in _segment_job_dir(root).glob('*.json'):
        try:
            data=json.loads(old.read_text(encoding='utf-8'))
            if data.get('item') == item_id_value and data.get('status') in ('queued','running'):
                return {'ok':True,'job':old.stem,'status':data['status'],'message':'An assembly is already active for this review item'}
        except (OSError, ValueError, KeyError):
            continue
    job=uuid.uuid4().hex
    state={'job':job,'item':item_id_value,'tracks':tracks,'status':'queued',
           'phase':'Queued for assembly','created_at':time.time()}
    _atomic_job_write(root, job, state)
    try:
        # Independent worker: an ffmpeg concat may take minutes, and the API
        # request must not hold the portal open or time out during the copy.
        subprocess.Popen([sys.executable, __file__, 'assemble-segments-job', '--job',job],
                         stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL,start_new_session=True,close_fds=True,
                         env={**os.environ,'PCGA_ROOT_OVERRIDE':str(root)})
    except Exception as exc:
        state.update(status='failed',error=str(exc)); _atomic_job_write(root,job,state)
        raise
    return {'ok':True,'job':job,'status':'queued','message':'Assembly started; original chapters will be preserved'}


def find_review_item(root: Path, encoded: str) -> ReviewItem:
    for item in scan_items(root):
        if secrets.compare_digest(item.id, encoded):
            return item
    path_from_id(root, encoded)
    raise FileNotFoundError("review item is no longer queued")


def tv_assignment_preview(item: ReviewItem) -> str:
    videos=sorted([f for f in item.files if f.suffix.lower() in VIDEO_EXTS], key=video_sequence_key)
    if not videos or not (item.media_kind == 'tv' or item.series):
        return ''
    parsed=[parse_episode_identity(v.name) for v in videos]
    if all(parsed):
        rows=[]
        for video,ep in zip(videos,parsed):
            token=f"S{int(ep['season']):02d}E{int(ep['episode']):02d}"
            if ep.get('episode_end') is not None and int(ep['episode_end']) != int(ep['episode']):
                token += f"-E{int(ep['episode_end']):02d}"
            rows.append(f'<tr><td>{html.escape(video.name)}</td><td><strong>{html.escape(token)}</strong></td></tr>')
        return '<section class="episode-plan"><strong>Episode assignment</strong><div class="muted">Episode numbers are already encoded in the filenames.</div><table><thead><tr><th>Source track</th><th>Jellyfin episode</th></tr></thead><tbody>'+''.join(rows)+'</tbody></table></section>'
    if any(parsed):
        rows=[]
        for video,ep in zip(videos,parsed):
            token=(f"S{int(ep['season']):02d}E{int(ep['episode']):02d}" if ep else 'Needs assignment')
            rows.append(f'<tr><td>{html.escape(video.name)}</td><td><strong>{html.escape(token)}</strong></td></tr>')
        return '<section class="episode-plan warning"><strong>Episode assignment needs review</strong><div class="muted">This folder mixes numbered and unnumbered tracks. PCGA will not guess a mixed mapping.</div><table><tbody>'+''.join(rows)+'</tbody></table></section>'
    season=item.season if item.season.isdigit() else '1'
    start=item.episode if item.episode.isdigit() else '1'
    rows=[]
    for offset,video in enumerate(videos):
