            "version":str(inst.get("version") or ""),"status":"installed" if inst else "owned","installable":True,
        })
    return out


def _amazon_items() -> list[dict]:
    provider=PROVIDERS["amazon"]
    plans=provider.library_plan()
    # Nile's sync only refreshes its provider-owned metadata cache; it does not
    # change account ownership or install/remove games, so it is valid in this
    # read-only storefront milestone.
    if plans and plans[0].argv:
        p=run_plan(plans[0],timeout=120)
        if p.returncode != 0:
            raise RuntimeError((p.stderr or p.stdout or "Nile library sync failed")[-1200:])
    library=_json_stdout(plans[-1],60) or []
    try: installed=_json_stdout(provider.installed_plan()[-1],45) or []
    except Exception: installed=[]
    if isinstance(library,dict): library=library.get("library") or library.get("items") or library.get("games") or []
    if isinstance(installed,dict): installed=installed.get("installed") or installed.get("items") or installed.get("games") or []
    imap={}
    for item in installed if isinstance(installed,list) else []:
        if isinstance(item,dict):
            aid=str(item.get("id") or item.get("app_name") or item.get("product_id") or "")
            if aid: imap[aid]=item
    out=[]
    for raw in library if isinstance(library,list) else []:
        if not isinstance(raw,dict): continue
        product=raw.get("product") if isinstance(raw.get("product"),dict) else raw
        aid=str(product.get("id") or raw.get("id") or "").strip()
        if not aid: continue
        detail=product.get("productDetail") if isinstance(product.get("productDetail"),dict) else {}
        details=detail.get("details") if isinstance(detail.get("details"),dict) else detail
        title=_text(product.get("title") or raw.get("title")) or aid
        inst=imap.get(aid) or {}
        art=_https_url(details.get("backgroundUrl2") or detail.get("iconUrl") or details.get("backgroundUrl1") or details.get("logoUrl"))
        release=str(details.get("releaseDate") or "")
