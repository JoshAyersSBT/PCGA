class GogProvider(StoreProvider):
    id = "gog"
    display_name = "GOG"
    runner = "gogdl"
    auth_mode = "authorization-code"

    def _auth_prefix(self) -> tuple[str, ...]:
        return ("--auth-config-path", str(GOG_AUTH))

    def status_plan(self):
        # gogdl's `auth` command may refresh/write its token file. v0.19.2
        # diagnostics stay read-only, so authentication state is inferred only
        # from private config evidence until the account manager lands.
        return self.version_plan()

    def login_plan(self, **kwargs):
        code = str(kwargs.get("code") or "")
        argv = self._auth_prefix() + ("auth", "--code", code)
        return [OperationPlan(self.id, "login", self.runner, argv, mutating=True, secret_args=(len(argv)-1,), note="GOG OAuth authorization code")]

    def logout_plan(self):
        # gogdl stores auth in the explicit auth file. v0.19.3 will expose the
        # safe host-side unlink operation through the account manager. Keep the
        # plan argv empty so this milestone never implies a nonexistent gogdl
        # logout command.
        return OperationPlan(self.id, "logout", self.runner, (), mutating=True, network=False, note="Account manager removes the provider auth file; no generic gogdl logout subcommand is assumed")

    def library_plan(self):
        # Heroic obtains the owned GOG catalog from GOG's account API after
        # gogdl refreshes the token. Keep both phases explicit in the provider
        # contract rather than pretending gogdl itself is the catalog API.
        return [
            OperationPlan(self.id, "library-auth", self.runner, self._auth_prefix() + ("auth",), note="Catalog refresh may refresh the provider-owned token file; it never changes ownership or installs"),
            OperationPlan(self.id, "library", self.runner, (), note="Catalog phase uses the GOG account API with the provider-owned refreshed token"),
        ]

    def installed_plan(self):
        return [OperationPlan(self.id, "installed", self.runner, (), network=False, note="PCGA-managed GOG installed manifest; gogdl is intentionally not treated as the install database")]

    def _support_path(self, app_id: str) -> str:
        return str(CONTAINER_CONFIG / "gogdl" / "heroic_gogdl" / "gog-support" / app_id)

    def _target(self, app_id: str, title: str) -> str:
        # GOG download's --path is a base destination, not an Epic-style
        # --base-path. Allocate an immutable per-provider/per-ID root so titles
        # with identical names cannot overwrite one another and resumption
        # uses exactly the same destination on every attempt.
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:+-]{0,179}", str(app_id)):
            raise ValueError("invalid GOG product id")
        return str(CONTAINER_LIBRARY / "gog" / str(app_id))

    def install_plan(self, app_id, title=""):
        argv = self._auth_prefix() + ("download", app_id, "--platform", "windows", "--path", self._target(app_id,title), "--support", self._support_path(app_id), "--skip-dlcs", "--lang", "en-US")
        return [OperationPlan(self.id, "install", self.runner, argv, mutating=True)]

    def update_plan(self, app_id, title=""):
        argv = self._auth_prefix() + ("update", app_id, "--platform", "windows", "--path", self._target(app_id,title), "--support", self._support_path(app_id), "--skip-dlcs", "--lang", "en-US")
        return [OperationPlan(self.id, "update", self.runner, argv, mutating=True)]

    def verify_plan(self, app_id, title=""):
        argv = self._auth_prefix() + ("repair", app_id, "--platform", "windows", "--path", self._target(app_id,title), "--support", self._support_path(app_id), "--skip-dlcs", "--lang", "en-US")
        return [OperationPlan(self.id, "verify", self.runner, argv, mutating=True)]

    def uninstall_plan(self, app_id, title=""):
        return [OperationPlan(self.id, "uninstall", self.runner, (), mutating=True, network=False, note="PCGA removes the game directory and its managed installed-manifest record; gogdl has no stable cross-version uninstall contract")]

    def launch_metadata_plan(self, app_id):
        return [OperationPlan(self.id, "launch-metadata", self.runner, self._auth_prefix() + ("info", app_id, "--platform", "windows"))]


class AmazonProvider(StoreProvider):
    id = "amazon"
    display_name = "Amazon Games"
    runner = "nile"
    auth_mode = "device-code"

    def status_plan(self):
        # Nile exposes a local JSON authentication status command; unlike
        # library sync this does not refresh the remote catalog.
        return OperationPlan(self.id, "status", self.runner, ("auth", "--status"), network=False)

    def login_plan(self, **kwargs):
        # Two-stage flow. The first command emits client_id/code_verifier/
        # serial/url JSON; the second consumes the user authorization code.
        code = str(kwargs.get("code") or "")
        verifier = str(kwargs.get("code_verifier") or "")
        serial = str(kwargs.get("serial") or "")
        client = str(kwargs.get("client_id") or "")
        plans = [OperationPlan(self.id, "login-start", self.runner, ("auth", "--login", "--non-interactive"), mutating=True)]
        if any((code, verifier, serial, client)):
            argv=("register","--code",code,"--code-verifier",verifier,"--serial",serial,"--client-id",client)
            plans.append(OperationPlan(self.id, "login-complete", self.runner, argv, mutating=True, secret_args=(2,4,6,8), note="Amazon device-registration flow"))
        return plans

    def logout_plan(self):
        return OperationPlan(self.id, "logout", self.runner, ("auth", "--logout"), mutating=True)

    def library_plan(self):
        return [
            OperationPlan(self.id, "library-sync", self.runner, ("library", "sync"), note="Refreshes Nile's provider-owned library cache without changing account ownership or installed games"),
            OperationPlan(self.id, "library", self.runner, ("library", "list", "--json"), network=False),
        ]

    def installed_plan(self):
        return [OperationPlan(self.id, "installed", self.runner, ("library", "list", "--installed", "--json"), network=False)]

    def install_plan(self, app_id, title=""):
        return [OperationPlan(self.id, "install", self.runner, ("install", "--base-path", str(CONTAINER_LIBRARY), app_id), mutating=True)]

    def update_plan(self, app_id, title=""):
        return [OperationPlan(self.id, "update", self.runner, ("update", "--base-path", str(CONTAINER_LIBRARY), app_id), mutating=True)]

    def verify_plan(self, app_id, title=""):
        return [OperationPlan(self.id, "verify", self.runner, ("verify", app_id), mutating=True, network=False)]

    def uninstall_plan(self, app_id, title=""):
        return [OperationPlan(self.id, "uninstall", self.runner, ("uninstall", app_id), mutating=True, network=False)]

    def launch_metadata_plan(self, app_id):
        return [OperationPlan(self.id, "launch-metadata", self.runner, ("install", "--info", "--json", app_id))]


