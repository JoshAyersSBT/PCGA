def safe_component(value: str) -> str:
    value = re.sub(r"[^A-Za-z0-9._ -]+", "", str(value or "")).strip().rstrip(".")[:96]
    return value or "Game"


def archive_root() -> Path:
    raw = ROOT_FILE.read_text(encoding="utf-8").strip()
    p = Path(raw)
    if not p.is_absolute():
        raise RuntimeError("invalid PCGA archive root")
    return p


def host_layout() -> dict[str, Path]:
    root = archive_root()
    base = root / "games" / "stores"
    layout = {
        "base": base,
        "config": base / "config",
        "library": base / "library",
        "cache": base / "cache",
        "home": base / "home",
        "state": STATE_ROOT,
        "catalogs": STATE_ROOT / "catalogs",
    }
    for path in layout.values():
        path.mkdir(parents=True, exist_ok=True)
    uid, gid = puid_pgid()
    # Credentials and the synthetic runner HOME are private but must be writable
    # by the same appliance UID/GID used inside PCGA game containers.
    for key, mode in (("config",0o700),("home",0o700),("cache",0o700),("library",0o755)):
        path=layout[key]
        try:
            os.chmod(path, mode)
            if os.geteuid() == 0: os.chown(path, uid, gid)
        except OSError:
            pass
    try:
        os.chmod(layout["state"], 0o700)
        os.chmod(layout["catalogs"], 0o700)
    except OSError: pass
    for name in ("legendary", "gog", "gogdl", "nile", "xdg"):
        path = layout["config"] / name
        path.mkdir(parents=True, exist_ok=True)
        try:
            os.chmod(path, 0o700)
            if os.geteuid() == 0: os.chown(path, uid, gid)
        except OSError:
            pass
    return layout


def puid_pgid() -> tuple[int, int]:
    uid = gid = 1000
    env = Path("/opt/pc-game-archive/.env")
    try:
        for line in env.read_text(encoding="utf-8").splitlines():
            k, _, v = line.partition("=")
            v = v.split("#", 1)[0].strip().strip('"')
            if k == "PUID" and v.isdigit(): uid = int(v)
            if k == "PGID" and v.isdigit(): gid = int(v)
    except OSError:
        pass
    return uid, gid


def docker_image_ready() -> bool:
    try:
        p = subprocess.run([DOCKER, "image", "inspect", IMAGE], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=15)
        return p.returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def docker_argv(provider: StoreProvider, argv: Iterable[str]) -> list[str]:
    layout = host_layout()
    uid, gid = puid_pgid()
    return [
        DOCKER, "run", "--rm", "--network", "bridge", "--user", f"{uid}:{gid}",
        "-e", "HOME=/pcga/home",
        "-e", "PYTHONUNBUFFERED=1",
        "-e", "NO_COLOR=1",
        "-e", f"LEGENDARY_CONFIG_PATH={CONTAINER_CONFIG / 'legendary'}",
        "-e", f"GOGDL_CONFIG_PATH={CONTAINER_CONFIG / 'gogdl'}",
        "-e", f"NILE_CONFIG_PATH={CONTAINER_CONFIG / 'nile'}",
        "-e", f"XDG_CONFIG_HOME={CONTAINER_CONFIG / 'xdg'}",
        "-e", f"XDG_CACHE_HOME={CONTAINER_CACHE}",
        "-v", f"{layout['config']}:{CONTAINER_CONFIG}:rw",
        "-v", f"{layout['library']}:{CONTAINER_LIBRARY}:rw",
        "-v", f"{layout['cache']}:{CONTAINER_CACHE}:rw",
        "-v", f"{layout['home']}:/pcga/home:rw",
        "--entrypoint", provider.binary,
        IMAGE,
        *[str(x) for x in argv],
    ]


def run_plan(plan: OperationPlan, timeout: int = 45, *, allow_account_mutation: bool = False) -> subprocess.CompletedProcess:
    if plan.mutating and not (allow_account_mutation and plan.operation in ACCOUNT_MUTATIONS):
        raise RuntimeError("Direct provider execution refuses game-mutating operations; use the persistent PCGA store-job worker")
    if not plan.argv:
        raise RuntimeError(f"{plan.provider}/{plan.operation} is a host-side strategy, not a runner command")
    provider = PROVIDERS[plan.provider]
    return subprocess.run(docker_argv(provider, plan.argv), text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout)


def config_evidence(provider_id: str, layout: dict[str, Path]) -> dict:
    config = layout["config"]
    if provider_id == "epic":
        roots = [config / "legendary"]
    elif provider_id == "gog":
        roots = [config / "gog" / "auth.json", config / "gogdl"]
    else:
        roots = [config / "nile"]
    present = []
    for p in roots:
        if p.is_file():
            try: present.append({"path": str(p.relative_to(layout['base'])), "present": True, "bytes": p.stat().st_size})
            except OSError: present.append({"path": str(p), "present": True})
        elif p.is_dir():
            try:
                count = sum(1 for x in p.rglob("*") if x.is_file())
            except OSError: count = 0
            present.append({"path": str(p.relative_to(layout['base'])), "present": count > 0, "files": count})
        else:
            present.append({"path": str(p.relative_to(layout['base'])), "present": False})
    return {"auth_material_present": any(x.get("present") for x in present), "evidence": present}


def provider_status(provider: StoreProvider, *, probe: bool = False, online: bool = False, runtime_ready: bool | None = None) -> dict:
    layout = host_layout()
    ready = docker_image_ready() if runtime_ready is None else bool(runtime_ready)
    result = {
        "id": provider.id,
        "name": provider.display_name,
        "runner": provider.runner,
        "auth_mode": provider.auth_mode,
        "capabilities": list(provider.capabilities),
        "runtime_ready": ready,
        "binary_ready": False,
        "version": "",
        "probe_ok": None,
        "probe_detail": "Backend image has not been prepared" if not ready else "Not probed",
        "config": config_evidence(provider.id, layout),
    }
    if not (ready and probe):
        return result
    plan = provider.version_plan()
    try:
        p = run_plan(plan, timeout=30)
        detail = ((p.stdout or "") + "\n" + (p.stderr or "")).strip()
        result["binary_ready"] = p.returncode == 0
        result["probe_ok"] = p.returncode == 0
        result["version"] = (p.stdout or p.stderr or "").strip().splitlines()[0][:240] if detail else ""
        result["probe_detail"] = detail[-800:] if detail else ("OK" if p.returncode == 0 else f"exit {p.returncode}")
    except Exception as exc:
        result["probe_ok"] = False
        result["probe_detail"] = str(exc)[:800]
        return result
    if online and result["probe_ok"]:
        # Only provider-defined, non-mutating status checks are allowed here.
        online_plan = provider.status_plan()
        if not online_plan.mutating and online_plan.argv != plan.argv:
            try:
                p = run_plan(online_plan, timeout=60)
                text = ((p.stdout or "") + "\n" + (p.stderr or "")).strip()
                result["online_probe_ok"] = p.returncode == 0
                result["online_probe_detail"] = text[-800:]
            except Exception as exc:
                result["online_probe_ok"] = False
                result["online_probe_detail"] = str(exc)[:800]
    return result


def status_payload(provider_id: str = "all", *, probe: bool = False, online: bool = False) -> dict:
    chosen = list(PROVIDERS.values()) if provider_id == "all" else [PROVIDERS[provider_id]]
    ready = docker_image_ready()
    providers = [provider_status(p, probe=probe, online=online, runtime_ready=ready) for p in chosen]
    return {
        "ok": True,
        "action": "store-providers-status",
        "version": VERSION,
        "heroic_bundle_version": HEROIC_VERSION,
        "image": IMAGE,
        "prepared": ready,
        "provider_count": len(providers),
        "ready_count": sum(1 for p in providers if p.get("binary_ready")),
        "providers": providers,
        "detail": (
            f"Store backend image is ready; {sum(1 for p in providers if p.get('binary_ready'))}/{len(providers)} providers passed the requested probe."
            if probe and ready else
            "Store backend image is ready; run diagnostics to probe bundled helper binaries."
            if ready else
            "Store backends are not prepared yet. Preparation downloads the pinned Heroic bundle and extracts only its Legendary, gogdl and Nile helper binaries."
        ),
    }


def plans_for(provider: StoreProvider, operation: str, app_id: str, title: str) -> list[OperationPlan]:
    if operation == "status": return [provider.status_plan()]
    if operation == "login": return provider.login_plan(code="<authorization-code>", code_verifier="<code-verifier>", serial="<serial>", client_id="<client-id>")
    if operation == "logout": return [provider.logout_plan()]
    if operation == "library": return provider.library_plan()
    if operation == "installed": return provider.installed_plan()
    if operation == "install": return provider.install_plan(app_id, title)
    if operation == "update": return provider.update_plan(app_id, title)
    if operation == "verify": return provider.verify_plan(app_id, title)
    if operation == "uninstall": return provider.uninstall_plan(app_id, title)
    if operation == "launch-metadata": return provider.launch_metadata_plan(app_id)
    raise ValueError("unsupported provider operation")


def capabilities_payload() -> dict:
    return {
        "ok": True,
        "action": "store-providers-capabilities",
        "version": VERSION,
        "providers": [
            {
                "id": p.id,
                "name": p.display_name,
                "runner": p.runner,
                "auth_mode": p.auth_mode,
                "capabilities": list(p.capabilities),
            }
            for p in PROVIDERS.values()
        ],
    }


def _atomic_json(path: Path, value: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(value, separators=(",", ":"), ensure_ascii=False), encoding="utf-8")
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


def _read_json(path: Path, default=None):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return {} if default is None else default


def _json_stdout(plan: OperationPlan, timeout: int = 90):
    proc = run_plan(plan, timeout=timeout)
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout or f"exit {proc.returncode}").strip()
        raise RuntimeError(detail[-1200:])
    text = (proc.stdout or "").strip()
    if not text:
        return None
    # A few helper versions prepend informational lines. Prefer the complete
    # payload, then fall back to the last JSON-looking line.
    try:
        return json.loads(text)
    except Exception:
        for line in reversed(text.splitlines()):
            line=line.strip()
            if line.startswith(("{", "[")):
                try: return json.loads(line)
                except Exception: pass
    raise RuntimeError(f"{plan.provider}/{plan.operation} did not return valid JSON")


def _https_url(value) -> str:
    url = str(value or "").strip()
    if url.startswith("//"):
        return "https:" + url
    if url.startswith("http://"):
        return "https://" + url[7:]
    return url if url.startswith("https://") else ""


def _text(value) -> str:
    if isinstance(value, str): return value.strip()
    if isinstance(value, dict):
        for key in ("name", "title", "value", "*", "en-US", "en"):
            if isinstance(value.get(key), str) and value.get(key).strip(): return value[key].strip()
    return ""


def _strip_markup(value) -> str:
    text = re.sub(r"<[^>]+>", " ", str(value or ""))
    return re.sub(r"\s+", " ", html.unescape(text)).strip()


def _epic_image(raw: dict) -> str:
    meta = raw.get("metadata") if isinstance(raw.get("metadata"), dict) else raw
    images = meta.get("keyImages") or raw.get("keyImages") or []
    if isinstance(images, list):
        preferred=("DieselGameBoxTall","OfferImageTall","DieselStoreFrontTall","DieselGameBox","OfferImageWide")
        for kind in preferred:
            for image in images:
                if isinstance(image, dict) and image.get("type") == kind:
                    url=_https_url(image.get("url"))
                    if url: return url
    for key in ("art_square_front","art_square","art_cover","cover_url","image"):
        url=_https_url(raw.get(key) or meta.get(key))
        if url: return url
    return ""


def _epic_items() -> list[dict]:
    provider=PROVIDERS["epic"]
    with ThreadPoolExecutor(max_workers=2) as ex:
        f_lib=ex.submit(_json_stdout, provider.library_plan()[-1], 120)
        f_inst=ex.submit(_json_stdout, provider.installed_plan()[-1], 45)
        library=f_lib.result() or []
        try: installed=f_inst.result() or []
        except Exception: installed=[]
    if isinstance(library, dict): library=library.get("games") or library.get("items") or library.get("library") or []
    if isinstance(installed, dict): installed=installed.get("games") or installed.get("items") or installed.get("installed") or list(installed.values())
    imap={}
    for item in installed if isinstance(installed,list) else []:
        if not isinstance(item,dict): continue
        aid=str(item.get("app_name") or item.get("appName") or item.get("app_id") or item.get("id") or "")
        if aid: imap[aid]=item
    out=[]
    for raw in library if isinstance(library,list) else []:
