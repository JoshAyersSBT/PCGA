@dataclass(frozen=True)
class OperationPlan:
    provider: str
    operation: str
    runner: str
    argv: tuple[str, ...]
    mutating: bool = False
    network: bool = True
    secret_args: tuple[int, ...] = ()
    note: str = ""

    def public(self) -> dict:
        data = asdict(self)
        argv = list(self.argv)
        for i in self.secret_args:
            if 0 <= i < len(argv):
                argv[i] = "<secret>"
        data["argv"] = argv
        data["secret_args"] = list(self.secret_args)
        return data


class StoreProvider:
    id = ""
    display_name = ""
    runner = ""
    auth_mode = ""

    @property
    def binary(self) -> str:
        return str(BACKEND_DIR / self.runner)

    @property
    def capabilities(self) -> tuple[str, ...]:
        return ("status", "login", "logout", "library", "installed", "install", "update", "verify", "uninstall", "launch-metadata")

    def version_plan(self) -> OperationPlan:
        return OperationPlan(self.id, "version", self.runner, ("--version",), network=False)

    def status_plan(self) -> OperationPlan:
        return self.version_plan()

    def login_plan(self, **kwargs) -> list[OperationPlan]:
        raise NotImplementedError

    def logout_plan(self) -> OperationPlan:
        raise NotImplementedError

    def library_plan(self) -> list[OperationPlan]:
        raise NotImplementedError

    def installed_plan(self) -> list[OperationPlan]:
        raise NotImplementedError

    def install_plan(self, app_id: str, title: str = "") -> list[OperationPlan]:
        raise NotImplementedError

    def update_plan(self, app_id: str, title: str = "") -> list[OperationPlan]:
        raise NotImplementedError

    def verify_plan(self, app_id: str, title: str = "") -> list[OperationPlan]:
        raise NotImplementedError

    def uninstall_plan(self, app_id: str, title: str = "") -> list[OperationPlan]:
        raise NotImplementedError

    def launch_metadata_plan(self, app_id: str) -> list[OperationPlan]:
        raise NotImplementedError


