def _account_local(provider_id: str) -> dict:
    layout=host_layout(); evidence=config_evidence(provider_id,layout); present=bool(evidence.get("auth_material_present"))
    state="connected" if present else "disconnected"
    detail="Stored provider authentication is present; choose Refresh status to verify it." if present else "No stored account authentication was found."
    if provider_id=="gog":
        data=_read_json(layout["config"] / "gog" / "auth.json",{})
        if isinstance(data,dict) and data.get("refresh_token"):
            exp=float(data.get("loginTime") or data.get("login_time") or 0)+float(data.get("expires_in") or 0)
            if exp and exp<time.time() and not data.get("refresh_token"):
                state="expired"
    return {"id":provider_id,"name":PROVIDERS[provider_id].display_name,"state":state,"connected":present,"verified":False,"detail":detail,"auth_material_present":present}


def _account_verify(provider_id: str) -> dict:
    provider=PROVIDERS[provider_id]; base=_account_local(provider_id)
    if not docker_image_ready():
        return {**base,"state":"needs-backends","connected":False,"verified":False,"detail":"Prepare the PC-store backends before verifying or connecting accounts."}
    try:
        if provider_id=="epic":
            plan=OperationPlan("epic","account-status","legendary",("status",),network=True)
            p=subprocess.run(docker_argv(provider,plan.argv),text=True,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=45)
        elif provider_id=="gog":
            plan=provider.library_plan()[0]
            p=subprocess.run(docker_argv(provider,plan.argv),text=True,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=60)
        else:
            plan=provider.status_plan()
            p=subprocess.run(docker_argv(provider,plan.argv),text=True,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=45)
        text=((p.stdout or "")+"\n"+(p.stderr or "")).strip()
        connected=p.returncode==0
        state="connected" if connected else ("expired" if base.get("auth_material_present") else "disconnected")
        detail=("Account verified." if connected else (_redact_text(text)[-700:] or "Authentication could not be verified."))
        return {**base,"state":state,"connected":connected,"verified":True,"detail":detail}
    except Exception as exc:
        return {**base,"state":"error" if base.get("auth_material_present") else "disconnected","connected":False,"verified":True,"detail":_catalog_failure_detail(provider_id,exc)}


def accounts_payload(provider_id: str="all", *, refresh: bool=False) -> dict:
    ids=list(PROVIDERS) if provider_id=="all" else [provider_id]
    cached=_read_json(ACCOUNT_STATE,{})
    previous={x.get("id"):x for x in cached.get("providers",[]) if isinstance(x,dict)} if isinstance(cached,dict) else {}
    if refresh:
        with ThreadPoolExecutor(max_workers=len(ids)) as ex:
            rows=list(ex.map(_account_verify,ids))
    else:
        rows=[]
        for pid in ids:
            local=_account_local(pid); old=previous.get(pid) or {}
            if local.get("auth_material_present") and old.get("verified"):
                local={**local,**{k:old.get(k) for k in ("state","connected","verified","detail","verified_at") if k in old}}
            rows.append(local)
    now=time.time()
    if refresh:
        for row in rows: row["verified_at"]=now
        full=[]
        by={x["id"]:x for x in rows}
        for pid in PROVIDERS: full.append(by.get(pid) or previous.get(pid) or _account_local(pid))
        _atomic_json(ACCOUNT_STATE,{"updated_at":now,"providers":full})
    return {"ok":True,"action":"store-accounts-status","version":VERSION,"provider":provider_id,"providers":rows,"connected_count":sum(1 for x in rows if x.get("connected")),"detail":"Store account status. Tokens and provider credentials are never returned by this endpoint."}


def account_login_start(provider_id: str) -> dict:
    if provider_id not in PROVIDERS: raise ValueError("unsupported provider")
    if not docker_image_ready(): raise RuntimeError("Prepare the PC-store backends before connecting an account.")
    _clear_flow(provider_id)
    if provider_id=="epic":
        return {"ok":True,"action":"store-account-login-start","provider":"epic","provider_label":"Epic Games","login_url":EPIC_LOGIN_URL,"input_kind":"authorization-code","detail":"Sign in to Epic in the new browser tab, then paste the authorizationCode value shown by Legendary's login page."}
    if provider_id=="gog":
        return {"ok":True,"action":"store-account-login-start","provider":"gog","provider_label":"GOG","login_url":GOG_LOGIN_URL,"input_kind":"authorization-code","detail":"Sign in to GOG in the new browser tab. After the redirect, copy the code value from the resulting URL and paste it into PCGA."}
    plan=PROVIDERS["amazon"].login_plan()[0]
    p=run_plan(plan,timeout=60,allow_account_mutation=True)
    if p.returncode!=0: raise RuntimeError((p.stderr or p.stdout or "Amazon login could not be started")[-1200:])
    data=None; text=(p.stdout or "").strip()
    try: data=json.loads(text)
    except Exception:
        for line in reversed(text.splitlines()):
            try:
                obj=json.loads(line.strip())
                if isinstance(obj,dict): data=obj; break
            except Exception: pass
    if not isinstance(data,dict): raise RuntimeError("Nile did not return a usable non-interactive login request")
    url=str(data.get("url") or data.get("login_url") or "").strip()
    pending={k:str(data.get(k) or "") for k in ("client_id","code_verifier","serial")}
    if not url or not all(pending.values()): raise RuntimeError("Nile returned an incomplete device-registration request")
    _save_flow("amazon",pending)
    return {"ok":True,"action":"store-account-login-start","provider":"amazon","provider_label":"Amazon Games","login_url":url,"input_kind":"authorization-code","expires_in":AUTH_FLOW_TTL,"detail":"Sign in to Amazon using the new browser tab, then paste the authorization code. PCGA keeps the device verifier and serial only on the server."}


def account_login_complete(provider_id: str, code_value: str) -> dict:
    if provider_id not in PROVIDERS: raise ValueError("unsupported provider")
    if not docker_image_ready(): raise RuntimeError("Prepare the PC-store backends before connecting an account.")
    code=_auth_code(code_value); provider=PROVIDERS[provider_id]
    if provider_id=="amazon":
        flow=_load_flow("amazon")
        plans=provider.login_plan(code=code,code_verifier=flow.get("code_verifier"),serial=flow.get("serial"),client_id=flow.get("client_id"))
        plan=plans[-1]
    else:
        plan=provider.login_plan(code=code)[-1]
    p=run_plan(plan,timeout=90,allow_account_mutation=True)
    if p.returncode!=0:
        detail=_redact_text((p.stderr or p.stdout or "Account connection failed").strip())[-1200:]
        raise RuntimeError(detail)
    _clear_flow(provider_id); _clear_catalog(provider_id)
    status=_account_verify(provider_id); status["verified_at"]=time.time()
    current=accounts_payload("all",refresh=False); by={x.get("id"):x for x in current.get("providers",[])}; by[provider_id]=status
    _atomic_json(ACCOUNT_STATE,{"updated_at":time.time(),"providers":[by.get(pid) or _account_local(pid) for pid in PROVIDERS]})
    return {"ok":True,"action":"store-account-login-complete","provider":provider_id,"account":status,"detail":f"{provider.display_name} account connected."}


def account_logout(provider_id: str) -> dict:
    if provider_id not in PROVIDERS: raise ValueError("unsupported provider")
    if provider_id=="gog":
        path=host_layout()["config"] / "gog" / "auth.json"
        try:
            if path.exists():
                path.write_bytes(b""); os.chmod(path,0o600); path.unlink()
        except OSError as exc: raise RuntimeError(f"Could not remove GOG authentication: {exc}")
    else:
        if not docker_image_ready(): raise RuntimeError("Prepare the PC-store backends before disconnecting this account.")
        plan=PROVIDERS[provider_id].logout_plan()
        p=run_plan(plan,timeout=60,allow_account_mutation=True)
        if p.returncode!=0: raise RuntimeError(_redact_text(p.stderr or p.stdout or "Account logout failed")[-1200:])
    _clear_flow(provider_id); _clear_catalog(provider_id)
    status=_account_local(provider_id); status.update({"state":"disconnected","connected":False,"verified":True,"verified_at":time.time(),"detail":"Account disconnected from PCGA."})
    current=accounts_payload("all",refresh=False); by={x.get("id"):x for x in current.get("providers",[])}; by[provider_id]=status
    _atomic_json(ACCOUNT_STATE,{"updated_at":time.time(),"providers":[by.get(pid) or _account_local(pid) for pid in PROVIDERS]})
    return {"ok":True,"action":"store-account-logout","provider":provider_id,"account":status,"detail":f"{PROVIDERS[provider_id].display_name} account disconnected."}

def _fuzzy_score(query: str, item: dict) -> float:
    q=re.sub(r"[^a-z0-9]+"," ",query.casefold()).strip()
    hay=" ".join([str(item.get("title") or ""),str(item.get("developer") or ""),str(item.get("provider_label") or ""),str(item.get("provider_game_id") or "")," ".join(item.get("genres") or [])]).casefold()
    h=re.sub(r"[^a-z0-9]+"," ",hay).strip()
    if not q: return 1.0
    if q == h: return 10.0
    if q in h: return 8.0 + min(1.0,len(q)/max(1,len(h)))
    qtokens=q.split(); htoks=h.split(); token_scores=[]
    for qt in qtokens:
        best=max([difflib.SequenceMatcher(None,qt,ht).ratio() for ht in htoks] or [0.0])
        token_scores.append(best)
    token=min(token_scores) if token_scores else 0.0
    whole=difflib.SequenceMatcher(None,q,h).ratio()
    return max(token*5.0,whole*4.0)


def library_payload(provider_id: str="all", *, query: str="", limit: int=240, refresh: bool=False) -> dict:
    provider_ids=list(PROVIDERS) if provider_id=="all" else [provider_id]
    limit=max(1,min(500,int(limit or 240)))
    catalogs=[]
    runtime_ready=docker_image_ready()
    with ThreadPoolExecutor(max_workers=len(provider_ids)) as ex:
        fut={ex.submit(_catalog,pid,refresh=refresh,runtime_ready=runtime_ready):pid for pid in provider_ids}
        for f in as_completed(fut):
            pid=fut[f]
            try: catalogs.append(f.result())
            except Exception as exc: catalogs.append({"provider":pid,"provider_label":PROVIDERS[pid].display_name,"available":False,"count":0,"items":[],"detail":str(exc)[:500]})
    order={pid:i for i,pid in enumerate(provider_ids)}; catalogs.sort(key=lambda x:order.get(x.get("provider"),99))
    rows=[]
    for catalog in catalogs:
        for item in catalog.get("items") or []:
            score=_fuzzy_score(query,item) if query else 0.0
            if query and score < 2.55: continue
            rows.append((score,item))
    if query: rows.sort(key=lambda r:(-r[0],str(r[1].get("sort_title") or r[1].get("title") or "")))
    else: rows.sort(key=lambda r:(str(r[1].get("sort_title") or r[1].get("title") or ""),str(r[1].get("provider") or "")))
    items=[]
    for score,item in rows[:limit]:
        obj=dict(item)
        if query: obj["search_score"]=round(score,4)
        items.append(obj)
    return {
        "ok":True,"action":"store-library","version":VERSION,"read_only":True,"query":query,"provider":provider_id,
        "count":len(items),"total_owned":sum(int(x.get("count") or 0) for x in catalogs),"items":items,
        "providers":[{k:v for k,v in x.items() if k!="items"} for x in catalogs],
        "detail":"Owned-game catalog. Epic/GOG support installation and guarded update, verify and uninstall through the persistent queue; Amazon remains library/account-only.",
    }


def main() -> None:
    ap = argparse.ArgumentParser(description="PCGA native PC-store provider foundation")
    sub = ap.add_subparsers(dest="command", required=True)
    st = sub.add_parser("status", help="Return safe provider diagnostics")
    st.add_argument("--provider", choices=["all", *PROVIDERS], default="all")
    st.add_argument("--probe", action="store_true", help="Run each bundled backend's --version command")
    st.add_argument("--online", action="store_true", help="Also run safe provider-defined online health checks when available")
    sub.add_parser("capabilities", help="Show the normalized provider contract")
    lib = sub.add_parser("library", help="Return the normalized read-only owned-game catalog")
    lib.add_argument("--provider", choices=["all", *PROVIDERS], default="all")
    lib.add_argument("--query", default="")
    lib.add_argument("--limit", type=int, default=240)
    lib.add_argument("--refresh", action="store_true", help="Refresh provider-owned catalog caches before returning")
    ac = sub.add_parser("accounts", help="Return sanitized store-account connection state")
    ac.add_argument("--provider", choices=["all", *PROVIDERS], default="all")
    ac.add_argument("--refresh", action="store_true", help="Verify existing authentication with provider backends")
    ls = sub.add_parser("login-start", help="Start a provider login flow without returning provider secrets")
    ls.add_argument("provider", choices=PROVIDERS)
    lc = sub.add_parser("login-complete", help="Complete a provider login with the returned authorization code")
    lc.add_argument("provider", choices=PROVIDERS)
    lc.add_argument("--code-stdin", action="store_true", help="Read the authorization code from stdin so it never appears in process arguments")
    lo = sub.add_parser("logout", help="Disconnect a provider account from PCGA")
    lo.add_argument("provider", choices=PROVIDERS)
    pl = sub.add_parser("plan", help="Show a redacted operation plan; never executes it")
    pl.add_argument("provider", choices=PROVIDERS)
    pl.add_argument("operation", choices=["status","login","logout","library","installed","install","update","verify","uninstall","launch-metadata"])
    pl.add_argument("--app-id", default="example-app")
    pl.add_argument("--title", default="Example Game")
    args = ap.parse_args()
    try:
        if args.command == "status":
            out = status_payload(args.provider, probe=args.probe, online=args.online)
        elif args.command == "capabilities":
            out = capabilities_payload()
        elif args.command == "library":
            out = library_payload(args.provider, query=str(args.query or "")[:160], limit=args.limit, refresh=args.refresh)
        elif args.command == "accounts":
            out = accounts_payload(args.provider, refresh=args.refresh)
        elif args.command == "login-start":
            out = account_login_start(args.provider)
        elif args.command == "login-complete":
            if not args.code_stdin: raise ValueError("login-complete requires --code-stdin")
            out = account_login_complete(args.provider, sys.stdin.read(8192))
        elif args.command == "logout":
            out = account_logout(args.provider)
        else:
            provider = PROVIDERS[args.provider]
            out = {
                "ok": True,
                "action": "store-provider-plan",
                "provider": provider.id,
                "operation": args.operation,
                "plans": [x.public() for x in plans_for(provider, args.operation, args.app_id, args.title)],
                "executed": False,
            }
        print(json.dumps(out, separators=(",", ":"), sort_keys=True))
    except Exception as exc:
        print(json.dumps({"ok": False, "error": type(exc).__name__, "detail": str(exc)}, separators=(",", ":")))
        raise SystemExit(1)


if __name__ == "__main__":
    main()
