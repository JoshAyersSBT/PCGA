def _load_flow(provider_id: str) -> dict:
    path=_flow_path(provider_id); data=_read_json(path,{})
    if not isinstance(data,dict) or time.time()-float(data.get("created_at") or 0)>AUTH_FLOW_TTL:
        try: path.unlink()
        except OSError: pass
        raise RuntimeError("The login request expired. Start the account connection again.")
    return data


