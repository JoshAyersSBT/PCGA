def _cached_catalog(provider_id: str) -> dict:
    data=_read_json(_cache_path(provider_id),{})
    return data if isinstance(data,dict) else {}


def _catalog_failure_detail(provider_id: str, error: Exception) -> str:
    """Never present credential errors or Python stack traces in the portal."""
    raw = str(error or "").strip()
    if provider_id == "amazon" and ("not logged in" in raw.casefold() or raw.casefold() in {"null", "none"}):
        return "Amazon Games is not connected. Open Control Center → Games → Amazon Games account to connect."
    if provider_id == "gog" and (raw.casefold() in {"null", "none", ""} or "token" in raw.casefold() or "auth" in raw.casefold()):
        return "GOG account verification failed. Open Control Center → Games → GOG account and reconnect."
    if provider_id == "epic" and ("logging in" in raw.casefold() or "traceback" in raw.casefold() or "auth" in raw.casefold()):
        return "Epic catalog could not be refreshed. Refresh your Epic account connection in Control Center → Games. If it persists, inspect pcga-store-provider logs on the appliance."
    # Other backend errors get a short, redacted final diagnostic line.
    parts = [line.strip() for line in raw.splitlines() if line.strip() and not line.strip().startswith('File "')]
    tail = next((line for line in reversed(parts) if line != "Traceback (most recent call last):"), "Provider catalog unavailable")
    return _redact_text(tail)[:240]


def _catalog(provider_id: str, *, refresh: bool=False, runtime_ready: bool|None=None) -> dict:
    path=_cache_path(provider_id); cached=_cached_catalog(provider_id); now=time.time()
    age=now-float(cached.get("updated_at") or 0)
    if cached.get("items") is not None and not refresh and age < CATALOG_CACHE_TTL:
        # The installed manifest may change while the owned catalog is warm.
        # Never allow a 120s cached ownership snapshot to hide completed jobs.
        if provider_id=="gog":
            cached={**cached,"items":_overlay_legacy_installed([dict(x) for x in cached.get("items",[])])}
        return {**cached,"cached":True,"cache_age_seconds":max(0,int(age))}
    ready=docker_image_ready() if runtime_ready is None else bool(runtime_ready)
    if not ready:
        if isinstance(cached.get("items"),list):
            if provider_id=="gog":
                cached={**cached,"items":_overlay_legacy_installed([dict(x) for x in cached.get("items",[])])}
            return {**cached,"available":True,"cached":True,"stale":True,"error":"backend-not-prepared","detail":"Using cached library because the PC-store backend image is not prepared. Open Store settings and choose Prepare backends to refresh it.","cache_age_seconds":max(0,int(age))}
        return {"provider":provider_id,"provider_label":PROVIDERS[provider_id].display_name,"available":False,"updated_at":0,"count":0,"items":[],"error":"backend-not-prepared","detail":"PC-store backends are not prepared. Open Store settings and choose Prepare backends."}
    fetch={"epic":_epic_items,"gog":_gog_items,"amazon":_amazon_items}[provider_id]
    try:
        items=_overlay_legacy_installed(fetch())
        payload={"provider":provider_id,"provider_label":PROVIDERS[provider_id].display_name,"available":True,"updated_at":now,"count":len(items),"items":items,"detail":f"Loaded {len(items)} owned title{'s' if len(items)!=1 else ''}."}
        _atomic_json(path,payload)
        return {**payload,"cached":False,"cache_age_seconds":0}
    except Exception as exc:
        if isinstance(cached.get("items"),list):
            if provider_id=="gog":
                cached={**cached,"items":_overlay_legacy_installed([dict(x) for x in cached.get("items",[])])}
            return {**cached,"available":True,"cached":True,"stale":True,"error":type(exc).__name__,"detail":f"Using cached library because refresh failed: {_catalog_failure_detail(provider_id,exc)}","cache_age_seconds":max(0,int(age))}
        return {"provider":provider_id,"provider_label":PROVIDERS[provider_id].display_name,"available":False,"updated_at":0,"count":0,"items":[],"error":type(exc).__name__,"detail":_catalog_failure_detail(provider_id,exc)}



def _redact_text(value: str) -> str:
    text=str(value or "")
    text=re.sub(r'(?i)(access_token|refresh_token|authorizationCode|authorization_code|code_verifier|client_secret)([\"\'\s:=]+)([^\s,}]+)',r'\1\2<redacted>',text)
    return text


def _auth_code(value: str) -> str:
    raw=str(value or "").strip()
    if not raw:
        raise ValueError("authorization code is required")
    if len(raw)>8192:
        raise ValueError("authorization code is too long")
    if raw.startswith("{"):
        try:
            obj=json.loads(raw)
            for key in ("authorizationCode","authorization_code","code"):
                if obj.get(key): raw=str(obj[key]).strip(); break
        except Exception:
            pass
    if raw.startswith(("http://","https://")):
        q=urllib.parse.parse_qs(urllib.parse.urlparse(raw).query)
        for key in ("code","authorizationCode","authorization_code"):
            if q.get(key): raw=str(q[key][0]).strip(); break
    raw=raw.strip().strip('"').strip("'")
    if not raw or any(ord(c)<32 for c in raw):
        raise ValueError("invalid authorization code")
    return raw


def _flow_path(provider_id: str) -> Path:
    AUTH_FLOW_ROOT.mkdir(parents=True,exist_ok=True)
    try: os.chmod(AUTH_FLOW_ROOT,0o700)
