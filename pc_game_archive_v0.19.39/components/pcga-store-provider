            "genres":genres,"year":year.group(0) if year else "","art_url":art,"owned":True,"installed":bool(inst),
            "install_path":str(inst.get("path") or inst.get("install_path") or ""),"version":str(inst.get("version") or ""),
            "status":"installed" if inst else "owned","installable":True,
        })
    return out


def _http_json(url: str, token: str, timeout: int = 30):
    headers={"Accept":"application/json","User-Agent":f"PCGA/{VERSION}"}
    if token: headers["Authorization"]="Bearer "+token
    req=urllib.request.Request(url,headers=headers,method="GET")
    with urllib.request.urlopen(req,timeout=timeout) as res:
        if int(getattr(res,"status",200)) != 200: raise RuntimeError(f"HTTP {getattr(res,'status',0)}")
        return json.loads(res.read(8*1024*1024).decode("utf-8","replace"))


def _gog_credentials() -> dict:
    provider=PROVIDERS["gog"]
    # Let gogdl validate/refresh an existing login. This writes only the
    # provider-owned auth cache and does not log a user in or out.
    p=run_plan(provider.library_plan()[0],timeout=60)
    candidate={}
    if p.returncode == 0:
        text=(p.stdout or "").strip()
        try: candidate=json.loads(text)
        except Exception:
            for line in reversed(text.splitlines()):
                try:
                    obj=json.loads(line)
                    if isinstance(obj,dict): candidate=obj; break
                except Exception: pass
    host_auth=host_layout()["config"] / "gog" / "auth.json"
    disk=_read_json(host_auth,{})
    if isinstance(disk,dict): candidate={**disk,**(candidate if isinstance(candidate,dict) else {})}
    token=str(candidate.get("access_token") or "")
    user=str(candidate.get("user_id") or "")
    if p.returncode != 0 or not token or not user:
        detail=(p.stderr or p.stdout or "GOG account credentials are unavailable").strip()
        raise RuntimeError(detail[-1000:] or "GOG account credentials are unavailable")
    return candidate


def _gog_products(ids: list[str], token: str) -> dict[str,dict]:
    result={}
    for start in range(0,len(ids),50):
        chunk=ids[start:start+50]
        q=urllib.parse.urlencode({"ids":",".join(chunk),"expand":"description","locale":"en-US"})
        try:
            data=_http_json("https://api.gog.com/products?"+q,token,30)
            rows=data if isinstance(data,list) else (data.get("products") if isinstance(data,dict) else [])
            for row in rows or []:
                if isinstance(row,dict) and row.get("id") is not None: result[str(row["id"])]=row
        except Exception:
            pass
    missing=[x for x in ids if x not in result][:120]
    if missing:
        def one(aid):
            try: return aid,_http_json(f"https://api.gog.com/products/{urllib.parse.quote(aid)}?expand=description&locale=en-US",token,20)
            except Exception: return aid,None
        with ThreadPoolExecutor(max_workers=8) as ex:
            for aid,row in ex.map(one,missing):
                if isinstance(row,dict): result[aid]=row
    return result


def _gog_items() -> list[dict]:
    cred=_gog_credentials(); token=str(cred.get("access_token") or ""); user=str(cred.get("user_id") or "")
    rows=[]; page_token=""; seen=set()
    for _ in range(40):
        url=f"https://galaxy-library.gog.com/users/{urllib.parse.quote(user)}/releases"
        if page_token: url += "?" + urllib.parse.urlencode({"page_token":page_token})
        data=_http_json(url,token,30)
        items=data.get("items") if isinstance(data,dict) else []
        rows.extend(x for x in (items or []) if isinstance(x,dict) and str(x.get("platform_id"))=="gog" and x.get("owned",True))
        nxt=str(data.get("next_page_token") or "") if isinstance(data,dict) else ""
        if not nxt or nxt in seen: break
        seen.add(nxt); page_token=nxt
    ids=[]
    for row in rows:
        aid=str(row.get("external_id") or "")
        if aid and aid not in ids: ids.append(aid)
    products=_gog_products(ids,token)
    out=[]
    for aid in ids:
        product=products.get(aid) or {}
        if str(product.get("game_type") or "game").lower()=="dlc": continue
        title=_text(product.get("title")) or aid
        images=product.get("images") if isinstance(product.get("images"),dict) else {}
        art=_https_url(images.get("background") or images.get("sidebarIcon2x") or images.get("sidebarIcon") or images.get("icon"))
        desc=product.get("description") if isinstance(product.get("description"),dict) else {}
        release=str(product.get("release_date") or ""); year=re.search(r"(?:19|20)\d{2}",release)
        out.append({
            "id":f"store:gog:{aid}","provider":"gog","provider_label":"GOG","runner":"gogdl","provider_game_id":aid,
            "title":title,"sort_title":title.casefold(),"description":_strip_markup(desc.get("lead") or desc.get("full")),"developer":"",
            "genres":[],"year":year.group(0) if year else "","art_url":art,"owned":True,"installed":False,"install_path":"","version":"",
            "status":"owned","installable":bool(product.get("is_installable",True)),
        })
    return out



def _legacy_heroic_installed_map() -> dict[tuple[str,str],dict]:
    """Return installed games discovered by the v0.19.0 Heroic compatibility index.

    v0.19.2 did not depend on Heroic for ownership/catalog refresh, but carrying
    this evidence forward prevents already-installed games from regressing to an
    "owned only" badge during the native-frontend migration.
    """
    data=_read_json(LEGACY_HEROIC_CATALOG,{})
    rows=data.get("items") if isinstance(data,dict) else []
    out={}
    aliases={"legendary":"epic","epic":"epic","gog":"gog","gogdl":"gog","nile":"amazon","amazon":"amazon"}
    for row in rows if isinstance(rows,list) else []:
        if not isinstance(row,dict): continue
        provider=aliases.get(str(row.get("heroic_runner") or row.get("runner") or "").casefold())
        app=str(row.get("heroic_app_name") or row.get("app_name") or "").strip()
        if not provider or not app: continue
        out[(provider,app)]={
            "install_path":str(row.get("host_install_path") or row.get("install_path") or ""),
            "version":str(row.get("version") or ""),
        }
    return out


def _gog_managed_installs() -> dict:
    """Only trust completed GOG downloads with files still under the archive."""
    data=_read_json(STATE_ROOT / "gog-installed.json", {})
    records=data.get("games", {}) if isinstance(data,dict) else {}
    base=host_layout()["library"].resolve()
    good={}
    for app_id,row in records.items() if isinstance(records,dict) else []:
        if not isinstance(row,dict) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:+-]{0,179}",str(app_id)):
            continue
        path=Path(str(row.get("install_path") or ""))
        try:
            resolved=path.resolve(strict=True)
            if not resolved.is_dir() or not resolved.is_relative_to(base / "gog"):
                continue
            if not any(resolved.iterdir()):
                continue
        except (ValueError,OSError):
            continue
        good[str(app_id)]={"install_path":str(resolved), "version":str(row.get("version") or "")}
    return good


def _overlay_legacy_installed(items: list[dict]) -> list[dict]:
    installed=_legacy_heroic_installed_map()
    managed=_gog_managed_installs() if any(x.get("provider")=="gog" for x in items) else {}
    for item in items:
        key=(str(item.get("provider") or ""),str(item.get("provider_game_id") or ""))
        if item.get("installed_source") == "pcga-gog" and key[0] == "gog" and key[1] not in managed:
            item.update(installed=False, status="owned", install_path="", installed_source="")
        if item.get("installed"): continue
        legacy=installed.get(key)
        record=managed.get(key[1]) if key[0]=="gog" else None
        if not record and not legacy: continue
        evidence=record or legacy
        item["installed"]=True
        item["status"]="installed"
        if evidence.get("install_path"): item["install_path"]=evidence["install_path"]
        if evidence.get("version"): item["version"]=evidence["version"]
        item["installed_source"]="pcga-gog" if record else "heroic-compat"
    return items

def _cache_path(provider_id: str) -> Path:
