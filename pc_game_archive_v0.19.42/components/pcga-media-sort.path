[Unit]
Description=Watch ARM output for media ready to sort

[Path]
PathChanged=__ARCHIVE_ROOT__/media/arm/work/completed
PathChanged=__ARCHIVE_ROOT__/media/arm/work/raw
PathChanged=__ARCHIVE_ROOT__/media/arm/work/transcode
PathChanged=__ARCHIVE_ROOT__/media/arm/music
Unit=pcga-media-sort.service

[Install]
WantedBy=multi-user.target
