#!/usr/bin/env python3
"""PCGA staging inventory and orphan-video reconciliation (v0.15.0).

ARM can leave valid video in raw/ or transcode/ even when its final handoff to
completed/ fails. This tool inventories all ARM video staging trees and safely
re-queues settled orphan artifacts by hard-linking (copy fallback) them into
metadata-pending. Source artifacts are never deleted.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import shutil
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

VERSION = "0.15.0"
VIDEO_EXTS={'.mkv','.mp4','.m4v','.avi','.mov','.mpg','.mpeg','.ts','.m2ts','.vob','.webm'}
CATEGORY_HINTS={
    'movies':'movie','movie':'movie','tv':'tv','series':'tv','shows':'tv',
    'unidentified':'unknown','undefined':'unknown','unknown':'unknown'
}


def root_path()->Path:
    ov=os.environ.get('PCGA_ROOT_OVERRIDE')
    if ov: return Path(ov)
    return Path(Path('/etc/pc-game-archive/archive-root').read_text().strip())


def arm_busy()->bool:
    if os.environ.get('PCGA_IGNORE_ARM_BUSY')=='1': return False
    try:
        p=subprocess.run(['systemctl','list-units','--all','--state=active,activating','--plain','--no-legend','pcga-arm-rip@*.service'],capture_output=True,text=True,check=False)
        if 'pcga-arm-rip@' in p.stdout: return True
    except OSError: pass
    try:
        p=subprocess.run(['docker','exec','arm-rippers','sh','-lc',"ps -eo args | grep -Eq '[p]ython3 /opt/arm/arm/ripper/main.py|[m]akemkvcon|[H]andBrakeCLI|[f]fmpeg'"],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,check=False)
        return p.returncode==0
    except OSError: return False


def videos(path:Path)->list[Path]:
    if path.is_file(): return [path] if path.suffix.lower() in VIDEO_EXTS else []
    out=[]
    try:
        for p in path.rglob('*'):
            if p.is_file() and p.suffix.lower() in VIDEO_EXTS and not p.name.startswith('.pcga-'):
                out.append(p)
    except OSError: pass
    return out


def settled(path:Path, seconds:int)->bool:
    vv=videos(path)
    if not vv: return False
    cutoff=time.time()-max(0,seconds)
    try:
        return all(p.stat().st_mtime <= cutoff for p in vv)
    except OSError:
        return False


def fingerprint(path:Path)->str:
    h=hashlib.sha256()
    base=path if path.is_dir() else path.parent
    for p in sorted(videos(path),key=lambda x:str(x)):
        st=p.stat()
        try: rel=str(p.relative_to(base))
        except ValueError: rel=p.name
        h.update(rel.encode('utf-8','surrogateescape'))
        h.update(b'\0'); h.update(str(st.st_size).encode()); h.update(b'\0')
        h.update(str(st.st_mtime_ns).encode()); h.update(b'\n')
    return h.hexdigest()


def size_bytes(path:Path)->int:
    total=0
    for p in videos(path):
        try: total+=p.stat().st_size
        except OSError: pass
    return total


def artifacts_for(stage:Path, kind:str)->list[tuple[Path,str]]:
    """Return whole artifacts rather than individual nested tracks."""
    if not stage.exists(): return []
    out=[]; seen=set()
    for top in sorted(stage.iterdir(),key=lambda p:p.name.lower()):
        if top.name.startswith('.pcga-'): continue
        hint=kind+'-recovery'
        key=top.name.lower()
        if key in CATEGORY_HINTS and top.is_dir():
            hint=CATEGORY_HINTS[key]
            for child in sorted(top.iterdir(),key=lambda p:p.name.lower()):
                if videos(child):
                    rp=str(child.resolve())
                    if rp not in seen: out.append((child,hint)); seen.add(rp)
            continue
        if videos(top):
            rp=str(top.resolve())
            if rp not in seen: out.append((top,hint)); seen.add(rp)
    return out


def legacy_state(src:Path, fp:str)->str|None:
    """Understand the v0.14.8 raw rescue marker without blindly trusting it."""
    if not src.is_dir(): return None
    marker=src/'.pcga-rescued'
    if not marker.is_file(): return None
    data={}
    try:
        for line in marker.read_text(errors='replace').splitlines():
            if '=' in line:
                k,v=line.split('=',1); data[k]=v
    except OSError: return None
    # v0.14.8 used a GNU-find based fingerprint format that is intentionally
    # different from this reconciler's portable fingerprint. Do not compare the
    # hashes directly. For hard-link recoveries the filesystem itself is the
    # authoritative proof: every rescued source video should still have another
    # link after the queue item is moved into a library destination.
    dest=Path(data.get('destination','')) if data.get('destination') else None
    if data.get('method')=='hard-link':
        vv=videos(src)
        if vv:
            all_linked=True
            for p in vv:
                try:
                    if p.stat().st_nlink <= 1: all_linked=False; break
                except OSError:
                    all_linked=False; break
            if all_linked: return 'legacy-promoted' if not (dest and dest.exists()) else 'legacy-queued'
        return 'legacy-stale-marker'
    if dest and dest.exists(): return 'legacy-queued'
    return 'legacy-marker-uncertain'


def ledger_dir()->Path:
    p=Path('/var/lib/pc-game-archive/ingest-reconcile')
    p.mkdir(parents=True,exist_ok=True)
    return p


def ledger_path(src:Path)->Path:
    key=hashlib.sha256(str(src.resolve()).encode()).hexdigest()
    return ledger_dir()/(key+'.json')


def read_ledger(src:Path)->dict:
    p=ledger_path(src)
    try: return json.loads(p.read_text())
    except Exception: return {}


def write_ledger(src:Path,data:dict)->None:
    p=ledger_path(src); tmp=p.with_suffix('.tmp')
    tmp.write_text(json.dumps(data,indent=2,sort_keys=True)+'\n')
    os.replace(tmp,p)


def tracked_state(src:Path,fp:str)->str|None:
    d=read_ledger(src)
    if d.get('fingerprint')==fp:
        if d.get('method')=='content-match': return 'content-present'
        dest=Path(d.get('queued_path','')) if d.get('queued_path') else None
        if dest and dest.exists(): return 'queued'
        if d.get('method')=='hard-link':
            for p in videos(src):
                try:
                    if p.stat().st_nlink>1: return 'promoted-or-queued'
                except OSError: pass
            return 'stale-ledger'
        return 'ledger-uncertain'
    return legacy_state(src,fp)


def quick_signature(path:Path)->str:
    """Content signature using size plus bounded samples; avoids hashing 40GB files."""
    st=path.stat(); size=st.st_size; h=hashlib.sha256(); h.update(str(size).encode()+b'\0')
    sample=1024*1024
    with path.open('rb',buffering=0) as f:
        offsets=[0]
        if size>sample*3: offsets.append(max(0,(size//2)-(sample//2)))
        if size>sample: offsets.append(max(0,size-sample))
        for off in sorted(set(offsets)):
            f.seek(off); h.update(f.read(sample))
    return h.hexdigest()


def tracked_size_index(root:Path)->dict[int,list[Path]]:
    idx:dict[int,list[Path]]={}
    roots=[root/'media/arm/work/completed',root/'media/metadata-pending',root/'media/quarantine',root/'media/library']
    for base in roots:
        if not base.exists(): continue
        try:
            for p in base.rglob('*'):
                if not p.is_file() or p.suffix.lower() not in VIDEO_EXTS: continue
                try: idx.setdefault(p.stat().st_size,[]).append(p)
                except OSError: pass
        except OSError: pass
    return idx


def missing_against_tracked(source_files:list[Path],idx:dict[int,list[Path]])->list[Path]:
    cache:dict[str,str]={}
    missing=[]
    for src in source_files:
        try: st=src.stat()
        except OSError:
            missing.append(src); continue
        candidates=idx.get(st.st_size,[])
        if not candidates:
            missing.append(src); continue
        matched=False
        srcsig=None
        for cand in candidates:
            try:
                if os.path.samefile(src,cand): matched=True; break
            except OSError: pass
            try:
                if srcsig is None: srcsig=quick_signature(src)
                ck=str(cand)
                if ck not in cache: cache[ck]=quick_signature(cand)
                if cache[ck]==srcsig:
                    matched=True; break
            except OSError:
                continue
        if not matched: missing.append(src)
    return missing


def safe_label(src:Path)->str:
    name=src.name.strip().replace('/','-').replace('\x00','') or 'Recovered video'
    return name[:180]


def unique_pending(pending:Path,label:str)->Path:
    stamp=time.strftime('%Y%m%d-%H%M%S')
    d=pending/f'{stamp}-{label}'
    n=0
    while d.exists():
        n+=1; d=pending/f'{stamp}-{n}-{label}'
    return d


def link_selected(src:Path,dest:Path,selected:list[Path])->str:
    dest.mkdir(parents=True,exist_ok=False)
    methods=set()
    base=src if src.is_dir() else src.parent
    for old in selected:
        try: rel=old.relative_to(base)
        except ValueError: rel=Path(old.name)
        out=dest/rel; out.parent.mkdir(parents=True,exist_ok=True)
        try:
            os.link(old,out); methods.add('hard-link')
        except OSError:
            shutil.copy2(old,out); methods.add('copy')
    return 'hard-link' if methods=={'hard-link'} else 'copy' if methods=={'copy'} else 'mixed'


def queue_artifact(root:Path,src:Path,hint:str,fp:str,selected:list[Path]|None=None)->tuple[Path,str]:
    pending=root/'media/metadata-pending'; pending.mkdir(parents=True,exist_ok=True)
    dest=unique_pending(pending,safe_label(src))
    chosen=selected if selected is not None else videos(src)
    method=link_selected(src,dest,chosen)
    (dest/'.pcga-source-hint').write_text(hint+'\n')
    manifest={
        'tool':'pcga-ingest-reconcile','version':VERSION,'source':str(src),
        'source_hint':hint,'fingerprint':fp,'method':method,
        'queued_path':str(dest),'queued_utc':datetime.now(timezone.utc).isoformat(),
        'video_files':len(chosen),'video_bytes':sum((p.stat().st_size for p in chosen if p.exists()),0),
        'partial_recovery': len(chosen) != len(videos(src)),
    }
    (dest/'.pcga-ingest-recovery.json').write_text(json.dumps(manifest,indent=2,sort_keys=True)+'\n')
    write_ledger(src,manifest)
    return dest,method


def inventory(root:Path,settle_seconds:int)->list[dict]:
    rows=[]
    stages=[('raw',root/'media/arm/work/raw'),('transcode',root/'media/arm/work/transcode'),('completed',root/'media/arm/work/completed')]
    for kind,stage in stages:
        for src,hint in artifacts_for(stage,kind):
            try: fp=fingerprint(src)
            except OSError: continue
            state=tracked_state(src,fp) if kind in ('raw','transcode') else None
            rows.append({
                'stage':kind,'path':str(src),'hint':hint,'settled':settled(src,settle_seconds),
                'video_files':len(videos(src)),'video_bytes':size_bytes(src),'fingerprint':fp,
                'tracking':state or ('sorter-owned' if kind=='completed' else 'orphan-candidate')
            })
    return rows


def human(n:int)->str:
    units=['B','KiB','MiB','GiB','TiB']; x=float(n)
    for u in units:
        if x<1024 or u==units[-1]: return f'{x:.1f} {u}'
        x/=1024
    return f'{n} B'


def print_audit(rows:list[dict],busy:bool)->None:
    print(f'PCGA ingest audit v{VERSION}  ARM_active={"yes" if busy else "no"}')
    if not rows:
        print('No video artifacts found in ARM raw/transcode/completed staging.')
        return
    for r in rows:
        flag='settled' if r['settled'] else 'writing/recent'
        print(f"[{r['stage']:9}] {flag:13} {r['tracking']:22} {r['video_files']:2} file(s) {human(r['video_bytes']):>10}  {r['path']}")


def main()->int:
    ap=argparse.ArgumentParser(description='Audit/reconcile orphaned ARM video staging')
    ap.add_argument('command',nargs='?',choices=('audit','reconcile'),default='audit')
    ap.add_argument('--json',action='store_true')
    ap.add_argument('--quiet',action='store_true')
    ap.add_argument('--force',action='store_true',help='requeue stale/uncertain recovery markers too')
    ap.add_argument('--settle-seconds',type=int,default=int(os.environ.get('PCGA_RECONCILE_SETTLE_SECONDS','120')))
    args=ap.parse_args()
    root=root_path(); busy=arm_busy(); rows=inventory(root,args.settle_seconds)
    if args.command=='audit':
        if args.json: print(json.dumps({'version':VERSION,'arm_active':busy,'items':rows},indent=2))
        else: print_audit(rows,busy)
        return 0
    if busy and os.environ.get('PCGA_IGNORE_ARM_BUSY')!='1':
        if not args.quiet: print('ARM is active; reconciliation deferred so shared staging is not touched.')
        return 0
    moved=0
    eligible_rows=[]
    for r in rows:
        if r['stage']=='completed' or not r['settled']: continue
        state=r['tracking']
        eligible=state in ('orphan-candidate','stale-ledger','legacy-stale-marker') or (args.force and state in ('ledger-uncertain','legacy-marker-uncertain'))
        if eligible: eligible_rows.append(r)
    idx=tracked_size_index(root) if eligible_rows else {}
    for r in eligible_rows:
        src=Path(r['path']); all_videos=videos(src)
        missing=missing_against_tracked(all_videos,idx)
        if not missing:
            manifest={
                'tool':'pcga-ingest-reconcile','version':VERSION,'source':str(src),
                'source_hint':r['hint'],'fingerprint':r['fingerprint'],'method':'content-match',
                'queued_path':'','queued_utc':datetime.now(timezone.utc).isoformat(),
                'video_files':len(all_videos),'video_bytes':r['video_bytes'],
            }
            write_ledger(src,manifest)
            if not args.quiet: print(f'Already represented downstream: {src}')
            continue
        try:
            dest,method=queue_artifact(root,src,r['hint'],r['fingerprint'],missing)
        except Exception as exc:
            if not args.quiet: print(f'FAILED {src}: {exc}',file=sys.stderr)
            continue
        moved+=1
        # Add newly queued files to the in-memory index so a second source copy
        # in another ARM staging tree is not queued again in this same pass.
        for q in videos(dest):
            try: idx.setdefault(q.stat().st_size,[]).append(q)
            except OSError: pass
        detail='' if len(missing)==len(all_videos) else f' ({len(missing)}/{len(all_videos)} missing video files)'
        if not args.quiet: print(f'Queued orphan via {method}{detail}: {src} -> {dest}')
    if moved:
        try: subprocess.run(['systemctl','--no-block','start','pcga-metadata-classify.service'],check=False,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
        except OSError: pass
    if not args.quiet: print(f'Reconciliation complete: queued={moved}')
    return 0

if __name__=='__main__':
    raise SystemExit(main())
