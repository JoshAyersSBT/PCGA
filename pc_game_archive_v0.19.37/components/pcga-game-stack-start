#!/usr/bin/env bash
set -Eeuo pipefail

STACK_DIR=/opt/pc-game-archive
STATE_DIR=/var/lib/pc-game-archive/bootstrap
STATE_FILE="$STATE_DIR/game-stack.state"

log(){ printf '[pcga-game-stack] %s\n' "$*"; }

PCGA_GAME_STACK_LOCK="${PCGA_GAME_STACK_LOCK:-/run/pcga-game-stack-start.lock}"
pcga_acquire_game_stack_lock(){
  [[ "${PCGA_GAME_STACK_LOCK_HELD:-0}" == 1 ]] && return 0
  exec 9>"$PCGA_GAME_STACK_LOCK"
  if ! flock -w "${PCGA_GAME_STACK_LOCK_TIMEOUT:-180}" 9; then
    printf '[pcga-lock] Timed out waiting for game-stack reconciliation lock: %s\n' "$PCGA_GAME_STACK_LOCK" >&2
    return 75
  fi
  export PCGA_GAME_STACK_LOCK_HELD=1
}
state(){ install -d -m 0755 "$STATE_DIR"; printf '%s\n' "$1" >"$STATE_FILE"; chmod 0644 "$STATE_FILE"; }

[[ $EUID -eq 0 ]] || exec sudo -E bash "$0" "$@"
[[ -d "$STACK_DIR" ]] || { log "Stack directory missing: $STACK_DIR"; state failed; exit 1; }

# Only one boot/reconciliation path may manipulate the game containers at once.
pcga_acquire_game_stack_lock || exit $?

# The shared PC-game LAN is persistent Docker state, but reconcile it here as
# well so a manual network prune cannot leave LANCommander/Wolf unbootable.
GAME_LAN_NETWORK="$(awk -F= '$1=="PCGA_GAME_LAN_NETWORK"{print substr($0,index($0,"=")+1)}' "$STACK_DIR/.env" 2>/dev/null | tail -n1)"
GAME_LAN_NETWORK="${GAME_LAN_NETWORK:-legacy-games}"
GAME_LAN_SUBNET="$(awk -F= '$1=="PCGA_GAME_LAN_SUBNET"{print substr($0,index($0,"=")+1)}' "$STACK_DIR/.env" 2>/dev/null | tail -n1)"
GAME_LAN_SUBNET="${GAME_LAN_SUBNET:-10.40.0.0/16}"
if ! docker network inspect "$GAME_LAN_NETWORK" >/dev/null 2>&1; then
  log "Recreating shared PC-game LAN $GAME_LAN_NETWORK ($GAME_LAN_SUBNET)"
  docker network create --driver bridge --attachable --subnet "$GAME_LAN_SUBNET" "$GAME_LAN_NETWORK" >/dev/null || { state failed; exit 1; }
fi

cd "$STACK_DIR"
FILES=(-f compose.yml)
[[ -f compose.jellyfin-gpu.yml ]] && FILES+=(-f compose.jellyfin-gpu.yml)
[[ -f compose.immich.yml ]] && FILES+=(-f compose.immich.yml)
[[ -f compose.romm.yml ]] && FILES+=(-f compose.romm.yml)
[[ -f compose.arm.yml ]] && FILES+=(-f compose.arm.yml)
[[ -f compose.status.yml ]] && FILES+=(-f compose.status.yml)
[[ -f compose.wolf.yml ]] && FILES+=(-f compose.wolf.yml)
[[ -f compose.moonlight-web.yml ]] && FILES+=(-f compose.moonlight-web.yml)
[[ -f compose.game-lan.yml ]] && FILES+=(-f compose.game-lan.yml)
[[ -f compose.nas.yml ]] && FILES+=(-f compose.nas.yml)
DC=(docker compose "${FILES[@]}")

compose_up_retry(){
  local out rc attempt
  for attempt in 1 2 3 4 5 6; do
    out="$(mktemp)"
    if "${DC[@]}" up "$@" >"$out" 2>&1; then
      rm -f "$out"; return 0
    else
      rc=$?
    fi
    if grep -Fq 'removal of container' "$out" && grep -Fq 'already in progress' "$out"; then
      log "Docker is still finishing a prior container removal; retrying Compose (${attempt}/6)"
      rm -f "$out"
      sleep $((attempt * 2))
      continue
    fi
    cat "$out" >&2; rm -f "$out"; return "$rc"
  done
  log 'Docker did not finish the prior container removal after bounded retries'
  return 1
}


repair_wolf_x264_pipeline(){
  local cfg=/etc/wolf/cfg/config.toml
  [[ -f "$cfg" ]] || { printf 'unchanged\n'; return 0; }
  python3 - "$cfg" <<'PYWOLFX264'
from pathlib import Path
import sys, tomllib
p=Path(sys.argv[1])
s=p.read_text()
needle="    [[gstreamer.video.h264_encoders]]\n    check_elements = [ 'x264enc' ]"
start=s.find(needle)
if start < 0:
    print('unchanged')
    raise SystemExit(0)
end=s.find('    [[gstreamer.video.hevc_encoders]]', start)
if end < 0:
    end=len(s)
block=s[start:end]
if 'video_params =' in block:
    print('unchanged')
    raise SystemExit(0)
plugin="    plugin_name = 'x264'\n"
if plugin not in block:
    raise SystemExit('x264 encoder block is missing plugin_name')
addition=(
    "    plugin_name = 'x264'\n"
    "    video_params = '''videoconvertscale !\n"
    "videorate !\n"
    "video/x-raw, width={width}, height={height}, framerate={fps}/1, format=I420,\n"
    "chroma-site={color_range}, colorimetry={color_space}'''\n"
    "    video_params_zero_copy = '''videoconvertscale !\n"
    "videorate !\n"
    "video/x-raw, width={width}, height={height}, framerate={fps}/1, format=I420,\n"
    "chroma-site={color_range}, colorimetry={color_space}'''\n"
)
block=block.replace(plugin, addition, 1)
candidate=s[:start] + block + s[end:]
tomllib.loads(candidate)
p.write_text(candidate)
print('changed')
PYWOLFX264
}

# Docker can be active before it is actually ready to accept compose work during
# host boot. Bound the wait so systemd can retry rather than hanging forever.
docker_ready=0
for _ in $(seq 1 30); do
  if docker info >/dev/null 2>&1; then docker_ready=1; break; fi
  sleep 2
done
if [[ $docker_ready -ne 1 ]]; then
  log 'Docker daemon did not become ready'
  state failed
  exit 1
fi
"${DC[@]}" config >/dev/null

romm_enabled=true
if [[ -r /etc/pc-game-archive/appliance.json ]]; then
  romm_enabled="$(python3 - <<'PY'
import json
try:
    with open('/etc/pc-game-archive/appliance.json', encoding='utf-8') as f:
        d=json.load(f)
    print('true' if d.get('games',{}).get('romm_enabled', True) else 'false')
except Exception:
    print('true')
PY
)"
fi

wait_http(){
  local url="$1" label="$2" tries="${3:-60}"
  for _ in $(seq 1 "$tries"); do
    code="$(curl -sS -L --max-time 3 -o /dev/null -w '%{http_code}' "$url" 2>/dev/null || true)"
    case "$code" in 200|301|302|303|307|308) return 0;; esac
    sleep 2
  done
  log "$label did not become HTTP-ready at $url"
  return 1
}

# LANCommander is a baseline PCGA service. `docker compose up -d` is used
# deliberately instead of relying only on restart:unless-stopped: an interrupted
# first-user bootstrap may have left the container explicitly stopped.
log 'Ensuring LANCommander is running'
if ! compose_up_retry -d lancommander; then
  log 'Unable to start LANCommander with Docker Compose'
  state failed
  exit 1
fi
if ! wait_http 'http://127.0.0.1:1337/' 'LANCommander' 60; then
  "${DC[@]}" logs --tail=80 lancommander >&2 || true
  state failed
  exit 1
fi

lan_state="$(cat "$STATE_DIR/lancommander.state" 2>/dev/null || true)"
if [[ "$lan_state" != ready ]]; then
  log 'Completing LANCommander appliance bootstrap'
  if ! /usr/local/sbin/pcga-lancommander-bootstrap; then
    log 'LANCommander bootstrap is not complete'
    state failed
    exit 1
  fi
  wait_http 'http://127.0.0.1:1337/' 'LANCommander after bootstrap' 60 || { state failed; exit 1; }
fi

if [[ "$romm_enabled" == true && -f compose.romm.yml ]]; then
  romm_port="$(awk -F= '$1=="ROMM_PORT"{print $2}' .env 2>/dev/null | tail -n1)"
  romm_port="${romm_port:-8082}"
  log 'Ensuring RomM database and application are running'
  if ! compose_up_retry -d romm-db romm; then
    log 'Unable to start RomM with Docker Compose'
    state failed
    exit 1
  fi
  if ! wait_http "http://127.0.0.1:${romm_port}/api/heartbeat" 'RomM' 90; then
    "${DC[@]}" logs --tail=100 romm-db romm >&2 || true
    state failed
    exit 1
  fi

  romm_state="$(cat "$STATE_DIR/romm.state" 2>/dev/null || true)"
  if [[ "$romm_state" != ready ]]; then
    log 'Completing RomM appliance bootstrap'
    if /usr/local/sbin/pcga-romm-bootstrap; then
      # Bootstrap can change RomM environment values such as setup-wizard state.
      # Recreate only on this first/recovery bootstrap, never on normal boots.
      compose_up_retry -d --no-deps --force-recreate romm
      wait_http "http://127.0.0.1:${romm_port}/api/heartbeat" 'RomM after bootstrap' 90 || { state failed; exit 1; }
    else
      log 'RomM bootstrap is not complete'
      state failed
      exit 1
    fi
  fi
else
  # The portal control is authoritative. Do not resurrect RomM when the user has
  # intentionally disabled the emulator backend.
  if docker inspect romm >/dev/null 2>&1; then docker stop romm >/dev/null 2>&1 || true; fi
  if docker inspect romm-db >/dev/null 2>&1; then docker stop romm-db >/dev/null 2>&1 || true; fi
  log 'RomM is disabled in PCGA settings'
fi

if [[ -f compose.wolf.yml && -f compose.moonlight-web.yml ]]; then
  moon_port="$(awk -F= '$1=="PCGA_MOONLIGHT_WEB_PORT"{print $2}' .env 2>/dev/null | tail -n1)"
  moon_port="${moon_port:-8101}"
  ca_cert=/etc/pc-game-archive/tls/pcga-ca.crt
  log 'Reconciling the PCGA secure browser context'
  /usr/local/sbin/pcga-secure-context-bootstrap || { log 'Secure-context bootstrap failed'; state failed; exit 1; }

  # Docker may have auto-started last boot's containers before DHCP completed.
  # Explicitly replace only services whose embedded network identity is stale;
  # ordinary boots do not churn healthy streaming identities.
  expected_lan_ip="$(awk -F= '$1=="PCGA_LAN_IP"{print substr($0,index($0,"=")+1)}' .env 2>/dev/null | tail -n1)"
  if [[ "$expected_lan_ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    if docker inspect wolf >/dev/null 2>&1; then
      wolf_internal="$(docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' wolf 2>/dev/null | awk -F= '$1=="WOLF_INTERNAL_IP"{print $2; exit}')"
      if [[ "$wolf_internal" != "$expected_lan_ip" ]]; then
        log "Recreating Wolf for current DHCP address $expected_lan_ip (was ${wolf_internal:-unset})"
        compose_up_retry -d --no-deps --force-recreate wolf || { state failed; exit 1; }
      fi
    fi
    stale_moon=()
    for lane in 1 2 3 4; do
      svc=moonlight-web; container=pcga-moonlight-web
      if [[ $lane -gt 1 ]]; then svc="moonlight-web-$lane"; container="pcga-moonlight-web-$lane"; fi
      if docker inspect "$container" >/dev/null 2>&1; then
        nat_ip="$(docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$container" 2>/dev/null | awk -F= '$1=="WEBRTC_NAT_1TO1_HOST"{print $2; exit}')"
        [[ "$nat_ip" == "$expected_lan_ip" ]] || stale_moon+=("$svc")
      fi
    done
    if (( ${#stale_moon[@]} )); then
      log "Recreating stale Moonlight Web lane(s) for current DHCP address $expected_lan_ip: ${stale_moon[*]}"
      compose_up_retry -d --no-deps --force-recreate "${stale_moon[@]}" || { state failed; exit 1; }
    fi
  fi

  log 'Ensuring Wolf and all PCGA browser streaming lanes are running'
  if ! compose_up_retry -d wolf wolf-den moonlight-web moonlight-web-2 moonlight-web-3 moonlight-web-4; then
    log 'Unable to start Wolf/Moonlight Web streaming services'
    state failed
    exit 1
  fi
  # Wolf stable can persist an x264 fallback entry without the software
  # videoconvert/videorate stage. That renders a consumer pipeline containing
  # a bare `! !` and causes an immediate GStreamer parse failure.
  wolf_x264_repair="$(repair_wolf_x264_pipeline)"
  if [[ "$wolf_x264_repair" == changed ]]; then
    log 'Repaired Wolf software x264 video conversion pipeline'
    docker restart wolf >/dev/null || { log 'Unable to restart Wolf after x264 pipeline repair'; state failed; exit 1; }
    sleep 2
  fi
  for lane in 1 2 3 4; do
    lane_port=$((moon_port + lane - 1))
    lane_service=moonlight-web; lane_container=pcga-moonlight-web
    if [[ "$lane" -gt 1 ]]; then lane_service="moonlight-web-$lane"; lane_container="pcga-moonlight-web-$lane"; fi
    if ! curl --cacert "$ca_cert" -fsS --retry 30 --retry-delay 2 --retry-connrefused --max-time 4 "https://127.0.0.1:${lane_port}/" >/dev/null 2>&1; then
      "${DC[@]}" logs --tail=100 "$lane_service" >&2 || true
      state failed
      exit 1
    fi
    moon_network="$(docker inspect -f '{{.HostConfig.NetworkMode}}' "$lane_container" 2>/dev/null || true)"
    if [[ "$moon_network" != host ]]; then
      log "Moonlight Web lane $lane is using '$moon_network' networking; host networking is required for browser streaming"
      state failed
      exit 1
    fi
  done
  read -r moon_state moon_state_network moon_lanes < <(python3 - "$STATE_DIR/moonlight-web.json" <<'PY'
import json,sys
try: d=json.load(open(sys.argv[1]))
except Exception: d={}
print(d.get('state',''), d.get('network_mode',''), d.get('lane_count',0))
PY
)
  if [[ "$moon_state" != ready || "$moon_state_network" != host || "$moon_lanes" != 4 ]]; then
    PCGA_MOONLIGHT_WEB_LANES=4 /usr/local/sbin/pcga-moonlight-web-bootstrap || { log 'Moonlight Web appliance bootstrap failed'; state failed; exit 1; }
  fi
fi

state ready
log 'Game services are running and reconciled'
