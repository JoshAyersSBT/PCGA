#!/usr/bin/env bash
set -Eeuo pipefail

PCGA_GAME_STACK_LOCK="${PCGA_GAME_STACK_LOCK:-/run/pcga-game-stack-start.lock}"
pcga_acquire_game_stack_lock(){
  [[ "${PCGA_GAME_STACK_LOCK_HELD:-0}" == 1 ]] && return 0
  exec 9>"$PCGA_GAME_STACK_LOCK"
  if ! flock -w "${PCGA_GAME_STACK_LOCK_TIMEOUT:-180}" 9; then
    printf '[pcga-lock] Timed out waiting for game-stack reconciliation lock: %s\n' "$PCGA_GAME_STACK_LOCK" >&2
    return 75
  fi
  export PCGA_GAME_STACK_LOCK_HELD=1
}
pcga_acquire_game_stack_lock || exit $?
STATE_DIR=/var/lib/pc-game-archive/bootstrap
STATE_FILE="$STATE_DIR/romm.state"
SECRETS=/etc/pc-game-archive/secrets
CREDS="$SECRETS/romm-bootstrap.env"
ROMM_ENV=/etc/pc-game-archive/romm.env
STACK_ENV=/opt/pc-game-archive/.env
install -d -m 0755 "$STATE_DIR"
install -d -m 0700 "$SECRETS"
[[ -x /usr/local/sbin/pcga-appliance-credentials ]] && /usr/local/sbin/pcga-appliance-credentials
state(){ printf '%s\n' "$1" >"$STATE_FILE"; chmod 0644 "$STATE_FILE"; }
port="${PCGA_ROMM_PORT:-}"
if [[ -z "$port" && -r "$STACK_ENV" ]]; then port="$(awk -F= '$1=="ROMM_PORT"{print $2}' "$STACK_ENV" | tail -n1)"; fi
port="${port:-8082}"
base="http://127.0.0.1:${port}"
for _ in $(seq 1 90); do curl -fsS --max-time 2 "$base/api/heartbeat" >/dev/null 2>&1 && break; sleep 2; done
curl -fsS --max-time 3 "$base/api/heartbeat" >/dev/null 2>&1 || { state failed; echo 'RomM heartbeat unavailable' >&2; exit 1; }
set_env(){ python3 - "$ROMM_ENV" "$1" "$2" <<'PYENV'
from pathlib import Path
import sys
p=Path(sys.argv[1]); k=sys.argv[2]; v=sys.argv[3]
lines=p.read_text().splitlines() if p.exists() else []
for i,line in enumerate(lines):
    if line.startswith(k+'='): lines[i]=f'{k}={v}'; break
else: lines.append(f'{k}={v}')
p.write_text('\n'.join(lines)+'\n')
PYENV
chmod 0600 "$ROMM_ENV"; }
verify(){
  local u="$1" p="$2"
  curl -fsS --max-time 8 \
    -H 'Content-Type: application/x-www-form-urlencoded' \
    --data-urlencode 'grant_type=password' \
    --data-urlencode "username=$u" \
    --data-urlencode "password=$p" \
    --data-urlencode 'scope=roms.read platforms.read assets.read firmware.read tasks.run' \
    "$base/api/token" | python3 -c 'import json,sys; d=json.load(sys.stdin); assert d.get("access_token")' >/dev/null 2>&1
}
persist_ready(){
  local u="$1" p="$2"
  umask 077
  cat >"$CREDS" <<EOF_CREDS
PCGA_ROMM_ADMIN_USER=$u
PCGA_ROMM_ADMIN_PASSWORD=$p
EOF_CREDS
  chmod 0600 "$CREDS"
  chown root:root "$CREDS" 2>/dev/null || true
  set_env DISABLE_SETUP_WIZARD true
  state ready
}
reconcile_reserved_identity(){
  local u="$1" email="$2" p="$3"
  # RomM intentionally closes unauthenticated admin creation after the first
  # administrator exists. PCGA still owns this appliance's RomM container and
  # database, so reconcile only the reserved PCGA identity through RomM's own
  # ORM/auth handlers. Existing non-PCGA users and administrators are untouched.
  docker exec \
    -e PCGA_BOOTSTRAP_USER="$u" \
    -e PCGA_BOOTSTRAP_EMAIL="$email" \
    -e PCGA_BOOTSTRAP_PASSWORD="$p" \
    -i romm python3 - <<'PYROMM'
import os
from handler.auth import auth_handler
from handler.database import db_user_handler
from models.user import Role, User

username = os.environ["PCGA_BOOTSTRAP_USER"].strip().lower()
email = os.environ.get("PCGA_BOOTSTRAP_EMAIL", "").strip().lower()
password = os.environ["PCGA_BOOTSTRAP_PASSWORD"]

existing = db_user_handler.get_user_by_username(username)
email_owner = db_user_handler.get_user_by_email(email) if email else None
safe_email = email if (not email_owner or (existing and email_owner.id == existing.id)) else None
hashed = auth_handler.get_password_hash(password)

if existing:
    updates = {
        "hashed_password": hashed,
        "enabled": True,
        "role": Role.ADMIN,
    }
    # Preserve an existing address. Only attach the appliance address when it
    # is unused, so a pre-existing administrator is never modified indirectly.
    if not existing.email and safe_email:
        updates["email"] = safe_email
    db_user_handler.update_user(existing.id, updates)
    print("updated")
else:
    db_user_handler.add_user(
        User(
            username=username,
            hashed_password=hashed,
            email=safe_email,
            enabled=True,
            role=Role.ADMIN,
        )
    )
    print("created")
PYROMM
}
enable_emulation(){
  set_env DISABLE_EMULATOR_JS false
  set_env DISABLE_RUFFLE_RS false
}
enable_emulation
if [[ -s "$CREDS" ]]; then
  # shellcheck disable=SC1090
  . "$CREDS"
  if verify "$PCGA_ROMM_ADMIN_USER" "$PCGA_ROMM_ADMIN_PASSWORD"; then
    set_env DISABLE_SETUP_WIZARD true
    state ready
    exit 0
  fi
fi
# New PCGA-managed RomM accounts always use the common appliance identity.
. /etc/pc-game-archive/secrets/appliance-admin.env
user="$PCGA_APPLIANCE_ADMIN_USER"
email="$PCGA_APPLIANCE_ADMIN_EMAIL"
pass="$PCGA_APPLIANCE_ADMIN_PASSWORD"
payload="$(python3 - "$user" "$email" "$pass" <<'PYJSON'
import json,sys
print(json.dumps({'username':sys.argv[1],'email':sys.argv[2],'password':sys.argv[3],'role':'ADMIN'}))
PYJSON
)"
out="$(mktemp)"
trap 'rm -f "$out"' EXIT
code="$(curl -sS --max-time 8 -o "$out" -w '%{http_code}' -H 'Content-Type: application/json' -d "$payload" "$base/api/users" || true)"
if [[ "$code" == 200 || "$code" == 201 ]]; then
  if ! verify "$user" "$pass"; then state failed; echo 'RomM admin was created but authentication verification failed' >&2; exit 1; fi
  persist_ready "$user" "$pass"
  exit 0
fi

# When RomM already has an administrator, /api/users correctly stops being a
# public bootstrap endpoint. That is not an "external administration" terminal
# state for a PCGA-owned service: add/reconcile the reserved appliance identity
# through RomM's own model/authentication layer, then verify it through OAuth.
case "$code" in
  400|401|403|409|422)
    if ! reconcile_reserved_identity "$user" "$email" "$pass"; then
      state failed
      echo "RomM already has users, but PCGA could not reconcile its reserved appliance identity (HTTP $code from first-user API)" >&2
      exit 1
    fi
    if ! verify "$user" "$pass"; then
      state failed
      echo 'RomM reserved appliance identity was reconciled but OAuth verification failed' >&2
      exit 1
    fi
    persist_ready "$user" "$pass"
    echo 'RomM already initialized; preserved existing users and reconciled the PCGA appliance identity.'
    ;;
  *)
    state failed
    echo "RomM bootstrap failed (HTTP $code): $(cat "$out" 2>/dev/null)" >&2
    exit 1
    ;;
esac
