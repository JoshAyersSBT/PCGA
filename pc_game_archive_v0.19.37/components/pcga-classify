def auto_threshold() -> float:
    env = os.environ.get('PCGA_CLASSIFY_AUTO_THRESHOLD','').strip()
    if env:
        try:
            return max(0.50, min(1.0, float(env)))
        except ValueError:
            pass
    try:
        cfg = json.loads(Path('/etc/pc-game-archive/appliance.json').read_text(encoding='utf-8'))
        return max(0.50, min(1.0, float(((cfg.get('review') or {}).get('auto_threshold', 0.90)))))
    except Exception:
        return 0.90

def log(msg: str) -> None:
    print(f'[classify] {msg}', flush=True)
    try:
        subprocess.run(['logger','-t','PCGA-CLASSIFY','--',msg], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    except OSError:
        pass


def root_path() -> Path:
    value = os.environ.get('PCGA_ROOT_OVERRIDE','').strip()
    if not value:
        p = Path('/etc/pc-game-archive/archive-root')
        value = p.read_text().strip() if p.exists() else ''
    root = Path(value)
    if not root.is_absolute():
        raise SystemExit('pcga-classify: invalid archive root')
    return root


def clean_name(name: str) -> tuple[str, str | None]:
    n = re.sub(r'^\d{8}-\d{6}-(?:\d+-)?', '', name)
    n = re.sub(r'(?i)^raw-', '', n)
    n = re.sub(r'_\d{10,}$', '', n)
    n = re.sub(r'(?i)(?:[._ -]+(?:t|title)[._ -]*\d{1,3})$', '', n)
    n = re.sub(r'(?i)\b(?:disc|disk|cd|dvd|blu[ -]?ray|bd)[ _.-]*\d+\b', ' ', n)
    n = re.sub(r'(?i)\b(?:proper|repack|remux|bluray|brrip|webrip|web-dl|dvdrip|x26[45]|h26[45]|hevc|aac|dts)\b', ' ', n)
    year = None
    m = re.search(r'(?:\(|\[|\b)((?:19|20)\d{2})(?:\)|\]|\b)', n)
    if m:
        year = m.group(1)
        n = n[:m.start()] + ' ' + n[m.end():]
    n = re.sub(r'[._]+', ' ', n)
    n = re.sub(r'\s+', ' ', n).strip(' -_.')
    return n, year


def safe_name(value: str) -> str:
    return re.sub(r'[\\/\0]', '-', str(value)).strip() or 'Unknown'


def original_queue_name(name: str) -> str:
    """Remove only PCGA's temporary timestamp prefix from a queued filename."""
    cleaned = re.sub(r'^\d{8}-\d{6}-(?:\d+-)?', '', name)
    return cleaned or name


def iter_files(path: Path, limit: int = 4000) -> list[Path]:
    if path.is_file():
        return [path]
    out: list[Path] = []
    try:
        for p in path.rglob('*'):
            if p.is_file():
                if p.name.startswith(INTERNAL_PREFIX):
                    continue
                out.append(p)
                if len(out) >= limit:
                    break
    except OSError:
        pass
    return out


def relative_names(path: Path, files: list[Path]) -> list[str]:
    if path.is_file():
        return [path.name.lower()]
    vals=[]
    for f in files:
        try: vals.append(str(f.relative_to(path)).replace('\\','/').lower())
        except ValueError: vals.append(f.name.lower())
    return vals


def settled(path: Path, seconds: int) -> bool:
    try:
        files = iter_files(path)
        if not files:
            return False
        mt = max([path.stat().st_mtime] + [p.stat().st_mtime for p in files])
        return time.time() - mt >= seconds
    except OSError:
        return False


