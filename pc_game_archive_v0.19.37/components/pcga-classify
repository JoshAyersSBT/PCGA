def file_index(path: Path) -> list[dict]:
    """Read the bounded optical directory index produced by pcga-pc-disc-rip."""
    if not path.is_dir():
        return []
    p=path/'.pcga-file-index.json'
    try:
        data=json.loads(p.read_text(encoding='utf-8')) if p.is_file() else {}
    except Exception:
        return []
    rows=data.get('files') if isinstance(data,dict) else []
    return [x for x in rows if isinstance(x,dict) and str(x.get('path') or '').strip()][:4000]


def _pretty_game_title(value: str) -> str:
    value=Path(str(value or '')).stem
    value=re.sub(r'(?i)[ _.-]*(?:manual|readme|setup|installer|launcher)$','',value)
    value=value.replace('®',' ').replace('™',' ')
    value=re.sub(r'([a-z0-9])([A-Z])',r'\1 \2',value)
    value=re.sub(r'[_ .-]+',' ',value).strip()
    # Split a trailing roman numeral that was glued to a word (BattlefrontII).
    value=re.sub(r'(?i)([a-z])((?:ii|iii|iv|vi|vii|viii|ix|x))$',r'\1 \2',value)
    return re.sub(r'\s+',' ',value).strip()


def optical_game_signal(path: Path, optical: dict) -> tuple[float,list[str],str|None]:
    """Score strong local Windows-game evidence without relying on Internet metadata.

    Optical dispatcher routing alone is intentionally weak.  A real application
    executable plus installer payload/autorun/DirectX structure is strong enough
    to publish the preserved disc as a PC-game candidate automatically.
    """
    insp=optical.get('inspection') if isinstance(optical.get('inspection'),dict) else {}
    index=file_index(path)
    indexed=[str(x.get('path') or '') for x in index]
    low=[x.lower() for x in indexed]
    app=[str(x) for x in (insp.get('application_executables') or []) if str(x).strip()]
    if not app:
        app=[x for x in indexed if x.lower().endswith('.exe')]
    generic={
        'setup.exe','install.exe','installer.exe','dxsetup.exe','dsetup.exe','syscheck.exe',
        'unins000.exe','uninstall.exe','autorun.exe','adberdr934_en_us.exe','adberdr.exe',
    }
    generic_dirs={'directx','redist','redistributable','adobe','install','support','tools'}
    game_exec=[]
    for raw in app:
        rp=Path(raw)
        base=rp.name.lower()
        parts={x.lower() for x in rp.parts[:-1]}
        if base in generic or base.startswith(('unins','vcredist','dotnetfx','adberdr')):
            continue
        if parts & generic_dirs and not any(k in base for k in ('game','battle','client','play')):
            continue
        game_exec.append(raw)
    installer=[str(x) for x in (insp.get('installer_markers') or []) if str(x).strip()]
    has_autorun=any(Path(x).name.lower()=='autorun.inf' for x in indexed) or any(str(x).lower()=='autorun.inf' for x in installer)
    has_setup=any(Path(x).name.lower() in {'setup.exe','install.exe','installer.exe'} for x in indexed) or any('setup.exe' in str(x).lower() for x in installer)
    cab_count=sum(1 for x in low if x.endswith('.cab'))
    installshield=any(x.endswith(('setup.inx','setup.ins','setup.isn','engine32.cab','data1.hdr')) for x in low)
    directx=any('/directx/' in ('/'+x) or x.startswith('directx/') for x in low)
    score=0
    evidence=[]
    if has_autorun: score+=1; evidence.append('autorun metadata present')
    if has_setup: score+=1; evidence.append('Windows installer executable present')
    if cab_count>=2: score+=1; evidence.append(f'installer payload contains {cab_count} CAB archive(s)')
    if installshield: score+=1; evidence.append('InstallShield-style setup payload detected')
    if directx: score+=1; evidence.append('bundled DirectX runtime detected')
    if game_exec: score+=3; evidence.append('application executable(s): '+', '.join(game_exec[:3]))

    # Manuals frequently preserve the human product title even when the volume
    # label is an acronym (for example BFII).
    title_candidates=[]
    for raw in indexed:
        name=Path(raw).name
        if re.search(r'(?i)(?:^|[-_ .])manual(?:[-_ .]|$)',name):
            candidate=_pretty_game_title(re.sub(r'(?i)[-_ .]*manual.*$','',Path(name).stem))
            if len(candidate)>=4: title_candidates.append(candidate)
    if not title_candidates:
        for raw in game_exec:
            candidate=_pretty_game_title(Path(raw).stem)
            if len(candidate)>=4: title_candidates.append(candidate)
    title=max(title_candidates,key=len) if title_candidates else None
    confidence=0.0
    if score>=6: confidence=0.99
    elif score>=5: confidence=0.98
    elif score>=4: confidence=0.96
    elif score>=3: confidence=0.92
    return confidence,evidence,title


def optical_fingerprint(path: Path) -> str:
    data=optical_manifest(path)
    return str(data.get('fingerprint') or '').strip() if isinstance(data,dict) else ''


def update_optical_dispatch(fingerprint: str, phase: str, *, classification: str|None=None,
                            confidence: float|None=None, downstream: Path|None=None,
                            detail: str|None=None) -> None:
    if not fingerprint:
        return
    base=Path('/var/lib/pc-game-archive/optical-dispatch')
    if not base.exists():
        return
    for state_path in base.glob('*.json'):
        try:
            data=json.loads(state_path.read_text(encoding='utf-8'))
        except Exception:
            continue
        if str(data.get('fingerprint') or '') != fingerprint:
            continue
        data['phase']=phase
        data['updated_at']=time.strftime('%Y-%m-%dT%H:%M:%SZ',time.gmtime())
        if classification: data['classification']=classification
        if confidence is not None: data['classification_confidence']=round(float(confidence),3)
        if downstream is not None:
            data['downstream_path']=str(downstream)
            data['final_path']=str(downstream)
        if detail: data['operation']=detail
        tmp=state_path.with_suffix('.tmp')
        try:
            tmp.write_text(json.dumps(data,indent=2,sort_keys=True)+'\n',encoding='utf-8')
            os.replace(tmp,state_path)
        except OSError:
            try: tmp.unlink(missing_ok=True)
            except OSError: pass


def downstream_optical_index(root: Path) -> dict[str,Path]:
    index={}
    roots=[root/'ingest/inbox/pc-games',root/'ingest/inbox/software',root/'ingest/inbox/disc-images',root/'media/library']
    for base in roots:
        if not base.exists(): continue
        try:
            manifests=base.rglob('.pcga-optical.json')
            for manifest in manifests:
                try:
                    data=json.loads(manifest.read_text(encoding='utf-8'))
                    fp=str(data.get('fingerprint') or '').strip()
                    if fp and fp not in index: index[fp]=manifest.parent
                except Exception: continue
        except OSError: continue
    return index


def retire_consumed_pending(root: Path, src: Path, downstream: Path, fingerprint: str) -> Path:
    """Move a stale already-published queue copy out of the active classifier."""
    base=root/'media/quarantine/duplicates'
    base.mkdir(parents=True,exist_ok=True)
    stamp=time.strftime('%Y%m%d-%H%M%S')
    target=base/f'{stamp}-consumed-{src.name}'
    n=0
    while target.exists():
        n+=1; target=base/f'{stamp}-consumed-{n}-{src.name}'
    was_file=src.is_file()
    side=manifest_path(src) if was_file else None
    shutil.move(str(src),str(target))
    if side and side.exists():
        try: shutil.move(str(side),str(target.with_name(target.name+'.pcga-classification.json')))
        except OSError: pass
    receipt=target/'.pcga-consumed.json' if target.is_dir() else target.with_name(target.name+'.pcga-consumed.json')
    payload={'schema':1,'pcga_version':VERSION,'fingerprint':fingerprint,'downstream_path':str(downstream),
             'retired_at':time.strftime('%Y-%m-%dT%H:%M:%SZ',time.gmtime()),'reason':'already-published-optical-fingerprint'}
    try: receipt.write_text(json.dumps(payload,indent=2,sort_keys=True)+'\n',encoding='utf-8')
    except OSError: pass
    update_optical_dispatch(fingerprint,'published',downstream=downstream,detail='Preserved source already exists downstream')
    log(f'retired stale pending copy {src.name}; fingerprint already published at {downstream}')
    return target

def file_size(path: Path) -> int:
    try:
        return max(0, int(path.stat().st_size))
    except OSError:
        return 0


def parse_episode_identity(name: str) -> dict | None:
    """Extract stable series/season/episode identity from a Jellyfin-style name."""
    raw = original_queue_name(Path(name).stem)
    match = None
    for rx in EPISODE_TOKEN_PATTERNS:
        match = rx.search(raw)
        if match:
            break
    if not match:
        return None
    prefix = raw[:match.start()].strip(' ._-')
    suffix = raw[match.end():].strip(' ._-')
    series, year = clean_name(prefix)
    if not series:
        return None
    # Episode titles should not absorb common release tags/codecs.
    episode_title, _ = clean_name(suffix) if suffix else ('', None)
    try:
        season = int(match.group('season'))
        episode = int(match.group('episode'))
        end_raw = match.groupdict().get('episode_end')
        episode_end = int(end_raw) if end_raw else None
    except (TypeError, ValueError):
        return None
    return {
        'series': series,
        'year': year,
        'season': season,
        'episode': episode,
        'episode_end': episode_end,
        'episode_title': episode_title or None,
    }


def provider_folder_tag(provider: str | None, provider_id: str | int | None) -> str:
    pid = str(provider_id or '').strip()
    p = str(provider or '').strip().lower()
    if not pid:
        return ''
    if p == 'tmdb' and re.fullmatch(r'\d+', pid):
        return f'[tmdbid-{pid}]'
    if p == 'tvdb' and re.fullmatch(r'\d+', pid):
        return f'[tvdbid-{pid}]'
    if (p in ('omdb', 'imdb') or pid.startswith('tt')) and re.fullmatch(r'tt\d+', pid):
        return f'[imdbid-{pid}]'
    return ''


def tv_series_folder_name(d: Decision, include_provider: bool = True) -> str:
    series = safe_name(d.series or d.title or 'Unknown Series')
    year = re.sub(r'\D', '', d.year or '')[:4]
    parts = [series]
    if year:
        parts.append(f'({year})')
    tag = provider_folder_tag(d.provider, d.provider_id) if include_provider else ''
    if tag:
        parts.append(tag)
    return ' '.join(parts)


def find_tv_series_root(root: Path, d: Decision) -> Path:
    tvroot=root/'media/library/tv'; tvroot.mkdir(parents=True,exist_ok=True)
    preferred=tvroot/tv_series_folder_name(d,True)
    base=tvroot/tv_series_folder_name(d,False)
    pid=str(d.provider_id or '').strip(); provider=str(d.provider or '').strip().lower()
    if pid:
        for child in tvroot.iterdir():
            if not child.is_dir(): continue
            ident=child/'.pcga-series.json'
            try: data=json.loads(ident.read_text()) if ident.exists() else {}
            except Exception: data={}
            if str(data.get('provider_id') or '')==pid and str(data.get('provider') or '').lower()==provider:
                return child
    if preferred.exists(): return preferred
    if pid and base.exists() and base != preferred:
        try:
            base.rename(preferred)
            return preferred
        except OSError:
            return base
    if base.exists(): return base
    return preferred


def canonical_episode_stem(series: str, season: int, episode: int,
                           episode_end: int | None = None,
                           episode_title: str | None = None) -> str:
    token = f'S{season:02d}E{episode:02d}'
    if episode_end is not None and episode_end != episode:
        token += f'-E{episode_end:02d}'
    stem = f'{safe_name(series)} - {token}'
    if episode_title:
        stem += ' - ' + safe_name(episode_title)
    return stem


def inspect_local(path: Path) -> Decision:
    files = iter_files(path)
    names = relative_names(path, files)
    basenames = {Path(x).name for x in names}
    dirs = set()
    if path.is_dir():
        try:
            dirs = {p.name.lower() for p in path.rglob('*') if p.is_dir()}
        except OSError:
            pass
    videos = [f for f in files if f.suffix.lower() in VIDEO_EXTS]
    audios = [f for f in files if f.suffix.lower() in AUDIO_EXTS]
    images = [f for f in files if f.suffix.lower() in IMAGE_EXTS]
    discs = [f for f in files if f.suffix.lower() in DISC_EXTS]
    title, year = clean_name(path.stem if path.is_file() else path.name)
    evidence: list[str] = []
    hint = source_hint(path)
    if hint:
        evidence.append(f'source category hint: {hint}')

    media=media_manifest(path)
    if media:
        layout=str(media.get('layout') or '').strip().lower()
        contents=media.get('contents') if isinstance(media.get('contents'),list) else []
        status=str(media.get('metadata_status') or 'provisional').strip().lower()
        media_title=str(media.get('collection_title') or media.get('title') or title or '').strip()
        if len(contents)>1 or layout in {'multi-title','multi-title-candidate','collection'}:
            names=[str((x or {}).get('title') or '').strip() for x in contents if isinstance(x,dict)]
            evidence.append(f'pre-rip media metadata: {layout or "multi-title"} with {len(contents)} logical item(s)')
            if names:evidence.append('included media: '+', '.join(x for x in names[:6] if x))
            # A multi-title physical disc must be split/mapped by title index before
            # Jellyfin promotion; confidence describes the source relationship, not
            # confidence that a single library destination is safe.
            return Decision('video','optical-multi-title',0.89,'review',evidence,media_title or title,year)
        if contents:
            item=contents[0] if isinstance(contents[0],dict) else {}
            kind=str(item.get('kind') or media.get('kind') or 'video').lower()
            item_title=str(item.get('title') or media_title or title).strip()
            evidence.append(f'pre-rip media metadata: {layout or "single-title"}; status={status}')
            if media.get('disc_number'):evidence.append(f"disc {media.get('disc_number')} of {media.get('disc_count') or '?'}")
            if kind=='movie':
                if status=='confirmed' and layout=='single-title':
                    # Confirmation of the *disc's identity* is not confirmation
                    # of which MakeMKV title is the actual feature.
                    return Decision('movie','optical-single-title',0.99,'review',evidence,item_title,year)
                # Multi-disc films require explicit part/bonus mapping before files
                # can be named safely for Jellyfin stacking/extras.
                return Decision('movie','optical-multi-disc' if layout=='multi-disc-title' else 'optical-title-candidate',0.89,'review',evidence,item_title,year)
            if kind=='tv':
                series=str(item.get('series') or item_title).strip()
                season=item.get('season') if item.get('season') is not None else media.get('season')
                try:season=int(season) if season is not None else None
                except (TypeError,ValueError):season=None
                evidence.append('TV disc relationship retained; episode/title-index mapping is required before automatic Jellyfin promotion')
                return Decision('tv','optical-season-disc',0.89,'review',evidence,series,year,series=series,season=season)

    game=game_manifest(path)
    if game:
        layout=str(game.get('layout') or '').strip().lower()
        contents=game.get('contents') if isinstance(game.get('contents'),list) else []
        ids=game.get('game_set_ids') if isinstance(game.get('game_set_ids'),list) else []
        status=str(game.get('metadata_status') or 'provisional').strip().lower()
        game_title=str(game.get('collection_title') or game.get('title') or title or '').strip()
        if layout=='compilation' and len(contents)>=2:
            evidence.append(f'pre-rip game metadata: compilation with {len(contents)} included game(s)')
            names=[str((x or {}).get('title') or '').strip() for x in contents if isinstance(x,dict)]
            if names: evidence.append('included games: '+', '.join(x for x in names[:6] if x))
            if status=='confirmed':
                return Decision('pc-game','preserved-game-compilation',0.99,'auto',evidence,game_title or title,year)
            return Decision('pc-game','preserved-game-compilation-candidate',0.93,'review',evidence,game_title or title,year)
        if ids or game.get('game_set_id'):
            evidence.append(f'pre-rip game metadata: {layout or "game-disc"}')
            optical=optical_manifest(path)
            signal_conf,signal_ev,signal_title=optical_game_signal(path,optical) if optical else (0.0,[],None)
            evidence.extend(signal_ev)
            conf=0.99 if status=='confirmed' else max(0.94,signal_conf)
            chosen=game_title or title
            # Prefer a descriptive local title over a short/acronymic volume label.
            if signal_title and (not chosen or len(re.sub(r'\W','',chosen))<=6 or len(signal_title)>len(chosen)+5):
                chosen=signal_title
            return Decision('pc-game','preserved-game-disc',conf,'auto' if conf>=auto_threshold() else 'review',evidence,chosen,year)

    optical=optical_manifest(path)
    if optical:
        guess=str(optical.get('content_guess') or '').strip().lower()
        try: guess_conf=float(optical.get('content_confidence') or 0.0)
        except (TypeError,ValueError): guess_conf=0.0
        route=str(optical.get('route') or '').strip().lower()
        kind=str(optical.get('kind') or '').strip().lower()
        fs=(optical.get('filesystem') or {}) if isinstance(optical.get('filesystem'),dict) else {}
        label=str(fs.get('label') or '').strip()
        evidence.append(f'optical dispatcher: {kind or "unknown"} via {route or "unknown"}')
        if label: evidence.append(f'optical volume label: {label}')
        insp=optical.get('inspection') or {}
        if isinstance(insp,dict):
            gm=insp.get('game_markers') or []; gs=insp.get('game_suffix_hits') or []; im=insp.get('installer_markers') or []
            if gm: evidence.append('disc game marker(s): '+', '.join(str(x) for x in gm[:5]))
            if gs: evidence.append('disc game-data file(s): '+', '.join(str(x) for x in gs[:3]))
            if im: evidence.append('disc installer marker(s): '+', '.join(str(x) for x in im[:5]))
        if guess == 'pc-game' and guess_conf >= 0.90:
            return Decision('pc-game','preserved-optical-disc',max(0.90,min(0.99,guess_conf)),'auto',evidence,title,year)
        if guess == 'pc-game-candidate':
            signal_conf,signal_ev,signal_title=optical_game_signal(path,optical)
            evidence.extend(signal_ev)
            if signal_conf >= auto_threshold():
                return Decision('pc-game','preserved-optical-game',signal_conf,'auto',evidence,signal_title or title,year)
            return Decision('pc-game','preserved-optical-disc-candidate',max(0.80,min(0.89,guess_conf,signal_conf or 0.89)),'review',evidence,signal_title or title,year)
        if guess == 'software':
            return Decision('software','preserved-optical-disc',max(0.78,min(0.89,guess_conf)),'review',evidence,title,year)
        if route in ('pc-data','pc-mixed'):
            return Decision('disc-image','preserved-data-disc',0.72,'review',evidence,title,year)

    if 'video_ts' in dirs:
        return Decision('video','dvd-video',0.99,'review',['DVD-Video VIDEO_TS structure detected'],title,year)
    if 'bdmv' in dirs:
        return Decision('video','bluray-video',0.99,'review',['Blu-ray BDMV structure detected'],title,year)

    game_hits = sorted(x for x in basenames if x in GAME_MARKERS or x.startswith('goggame-'))
    if game_hits:
        evidence.append('game-specific marker(s): ' + ', '.join(game_hits[:5]))
        if 'autorun.inf' in basenames: evidence.append('autorun.inf present')
        return Decision('pc-game','data-disc',0.99,'auto',evidence,title,year)

    software_hits = sorted(x for x in basenames if x in SOFTWARE_MARKERS)
    installer_files = [x for x in names if Path(x).suffix.lower() in INSTALLER_EXTS]
    if software_hits and (len(files) >= 2 or installer_files):
        evidence.append('installer marker(s): ' + ', '.join(software_hits[:5]))
        if any(x.endswith(('.cab','.msi')) for x in names): evidence.append('installer payload (.cab/.msi) detected')
        return Decision('software','data-disc',0.96,'auto',evidence,title,year)

    if path.is_file() and path.suffix.lower() in DISC_EXTS:
        if hint == 'pc-game' and path.suffix.lower() in {'.iso','.img','.mdf','.mds','.bin','.cue'}:
            return Decision('pc-game','uploaded-optical-image',0.99,'auto',[f'explicit PC game upload; optical-disc image {path.suffix.lower()}'],title,year)
        return Decision('disc-image','optical-image',0.94,'auto',[f'optical-disc image extension {path.suffix.lower()}'],title,year)
    if discs and not videos and not audios:
        return Decision('disc-image','optical-image-set',0.94,'auto',[f'{len(discs)} optical-disc image file(s) detected'],title,year)

    if images and not videos and not audios and not discs:
        if len(images) == len(files):
            subtype='photo-collection' if len(images) >= 2 or path.is_dir() else 'photo-file'
            return Decision('photo',subtype,0.99,'auto',[f'{len(images)} image file(s), no audio/video/disc payload'],title,year)

    if audios and not videos:
        if len(audios) >= 2 or path.is_dir():
            return Decision('music','audio-collection',0.98,'auto',[f'{len(audios)} audio track file(s), no video'],title,year)
        return Decision('music','audio-file',0.92,'auto',['single audio file, no video'],title,year)

    if videos:
        if hint == 'home-video':
            return Decision('home-video','user-home-video',0.99,'auto',evidence+['explicit Home Video upload hint'],title,year)
        episode_rows=[]
        for f in videos:
            parsed=parse_episode_identity(f.name)
            if parsed:
                if path.is_dir():
                    try: parsed['path']=str(f.relative_to(path))
                    except ValueError: parsed['path']=f.name
                else:
                    parsed['path']=f.name
                episode_rows.append(parsed)
        if episode_rows:
            same_series=len({re.sub(r'[^a-z0-9]+',' ',str(x['series']).lower()).strip() for x in episode_rows}) == 1
            all_parsed=len(episode_rows) == len(videos)
            nonvideo=[f for f in files if f.suffix.lower() not in VIDEO_EXTS]
            first=episode_rows[0]
            ev=list(evidence)
            ev.append(f'episode identity parsed from {len(episode_rows)} of {len(videos)} video item(s)')
            ev.append(f"series={first['series']}; first=S{int(first['season']):02d}E{int(first['episode']):02d}")
            if same_series and all_parsed and not nonvideo:
                d=Decision('tv','episodic-video',0.99,'auto',ev,
                           first['series'], first.get('year') or year,
                           series=first['series'], episodes=episode_rows)
                if len(episode_rows)==1:
                    d.season=int(first['season']); d.episode=int(first['episode'])
                    d.episode_end=first.get('episode_end'); d.episode_title=first.get('episode_title')
                return d
            ev.append('mixed/unparsed episode bundle retained for manual review')
            return Decision('tv','episodic-video-mixed',0.88,'review',ev,
                            first['series'], first.get('year') or year,
                            series=first['series'], episodes=episode_rows)

        camera_hits=0
        for f in videos:
            if any(rx.search(f.stem) for rx in CAMERA_PATTERNS):
                camera_hits += 1
        if camera_hits and camera_hits >= max(1, len(videos)//2):
            ev=list(evidence); ev.append(f'camera/date naming on {camera_hits} of {len(videos)} video file(s)')
            return Decision('home-video','camera-video',0.94,'auto',ev,title,year)

        sizes=sorted(((file_size(f), f) for f in videos), key=lambda x: x[0], reverse=True)
        largest=sizes[0][0] if sizes else 0
        second=sizes[1][0] if len(sizes)>1 else 0
        total=sum(x[0] for x in sizes)
        dominance=(largest/total) if total else 0.0
        second_ratio=(second/largest) if largest else 0.0
        comparable=sum(1 for size,_ in sizes if largest and size >= largest*0.55 and size >= 250*MIB)
        shape_ev=f'video layout: {len(videos)} file(s), largest={largest//MIB} MiB, dominance={dominance:.2f}, comparable={comparable}'

        # ARM's directory is only a hint. Combine it with the actual artifact
        # shape so disabling ARM metadata no longer makes routing random.
        if len(videos) == 1:
            ev=list(evidence); ev.append(shape_ev)
            if hint == 'movie':
                ev.append('single video agrees with ARM movie hint')
                return Decision('movie','single-feature',0.98,'auto',ev,title,year)
            if hint in ('unknown','unidentified','undefined','raw-recovery','transcode-recovery') and largest >= 300*MIB:
                ev.append('single substantial optical-video artifact; treating as feature movie')
                return Decision('movie','single-feature',0.92,'auto',ev,title,year)
            if hint == 'tv':
                ev.append('single video conflicts with ARM TV hint; manual confirmation retained')
                return Decision('tv','single-episode-candidate',0.84,'review',ev,title,year)
            ev.append('one video file and no episodic naming; metadata confirmation recommended')
            return Decision('movie','single-feature-candidate',0.78,'review',ev,title,year)

        # Movie discs commonly contain one dominant feature plus much smaller
        # extras. Require a clear size gap before auto-routing.
        movie_shape = largest >= 500*MIB and dominance >= 0.58 and second_ratio <= 0.48
        if movie_shape:
            ev=list(evidence); ev.extend([shape_ev,'one dominant feature with smaller extras'])
            conf=0.97 if hint == 'movie' else 0.92 if hint in ('unknown','unidentified','undefined','raw-recovery','transcode-recovery','') else 0.86
            action='auto' if conf >= auto_threshold() else 'review'
            # Extras / alternate cuts may be bigger or longer than the film.
            # Never auto-publish an undifferentiated multi-video optical rip.
            ev.append('main-feature selection required; no automatic extras promotion')
            return Decision('movie','dominant-feature',conf,'review',ev,title,year)

        # TV sets commonly contain several similarly sized feature tracks.
        # Three or more comparable tracks are strong local evidence; two tracks
        # become auto only when ARM independently hinted TV.
        if comparable >= 3 or (hint == 'tv' and comparable >= 2):
            ev=list(evidence); ev.extend([shape_ev,'multiple similarly sized feature tracks indicate episodic video'])
            if hint == 'movie':
                ev.append('local episodic layout conflicts with ARM movie hint; manual confirmation retained')
                return Decision('video','movie-tv-conflict',0.78,'review',ev,title,year)
            # Track size is enough to suggest TV, but not enough to assign safe
            # episode numbers for Jellyfin. Keep unnamed multi-track sets in
            # review unless filenames already provided SxxEyy evidence above.
            conf=0.88 if hint == 'tv' else 0.84
            ev.append('episode numbering is unknown; manual review required before Jellyfin promotion')
            return Decision('tv','multi-episode-candidate',conf,'review',ev,title,year)

        ev=list(evidence); ev.append(shape_ev)
        if hint == 'movie':
            ev.append('ARM movie hint conflicts with ambiguous multi-video layout')
            return Decision('movie','multi-video-candidate',0.83,'review',ev,title,year)
        if hint == 'tv':
            ev.append('ARM TV hint present but local track layout is not decisive')
            return Decision('tv','multi-video-candidate',0.83,'review',ev,title,year)
        ev.append('multiple video files without decisive feature/episode structure')
        return Decision('video','multi-video-ambiguous',0.55,'review',ev,title,year)

    if files:
        exts = sorted({f.suffix.lower() or '[no extension]' for f in files})
        if any(f.suffix.lower() in INSTALLER_EXTS for f in files):
            return Decision('software','data-files',0.82,'review',['executable/installer-like files detected but no strong installer marker'],title,year)
        return Decision('data','unknown-data',0.55,'review',[f'{len(files)} non-media file(s); extensions: {", ".join(exts[:8])}'],title,year)
    return Decision('unknown','empty',0.0,'review',['no regular files found'],title,year)


def provider_config() -> tuple[str,str]:
    pf=Path('/etc/pc-game-archive/arm-metadata-provider')
    provider=(pf.read_text().strip().lower() if pf.exists() else 'omdb')
    if provider not in ('omdb','tmdb'): provider='omdb'
    kf=Path('/etc/pc-game-archive/arm-omdb-key' if provider=='omdb' else '/etc/pc-game-archive/arm-tmdb-key')
    return provider, (kf.read_text().strip() if kf.exists() else '')


def get_json(url: str, timeout: float) -> dict:
    req=urllib.request.Request(url, headers={'User-Agent':f'PCGameArchive/{VERSION}'})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read().decode('utf-8'))


def similarity(a: str, b: str) -> float:
    norm=lambda s: re.sub(r'[^a-z0-9]+',' ',s.lower()).strip()
    return difflib.SequenceMatcher(None,norm(a),norm(b)).ratio()


def enrich_video(decision: Decision, timeout: float) -> Decision:
    if decision.classification not in ('movie','video','tv') or not (decision.series or decision.title):
        return decision
    provider,key=provider_config()
    if not key:
        decision.evidence.append(f'{provider.upper()} not configured; local classification retained')
        return decision
    try:
        if provider=='omdb':
            endpoint=os.environ.get('PCGA_OMDB_ENDPOINT','https://www.omdbapi.com/')
            lookup_title=decision.series or decision.title
            q={'apikey':key,'t':lookup_title}
            if decision.classification=='tv': q['type']='series'
            elif decision.classification=='movie': q['type']='movie'
            if decision.year: q['y']=decision.year
            data=get_json(endpoint+'?'+urllib.parse.urlencode(q),timeout)
            if str(data.get('Response','')).lower()!='true':
                decision.evidence.append('OMDb returned no match')
                return decision
            typ=str(data.get('Type','')).lower()
            if typ not in ('movie','series'): return decision
            found=str(data.get('Title') or decision.title)
            sim=similarity(lookup_title,found)
            if sim < 0.72:
                decision.evidence.append(f'OMDb candidate rejected: title similarity {sim:.2f}')
                return decision
            decision.classification='movie' if typ=='movie' else 'tv'
            decision.subtype='metadata-identified'
            decision.confidence=max(decision.confidence, min(0.99,0.88+0.11*sim))
            decision.action='auto' if decision.confidence>=auto_threshold() else 'review'
            decision.title=found
            if decision.classification=='tv': decision.series=found
            decision.year=str(data.get('Year',''))[:4] or decision.year
            decision.provider='omdb'; decision.provider_id=data.get('imdbID')
            decision.evidence.append(f'OMDb {typ} match; title similarity {sim:.2f}')
            return decision
        default_endpoint = ('https://api.themoviedb.org/3/search/tv' if decision.classification=='tv' else
                            'https://api.themoviedb.org/3/search/movie' if decision.classification=='movie' else
                            'https://api.themoviedb.org/3/search/multi')
        endpoint=os.environ.get('PCGA_TMDB_ENDPOINT',default_endpoint)
        lookup_title=decision.series or decision.title
        q={'api_key':key,'query':lookup_title}
        data=get_json(endpoint+'?'+urllib.parse.urlencode(q),timeout)
        best=None
        for result in data.get('results',[])[:10]:
            mt=result.get('media_type') or ('tv' if decision.classification=='tv' else 'movie' if decision.classification=='movie' else None)
            if mt not in ('movie','tv'): continue
            found=result.get('title') or result.get('name') or ''
            sim=similarity(lookup_title,found)
            if best is None or sim>best[0]: best=(sim,result)
        if not best or best[0] < 0.72:
            decision.evidence.append('TMDb returned no sufficiently similar movie/TV match')
            return decision
        sim,result=best; mt=result.get('media_type'); found=result.get('title') or result.get('name') or decision.title
        decision.classification='movie' if mt=='movie' else 'tv'
        decision.subtype='metadata-identified'
        decision.confidence=max(decision.confidence,min(0.99,0.88+0.11*sim))
        decision.action='auto' if decision.confidence>=auto_threshold() else 'review'
        decision.title=found
        if decision.classification=='tv': decision.series=found
        decision.year=(result.get('release_date') or result.get('first_air_date') or '')[:4] or decision.year
        decision.provider='tmdb'; decision.provider_id=result.get('id')
        decision.evidence.append(f'TMDb {mt} match; title similarity {sim:.2f}')
    except Exception as exc:
        decision.evidence.append(f'metadata lookup deferred: {type(exc).__name__}')
    return decision


def manifest_path(src: Path) -> Path:
    return src/'.pcga-classification.json' if src.is_dir() else src.with_name(src.name+'.pcga-classification.json')


def write_manifest(src: Path, decision: Decision, destination: Path | None = None) -> None:
    payload={
        'schema_version':SCHEMA,'pcga_version':VERSION,'classified_at':time.strftime('%Y-%m-%dT%H:%M:%SZ',time.gmtime()),
        'source':str(src),'classification':decision.classification,'subtype':decision.subtype,
        'confidence':round(decision.confidence,3),'action':decision.action,'title':decision.title,'year':decision.year,
        'provider':decision.provider,'provider_id':decision.provider_id,'evidence':decision.evidence,
        'series':decision.series,'season':decision.season,'episode':decision.episode,
        'episode_end':decision.episode_end,'episode_title':decision.episode_title,'episodes':decision.episodes,
        'destination':str(destination) if destination else None,
    }
    try: manifest_path(src).write_text(json.dumps(payload,indent=2,sort_keys=True)+'\n')
    except OSError as exc: log(f'could not write manifest for {src.name}: {exc}')


def unique_dest(dest: Path) -> Path:
    if not dest.exists(): return dest
    stamp=time.strftime('%Y%m%d-%H%M%S')
    candidate=dest.with_name(f'{dest.name}-{stamp}')
    i=1
    while candidate.exists():
        i+=1; candidate=dest.with_name(f'{dest.name}-{stamp}-{i}')
    return candidate


def destination_for(root: Path, src: Path, d: Decision) -> Path | None:
    title=safe_name(d.title or clean_name(src.stem if src.is_file() else src.name)[0] or src.stem)
    year=re.sub(r'\D','',d.year or '')[:4]
    named=f'{title} ({year})' if year else title
    if d.classification=='movie': return root/'media/library/movies'/named
    if d.classification=='tv': return root/'media/library/tv'/tv_series_folder_name(d)
    if d.classification=='music': return root/'media/library/music'/named
    if d.classification=='home-video': return root/'media/library/home-videos'/named
    if d.classification=='photo':
        uploads=root/'media/library/photos'/'Uploads'
        if src.is_file(): return uploads/time.strftime('%Y-%m',time.localtime())/original_queue_name(src.name)
        return uploads/named
    if d.classification=='pc-game': return root/'ingest/inbox/pc-games'/named
    if d.classification=='software': return root/'ingest/inbox/software'/named
    if d.classification=='disc-image':
        leaf = named + src.suffix.lower() if src.is_file() and src.suffix else named
        return root/'ingest/inbox/disc-images'/leaf
    return None


def move_manifest_for_file(old: Path, new: Path) -> None:
    side=old.with_name(old.name+'.pcga-classification.json')
    if side.exists():
        try: shutil.move(str(side),str(new.with_name(new.name+'.pcga-classification.json')))
        except OSError: pass


def cleanup_source_hint(src: Path) -> None:
    hp=source_hint_path(src)
    try:
        if hp.exists(): hp.unlink()
    except OSError:
        pass


def write_series_identity(series_root: Path, d: Decision) -> None:
    payload={
        'pcga_version':VERSION,'series':d.series or d.title,'year':d.year,
        'provider':d.provider,'provider_id':d.provider_id,
        'updated_at':time.strftime('%Y-%m-%dT%H:%M:%SZ',time.gmtime()),
    }
    try:
        (series_root/'.pcga-series.json').write_text(json.dumps(payload,indent=2,sort_keys=True)+'\n')
    except OSError:
        pass


def promote_tv(root: Path, src: Path, decision: Decision) -> bool:
    rows=list(decision.episodes or [])
    if not rows and decision.season is not None and decision.episode is not None:
        rows=[{
            'path':src.name,'series':decision.series or decision.title,
            'season':decision.season,'episode':decision.episode,
            'episode_end':decision.episode_end,'episode_title':decision.episode_title,
            'year':decision.year,
        }]
    if not rows:
        return False
    series=decision.series or decision.title or str(rows[0].get('series') or '')
    if not series:
        return False
    series_root=find_tv_series_root(root,decision)
    planned=[]
    for row in rows:
        try:
            season=int(row['season']); episode=int(row['episode'])
        except (KeyError,TypeError,ValueError):
            return False
        rel=str(row.get('path') or src.name)
        old=(src/rel) if src.is_dir() else src
        if not old.is_file():
            return False
        stem=canonical_episode_stem(series,season,episode,row.get('episode_end'),row.get('episode_title'))
        final=series_root/f'Season {season:02d}'/(stem+old.suffix.lower())
        planned.append((old,final))
    if len({str(a.resolve()) for a,_ in planned}) != len(planned):
        return False
    collisions=[final for _,final in planned if final.exists()]
    if collisions:
        dup=root/'media/quarantine/duplicates'/(time.strftime('%Y%m%d-%H%M%S')+'-'+src.name)
        dup.parent.mkdir(parents=True,exist_ok=True)
        write_manifest(src,decision,dup)
        cleanup_source_hint(src)
        shutil.move(str(src),str(dup)); move_manifest_for_file(src,dup)
        log(f'TV destination exists; preserved duplicate {src.name} -> {dup}')
        return True
    for old,final in planned:
        final.parent.mkdir(parents=True,exist_ok=True)
        shutil.move(str(old),str(final))
    write_series_identity(series_root,decision)
    # The queue manifest/hint described the bundle, not an individual episode.
    try:
        mp=manifest_path(src)
        if mp.exists(): mp.unlink()
    except OSError:
        pass
    cleanup_source_hint(src)
    if src.is_dir():
        for d in sorted([x for x in src.rglob('*') if x.is_dir()], key=lambda x:len(x.parts), reverse=True):
            try: d.rmdir()
            except OSError: pass
        try: src.rmdir()
        except OSError: pass
    log(f'tv {decision.confidence:.2f}: {src.name} -> {series_root} ({len(planned)} episode(s))')
    return True


def promote(root: Path, src: Path, decision: Decision) -> bool:
    if decision.classification=='tv':
        return promote_tv(root,src,decision)
    dest=destination_for(root,src,decision)
    if not dest: return False

    # Movie/TV/music/home destinations are library folders. A loose file must
    # be placed inside that folder rather than renamed to the folder path. The
    # game/software queues follow the same preservation-friendly rule for a
    # loose installer. Disc-image destinations are intentionally files.
    folder_classes={'movie','tv','music','home-video','pc-game','software'}
    if src.is_file() and decision.classification in folder_classes:
        dest.mkdir(parents=True,exist_ok=True)
        final=dest/original_queue_name(src.name)
    else:
        dest.parent.mkdir(parents=True,exist_ok=True)
        final=dest

    if final.exists():
        if decision.classification in ('movie','tv','music','home-video'):
            dup=root/'media/quarantine/duplicates'/(time.strftime('%Y%m%d-%H%M%S')+'-'+src.name)
            dup.parent.mkdir(parents=True,exist_ok=True)
            write_manifest(src,decision,dup)
            cleanup_source_hint(src)
            shutil.move(str(src),str(dup)); move_manifest_for_file(src,dup)
            log(f'destination exists; preserved duplicate {src.name} -> {dup}')
            return True
        final=unique_dest(final)

    write_manifest(src,decision,final)
    cleanup_source_hint(src)
    shutil.move(str(src),str(final)); move_manifest_for_file(src,final)
    log(f'{decision.classification} {decision.confidence:.2f}: {src.name} -> {final}')
    return True


def repair_tv_layout(root: Path, apply: bool = False) -> int:
    tvroot=root/'media/library/tv'
    tvroot.mkdir(parents=True,exist_ok=True)
    candidates=0; moved=0
    for child in sorted(tvroot.iterdir(), key=lambda p:p.name.lower()):
        if not child.is_dir(): continue
        videos=[p for p in child.rglob('*') if p.is_file() and p.suffix.lower() in VIDEO_EXTS]
        if not videos: continue
        rows=[]
        for video in videos:
            parsed=parse_episode_identity(video.name)
            if not parsed: rows=[]; break
            parsed['old']=video
            rows.append(parsed)
        if not rows: continue
        series_keys={re.sub(r'[^a-z0-9]+',' ',str(r['series']).lower()).strip() for r in rows}
        if len(series_keys)!=1: continue
        first=rows[0]
        d=Decision('tv','layout-repair',1.0,'auto',['existing TV layout repair'],
                   first['series'],first.get('year'),series=first['series'])
        target_root=tvroot/tv_series_folder_name(d)
        plan=[]
        for row in rows:
            old=row['old']; season=int(row['season']); episode=int(row['episode'])
            final=target_root/f'Season {season:02d}'/(canonical_episode_stem(first['series'],season,episode,row.get('episode_end'),row.get('episode_title'))+old.suffix.lower())
            if old.resolve() != final.resolve(): plan.append((old,final))
        if not plan: continue
        if any(final.exists() and final.resolve()!=old.resolve() for old,final in plan):
            log(f'TV repair skipped {child.name}: destination collision')
            continue
        candidates+=1
        print(f"TV repair: {child} -> {target_root} ({len(plan)} file(s))")
        if not apply: continue
        for old,final in plan:
            final.parent.mkdir(parents=True,exist_ok=True)
            shutil.move(str(old),str(final)); moved+=1
        write_series_identity(target_root,d)
        leftovers=[p for p in child.rglob('*') if p.is_file() and not p.name.startswith('.pcga-')]
        if leftovers and child != target_root:
            extras=target_root/'extras'/safe_name(child.name)
            extras.mkdir(parents=True,exist_ok=True)
            for old in leftovers:
                target=extras/old.name
                if target.exists(): target=unique_dest(target)
                shutil.move(str(old),str(target))
        for dpath in sorted([x for x in child.rglob('*') if x.is_dir()],key=lambda x:len(x.parts),reverse=True):
            try:dpath.rmdir()
            except OSError:pass
        if child != target_root:
            try: child.rmdir()
            except OSError: pass
    print(f"TV layout repair {'applied' if apply else 'preview'}: candidates={candidates} files_moved={moved}")
    return 0


def scan_items(root: Path) -> Iterable[Path]:
    seen=set()
    for base in (root/'media/metadata-pending', root/'media/quarantine/unidentified'):
        if not base.exists(): continue
        for src in list(base.iterdir()):
            if src.name.startswith('.pcga-') or src.name.endswith('.pcga-classification.json'): continue
            try: key=str(src.resolve())
            except OSError: continue
            if key in seen: continue
            seen.add(key); yield src


def main() -> int:
    ap=argparse.ArgumentParser(description='PC Game Archive local-first classification engine')
    ap.add_argument('path',nargs='?',help='classify one path instead of the pending queues')
    ap.add_argument('--json',action='store_true',help='print one-path decision as JSON')
    ap.add_argument('--no-move',action='store_true',help='write/print classifications without promoting')
    ap.add_argument('--status',action='store_true',help='show pending decisions and auto-classified queue counts')
    ap.add_argument('--repair-tv-layout',action='store_true',help='preview repair of split TV series folders using SxxEyy filenames')
    ap.add_argument('--apply',action='store_true',help='apply --repair-tv-layout changes')
    args=ap.parse_args()
    root=root_path(); settle=int(os.environ.get('PCGA_CLASSIFY_SETTLE_SECONDS','60')); timeout=float(os.environ.get('PCGA_METADATA_TIMEOUT','5'))
    for d in ('media/metadata-pending','media/quarantine/unidentified','media/quarantine/duplicates','media/library/movies','media/library/tv','media/library/music','media/library/home-videos','media/library/photos','ingest/inbox/pc-games','ingest/inbox/software','ingest/inbox/disc-images'):
        (root/d).mkdir(parents=True,exist_ok=True)
    if args.repair_tv_layout:
        return repair_tv_layout(root,args.apply)
    if args.status:
        print('PCGA classification status')
        for rel in ('ingest/inbox/pc-games','ingest/inbox/software','ingest/inbox/disc-images'):
            d=root/rel
            count=sum(1 for x in d.iterdir() if not x.name.endswith('.pcga-classification.json')) if d.exists() else 0
            print(f'  {rel}: {count}')
        print('  pending decisions:')
        any_pending=False
        for src in scan_items(root):
            any_pending=True
            mp=manifest_path(src)
            try: data=json.loads(mp.read_text()) if mp.exists() else {}
            except Exception: data={}
            print(f"    {src.name}: {data.get('classification','uninspected')} confidence={data.get('confidence','-')} action={data.get('action','-')}")
            for ev in (data.get('evidence') or [])[:2]: print(f'      - {ev}')
        if not any_pending: print('    none')
        return 0
    items=[Path(args.path)] if args.path else list(scan_items(root))
    downstream_index=downstream_optical_index(root) if not args.path else {}
    moved=0; inspected=0; review=0; pc_games_moved=0; retired=0
    for src in items:
        if not src.exists(): continue
        if not args.path and not settled(src,settle): continue
        fp=optical_fingerprint(src)
        if not args.path and fp and fp in downstream_index:
            try:
                retire_consumed_pending(root,src,downstream_index[fp],fp); retired+=1
            except OSError as exc:
                log(f'could not retire stale pending copy {src}: {exc}')
            continue
        inspected+=1
        d=inspect_local(src)
        if d.classification in ('movie','video','tv'):
            d=enrich_video(d,timeout)
        hard_review={'optical-multi-title','optical-multi-disc','optical-season-disc',
                     'optical-single-title','optical-title-candidate','dominant-feature',
                     'multi-video-candidate','multi-video-ambiguous','movie-tv-conflict',
                     'multi-episode-candidate','optical-segment-assembly'}
        video_count=sum(1 for x in iter_files(src) if x.suffix.lower() in VIDEO_EXTS)
        # Metadata lookup may upgrade a weak local decision to 0.99; this must
        # never override the physical evidence that multiple MakeMKV titles exist.
        is_optical_source=bool(media_manifest(src) or source_hint(src) in
                                   ('movie','tv','unknown','unidentified','undefined','raw-recovery','transcode-recovery'))
        needs_feature_review=(video_count>1 and d.classification in ('movie','video','tv')
                              and is_optical_source and not (d.classification=='tv' and d.episodes))
        structured_optical=bool(media_manifest(src).get('pcga_disc_structure'))
        segment_assembly=(src.is_dir() and (src/'.pcga-segment-assembly.json').is_file())
        unbound_optical=(video_count>=1 and is_optical_source and not media_manifest(src))
        d.action='review' if (structured_optical or segment_assembly or d.subtype in hard_review or needs_feature_review or unbound_optical) else ('auto' if d.confidence >= auto_threshold() and destination_for(root,src,d) else 'review')
        if structured_optical:
            data=media_manifest(src).get('pcga_disc_structure') or {}
            d.evidence.append(f"Disc-native logical title manifest: {len(data.get('logical_titles') or [])} MakeMKV title(s); verify complete feature and extras")
        if segment_assembly:
            d.evidence.append('Assembled movie segments must be previewed and confirmed before publication')
        if unbound_optical:
            d.evidence.append('unverified optical origin; disc identity must be confirmed before publishing')
        if needs_feature_review:
            d.evidence.append('multiple optical video titles: explicitly select the feature in Manual Review')
        if args.json:
            print(json.dumps(asdict(d),indent=2,sort_keys=True))
        write_manifest(src,d)
        if d.action=='auto' and not args.no_move:
            expected=destination_for(root,src,d)
            if fp: update_optical_dispatch(fp,'publishing',classification=d.classification,confidence=d.confidence,detail='Classification accepted; publishing preserved content')
            try:
                if promote(root,src,d):
                    moved+=1
                    if d.classification=='pc-game': pc_games_moved+=1
                    if fp:
                        update_optical_dispatch(fp,'published',classification=d.classification,confidence=d.confidence,downstream=expected,detail='Preserved content published to appliance library')
            except OSError as exc:
                if fp: update_optical_dispatch(fp,'review-required',classification=d.classification,confidence=d.confidence,detail='Automatic publication failed; manual review required')
                log(f'promotion failed for {src}: {exc}')
        else:
            review+=1
            if fp: update_optical_dispatch(fp,'review-required',classification=d.classification,confidence=d.confidence,detail='Preserved content requires classification review')
            log(f'review {d.confidence:.2f} {d.classification}: {src.name}; ' + '; '.join(d.evidence[:2]))
    if moved and Path('/usr/local/sbin/pcga-jellyfin-refresh').exists() and os.environ.get('PCGA_DISABLE_JELLYFIN_REFRESH')!='1':
        subprocess.run(['/usr/local/sbin/pcga-jellyfin-refresh'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    if pc_games_moved and Path('/usr/local/sbin/pcga-game-orchestrator').exists() and os.environ.get('PCGA_DISABLE_GAME_ORCHESTRATOR')!='1':
        subprocess.run(['systemctl','--no-block','start','pcga-game-orchestrator.service'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    log(f'pass complete; inspected={inspected} promoted={moved} pc_games={pc_games_moved} review={review} retired={retired}')
    return 0

if __name__=='__main__':
    raise SystemExit(main())
